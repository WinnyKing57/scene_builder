   "sceneDescription": {
    "itemList": {
     "items": [
      {
       "type": "SceneWebView",
       "sceneWebViewConfig": {
        "closeSceneOnPress": false,
        "enableJavaScript": true,
        "enableSwipeNavigation": false,
        "height": 20,
        "url": "<!DOCTYPE+html>\n<html>\n<head>\n++<meta+charset=\"UTF-8\">\n++<title>YouTube+Playlist+Auto-Open+with+Fallback</title>\n++<style>\n++++html,+body+{\n++++++margin:+0;\n++++++padding:+0;\n++++++width:+100vw;\n++++++height:+100vh;\n++++++background:+black;\n++++++cursor:+pointer;\n++++}\n++++#fallback+{\n++++++position:+absolute;\n++++++top:+0;+left:+0;\n++++++width:+100%;\n++++++height:+100%;\n++++++display:+none;+/*+hidden+initially+*/\n++++}\n++</style>\n</head>\n<body>\n++<a+id=\"fallback\"+href=\"{lv=input}\"+target=\"_blank\"></a>\n\n++<script>\n++++const+youtubeLink+=+\"{lv=input}\";\n++++const+fallback+=+document.getElementById(\"fallback\");\n\n++++function+openPlaylist()+{\n++++++//+Notify+server\n++++++fetch(\"http://localhost:8080/youTubePopupTrigger?status=opened\").catch(()+=>+{});\n\n++++++//+Attempt+automatic+navigation\n++++++try+{\n++++++++window.location.href+=+youtubeLink;\n++++++}+catch+(e)+{\n++++++++//+If+automatic+navigation+fails,+show+fallback\n++++++++fallback.style.display+=+\"block\";\n++++++}\n\n++++++//+Optional:+send+progress+every+5+seconds\n++++++const+intervalId+=+setInterval(()+=>+{\n++++++++fetch(\"http://localhost:8080/youTubePopupTrigger?status=progress\").catch(()+=>+{});\n++++++},+5000);\n\n++++++//+Stop+loop+if+page+is+closed+or+hidden\n++++++window.addEventListener(\"beforeunload\",+()+=>+{\n++++++++clearInterval(intervalId);\n++++++++if+(navigator.sendBeacon)+{\n++++++++++navigator.sendBeacon(\"http://localhost:8080/youTubePopupTrigger?status=closed\");\n++++++++}\n++++++});\n++++}\n\n++++//+Simulate+click+on+load\n++++window.addEventListener(\"load\",+()+=>+{\n++++++const+clickEvent+=+new+MouseEvent(\"click\",+{+bubbles:+true,+cancelable:+true+});\n++++++document.body.dispatchEvent(clickEvent);\n\n++++++//+Try+to+open+playlist\n++++++openPlaylist();\n++++});\n\n++++//+Fallback+click+handler\n++++fallback.addEventListener(\"click\",+()+=>+{\n++++++fallback.style.display+=+\"none\";+//+hide+fallback+after+click\n++++});\n++</script>\n</body>\n</html>\n",
        "variableUpdateValue": {
         "type": "None"
        },
        "width": 100
       },
