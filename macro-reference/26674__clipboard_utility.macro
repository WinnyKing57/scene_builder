  {
   "blockNextAction": true,
   "m_nonRoot": true,
   "m_script": "#!/system/bin/sh\n\n#+Newer+Android+versions+(single+property+for+locale+++region)\nlang=$(getprop+persist.sys.locale)\n\n#+Fallback+for+older+Android+versions\nif+[+-z+\"$lang\"+];+then\n++++lang=$(getprop+persist.sys.language)\n++++region=$(getprop+persist.sys.country)\n++++if+[+-n+\"$region\"+];+then\n++++++++lang=\"${lang}_${region}\"\n++++fi\nfi\n\necho+\"$lang\"\n",
   "m_variableToSaveResponse": {
    "dictionary": {
