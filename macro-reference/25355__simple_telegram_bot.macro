        {
         "key": "FirstStartDialog",
         "variable": {
          "textValue": "<b>🛠+Criação+do+bot</b>\n<br>\n1.+<b>Abra+o+Telegram</b>+e+encontre+<b><a+href=\"https://t.me/BotFather\">@BotFather</a></b><br>\n2.+Envie+o+comando:+<code>/newbot</code><br>\n3.+Siga+as+instruções:+insira+o+<b>nome+do+bot</b>+e+o+<b>nome+de+usuário</b><br>\n4.+Copie+o+<b>Token+da+API</b>+fornecido<br>\n5.+Cole+o+token+no+campo+<code>Telegram+API+token</code>\n<br>\n<br>\n<b>🔐+Conexão+de+serviços+API:</b>\n<br>\n•+<b>VirusTotal</b>:+obtenha+uma+chave+API+em+<a+href=\"https://www.virustotal.com/\">virustotal.com</a>\n<br>\n•+Cole+a+chave+no+campo+<code>VirusTotal+API+token</code>\n<br>\n<br>\n•+<b>DeepSeek</b>:+registre+uma+chave+em+<a+href=\"https://openrouter.ai/deepseek/deepseek-chat-v3-0324\">openrouter.ai</a>\n<br>\n•+Cole+a+chave+no+campo+<code>OpenRoute+API+token</code>\n<br>\n<br>\n<b>📎+Mais+sobre+o+macro:</b>\n<br>\n<a+href=\"https://github.com/BespredeL/MacroDroid/\">GitHub</a>+|+<a+href=\"https://4pda.to/forum/index.php?showtopic=796731&view=findpost&p=136381928\">4PDA</a>+|+<a+href=\"https://www.macrodroidforum.com/index.php?threads/simple-telegram-bot.10087/\">MacroDroid+Forum</a>",
          "variableType": 2,
          "type": "StringValue"
         },
