        {
         "key": "FirstStartDialog",
         "variable": {
          "textValue": "<b>🛠+Création+du+bot</b>\n<br>\n1.+<b>Ouvrez+Telegram</b>+et+trouvez+<b><a+href=\"https://t.me/BotFather\">@BotFather</a></b><br>\n2.+Envoyez+la+commande+:+<code>/newbot</code><br>\n3.+Suivez+les+instructions+:+entrez+le+<b>nom+du+bot</b>+et+le+<b>nom+d’utilisateur</b><br>\n4.+Copiez+le+<b>jeton+API</b>+fourni<br>\n5.+Collez+le+jeton+dans+le+champ+<code>Telegram+API+token</code>\n<br>\n<br>\n<b>🔐+Connexion+des+services+API+:</b>\n<br>\n•+<b>VirusTotal</b>+:+obtenez+une+clé+API+sur+<a+href=\"https://www.virustotal.com/\">virustotal.com</a>\n<br>\n•+Collez+la+clé+dans+le+champ+<code>VirusTotal+API+token</code>\n<br>\n<br>\n•+<b>DeepSeek</b>+:+enregistrez+une+clé+sur+<a+href=\"https://openrouter.ai/deepseek/deepseek-chat-v3-0324\">openrouter.ai</a>\n<br>\n•+Collez+la+clé+dans+le+champ+<code>OpenRoute+API+token</code>\n<br>\n<br>\n<b>📎+Plus+d’infos+sur+le+macro+:</b>\n<br>\n<a+href=\"https://github.com/BespredeL/MacroDroid/\">GitHub</a>+|+<a+href=\"https://4pda.to/forum/index.php?showtopic=796731&view=findpost&p=136381928\">4PDA</a>+|+<a+href=\"https://www.macrodroidforum.com/index.php?threads/simple-telegram-bot.10087/\">MacroDroid+Forum</a>",
          "variableType": 2,
          "type": "StringValue"
         },
