        {
         "key": "FirstStartDialog",
         "variable": {
          "textValue": "<b>🛠+Creación+del+bot</b>\n<br>\n1.+<b>Abra+Telegram</b>+y+busque+<b><a+href=\"https://t.me/BotFather\">@BotFather</a></b><br>\n2.+Envíe+el+comando:+<code>/newbot</code><br>\n3.+Siga+las+instrucciones:+ingrese+el+<b>nombre+del+bot</b>+y+el+<b>nombre+de+usuario</b><br>\n4.+Copie+el+<b>Token+API</b>+generado<br>\n5.+Pegue+el+token+en+el+campo+<code>Telegram+API+token</code>\n<br>\n<br>\n<b>🔐+Conexión+de+servicios+API:</b>\n<br>\n•+<b>VirusTotal</b>:+obtenga+una+clave+API+en+<a+href=\"https://www.virustotal.com/\">virustotal.com</a>\n<br>\n•+Pegue+la+clave+en+el+campo+<code>VirusTotal+API+token</code>\n<br>\n<br>\n•+<b>DeepSeek</b>:+registre+una+clave+en+<a+href=\"https://openrouter.ai/deepseek/deepseek-chat-v3-0324\">openrouter.ai</a>\n<br>\n•+Pegue+la+clave+en+el+campo+<code>OpenRoute+API+token</code>\n<br>\n<br>\n<b>📎+Más+sobre+el+macro:</b>\n<br>\n<a+href=\"https://github.com/BespredeL/MacroDroid/\">GitHub</a>+|+<a+href=\"https://4pda.to/forum/index.php?showtopic=796731&view=findpost&p=136381928\">4PDA</a>+|+<a+href=\"https://www.macrodroidforum.com/index.php?threads/simple-telegram-bot.10087/\">MacroDroid+Forum</a>",
