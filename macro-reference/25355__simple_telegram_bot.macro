    {
     "sceneDescription": {
      "itemList": {
       "items": [
        {
         "type": "SceneWebView",
         "sceneWebViewConfig": {
          "closeSceneOnPress": false,
          "enableJavaScript": true,
          "enableSwipeNavigation": false,
          "height": 99,
          "url": "<!--\n++Simple+Telegram+Bot+(STB)+Macro+—+Docs\n++---\n++Author:++++BespredeL+(Aleksandr+Kireev)\n++Website:+++https://bespredel.name\n++GitHub:++++https://github.com/BespredeL\n-->\n<!doctype+html>\n<html+lang=\"ru\">\n<head>\n++++<meta+charset=\"utf-8\"+/>\n++++<meta+name=\"viewport\"+content=\"width=device-width,initial-scale=1\"+/>\n++++<title>Simple+Telegram+Bot</title>\n++++<style>\n++++++++:root+{\n++++++++++++--bg:+#f9fafb;\n++++++++++++--card:+#fff;\n++++++++++++--accent:+#0ea5e9;\n++++++++++++--muted:+#6b7280;\n++++++++++++--text:+#111827;\n++++++++++++--card-radius:+10px;\n++++++++++++--shadow:+0+2px+6px+rgba(0,0,0,.3);\n++++++++++++--blue:+#1976d2;\n++++++++++++--green:+#2e7d32;\n++++++++++++--red:+#c62828;\n++++++++++++--header-height:+50px;\n++++++++++++--nav-height:+64px;\n++++++++++++font-family:+Inter,+Roboto,+Arial,+sans-serif;\n++++++++}\n\n++++++++html+{\n++++++++++++scroll-behavior:+smooth;\n++++++++++++scroll-padding-top:+calc(var(--header-height)+++5px);\n++++++++}\n\n++++++++body+{\n++++++++++++margin:+0;\n++++++++++++background:+var(--bg);\n++++++++++++color:+var(--text);\n++++++++++++padding:+var(--header-height)+0+calc(var(--nav-height)+++12px);\n++++++++++++-webkit-font-smoothing:+antialiased\n++++++++}\n\n++++++++header+{\n++++++++++++position:+fixed;\n++++++++++++top:+0;+left:+0;+right:+0;\n++++++++++++height:+var(--header-height);\n++++++++++++display:+flex;\n++++++++++++align-items:+center;\n++++++++++++justify-content:+center;\n++++++++++++background:+var(--blue);\n++++++++++++color:+#fff;\n++++++++++++font-size:+18px;\n++++++++++++font-weight:+600;\n++++++++++++z-index:+1000;\n++++++++++++box-shadow:+var(--shadow);\n++++++++}\n\n++++++++section+{\n++++++++++++max-width:+900px;\n++++++++++++margin:+0+auto;\n++++++++++++padding:+15px+18px\n++++++++}\n\n++++++++.block+{\n++++++++++++background:+var(--card);\n++++++++++++border:+1px+solid+#e5e7eb;\n++++++++++++border-radius:+var(--card-radius);\n++++++++++++padding:+18px;\n++++++++++++margin-bottom:+18px;\n++++++++++++scroll-margin-top:+12px\n++++++++}\n\n++++++++.title+{\n++++++++++++margin-bottom:+8px;\n++++++++++++display:+flex;\n++++++++++++gap:+8px;\n++++++++++++align-items:+center;\n++++++++++++flex-wrap:+wrap\n++++++++}\n\n++++++++.h+{\n++++++++++++font-size:+20px;\n++++++++++++font-weight:+700;\n++++++++++++margin-bottom:+6px\n++++++++}\n\n++++++++h2.h+{\n++++++++++++margin-top:+12px;\n++++++++++++margin-bottom:+12px;\n++++++++}\n\n++++++++.badge+{\n++++++++++++display:+inline-block;\n++++++++++++padding:+4px+10px;\n++++++++++++border-radius:+8px;\n++++++++++++font-size:+13px\n++++++++}\n\n++++++++.badge-info+{\n++++++++++++background:+var(--accent);\n++++++++++++color:+#fff\n++++++++}\n\n++++++++.desc+{\n++++++++++++color:+var(--muted);\n++++++++++++font-size:+14px;\n++++++++++++margin:+12px+0\n++++++++}\n\n++++++++.section-title+{\n++++++++++++font-weight:+600;\n++++++++++++font-size:+13px;\n++++++++++++margin:+8px+0+4px;\n++++++++++++color:+#374151\n++++++++}\n\n++++++++ul+{\n++++++++++++margin:+0+0+12px+18px;\n++++++++++++padding:+0\n++++++++}\n\n++++++++li+{\n++++++++++++font-size:+14px;\n++++++++++++color:+#374151;\n++++++++++++line-height:+1.5;\n++++++++++++margin:+4px+0\n++++++++}\n\n++++++++.key+{\n++++++++++++color:+var(--accent);\n++++++++++++font-weight:+600;\n++++++++++++margin-right:+6px\n++++++++}\n\n++++++++.hello-world-block+{\n++++++++++++font-size:+14px;\n++++++++++++background:+#fefce0;\n++++++++++++border:+1px+solid+#fdebba;\n++++++++++++border-radius:+12px;\n++++++++++++padding:+20px;\n++++++++++++line-height:+1.5;\n++++++++}\n\n++++++++.hello-world-block+h3+{\n++++++++++++margin:+0+0+12px;\n++++++++++++font-size:+17px;\n++++++++++++font-weight:+700;\n++++++++++++color:+#263238;\n++++++++++++display:+flex;\n++++++++++++align-items:+center;\n++++++++++++gap:+8px\n++++++++}\n\n++++++++.hello-world-block+div:not(:last-child)+{\n++++++++++++margin-bottom:+15px;\n++++++++}\n\n++++++++.hello-world-block+ul+{\n++++++++++++margin-left:+0;\n++++++++++++margin-bottom:+0;\n++++++++}\n++++++++\n++++++++.hello-world-block+ul:not(:last-child)+{\n++++++++++++margin-bottom:+15px;\n++++++++}\n\n++++++++.hello-world-block+ul+li::marker+{\n++++++++++++content:+\"\";\n++++++++}\n\n++++++++.instruction-block+{\n++++++++++++background:+#e0f2fe;\n++++++++++++border:+1px+solid+#bae6fd;\n++++++++++++border-radius:+12px;\n++++++++++++padding:+20px;\n++++++++++++margin:+18px+0\n++++++++}\n\n++++++++.instruction-block+h3+{\n++++++++++++margin:+0+0+12px;\n++++++++++++font-size:+17px;\n++++++++++++font-weight:+700;\n++++++++++++color:+#0369a1;\n++++++++++++display:+flex;\n++++++++++++align-items:+center;\n++++++++++++gap:+8px\n++++++++}\n\n++++++++.instruction-block+ol+{\n++++++++++++margin:+0;\n++++++++++++padding-left:+20px;\n++++++++++++color:+#0c4a6e\n++++++++}\n\n++++++++.instruction-block+li+{\n++++++++++++margin-bottom:+8px;\n++++++++++++line-height:+1.5\n++++++++}\n\n++++++++.instruction-block+code,+.block+code+{\n++++++++++++background:+#fff;\n++++++++++++border:+1px+solid+#bae6fd;\n++++++++++++padding:+2px+6px;\n++++++++++++border-radius:+6px;\n++++++++++++font-size:+13px;\n++++++++++++color:+#0369a1\n++++++++}\n\n++++++++.code-chunk+{\n++++++++++++background:+#0b1220;\n++++++++++++color:+#e5e7eb;\n++++++++++++border-radius:+10px;\n++++++++++++padding:+12px;\n++++++++++++font-family:+ui-monospace,+SFMono-Regular,+Menlo,+Consolas,+\"Liberation+Mono\",+monospace;\n++++++++++++overflow:+auto;\n++++++++++++font-size:+13px;\n++++++++++++margin:+10px+0\n++++++++}\n\n++++++++.nav-wrap+{\n++++++++++++position:+fixed;\n++++++++++++left:+0;\n++++++++++++right:+0;\n++++++++++++bottom:+0;\n++++++++++++height:+var(--nav-height);\n++++++++++++display:+flex;\n++++++++++++align-items:+center;\n++++++++++++justify-content:+center;\n++++++++++++z-index:+1000;\n++++++++++++pointer-events:+none\n++++++++}\n\n++++++++nav+{\n++++++++++++pointer-events:+auto;\n++++++++++++box-sizing:+border-box;\n++++++++++++width:+100%;\n++++++++++++max-width:+1100px;\n++++++++++++margin:+0+14px;\n++++++++++++background:+#fff;\n++++++++++++border-top:+1px+solid+#e5e7eb;\n++++++++++++display:+flex;\n++++++++++++gap:+10px;\n++++++++++++overflow-x:+auto;\n++++++++++++white-space:+nowrap;\n++++++++++++padding:+10px+12px;\n++++++++++++scrollbar-width:+none;\n++++++++++++border-radius:+12px+12px+8px+8px\n++++++++}\n\n++++++++nav::-webkit-scrollbar+{\n++++++++++++display:+none\n++++++++}\n\n++++++++nav+a+{\n++++++++++++display:+inline-block;\n++++++++++++text-decoration:+none;\n++++++++++++font-size:+14px;\n++++++++++++font-weight:+500;\n++++++++++++color:+var(--muted);\n++++++++++++padding:+8px+14px;\n++++++++++++border-radius:+12px;\n++++++++++++margin:+0+4px;\n++++++++++++transition:+background+.12s,+color+.12s;\n++++++++++++flex-shrink:+0\n++++++++}\n\n++++++++nav+a.active+{\n++++++++++++color:+var(--accent);\n++++++++++++background:+rgba(14,+165,+233,+.08)\n++++++++}\n\n++++++++.menu-hint+{\n++++++++++++position:+absolute;\n++++++++++++right:+14px;\n++++++++++++bottom:+calc(var(--nav-height)+++8px);\n++++++++++++background:+rgba(17,+24,+39,+.95);\n++++++++++++color:+#fff;\n++++++++++++font-size:+12px;\n++++++++++++padding:+6px+10px;\n++++++++++++border-radius:+999px;\n++++++++++++opacity:+.95;\n++++++++++++transition:+.28s;\n++++++++++++z-index:+1002\n++++++++}\n\n++++++++.menu-hint.hidden+{\n++++++++++++opacity:+0;\n++++++++++++transform:+translateY(8px);\n++++++++++++pointer-events:+none\n++++++++}\n++++</style>\n</head>\n<body>\n<header+data-i18n=\"headerTitle\">🤖+Simple+Telegram+Bot+-+Documentation</header>\n\n<!--+About+me+-->\n<section+id=\"helloWorld\"></section>\n\n<!--+Training+sections+-->\n<section+id=\"learn\">\n++++<h2+class=\"h\"+data-i18n=\"learnTitle\">Instructions</h2>\n</section>\n\n<!--+Action+Blocks+-->\n<section+id=\"actionBlocks\">\n++++<h2+class=\"h\"+data-i18n=\"groupsTitle\">Action+groups</h2>\n</section>\n\n<div+class=\"nav-wrap\">\n++++<nav+id=\"mainNav\"+aria-label=\"Contents+navigation\"></nav>\n++++<div+class=\"menu-hint\"+id=\"menuHint\"+data-i18n=\"menuHint\">Swipe+the+menu+→</div>\n</div>\n\n<script>\n++++const+DEFAULT_LANG+=+'{lv=currentLang}';\n\n++++/**+=====================+i18n+dictionary+======================+**/\n++++const+langs+=+JSON.parse('{lv=localizedDocJson}');\n\n++++/**+=====================+Blocks+data+==========================+**/\n++++const+blocks+=+JSON.parse('{lv=blocksJson}');\n\n++++/**+=====================+Tiny+DOM+helpers+=====================+**/\n++++const+$+=+(sel,+root+=+document)+=>+root.querySelector(sel);\n++++const+$$+=+(sel,+root+=+document)+=>+Array.from(root.querySelectorAll(sel));\n\n++++function+el(tag,+attrs+=+{},+html)+{\n++++++++const+n+=+document.createElement(tag);\n++++++++for+(const+[k,+v]+of+Object.entries(attrs))+{\n++++++++++++if+(k+===+'class')+n.className+=+v;\n++++++++++++else+if+(k.startsWith('data-'))+n.setAttribute(k,+v);\n++++++++++++else+if+(k+===+'text')+n.textContent+=+v;\n++++++++++++else+if+(k+===+'html')+n.innerHTML+=+v;\n++++++++++++else+n.setAttribute(k,+v);\n++++++++}\n++++++++if+(html+!==+undefined)+n.innerHTML+=+html;\n++++++++return+n;\n++++}\n\n++++/**+=====================+i18n+with+fallback+====================+**/\n++++const+currentLang+=+(DEFAULT_LANG+&&+langs[DEFAULT_LANG])+?+DEFAULT_LANG+:+'en';\n\n++++function+_readPath(root,+parts)+{\n++++++++let+acc+=+root;\n++++++++for+(const+k+of+parts)+{\n++++++++++++if+(!acc+||+!(k+in+acc))+return+undefined;\n++++++++++++acc+=+acc[k];\n++++++++}\n++++++++return+acc;\n++++}\n\n++++function+t(path,+fallback+=+'')+{\n++++++++if+(!path)+return+fallback;\n++++++++const+parts+=+path.split('.');\n++++++++let+v+=+_readPath(langs[currentLang],+parts);\n++++++++if+(v+!=+null)+return+v;\n++++++++v+=+_readPath(langs.en,+parts);\n++++++++return+v+!=+null+?+v+:+fallback;\n++++}\n\n++++/**+=====================+Rendering+=====================+**/\n++++function+createKvList(items)+{\n++++++++const+ul+=+el('ul');\n++++++++for+(const+it+of+items)+{\n++++++++++++const+li+=+el('li');\n++++++++++++const+typeLabel+=+it.type+===+'ArrayDict'\n++++++++++++++++?+t('commonTypes.ArrayDict',+'Array<Dictionary>')\n++++++++++++++++:+t('commonTypes.'+++it.type,+'');\n++++++++++++const+descText+=+it.desc+?+t(it.desc,+'')+:+'';\n++++++++++++li.appendChild(el('span',+{class:+'key',+text:+it.key}));\n++++++++++++li.appendChild(document.createTextNode('+-+'+++typeLabel));\n++++++++++++if+(descText)+li.appendChild(document.createTextNode('+-+'+++descText));\n++++++++++++ul.appendChild(li);\n++++++++}\n++++++++return+ul;\n++++}\n\n++++function+renderHeader()+{\n++++++++const+header+=+$('header');\n++++++++if+(header)+header.textContent+=+t('headerTitle',+'Simple+Telegram+Bot+-+Documentation');\n++++}\n\n++++function+renderHelloWorld()+{\n++++++++const+helloWorld+=+$('#helloWorld');\n++++++++if+(!helloWorld)+return;\n\n++++++++const+data+=+{\n++++++++++++en:+{\n++++++++++++++++title:+'Simple+Telegram+Bot+(STB)+Macro',\n++++++++++++++++author:+'Author:',\n++++++++++++++++site:+'Website:',\n++++++++++++++++github:+'GitHub:',\n++++++++++++++++featuresTitle:+'Flexible+and+extensible+Telegram+bot+for+MacroDroid:+from+device+control+to+any+custom+scenarios.',\n++++++++++++++++info:+[\n++++++++++++++++++++['Author:',+'BespredeL+(Alexander+Kireev)'],\n++++++++++++++++++++['Website:',+'https://BespredeL.name',+'https://bespredel.name'],\n++++++++++++++++++++['GitHub:',+'https://github.com/BespredeL',+'https://github.com/BespredeL']\n++++++++++++++++],\n++++++++++++++++features:+[\n++++++++++++++++++++'🔐+Authorized+control+via+Telegram+ID',\n++++++++++++++++++++'📍+Geolocation,+device+info,+and+sound+alert+tools',\n++++++++++++++++++++'🔁+Notification+and+SMS+forwarding',\n++++++++++++++++++++'📸+Intruder+detection+with+photo+capture',\n++++++++++++++++++++'📞+Call+handling+(reject/call+specific+number)',\n++++++++++++++++++++'🧠+AI+support+via+DeepSeek+(optional)',\n++++++++++++++++++++'🌐+URL+scanning+via+VirusTotal+(optional)',\n++++++++++++++++++++'🗂️+Save+media,+documents,+and+notes',\n++++++++++++++++++++'🌍+Multilingual+interface+support'\n++++++++++++++++]\n++++++++++++},\n++++++++++++ru:+{\n++++++++++++++++title:+'Макрос+Simple+Telegram+Bot+(STB)',\n++++++++++++++++author:+'Автор:',\n++++++++++++++++site:+'Сайт:',\n++++++++++++++++github:+'GitHub:',\n++++++++++++++++featuresTitle:+'Гибкий+и+расширяемый+Telegram-бот+для+MacroDroid:+от+управления+устройством+до+любых+пользовательских+сценариев.',\n++++++++++++++++info:+[\n++++++++++++++++++++['Автор:',+'BespredeL+(Александр+Киреев)'],\n++++++++++++++++++++['Сайт:',+'https://BespredeL.name',+'https://bespredel.name'],\n++++++++++++++++++++['GitHub:',+'https://github.com/BespredeL',+'https://github.com/BespredeL']\n++++++++++++++++],\n++++++++++++++++features:+[\n++++++++++++++++++++'🔐+Авторизация+по+Telegram+ID',\n++++++++++++++++++++'📍+Получение+геолокации,+информации+об+устройстве+и+подача+сигнала',\n++++++++++++++++++++'🔁+Пересылка+уведомлений+и+SMS',\n++++++++++++++++++++'📸+Фото+при+попытке+несанкционированного+доступа',\n++++++++++++++++++++'📞+Управление+звонками+(отклонение+/+вызов+на+указанный+номер)',\n++++++++++++++++++++'🧠+Поддержка+AI+через+DeepSeek+(по+желанию)',\n++++++++++++++++++++'🌐+Проверка+ссылок+через+VirusTotal+(по+желанию)',\n++++++++++++++++++++'🗂️+Сохранение+медиа,+документов+и+заметок',\n++++++++++++++++++++'🌍+Многоязычный+интерфейс'\n++++++++++++++++]\n++++++++++++}\n++++++++};\n\n++++++++const+lang+=+data[currentLang]+?+currentLang+:+'en';\n++++++++const+dict+=+data[lang];\n\n++++++++const+wrap+=+el('div',+{class:+'hello-world-block'});\n++++++++wrap.appendChild(el('h3',+{text:+dict.title}));\n\n++++++++const+ulInfo+=+el('ul');\n++++++++dict.info.forEach(([label,+text,+href])+=>+{\n++++++++++++const+li+=+el('li');\n++++++++++++li.appendChild(el('b',+{text:+label+++'+'}));\n++++++++++++if+(href)+{\n++++++++++++++++li.appendChild(el('a',+{href,+target:+'_blank',+rel:+'noopener',+text}));\n++++++++++++}+else+{\n++++++++++++++++li.appendChild(document.createTextNode(text));\n++++++++++++}\n++++++++++++ulInfo.appendChild(li);\n++++++++});\n++++++++wrap.appendChild(ulInfo);\n\n++++++++const+featuresDiv+=+el('div');\n++++++++featuresDiv.appendChild(el('b',+{text:+dict.featuresTitle}));\n\n++++++++const+ulFeatures+=+el('ul');\n++++++++dict.features.forEach(text+=>+ulFeatures.appendChild(el('li',+{text})));\n++++++++featuresDiv.appendChild(ulFeatures);\n++++++++wrap.appendChild(featuresDiv);\n\n++++++++helloWorld.innerHTML+=+'';\n++++++++helloWorld.appendChild(wrap);\n++++}\n\n++++function+renderLearn()+{\n++++++++const+root+=+$('#learn');\n++++++++if+(!root)+return;\n\n++++++++root.innerHTML+=+'';\n++++++++root.appendChild(el('h2',+{class:+'h',+'data-i18n':+'learnTitle',+text:+t('learnTitle',+'Guides')}));\n\n++++++++const+learnIds+=+langs.en?.learn+?+Object.keys(langs.en.learn)+:+[];\n++++++++for+(const+id+of+learnIds)+{\n++++++++++++const+emoji+=+t('learn.'+++id+++'.emoji',+'📘');\n++++++++++++const+title+=+t('learn.'+++id+++'.title',+id);\n++++++++++++const+steps+=+t('learn.'+++id+++'.steps',+[]);\n++++++++++++const+block+=+el('div',+{class:+'instruction-block',+id});\n++++++++++++block.appendChild(el('h3',+{html:+emoji+++'+'+++title}));\n++++++++++++const+ol+=+el('ol');\n++++++++++++for+(const+step+of+steps)+ol.appendChild(el('li',+{html:+step}));\n++++++++++++block.appendChild(ol);\n++++++++++++root.appendChild(block);\n++++++++}\n++++}\n\n++++function+renderBlocks()+{\n++++++++const+groupTitleNode+=+$('#actionBlocks+[data-i18n=\"groupsTitle\"]');\n++++++++if+(groupTitleNode)+groupTitleNode.textContent+=+t('groupsTitle',+'Action+Groups');\n\n++++++++$$('#actionBlocks+.block').forEach(node+=>+node.remove());\n\n++++++++for+(const+b+of+blocks)+{\n++++++++++++const+block+=+el('div',+{class:+'block',+id:+b.id,+'data-nav-label':+b.id});\n\n++++++++++++const+titleWrap+=+el('div',+{class:+'title'});\n++++++++++++titleWrap.appendChild(el('div',+{class:+'h',+text:+t('blocks.'+++b.id+++'.title',+b.id)}));\n++++++++++++titleWrap.appendChild(el('div',+{class:+'badge+badge-info',+text:+b.badge}));\n++++++++++++block.appendChild(titleWrap);\n\n++++++++++++const+desc+=+t('blocks.'+++b.id+++'.desc',+'');\n++++++++++++if+(desc)+block.appendChild(el('div',+{class:+'desc',+text:+desc}));\n\n++++++++++++block.appendChild(el('div',+{class:+'section-title',+text:+t('inputs',+'Input+variables')}));\n++++++++++++block.appendChild(createKvList(b.inputs));\n++++++++++++block.appendChild(el('div',+{class:+'section-title',+text:+t('outputs',+'Output+variables')}));\n++++++++++++block.appendChild(createKvList(b.outputs));\n\n++++++++++++$('#actionBlocks').appendChild(block);\n++++++++}\n++++}\n\n++++function+renderNav()+{\n++++++++const+nav+=+$('#mainNav');\n++++++++if+(!nav)+return;\n\n++++++++nav.innerHTML+=+'';\n++++++++const+anchors+=+[\n++++++++++++['#helloWorld',+'🤖'],\n++++++++++++['#howCommands',+t('nav.commands',+'Commands')],\n++++++++++++['#i18nIntro',+t('nav.translations',+'Translations')],\n++++++++++++...blocks.map(b+=>+['#'+++b.id,+b.id])\n++++++++];\n\n++++++++for+(const+[href,+label]+of+anchors)+{\n++++++++++++nav.appendChild(el('a',+{href,+text:+label}));\n++++++++}\n\n++++++++const+navLinks+=+$$('#mainNav+a');\n++++++++const+observables+=+anchors\n++++++++.map(([sel])+=>+document.querySelector(sel))\n++++++++.filter(Boolean);\n\n++++++++window.addEventListener('scroll',+()+=>+{\n++++++++++++let+best+=+null;\n++++++++++++let+bestTop+=+Infinity;\n++++++++++++for+(const+section+of+observables)+{\n++++++++++++++++const+r+=+section.getBoundingClientRect();\n++++++++++++++++if+(r.top+>=+0+&&+r.top+<+bestTop)+{\n++++++++++++++++++++bestTop+=+r.top;\n++++++++++++++++++++best+=+section;\n++++++++++++++++}\n++++++++++++}\n++++++++++++if+(!best+&&+observables.length)+{\n++++++++++++++++best+=+observables[observables.length+-+1];\n++++++++++++}\n\n++++++++++++navLinks.forEach(a+=>+a.classList.remove('active'));\n\n++++++++++++if+(best)+{\n++++++++++++++++const+active+=+nav.querySelector(`a[href=\"#${best.id}\"]`);\n++++++++++++++++if+(active)+{\n++++++++++++++++++++active.classList.add('active');\n\n++++++++++++++++++++try+{\n++++++++++++++++++++++++active.scrollIntoView({behavior:+'smooth',+inline:+'center',+block:+'nearest'});\n++++++++++++++++++++}+catch+{\n++++++++++++++++++++++++try+{\n++++++++++++++++++++++++++++active.parentNode.scrollLeft+=+active.offsetLeft+-+(active.parentNode.clientWidth+/+2);\n++++++++++++++++++++++++}+catch+{\n++++++++++++++++++++++++}\n++++++++++++++++++++}\n++++++++++++++++}\n++++++++++++}\n++++++++},+{passive:+true});\n\n++++++++const+hint+=+$('#menuHint');\n++++++++if+(hint)+hint.textContent+=+t('menuHint',+'Swipe+the+menu+→');\n\n++++++++try+{\n++++++++++++nav.addEventListener('wheel',+()+=>+hint?.classList.add('hidden'));\n++++++++++++nav.addEventListener('pointerdown',+()+=>+hint?.classList.add('hidden'));\n++++++++}+catch+{\n++++++++}\n++++}\n\n++++function+renderAll()+{\n++++++++renderHeader();\n++++++++renderHelloWorld();\n++++++++renderLearn();\n++++++++renderBlocks();\n++++++++renderNav();\n++++}\n\n++++/**+=====================+Init+&+Events+=====================+**/\n++++document.addEventListener('DOMContentLoaded',+()+=>+{\n++++++++renderAll();\n++++++++if+(location.hash)+{\n++++++++++++const+target+=+document.getElementById(location.hash.slice(1));\n++++++++++++if+(target)+{\n++++++++++++++++try+{\n++++++++++++++++++++target.scrollIntoView();\n++++++++++++++++}+catch+{\n++++++++++++++++++++window.scrollTo(0,+target.offsetTop+-+40);\n++++++++++++++++}\n++++++++++++}\n++++++++}\n++++});\n</script>\n</body>\n</html>",
