       "type": "SceneWebView",
       "sceneWebViewConfig": {
        "closeSceneOnPress": false,
        "enableJavaScript": true,
        "enableSwipeNavigation": true,
        "height": 100,
        "padding": "0",
        "url": "<!DOCTYPE+html>\n<html+lang=\"en\">\n<head>\n<meta+charset=\"UTF-8\">\n<meta+name=\"viewport\"+content=\"width=device-width,+initial-scale=1.0,+maximum-scale=1.0,+user-scalable=no\">\n<title>Teddy+Synth+|+unskyit.com</title>\n<style>\n:root+{\n++++--unskyit-bg:+#d7ccc8;\n++++--unskyit-glass:+rgba(255,+255,+255,+0.45);\n++++--unskyit-glass-border:+rgba(255,+255,+255,+0.6);\n++++--unskyit-text:+#4e342e;\n++++--unskyit-accent:+#8d6e63;\n++++--unskyit-accent-light:+#bcaaa4;\n++++--unskyit-highlight:+#ffccbc;\n++++--unskyit-shadow:+rgba(78,+52,+46,+0.15);\n}\n*+{\n++++box-sizing:+border-box;\n++++-webkit-tap-highlight-color:+transparent;\n++++user-select:+none;+\n}\nbody+{\n++++margin:+0;\n++++padding:+20px;\n++++font-family:+'Nunito',+'Segoe+UI',+sans-serif;\n++++background:+var(--unskyit-bg);\n++++background-image:+radial-gradient(circle+at+10%+20%,+rgba(255,255,255,0.4)+0%,+transparent+20%),+radial-gradient(circle+at+90%+80%,+rgba(141,110,99,0.1)+0%,+transparent+20%);\n++++color:+var(--unskyit-text);\n++++min-height:+100vh;\n++++display:+flex;\n++++flex-direction:+column;\n++++align-items:+center;\n}\n.unskyit_container+{\n++++width:+100%;\n++++max-width:+650px;\n++++padding-bottom:+80px;\n}\n.unskyit_header+{\n++++text-align:+center;\n++++margin-bottom:+25px;\n++++padding:+15px;\n++++background:+var(--unskyit-glass);\n++++backdrop-filter:+blur(12px);\n++++-webkit-backdrop-filter:+blur(12px);\n++++border-radius:+20px;\n++++border:+1px+solid+var(--unskyit-glass-border);\n++++box-shadow:+0+8px+32px+var(--unskyit-shadow);\n}\n.unskyit_logo+{\n++++font-size:+1.5rem;\n++++font-weight:+800;\n++++color:+var(--unskyit-text);\n++++letter-spacing:+1px;\n++++text-shadow:+1px+1px+2px+rgba(255,255,255,0.8);\n}\n.unskyit_sub+{\n++++font-size:+0.75rem;\n++++opacity:+0.8;\n++++margin-top:+5px;\n++++font-weight:+600;\n}\n.unskyit_glass_panel+{\n++++background:+var(--unskyit-glass);\n++++backdrop-filter:+blur(10px);\n++++-webkit-backdrop-filter:+blur(10px);\n++++border-radius:+24px;\n++++padding:+20px;\n++++margin-bottom:+20px;\n++++border:+1px+solid+var(--unskyit-glass-border);\n++++box-shadow:+0+4px+16px+var(--unskyit-shadow);\n++++transition:+transform+0.2s+ease;\n}\n.unskyit_nav+{\n++++display:+flex;\n++++gap:+10px;\n++++margin-bottom:+20px;\n++++background:+rgba(255,255,255,0.3);\n++++padding:+5px;\n++++border-radius:+50px;\n}\n.unskyit_tab+{\n++++flex:+1;\n++++padding:+12px;\n++++border:+none;\n++++background:+transparent;\n++++border-radius:+40px;\n++++color:+var(--unskyit-text);\n++++font-weight:+700;\n++++cursor:+pointer;\n++++transition:+all+0.3s+ease;\n}\n.unskyit_tab.active+{\n++++background:+var(--unskyit-text);\n++++color:+#fff;\n++++box-shadow:+0+4px+10px+rgba(78,52,46,0.3);\n}\n.unskyit_control_row+{\n++++display:+flex;\n++++justify-content:+space-between;\n++++align-items:+center;\n++++margin-bottom:+15px;\n}\n.unskyit_label+{\n++++font-size:+0.9rem;\n++++font-weight:+700;\n++++display:+flex;\n++++align-items:+center;\n++++gap:+8px;\n}\ninput[type=\"range\"]+{\n++++-webkit-appearance:+none;\n++++width:+100%;\n++++height:+8px;\n++++background:+rgba(255,255,255,0.5);\n++++border-radius:+10px;\n++++margin:+10px+0;\n}\ninput[type=\"range\"]::-webkit-slider-thumb+{\n++++-webkit-appearance:+none;\n++++width:+22px;\n++++height:+22px;\n++++background:+var(--unskyit-text);\n++++border-radius:+50%;\n++++border:+2px+solid+#fff;\n++++box-shadow:+0+2px+5px+rgba(0,0,0,0.2);\n++++cursor:+pointer;\n}\nselect,+input[type=\"text\"]+{\n++++background:+rgba(255,255,255,0.6);\n++++border:+1px+solid+#fff;\n++++padding:+8px+12px;\n++++border-radius:+12px;\n++++color:+var(--unskyit-text);\n++++font-weight:+600;\n++++outline:+none;\n++++font-family:+inherit;\n}\n.unskyit_btn+{\n++++background:+var(--unskyit-accent);\n++++color:+white;\n++++border:+none;\n++++padding:+12px+24px;\n++++border-radius:+16px;\n++++font-weight:+700;\n++++font-size:+0.95rem;\n++++cursor:+pointer;\n++++width:+100%;\n++++box-shadow:+0+4px+12px+rgba(141,110,99,0.3);\n++++transition:+transform+0.1s;\n}\n.unskyit_btn:active+{+transform:+scale(0.96);+}\n.unskyit_btn_secondary+{\n++++background:+rgba(255,255,255,0.6);\n++++color:+var(--unskyit-text);\n}\n.unskyit_canvas_wrap+{\n++++width:+100%;\n++++height:+100px;\n++++background:+rgba(0,0,0,0.05);\n++++border-radius:+16px;\n++++overflow:+hidden;\n++++margin-bottom:+15px;\n++++border:+1px+solid+rgba(255,255,255,0.2);\n}\n.unskyit_daw_grid+{\n++++display:+grid;\n++++gap:+10px;\n++++overflow-x:+auto;\n++++padding-bottom:+10px;\n}\n.unskyit_track+{\n++++display:+flex;\n++++align-items:+center;\n++++gap:+8px;\n++++background:+rgba(255,255,255,0.3);\n++++padding:+8px;\n++++border-radius:+12px;\n}\n.unskyit_track_header+{\n++++width:+80px;\n++++font-size:+0.75rem;\n++++font-weight:+800;\n++++white-space:+nowrap;\n++++overflow:+hidden;\n++++text-overflow:+ellipsis;\n}\n.unskyit_step_row+{\n++++display:+flex;\n++++gap:+4px;\n++++flex:+1;\n}\n.unskyit_step+{\n++++width:+24px;\n++++height:+32px;\n++++background:+rgba(255,255,255,0.5);\n++++border-radius:+6px;\n++++cursor:+pointer;\n++++border:+1px+solid+transparent;\n}\n.unskyit_step.active+{\n++++background:+var(--unskyit-text);\n++++border-color:+#fff;\n}\n.unskyit_step.current+{\n++++box-shadow:+0+0+0+2px+var(--unskyit-highlight);\n}\n.unskyit_hidden+{+display:+none;+}\n.unskyit_modal+{\n++++position:+fixed;\n++++top:+0;+left:+0;+right:+0;+bottom:+0;\n++++background:+rgba(0,0,0,0.4);\n++++backdrop-filter:+blur(5px);\n++++display:+flex;\n++++align-items:+center;\n++++justify-content:+center;\n++++z-index:+100;\n++++opacity:+0;\n++++pointer-events:+none;\n++++transition:+opacity+0.3s;\n}\n.unskyit_modal.show+{+opacity:+1;+pointer-events:+all;+}\n.unskyit_modal_content+{\n++++background:+#eae3dc;\n++++padding:+25px;\n++++border-radius:+24px;\n++++width:+80%;\n++++max-width:+300px;\n++++text-align:+center;\n++++box-shadow:+0+10px+40px+rgba(0,0,0,0.2);\n}\n#unskyit_viz+{+width:+100%;+height:+100%;+}\n.unskyit_transport+{\n++++display:+flex;\n++++gap:+10px;\n++++margin-bottom:+15px;\n}\n</style>\n</head>\n<body>\n\n<div+class=\"unskyit_container\">\n++++<header+class=\"unskyit_header\">\n++++++++<div+class=\"unskyit_logo\">🧸+TEDDY+SYNTH</div>\n++++++++<div+class=\"unskyit_sub\">Powered+by+unskyit.com</div>\n++++</header>\n\n++++<div+class=\"unskyit_nav\">\n++++++++<button+class=\"unskyit_tab+active\"+onclick=\"unskyit_switchTab('design')\">Sound+Lab</button>\n++++++++<button+class=\"unskyit_tab\"+onclick=\"unskyit_switchTab('studio')\">Teddy+Studio</button>\n++++</div>\n\n++++<div+id=\"unskyit_tab_design\">\n++++++++<div+class=\"unskyit_glass_panel\">\n++++++++++++<div+class=\"unskyit_canvas_wrap\">\n++++++++++++++++<canvas+id=\"unskyit_viz\"></canvas>\n++++++++++++</div>\n++++++++++++<div+style=\"display:grid;+grid-template-columns:+1fr+1fr;+gap:10px;\">\n++++++++++++++++<button+class=\"unskyit_btn\"+id=\"unskyit_playBtn\">TEST+TONE</button>\n++++++++++++++++<button+class=\"unskyit_btn+unskyit_btn_secondary\"+id=\"unskyit_saveBtn\">SAVE+ASSET</button>\n++++++++++++</div>\n++++++++</div>\n\n++++++++<div+class=\"unskyit_glass_panel\">\n++++++++++++<div+class=\"unskyit_control_row\">\n++++++++++++++++<span+class=\"unskyit_label\">Wave+Shape</span>\n++++++++++++++++<select+id=\"unskyit_wave\">\n++++++++++++++++++++<option+value=\"sine\">Sine+(Smooth)</option>\n++++++++++++++++++++<option+value=\"square\">Square+(8-Bit)</option>\n++++++++++++++++++++<option+value=\"triangle\">Triangle+(Soft)</option>\n++++++++++++++++++++<option+value=\"sawtooth\">Sawtooth+(Sharp)</option>\n++++++++++++++++</select>\n++++++++++++</div>\n++++++++++++\n++++++++++++<div+class=\"unskyit_control_row\">\n++++++++++++++++<span+class=\"unskyit_label\">Frequency+<span+id=\"unskyit_freqVal\"+style=\"background:rgba(255,255,255,0.5);+padding:2px+6px;+border-radius:8px;+font-size:0.8em;\">440Hz</span></span>\n++++++++++++</div>\n++++++++++++<input+type=\"range\"+id=\"unskyit_freq\"+min=\"20\"+max=\"2000\"+step=\"1\"+value=\"440\">\n++++++++++++\n++++++++++++<div+class=\"unskyit_control_row\"+style=\"margin-top:15px;\">\n++++++++++++++++<span+class=\"unskyit_label\">Envelope+(Snap+vs+Drone)</span>\n++++++++++++</div>\n++++++++++++<div+style=\"display:flex;+gap:10px;+align-items:center;+font-size:0.8rem;\">\n++++++++++++++++<span>Short</span>\n++++++++++++++++<input+type=\"range\"+id=\"unskyit_release\"+min=\"0.05\"+max=\"2\"+step=\"0.05\"+value=\"0.5\">\n++++++++++++++++<span>Long</span>\n++++++++++++</div>\n++++++++</div>\n\n++++++++<div+class=\"unskyit_glass_panel\">\n++++++++++++<div+class=\"unskyit_control_row\">\n++++++++++++++++<span+class=\"unskyit_label\">Wobble+(LFO)</span>\n++++++++++++++++<input+type=\"checkbox\"+id=\"unskyit_lfoOn\">\n++++++++++++</div>\n++++++++++++<div+id=\"unskyit_lfoControls\"+style=\"opacity:0.5;+pointer-events:none;+transition:opacity+0.3s;\">\n++++++++++++++++<input+type=\"range\"+id=\"unskyit_lfoRate\"+min=\"0.1\"+max=\"20\"+step=\"0.1\"+value=\"5\">\n++++++++++++++++<div+style=\"text-align:center;+font-size:0.75rem;+margin-top:-5px;\">Speed</div>\n++++++++++++++++<input+type=\"range\"+id=\"unskyit_lfoDepth\"+min=\"0\"+max=\"1000\"+step=\"10\"+value=\"100\">\n++++++++++++++++<div+style=\"text-align:center;+font-size:0.75rem;+margin-top:-5px;\">Depth</div>\n++++++++++++</div>\n++++++++</div>\n++++</div>\n\n++++<div+id=\"unskyit_tab_studio\"+class=\"unskyit_hidden\">\n++++++++<div+class=\"unskyit_glass_panel\">\n++++++++++++<div+class=\"unskyit_transport\">\n++++++++++++++++<button+class=\"unskyit_btn\"+id=\"unskyit_dawPlay\">▶+PLAY+LOOP</button>\n++++++++++++++++<button+class=\"unskyit_btn+unskyit_btn_secondary\"+id=\"unskyit_dawStop\">■+STOP</button>\n++++++++++++</div>\n++++++++++++<div+class=\"unskyit_control_row\">\n++++++++++++++++<span+class=\"unskyit_label\">Tempo:+<span+id=\"unskyit_bpmVal\">120</span>+BPM</span>\n++++++++++++</div>\n++++++++++++<input+type=\"range\"+id=\"unskyit_bpm\"+min=\"60\"+max=\"240\"+value=\"120\">\n++++++++</div>\n\n++++++++<div+class=\"unskyit_glass_panel\">\n++++++++++++<h3+style=\"margin:0+0+15px+0;+font-size:1rem;+opacity:0.7;\">Arrangement+Grid</h3>\n++++++++++++<div+id=\"unskyit_tracks\"+class=\"unskyit_daw_grid\">\n++++++++++++++++<div+style=\"text-align:center;+padding:20px;+opacity:0.6;\">No+assets+yet.<br>Go+to+Sound+Lab+>+Save+Asset.</div>\n++++++++++++</div>\n++++++++++++<button+class=\"unskyit_btn+unskyit_btn_secondary\"+style=\"margin-top:10px;+font-size:0.8rem;+padding:8px;\"+onclick=\"unskyit_clearPattern()\">Clear+Pattern</button>\n++++++++</div>\n++++</div>\n</div>\n\n<div+id=\"unskyit_modal\"+class=\"unskyit_modal\">\n++++<div+class=\"unskyit_modal_content\">\n++++++++<h3+style=\"margin-top:0;\">Name+Asset</h3>\n++++++++<input+type=\"text\"+id=\"unskyit_assetName\"+placeholder=\"e.g.+Soft+Kick\"+style=\"width:100%;+margin-bottom:15px;+text-align:center;\">\n++++++++<div+style=\"display:flex;+gap:10px;\">\n++++++++++++<button+class=\"unskyit_btn+unskyit_btn_secondary\"+onclick=\"unskyit_closeModal()\">Cancel</button>\n++++++++++++<button+class=\"unskyit_btn\"+onclick=\"unskyit_confirmSave()\">Save</button>\n++++++++</div>\n++++</div>\n</div>\n\n<script>\nconst+unskyit_state+=+{\n++++ctx:+null,\n++++osc:+null,\n++++gain:+null,\n++++analyser:+null,\n++++lfo:+null,\n++++isPlaying:+false,\n++++assets:+[],+\n++++sequence:+[],+\n++++isPlayingSeq:+false,\n++++currentStep:+0,\n++++nextNoteTime:+0,\n++++timerID:+null,\n++++tempo:+120,\n++++steps:+16\n};\n\nconst+unskyit_dom+=+{\n++++freq:+document.getElementById('unskyit_freq'),\n++++wave:+document.getElementById('unskyit_wave'),\n++++rel:+document.getElementById('unskyit_release'),\n++++lfoOn:+document.getElementById('unskyit_lfoOn'),\n++++lfoRate:+document.getElementById('unskyit_lfoRate'),\n++++lfoDepth:+document.getElementById('unskyit_lfoDepth'),\n++++freqVal:+document.getElementById('unskyit_freqVal'),\n++++viz:+document.getElementById('unskyit_viz'),\n++++tracks:+document.getElementById('unskyit_tracks')\n};\n\nfunction+unskyit_initAudio()+{\n++++if+(unskyit_state.ctx)+return;\n++++unskyit_state.ctx+=+new+(window.AudioContext+||+window.webkitAudioContext)();\n++++unskyit_state.analyser+=+unskyit_state.ctx.createAnalyser();\n++++unskyit_state.analyser.fftSize+=+2048;\n}\n\nfunction+unskyit_playPreview()+{\n++++unskyit_initAudio();\n++++if(unskyit_state.ctx.state+===+'suspended')+unskyit_state.ctx.resume();\n\n++++const+t+=+unskyit_state.ctx.currentTime;\n++++const+osc+=+unskyit_state.ctx.createOscillator();\n++++const+gain+=+unskyit_state.ctx.createGain();\n++++\n++++osc.type+=+unskyit_dom.wave.value;\n++++osc.frequency.value+=+parseFloat(unskyit_dom.freq.value);\n\n++++const+rel+=+parseFloat(unskyit_dom.rel.value);\n++++\n++++gain.gain.setValueAtTime(0,+t);\n++++gain.gain.linearRampToValueAtTime(0.5,+t+++0.05);\n++++gain.gain.exponentialRampToValueAtTime(0.001,+t+++0.05+++rel);\n\n++++if+(unskyit_dom.lfoOn.checked)+{\n++++++++const+lfo+=+unskyit_state.ctx.createOscillator();\n++++++++const+lfoG+=+unskyit_state.ctx.createGain();\n++++++++lfo.frequency.value+=+parseFloat(unskyit_dom.lfoRate.value);\n++++++++lfoG.gain.value+=+parseFloat(unskyit_dom.lfoDepth.value);\n++++++++lfo.connect(lfoG);\n++++++++lfoG.connect(osc.frequency);\n++++++++lfo.start(t);\n++++++++lfo.stop(t+++0.05+++rel);\n++++}\n\n++++osc.connect(gain);\n++++gain.connect(unskyit_state.analyser);\n++++unskyit_state.analyser.connect(unskyit_state.ctx.destination);\n\n++++osc.start(t);\n++++osc.stop(t+++0.05+++rel);\n++++\n++++unskyit_vizLoop();\n}\n\nfunction+unskyit_vizLoop()+{\n++++const+cvs+=+unskyit_dom.viz;\n++++const+ctx+=+cvs.getContext('2d');\n++++const+w+=+cvs.width+=+cvs.offsetWidth;\n++++const+h+=+cvs.height+=+cvs.offsetHeight;\n++++const+buffer+=+unskyit_state.analyser.frequencyBinCount;\n++++const+data+=+new+Uint8Array(buffer);\n\n++++function+draw()+{\n++++++++if(!unskyit_state.ctx)+return;\n++++++++unskyit_state.analyser.getByteTimeDomainData(data);\n++++++++ctx.clearRect(0,0,w,h);\n++++++++ctx.lineWidth+=+2;\n++++++++ctx.strokeStyle+=+'#8d6e63';\n++++++++ctx.beginPath();\n++++++++const+slice+=+w+*+1.0+/+buffer;\n++++++++let+x+=+0;\n++++++++for(let+i=0;+i<buffer;+i++)+{\n++++++++++++const+v+=+data[i]+/+128.0;\n++++++++++++const+y+=+v+*+h/2;\n++++++++++++if(i===0)+ctx.moveTo(x,y);+else+ctx.lineTo(x,y);\n++++++++++++x+=slice;\n++++++++}\n++++++++ctx.stroke();\n++++++++requestAnimationFrame(draw);\n++++}\n++++draw();\n}\n\nfunction+unskyit_saveAsset()+{\n++++document.getElementById('unskyit_modal').classList.add('show');\n}\n\nfunction+unskyit_closeModal()+{\n++++document.getElementById('unskyit_modal').classList.remove('show');\n}\n\nfunction+unskyit_confirmSave()+{\n++++const+name+=+document.getElementById('unskyit_assetName').value+||+'Untitled';\n++++const+asset+=+{\n++++++++name:+name,\n++++++++freq:+parseFloat(unskyit_dom.freq.value),\n++++++++wave:+unskyit_dom.wave.value,\n++++++++rel:+parseFloat(unskyit_dom.rel.value),\n++++++++lfo:+unskyit_dom.lfoOn.checked,\n++++++++lRate:+parseFloat(unskyit_dom.lfoRate.value),\n++++++++lDepth:+parseFloat(unskyit_dom.lfoDepth.value)\n++++};\n++++unskyit_state.assets.push(asset);\n++++unskyit_state.sequence.push(new+Array(16).fill(false));\n++++unskyit_renderTracks();\n++++unskyit_closeModal();\n++++unskyit_switchTab('studio');\n}\n\nfunction+unskyit_renderTracks()+{\n++++const+container+=+unskyit_dom.tracks;\n++++container.innerHTML+=+'';\n++++\n++++if(unskyit_state.assets.length+===+0)+{\n++++++++container.innerHTML+=+'<div+style=\"text-align:center;+padding:20px;+opacity:0.6;\">No+assets+yet.<br>Go+to+Sound+Lab+>+Save+Asset.</div>';\n++++++++return;\n++++}\n\n++++unskyit_state.assets.forEach((asset,+tIdx)+=>+{\n++++++++const+row+=+document.createElement('div');\n++++++++row.className+=+'unskyit_track';\n++++++++\n++++++++const+hd+=+document.createElement('div');\n++++++++hd.className+=+'unskyit_track_header';\n++++++++hd.textContent+=+asset.name;\n++++++++\n++++++++const+steps+=+document.createElement('div');\n++++++++steps.className+=+'unskyit_step_row';\n++++++++\n++++++++for(let+s=0;+s<16;+s++)+{\n++++++++++++const+btn+=+document.createElement('div');\n++++++++++++btn.className+=+`unskyit_step+${unskyit_state.sequence[tIdx][s]+?+'active'+:+''}`;\n++++++++++++btn.dataset.t+=+tIdx;\n++++++++++++btn.dataset.s+=+s;\n++++++++++++btn.onclick+=+()+=>+{\n++++++++++++++++unskyit_state.sequence[tIdx][s]+=+!unskyit_state.sequence[tIdx][s];\n++++++++++++++++unskyit_renderTracks();\n++++++++++++};\n++++++++++++steps.appendChild(btn);\n++++++++}\n++++++++\n++++++++row.appendChild(hd);\n++++++++row.appendChild(steps);\n++++++++container.appendChild(row);\n++++});\n}\n\nfunction+unskyit_clearPattern()+{\n++++unskyit_state.sequence.forEach(row+=>+row.fill(false));\n++++unskyit_renderTracks();\n}\n\nfunction+unskyit_switchTab(tab)+{\n++++document.querySelectorAll('.unskyit_tab').forEach(b+=>+b.classList.remove('active'));\n++++document.querySelectorAll('[id^=\"unskyit_tab_\"]').forEach(d+=>+d.classList.add('unskyit_hidden'));\n++++\n++++if+(tab+===+'design')+{\n++++++++document.querySelector('.unskyit_tab:first-child').classList.add('active');\n++++++++document.getElementById('unskyit_tab_design').classList.remove('unskyit_hidden');\n++++}+else+{\n++++++++document.querySelector('.unskyit_tab:last-child').classList.add('active');\n++++++++document.getElementById('unskyit_tab_studio').classList.remove('unskyit_hidden');\n++++}\n}\n\n//+Sequencer+Logic\nfunction+unskyit_scheduler()+{\n++++const+lookahead+=+25.0;\n++++const+scheduleAheadTime+=+0.1;\n\n++++while+(unskyit_state.nextNoteTime+<+unskyit_state.ctx.currentTime+++scheduleAheadTime)+{\n++++++++unskyit_scheduleNote(unskyit_state.currentStep,+unskyit_state.nextNoteTime);\n++++++++unskyit_nextNote();\n++++}\n++++unskyit_state.timerID+=+setTimeout(unskyit_scheduler,+lookahead);\n}\n\nfunction+unskyit_nextNote()+{\n++++const+secondsPerBeat+=+60.0+/+unskyit_state.tempo;\n++++unskyit_state.nextNoteTime++=+0.25+*+secondsPerBeat;\n++++unskyit_state.currentStep+=+(unskyit_state.currentStep+++1)+%+16;\n}\n\nfunction+unskyit_scheduleNote(step,+time)+{\n++++//+UI+Update\n++++requestAnimationFrame(()+=>+{\n++++++++document.querySelectorAll('.unskyit_step').forEach(el+=>+el.classList.remove('current'));\n++++++++document.querySelectorAll(`.unskyit_step[data-s=\"${step}\"]`).forEach(el+=>+el.classList.add('current'));\n++++});\n\n++++unskyit_state.assets.forEach((asset,+idx)+=>+{\n++++++++if+(unskyit_state.sequence[idx][step])+{\n++++++++++++unskyit_playNote(asset,+time);\n++++++++}\n++++});\n}\n\nfunction+unskyit_playNote(asset,+time)+{\n++++const+osc+=+unskyit_state.ctx.createOscillator();\n++++const+gain+=+unskyit_state.ctx.createGain();\n++++\n++++osc.type+=+asset.wave;\n++++osc.frequency.value+=+asset.freq;\n++++\n++++gain.gain.setValueAtTime(0,+time);\n++++gain.gain.linearRampToValueAtTime(0.5,+time+++0.05);\n++++gain.gain.exponentialRampToValueAtTime(0.001,+time+++0.05+++asset.rel);\n\n++++if+(asset.lfo)+{\n++++++++const+lfo+=+unskyit_state.ctx.createOscillator();\n++++++++const+lfoG+=+unskyit_state.ctx.createGain();\n++++++++lfo.frequency.value+=+asset.lRate;\n++++++++lfoG.gain.value+=+asset.lDepth;\n++++++++lfo.connect(lfoG);\n++++++++lfoG.connect(osc.frequency);\n++++++++lfo.start(time);\n++++++++lfo.stop(time+++0.05+++asset.rel);\n++++}\n\n++++osc.connect(gain);\n++++gain.connect(unskyit_state.ctx.destination);\n++++\n++++osc.start(time);\n++++osc.stop(time+++0.05+++asset.rel);\n}\n\ndocument.getElementById('unskyit_freq').oninput+=+function()+{\n++++document.getElementById('unskyit_freqVal').textContent+=+this.value+++'Hz';\n};\n\ndocument.getElementById('unskyit_lfoOn').onchange+=+function()+{\n++++const+div+=+document.getElementById('unskyit_lfoControls');\n++++div.style.opacity+=+this.checked+?+'1'+:+'0.5';\n++++div.style.pointerEvents+=+this.checked+?+'all'+:+'none';\n};\n\ndocument.getElementById('unskyit_playBtn').onclick+=+unskyit_playPreview;\ndocument.getElementById('unskyit_saveBtn').onclick+=+unskyit_saveAsset;\n\ndocument.getElementById('unskyit_dawPlay').onclick+=+function()+{\n++++unskyit_initAudio();\n++++if(unskyit_state.ctx.state+===+'suspended')+unskyit_state.ctx.resume();\n++++\n++++if+(unskyit_state.isPlayingSeq)+return;\n++++unskyit_state.isPlayingSeq+=+true;\n++++unskyit_state.currentStep+=+0;\n++++unskyit_state.nextNoteTime+=+unskyit_state.ctx.currentTime;\n++++unskyit_scheduler();\n};\n\ndocument.getElementById('unskyit_dawStop').onclick+=+function()+{\n++++unskyit_state.isPlayingSeq+=+false;\n++++clearTimeout(unskyit_state.timerID);\n++++document.querySelectorAll('.unskyit_step').forEach(el+=>+el.classList.remove('current'));\n};\n\ndocument.getElementById('unskyit_bpm').oninput+=+function()+{\n++++unskyit_state.tempo+=+parseInt(this.value);\n++++document.getElementById('unskyit_bpmVal').textContent+=+this.value;\n};\n\n//+Check+Integrity\n(function(){\n++++if(!document.title.includes('unskyit'))+console.log('Branding+Missing');\n})();\n\n</script>\n</body>\n</html>",
