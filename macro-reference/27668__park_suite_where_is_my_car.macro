   ],
   "m_category": "Standort",
   "m_completed": true,
   "m_constraintList": [],
   "m_description": "This+action+block+allows+you+to+get+adress+information+of+a+location+from+given+coordinates+by+reverse+geocoding.+\nIt+returns+only+the+address+and+will+get+rid+of+all+additional+information.+\nIf+you+define+your+home+country,+the+country+part+will+be+suppressed+when+addresses+are+returned+for+coordinates+around+your+own+country.+\nIf+the+variable+\"AdditionalInfo\"+is+set+to+\"true\"+then+the+returned+address+will+be+expanded+with+local+or+tourist+information+if+available.+\nAnd+finally+you+can/should+set+the+language+to+your+requirements+(i.e.+de+or+en)+\n\nOSM+nominatim+API+is+used+to+get+address+information.+NO+API-KEY+NEEDED.+Read+more+there:+https://nominatim.org/release-docs/develop/api/Reverse/\n\nIt+is+based+on+an+action+block+by+@FrameXX\nThis+macro+was+written+by+@TexMex",
   "m_descriptionOpen": false,
   "m_enabled": false,
   "m_excludeLog": false,
   "m_headingColor": -855310,
   "m_isOrCondition": false,
   "m_name": "ReverseGeocoding",
   "m_triggerList": []
  }
 ],
