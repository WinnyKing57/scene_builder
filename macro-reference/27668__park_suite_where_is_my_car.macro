   ],
   "m_category": "Nützliches",
   "m_completed": true,
   "m_constraintList": [],
   "m_description": "This+actionblock+abbreviates+the+month+followed+by+a+dot+-+if+wanted.++Differrent+languages+possible.+\n\nWriting+a+date+in+a+shortened+format+can+be+tricky+if+the+month+needs+to+be+abbreviated,+as+MacroDroid+lacks+a+built-in+function+for+this.\nThis+actionblock+abbreviates+the+month+as+much+as+possible—typically+to+three+letters.+A+period+can+optionally+be+added+at+the+end;+The+actionblock+accounts+for+the+specific+language+to+determine+whether+a+period+should+be+omitted+because+the+month+name+might+be+already+short.+\nEnglish+(en)+,+German+(de)+,+French+(fr)+and+Spanish+(es)+are+supported+out+of+the+box,+and+adding+further+languages+​​is+easily+done+by+updating+the+`month_array`+variable.+For+an+added+new+language+place+the+month+numbers+that+do+not+require+a+dot+in+the+short+version+in+the+array+0+like+the+other+existing+languages+(month+numbers+divided+by+pipe+symbol+\"|\"+or+any+other+symbol)+\n\nThis+macro+was+written+by+@TexMex",
   "m_descriptionOpen": false,
   "m_enabled": false,
   "m_excludeLog": false,
   "m_headingColor": 0,
   "m_isOrCondition": false,
   "m_name": "MonthShort",
   "m_triggerList": []
  },
