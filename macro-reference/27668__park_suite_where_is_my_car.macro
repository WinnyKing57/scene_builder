    {
     "blockNextAction": true,
     "m_nonRoot": true,
     "m_script": "sed+-e+'s/$/‰】/'+-i++\"{lv=filePath}{lv=copyName}\"",
     "timeoutSeconds": 30,
     "useHelper": true,
     "useShizuku": false,
     "disableLogging": false,
     "m_SIGUID": -8394157569603925618,
     "m_classType": "ShellScriptAction",
     "m_comment": "Preserve+empty+lines:+change+empty+lines+to+‰】",
