'active')\n++++++++++++++++})\n++++++++++++});\n\n++++++++++++var+mgCvs+=+document.getElementById('mgCvs'),+mgX+=+mgCvs.getContext('2d');\n++++++++++++var+mgActive+=+false,+mgScore+=+0,+mgTimer+=+0,+mgInt+=+null,+curMG+=+null;\n++++++++++++var+MINIGAMES+=+[\n++++++++++++++++{+id:+'butterfly',+n:+'🦋+Pegue+a+Borboleta',+d:+'Clique+na+borboleta+antes+que+fuja!'+},\n++++++++++++++++{+id:+'memory',+n:+'🃏+Jogo+da+Memória',+d:+'Encontre+os+pares+de+emojis!'+},\n++++++++++++++++{+id:+'reaction',+n:+'⚡+Reflexo+Rápido',+d:+'Toque+quando+ficar+verde!'+}\n++++++++++++];\n++++++++++++var+bfPos+=+{+x:+100,+y:+100+};\n++++++++++++var+memCards+=+[],+memFlipped+=+[],+memSolved+=+[],+memMatched+=+0,+memLock+=+false;\n++++++++++++var+rxState+=+0,+rxStart+=+0,+rxCount+=+0,+rxTo+=+null;\n\n++++++++++++function+openMGSelect()+{\n++++++++++++++++iA();+closeAll();+var+p+=+document.getElementById('mgSelect');+p.style.display+=+'block';\n++++++++++++++++var+l+=+document.getElementById('mgList');+l.innerHTML+=+'';\n++++++++++++++++MINIGAMES.forEach(function+(mg)+{\n++++++++++++++++++++var+d+=+document.createElement('div');+d.className+=+'mg-card';+d.innerHTML+=+'<b>'+++mg.n+++'</b><br><small>'+++mg.d+++'</small>';\n++++++++++++++++++++d.addEventListener('click',+function+()+{+p.style.display+=+'none';+openMG(mg.id)+});+l.appendChild(d)\n++++++++++++++++})\n++++++++++++}\n\n++++++++++++function+openMG(id)+{\n++++++++++++++++curMG+=+id;+document.getElementById('mgPlay').style.display+=+'block';+document.getElementById('mgStart').style.display+=+'inline-block';+mgScore+=+0;+mgActive+=+false;\n++++++++++++++++if+(id+===+'butterfly')+{+mgTimer+=+15;+document.getElementById('mgTitle').innerText+=+'🦋+Pegue+a+Borboleta!';+document.getElementById('mgInfo').innerText+=+'Acertos:+0+|+⏱️+15s';+bfPos+=+{+x:+100,+y:+100+};+drawBF()+}\n++++++++++++++++else+if+(id+===+'memory')+{+mgTimer+=+30;+document.getElementById('mgTitle').innerText+=+'🃏+Memória';+document.getElementById('mgInfo').innerText+=+'Pares:+0+|+⏱️+30s';+initMem()+}\n++++++++++++++++else+if+(id+===+'reaction')+{+document.getElementById('mgTitle').innerText+=+'⚡+Reflexo';+document.getElementById('mgInfo').innerText+=+'Espere+o+verde...';+initRx()+}\n++++++++++++}\n\n++++++++++++document.getElementById('mgStart').addEventListener('click',+function+()+{+if+(mgActive)+return;+startMG()+});\n++++++++++++function+startMG()+{\n++++++++++++++++if+(S.hunger+<+20)+{+msg(\"Estou+com+muita+fome!+😩\");+return;+}\n++++++++++++++++if+(S.energy+<+20)+{+msg(\"Sem+energia+para+jogar!+🥱\");+return;+}\n++++++++++++++++S.energy+-=+10;+S.hunger+-=+10;+uUI();+//+Minigames+drain+energy+instantly\n++++++++++++++++mgActive+=+true;+mgScore+=+0;+document.getElementById('mgStart').style.display+=+'none';\n++++++++++++++++if+(curMG+===+'butterfly')+{+mgTimer+=+15;+if+(mgInt)+clearInterval(mgInt);+mgInt+=+setInterval(function+()+{+mgTimer--;+document.getElementById('mgInfo').innerText+=+'Acertos:+'+++mgScore+++'+|+⏱️+'+++mgTimer+++'s';+if+(mgTimer+<=+0)+{+clearInterval(mgInt);+mgActive+=+false;+endMG()+}+else+{+bfPos.x+=+20+++Math.random()+*+160;+bfPos.y+=+20+++Math.random()+*+160;+drawBF()+}+},+800);+drawBF()+}\n++++++++++++++++else+if+(curMG+===+'memory')+{+mgTimer+=+30;+startMem()+}\n++++++++++++++++else+if+(curMG+===+'reaction')+{+startRx()+}\n++++++++++++}\n++++++++++++function+endMG()+{\n++++++++++++++++S.coins++=+mgScore;+addXP(mgScore+*+2);+uUI();\n++++++++++++++++mgX.fillStyle+=+'rgba(0,0,0,0.8)';+mgX.fillRect(0,+0,+200,+200);\n++++++++++++++++mgX.fillStyle+=+'#fff';+mgX.font+=+'bold+22px+Arial';+mgX.textAlign+=+'center';+mgX.textBaseline+=+'middle';\n++++++++++++++++mgX.fillText('FIM+DE+JOGO',+100,+70);\n++++++++++++++++mgX.fillStyle+=+'#f1c40f';+mgX.font+=+'bold+18px+Arial';\n++++++++++++++++mgX.fillText('+'+++mgScore+++'+Moedas',+100,+110);\n++++++++++++++++mgX.fillStyle+=+'#aaa';+mgX.font+=+'12px+Arial';\n++++++++++++++++mgX.fillText('(Clique+para+fechar)',+100,+150);\n++++++++++++++++sfx(400,+.1,+'square',+.5);\n+++++++++