        "height": 92,
        "padding": "0",
        "url": "<!DOCTYPE+html>\n<html+lang=\"pt-BR\">\n\n<head>\n++++<meta+charset=\"UTF-8\">\n++++<title>Cat+Virtual+Pet</title>\n++++<meta+name=\"viewport\"+content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\">\n++++<meta+http-equiv=\"X-UA-Compatible\"+content=\"IE=edge\">\n++++<style>\n++++++++*+{\n++++++++++++box-sizing:+border-box;\n++++++++++++-webkit-tap-highlight-color:+transparent\n++++++++}\n\n++++++++body+{\n++++++++++++margin:+0;\n++++++++++++background:+#f0f0f0;\n++++++++++++overflow:+hidden;\n++++++++++++touch-action:+none;\n++++++++++++font-family:+'Segoe+UI',+Arial,+sans-serif;\n++++++++++++-webkit-user-select:+none;\n++++++++++++user-select:+none\n++++++++}\n\n++++++++canvas+{\n++++++++++++display:+block;\n++++++++++++position:+relative;\n++++++++++++z-index:+1\n++++++++}\n\n++++++++#ui+{\n++++++++++++position:+absolute;\n++++++++++++top:+0;\n++++++++++++left:+0;\n++++++++++++width:+100%;\n++++++++++++height:+100%;\n++++++++++++display:+flex;\n++++++++++++flex-direction:+column;\n++++++++++++justify-content:+space-between;\n++++++++++++pointer-events:+none;\n++++++++++++z-index:+2\n++++++++}\n\n++++++++.glass+{\n++++++++++++background:+rgba(255,+255,+255,+.75);\n++++++++++++border:+1px+solid+rgba(255,+255,+255,+.8);\n++++++++++++pointer-events:+auto;\n++++++++++++box-shadow:+0+2px+6px+rgba(0,+0,+0,+.08)\n++++++++}\n\n++++++++#header+{\n++++++++++++width:+100%;\n++++++++++++display:+flex;\n++++++++++++justify-content:+space-between;\n++++++++++++align-items:+center;\n++++++++++++padding:+8px+12px\n++++++++}\n\n++++++++#mute+{\n++++++++++++padding:+6px+12px;\n++++++++++++font-size:+10px;\n++++++++++++font-weight:+bold;\n++++++++++++color:+#5d4037;\n++++++++++++cursor:+pointer;\n++++++++++++border-radius:+12px\n++++++++}\n\n++++++++#brand+{\n++++++++++++color:+#5d4037;\n++++++++++++font-size:+10px;\n++++++++++++font-weight:+900;\n++++++++++++padding:+6px;\n++++++++++++opacity:+.5\n++++++++}\n\n++++++++#stats+{\n++++++++++++display:+grid;\n++++++++++++grid-template-columns:+1fr+1fr;\n++++++++++++gap:+6px;\n++++++++++++margin:+0+12px;\n++++++++++++padding:+10px;\n++++++++++++border-radius:+14px;\n++++++++++++color:+#5d4037;\n++++++++++++font-weight:+bold;\n++++++++++++font-size:+12px\n++++++++}\n\n++++++++.sb+{\n++++++++++++background:+rgba(0,+0,+0,+.1);\n++++++++++++border-radius:+8px;\n++++++++++++height:+7px;\n++++++++++++margin-top:+3px;\n++++++++++++overflow:+hidden\n++++++++}\n\n++++++++.sf+{\n++++++++++++height:+100%;\n++++++++++++background:+#4CAF50;\n++++++++++++transition:+width+.3s;\n++++++++++++border-radius:+8px\n++++++++}\n\n++++++++.sf.low+{\n++++++++++++background:+#f44336\n++++++++}\n\n++++++++.sf.xp+{\n++++++++++++background:+#9C27B0\n++++++++}\n\n++++++++#rooms+{\n++++++++++++display:+flex;\n++++++++++++justify-content:+center;\n++++++++++++gap:+5px;\n++++++++++++padding:+6px;\n++++++++++++margin:+2px+8px\n++++++++}\n\n++++++++.rb+{\n++++++++++++padding:+6px+9px;\n++++++++++++border-radius:+20px;\n++++++++++++background:+rgba(205,+133,+63,+.5);\n++++++++++++border:+none;\n++++++++++++font-size:+11px;\n++++++++++++font-weight:+bold;\n++++++++++++color:+#3e2c1b;\n++++++++++++cursor:+pointer\n++++++++}\n\n++++++++.rb.active+{\n++++++++++++background:+rgba(205,+133,+63,+.9);\n++++++++++++box-shadow:+0+2px+8px+rgba(0,+0,+0,+.2)\n++++++++}\n\n++++++++#actions+{\n++++++++++++display:+flex;\n++++++++++++justify-content:+space-evenly;\n++++++++++++padding:+6px;\n++++++++++++width:+100%;\n++++++++++++flex-wrap:+wrap;\n++++++++++++gap:+5px\n++++++++}\n\n++++++++.ab+{\n++++++++++++padding:+8px;\n++++++++++++border-radius:+14px;\n++++++++++++font-size:+16px;\n++++++++++++border:+none;\n++++++++++++cursor:+pointer;\n++++++++++++font-weight:+bold;\n++++++++++++color:+#5d4037;\n++++++++++++display:+flex;\n++++++++++++flex-direction:+column;\n++++++++++++align-items:+center;\n++++++++++++gap:+2px;\n++++++++++++min-width:+60px\n++++++++}\n\n++++++++.ab+span+{\n++++++++++++font-size:+9px;\n++++++++++++text-transform:+uppercase\n++++++++}\n\n++++++++.ab[disabled]+{\n++++++++++++opacity:+.3;\n++++++++++++pointer-events:+none\n++++++++}\n\n++++++++#extras+{\n++++++++++++display:+flex;\n++++++++++++justify-content:+center;\n++++++++++++gap:+10px;\n++++++++++++padding:+0+12px+10px;\n++++++++++++width:+100%\n++++++++}\n\n++++++++.eb+{\n++++++++++++padding:+7px+14px;\n++++++++++++border-radius:+20px;\n++++++++++++font-size:+12px;\n++++++++++++font-weight:+bold;\n++++++++++++background:+rgba(255,+215,+0,+.35);\n++++++++++++border:+1px+solid+#daa520;\n++++++++++++color:+#5d4037;\n++++++++++++cursor:+pointer\n++++++++}\n\n++++++++.eb[disabled]+{\n++++++++++++opacity:+.3;\n++++++++++++pointer-events:+none\n++++++++}\n\n++++++++#msg+{\n++++++++++++position:+absolute;\n++++++++++++top:+38%;\n++++++++++++width:+100%;\n++++++++++++text-align:+center;\n++++++++++++color:+#5d4037;\n++++++++++++font-size:+20px;\n++++++++++++font-weight:+800;\n++++++++++++pointer-events:+none;\n++++++++++++opacity:+0;\n++++++++++++transition:+opacity+.5s;\n++++++++++++z-index:+3;\n++++++++++++text-shadow:+0+1px+3px+rgba(255,+255,+255,+.8)\n++++++++}\n\n++++++++.pop+{\n++++++++++++position:+fixed;\n++++++++++++background:+rgba(255,+250,+240,+.97);\n++++++++++++border-radius:+18px;\n++++++++++++padding:+20px;\n++++++++++++border:+2px+solid+#deb887;\n++++++++++++box-shadow:+0+8px+24px+rgba(0,+0,+0,+.3);\n++++++++++++pointer-events:+auto;\n++++++++++++z-index:+200;\n++++++++++++text-align:+center;\n++++++++++++color:+#5d4037;\n++++++++++++display:+none;\n++++++++++++left:+5%;\n++++++++++++top:+20px;\n++++++++++++width:+90%;\n++++++++++++max-width:+400px;\n++++++++++++min-height:+420px;\n++++++++++++max-height:+90vh;\n++++++++++++overflow-y:+auto\n++++++++}\n\n++++++++.pop+h3+{\n++++++++++++margin:+0+0+8px;\n++++++++++++font-size:+16px\n++++++++}\n\n++++++++.pop+p+{\n++++++++++++margin:+4px+0;\n++++++++++++font-size:+13px\n++++++++}\n\n++++++++.pop+button+{\n++++++++++++background:+#deb887;\n++++++++++++border:+none;\n++++++++++++border-radius:+20px;\n++++++++++++padding:+8px+16px;\n++++++++++++margin:+4px;\n++++++++++++font-weight:+bold;\n++++++++++++color:+#3e2c1b;\n++++++++++++cursor:+pointer;\n++++++++++++font-size:+13px\n++++++++}\n\n++++++++.pop+button:disabled+{\n++++++++++++opacity:+.4\n++++++++}\n\n++++++++.pc+{\n++++++++++++position:+absolute;\n++++++++++++top:+6px;\n++++++++++++right:+10px;\n++++++++++++font-size:+18px;\n++++++++++++cursor:+pointer;\n++++++++++++background:+none;\n++++++++++++border:+none;\n++++++++++++color:+#5d4037;\n++++++++++++padding:+4px\n++++++++}\n\n++++++++.tab-bar+{\n++++++++++++display:+flex;\n++++++++++++gap:+4px;\n++++++++++++margin-bottom:+10px;\n++++++++++++justify-content:+center;\n++++++++++++flex-wrap:+wrap\n++++++++}\n\n++++++++.tab-btn+{\n++++++++++++padding:+5px+10px;\n++++++++++++border-radius:+12px;\n++++++++++++border:+1px+solid+#ccc;\n++++++++++++background:+#f5f0e0;\n++++++++++++font-size:+11px;\n++++++++++++font-weight:+bold;\n++++++++++++cursor:+pointer;\n++++++++++++color:+#5d4037\n++++++++}\n\n++++++++.tab-btn.active+{\n++++++++++++background:+#deb887;\n++++++++++++border-color:+#c9a050\n++++++++}\n\n++++++++.tab-content+{\n++++++++++++display:+none\n++++++++}\n\n++++++++.tab-content.active+{\n++++++++++++display:+block\n++++++++}\n\n++++++++.shop-item+{\n++++++++++++display:+flex;\n++++++++++++justify-content:+space-between;\n++++++++++++align-items:+center;\n++++++++++++padding:+6px+8px;\n++++++++++++margin:+4px+0;\n++++++++++++background:+rgba(0,+0,+0,+.05);\n++++++++++++border-radius:+10px;\n++++++++++++font-size:+12px;\n++++++++++++text-align:+left\n++++++++}\n\n++++++++.shop-item+button+{\n++++++++++++padding:+5px+10px;\n++++++++++++font-size:+11px;\n++++++++++++min-width:+60px\n++++++++}\n\n++++++++.mg-card+{\n++++++++++++padding:+10px;\n++++++++++++margin:+6px+0;\n++++++++++++background:+rgba(0,+0,+0,+.05);\n++++++++++++border-radius:+12px;\n++++++++++++cursor:+pointer\n++++++++}\n\n++++++++.mg-card:active+{\n++++++++++++background:+rgba(0,+0,+0,+.12)\n++++++++}\n\n++++++++.minigame-canvas+{\n++++++++++++width:+200px;\n++++++++++++height:+200px;\n++++++++++++background:+#a2d9ce;\n++++++++++++border-radius:+14px;\n++++++++++++margin:+6px+auto;\n++++++++++++display:+block;\n++++++++++++border:+3px+solid+#5d4037\n++++++++}\n++++</style>\n</head>\n\n<body>\n++++<div+id=\"ui\">\n++++++++<div>\n++++++++++++<div+id=\"header\">\n++++++++++++++++<div+id=\"mute\"+class=\"glass\">🔊</div><span+id=\"brand\">Created+By:Alex+Pereira+Franco</span>\n++++++++++++</div>\n++++++++++++<div+id=\"stats\"+class=\"glass\">\n++++++++++++++++<div>❤️+<span+id=\"vh\">100</span>%<div+class=\"sb\">\n++++++++++++++++++++++++<div+id=\"bh\"+class=\"sf\"+style=\"width:100%\"></div>\n++++++++++++++++++++</div>\n++++++++++++++++</div>\n++++++++++++++++<div>🍔+<span+id=\"vhu\">100</span>%<div+class=\"sb\">\n++++++++++++++++++++++++<div+id=\"bhu\"+class=\"sf\"+style=\"width:100%\"></div>\n++++++++++++++++++++</div>\n++++++++++++++++</div>\n++++++++++++++++<div>⚽+<span+id=\"vj\">100</span>%<div+class=\"sb\">\n++++++++++++++++++++++++<div+id=\"bj\"+class=\"sf\"+style=\"width:100%\"></div>\n++++++++++++++++++++</div>\n++++++++++++++++</div>\n++++++++++++++++<div>💰+<span+id=\"vc\">10</span>+|+🍽️+<span+id=\"vf\">5</span></div>\n++++++++++++++++<div>⭐+Nv.<span+id=\"vlv\">1</span>\n++++++++++++++++++++<div+class=\"sb\">\n++++++++++++++++++++++++<div+id=\"bxp\"+class=\"sf+xp\"+style=\"width:0%\"></div>\n++++++++++++++++++++</div>\n++++++++++++++++</div>\n++++++++++++++++<div>🧼+<span+id=\"vhyg\">100</span>%<div+class=\"sb\">\n++++++++++++++++++++++++<div+id=\"bhyg\"+class=\"sf\"+style=\"width:100%\"></div>\n++++++++++++++++++++</div>\n++++++++++++++++</div>\n++++++++++++++++<div>⚡+<span+id=\"ve\">100</span>%<div+class=\"sb\">\n++++++++++++++++++++++++<div+id=\"be\"+class=\"sf\"+style=\"width:100%\"></div>\n++++++++++++++++++++</div>\n++++++++++++++++</div>\n++++++++++++++++<div>😴+<span+id=\"venergy\">Descansado</span></div>\n++++++++++++</div>\n++++++++++++<div+id=\"rooms\"+class=\"glass\">\n++++++++++++++++<button+class=\"rb+active\"+data-room=\"living\">🛋️Sala</button>\n++++++++++++++++<button+class=\"rb\"+data-room=\"kitchen\">🍳Cozinha</button>\n++++++++++++++++<button+class=\"rb\"+data-room=\"bedroom\">🛏️Quarto</button>\n++++++++++++++++<button+class=\"rb\"+data-room=\"bathroom\">🚽Banheiro</button>\n++++++++++++</div>\n++++++++</div>\n++++++++<div+id=\"msg\"></div>\n++++++++<div>\n++++++++++++<div+id=\"actions\">\n++++++++++++++++<button+class=\"ab+glass\"+id=\"bFeed\"+disabled>🍔<span>Comer</span></button>\n++++++++++++++++<button+class=\"ab+glass\"+id=\"bPlay\"+disabled>⚽<span>Brincar</span></button>\n++++++++++++++++<button+class=\"ab+glass\"+id=\"bSleep\"+disabled>😴<span>Dormir</span></button>\n++++++++++++++++<button+class=\"ab+glass\"+id=\"bBath\"+disabled>🛁<span>Banho</span></button>\n++++++++++++++++<button+class=\"ab+glass\"+id=\"bHit\">🥊<span>Bater</span></button>\n++++++++++++</div>\n++++++++++++<div+id=\"extras\">\n++++++++++++++++<button+class=\"eb+glass\"+id=\"bStore\">🛒+Loja</button>\n++++++++++++++++<button+class=\"eb+glass\"+id=\"bMini\"+disabled>🎮+Jogos</button>\n++++++++++++</div>\n++++++++</div>\n++++</div>\n++++<div+id=\"shopPop\"+class=\"pop\">\n++++++++<button+class=\"pc\"+id=\"shopClose\">✖</button>\n++++++++<h3>🛒+Loja</h3>\n++++++++<p>💰+<span+id=\"sc\">0</span>+moedas</p>\n++++++++<div+class=\"tab-bar\">\n++++++++++++<button+class=\"tab-btn+active\"+data-tab=\"food\">🍔Comida</button>\n++++++++++++<button+class=\"tab-btn\"+data-tab=\"walls\">🎨Papéis</button>\n++++++++++++<button+class=\"tab-btn\"+data-tab=\"furni\">🪑Móveis</button>\n++++++++++++<button+class=\"tab-btn\"+data-tab=\"pots\">🧪Poções</button>\n++++++++++++<button+class=\"tab-btn\"+data-tab=\"upg\">⬆️Melhoria</button>\n++++++++</div>\n++++++++<div+id=\"tab-food\"+class=\"tab-content+active\"></div>\n++++++++<div+id=\"tab-walls\"+class=\"tab-content\"></div>\n++++++++<div+id=\"tab-furni\"+class=\"tab-content\"></div>\n++++++++<div+id=\"tab-pots\"+class=\"tab-content\"></div>\n++++++++<div+id=\"tab-upg\"+class=\"tab-content\"></div>\n++++</div>\n++++<div+id=\"mgSelect\"+class=\"pop\">\n++++++++<button+class=\"pc\"+id=\"mgSelClose\">✖</button>\n++++++++<h3>��+Minijogos</h3>\n++++++++<div+id=\"mgList\"></div>\n++++</div>\n++++<div+id=\"mgPlay\"+class=\"pop\">\n++++++++<button+class=\"pc\"+id=\"mgPlayClose\">✖</button>\n++++++++<h3+id=\"mgTitle\">Jogo</h3>\n++++++++<canvas+id=\"mgCvs\"+class=\"minigame-canvas\"+width=\"200\"+height=\"200\"></canvas>\n++++++++<p+id=\"mgInfo\"></p>\n++++++++<button+id=\"mgStart\">Iniciar</button>\n++++</div>\n++++<canvas+id=\"cvs\"></canvas>\n++++<script>\n++++++++(function+()+{\n++++++++++++'use+strict';\n++++++++++++var+C+=+document.getElementById('cvs'),+X+=+C.getContext('2d'),+w+=+0,+h+=+0;\n++++++++++++var+AC+=+null,+sOn+=+true,+mStarted+=+false,+mInt+=+null,+isDead+=+false,+warnTick+=+0;\n++++++++++++function+iA()+{+if+(!AC)+{+try+{+AC+=+new+(window.AudioContext+||+window.webkitAudioContext)()+}+catch+(e)+{+return+}+}+if+(AC+&&+AC.state+===+'suspended')+try+{+AC.resume()+}+catch+(e)+{+}+if+(!mStarted+&&+AC)+{+sBGM();+mStarted+=+true+}+}\n++++++++++++function+sfx(f,+v,+t,+d)+{+t+=+t+||+'sine';+d+=+d+||+.3;+if+(!AC+||+!sOn)+return;+try+{+var+o+=+AC.createOscillator(),+g+=+AC.createGain();+o.type+=+t;+o.frequency.setValueAtTime(f,+AC.currentTime);+g.gain.setValueAtTime(v,+AC.currentTime);+g.gain.exponentialRampToValueAtTime(.0001,+AC.currentTime+++d);+o.connect(g);+g.connect(AC.destination);+o.start();+o.stop(AC.currentTime+++d)+}+catch+(e)+{+}+}\n++++++++++++function+sBGM()+{\n++++++++++++++++if+(mInt)+clearInterval(mInt);\n\n++++++++++++++++//+Melodies+for+different+states\n++++++++++++++++var+mHappy+=+{+n:+[392,+440,+523.25,+659.25],+t:+'triangle',+v:+1.0,+d:+.2,+spd:+1+};+//+G,+A,+C,+E\n++++++++++++++++var+mSad+=+{+n:+[293.66,+261.63,+220,+196],+t:+'sine',+v:+1.2,+d:+.4,+spd:+1+};+//+Melancholic\n++++++++++++++++var+mSick+=+{+n:+[207.65,+196,+185,+174.61],+t:+'sine',+v:+1.2,+d:+.5,+spd:+2+};+//+Very+slow,+descending\n++++++++++++++++var+mHungry+=+{+n:+[440,+440,+440,+0],+t:+'square',+v:+0.8,+d:+.1,+spd:+0.5+};+//+Annoyed,+repetitive\n++++++++++++++++var+mDirty+=+{+n:+[311.13,+329.63,+311.13,+293.66],+t:+'sawtooth',+v:+0.8,+d:+.2,+spd:+1.5+};+//+Dissonant,+slippery\n++++++++++++++++var+mCrit+=+{+n:+[130.81,+0,+123.47,+0],+t:+'sawtooth',+v:+1.5,+d:+.8,+spd:+3+};+//+\"Heartbeat\"+critical\n++++++++++++++++var+mDead+=+{+n:+[82.41],+t:+'sawtooth',+v:+1.5,+d:+2.0,+spd:+4+};+//+Flatline+(E2)\n\n++++++++++++++++var+beat+=+0;\n\n++++++++++++++++mInt+=+setInterval(function+()+{\n++++++++++++++++++++if+(!sOn+||+!AC+||+sleeping)+return;\n\n++++++++++++++++++++var+state+=+mHappy;\n\n++++++++++++++++++++if+(isDead)+state+=+mDead;\n++++++++++++++++++++else+if+(S.health+<+15+&&+S.joy+<+15+&&+S.hunger+<+15+&&+S.hygiene+<+15)+state+=+mCrit;\n++++++++++++++++++++else+if+(S.health+<+20)+state+=+mSick;\n++++++++++++++++++++else+if+(S.hunger+<+20)+state+=+mHungry;\n++++++++++++++++++++else+if+(S.hygiene+<+20)+state+=+mDirty;\n++++++++++++++++++++else+if+(S.joy+<+20)+state+=+mSad;\n\n++++++++++++++++++++//+Only+play+if+the+beat+aligns+with+the+melody's+speed+multiplier+(to+allow+slower+tracks)\n++++++++++++++++++++if+(beat+%+(state.spd+*+2)+===+0)+{\n++++++++++++++++++++++++var+idx+=+Math.floor(beat+/+(state.spd+*+2))+%+state.n.length;\n++++++++++++++++++++++++var+freq+=+state.n[idx];\n++++++++++++++++++++++++if+(freq+>+0)+sfx(freq,+state.v,+state.t,+state.d);\n++++++++++++++++++++}\n++++++++++++++++++++beat++;\n++++++++++++++++},+300);+//+Base+tick+is+300ms,+happy/sad+play+every+600ms+(spd:1)\n++++++++++++}\n++++++++++++document.getElementById('mute').addEventListener('click',+function+(e)+{+e.stopPropagation();+sOn+=+!sOn;+this.textContent+=+sOn+?+'🔊'+:+'🔇';+if+(AC)+try+{+sOn+?+AC.resume()+:+AC.suspend()+}+catch+(e)+{+}+iA()+});\n\n++++++++++++var+S+=+{+health:+100,+hunger:+80,+joy:+80,+energy:+100,+coins:+10,+hygiene:+100,+reviveHearts:+0+};\n++++++++++++var+food+=+5,+room+=+'living',+lvl+=+1,+xp+=+0,+sleeping+=+false,+sleepT+=+0,+rHearts+=+[];\n++++++++++++var+pet+=+{+x:+0,+y:+0,+size:+80,+emoji:+'😺',+scale:+1+};\n++++++++++++var+poops+=+[],+fOff+=+0;\n++++++++++++var+upg+=+{+slowHP:+0,+autoFood:+0,+autoCoins:+0+};\n++++++++++++var+hugeT+=+0;\n++++++++++++var+walls+=+{+living:+0,+kitchen:+0,+bedroom:+0,+bathroom:+0+};\n++++++++++++var+furni+=+{};\n\n++++++++++++var+WALLPAPERS+=+{\n++++++++++++++++living:+[{+n:+'Padrão',+c:+'#fdf6e3',+p:+0+},+{+n:+'Sunset',+c:+'#ffe4c4',+p:+15+},+{+n:+'Azul+Céu',+c:+'#cce5ff',+p:+20+},+{+n:+'Verde+Menta',+c:+'#d4edda',+p:+20+}],\n++++++++++++++++kitchen:+[{+n:+'Padrão',+c:+'#ffe0b5',+p:+0+},+{+n:+'Rosa+Chef',+c:+'#ffe0e6',+p:+15+},+{+n:+'Amarelo',+c:+'#fff9c4',+p:+20+},+{+n:+'Cinza+Modern',+c:+'#e0e0e0',+p:+20+}],\n++++++++++++++++bedroom:+[{+n:+'Padrão',+c:+'#d9e6f2',+p:+0+},+{+n:+'Roxo+Noite',+c:+'#e1d5f0',+p:+15+},+{+n:+'Rosa+Bebê',+c:+'#fce4ec',+p:+20+},+{+n:+'Escuro',+c:+'#c5cae9',+p:+25+}],\n++++++++++++++++bathroom:+[{+n:+'Padrão',+c:+'#d1f2eb',+p:+0+},+{+n:+'Azul+Oceano',+c:+'#b3e5fc',+p:+15+},+{+n:+'Branco+Puro',+c:+'#f5f5f5',+p:+20+},+{+n:+'Turquesa',+c:+'#b2dfdb',+p:+20+}]\n++++++++++++};\n++++++++++++var+FURNITURE+=+{\n++++++++++++++++living:+[{+id:+'l_tv',+n:+'📺+TV+Grande',+e:+'📺',+x:+.82,+y:+.82,+s:+40,+p:+30+},+{+id:+'l_sofa',+n:+'🛋️+Sofá',+e:+'🛋️',+x:+.15,+y:+.85,+s:+45,+p:+25+},+{+id:+'l_plant',+n:+'🌿+Planta',+e:+'🌿',+x:+.9,+y:+.6,+s:+35,+p:+15+},+{+id:+'l_book',+n:+'📚+Estante',+e:+'📚',+x:+.08,+y:+.6,+s:+35,+p:+20+}],\n++++++++++++++++kitchen:+[{+id:+'k_fridge',+n:+'🧊+Geladeira',+e:+'🧊',+x:+.85,+y:+.7,+s:+45,+p:+25+},+{+id:+'k_stove',+n:+'🍳+Fogão',+e:+'🍳',+x:+.15,+y:+.8,+s:+40,+p:+20+},+{+id:+'k_table',+n:+'🍽️+Mesa',+e:+'🍽️',+x:+.5,+y:+.88,+s:+35,+p:+15+},+{+id:+'k_cup',+n:+'☕+Cafeteira',+e:+'☕',+x:+.88,+y:+.55,+s:+30,+p:+10+}],\n++++++++++++++++bedroom:+[{+id:+'b_bed',+n:+'🛏️+Cama',+e:+'🛏️',+x:+.2,+y:+.85,+s:+50,+p:+30+},+{+id:+'b_lamp',+n:+'💡+Abajur',+e:+'💡',+x:+.85,+y:+.55,+s:+30,+p:+10+},+{+id:+'b_bear',+n:+'🧸+Ursinho',+e:+'🧸',+x:+.75,+y:+.88,+s:+35,+p:+15+},+{+id:+'b_star',+n:+'⭐+Estrelas',+e:+'⭐',+x:+.1,+y:+.35,+s:+25,+p:+20+}],\n++++++++++++++++bathroom:+[{+id:+'bt_tub',+n:+'🛁+Banheira',+e:+'🛁',+x:+.15,+y:+.8,+s:+45,+p:+30+},+{+id:+'bt_mirror',+n:+'🪞+Espelho',+e:+'🪞',+x:+.85,+y:+.45,+s:+35,+p:+15+},+{+id:+'bt_towel',+n:+'🧴+Shampoo',+e:+'🧴',+x:+.9,+y:+.75,+s:+30,+p:+10+},+{+id:+'bt_duck',+n:+'🦆+Patinho',+e:+'🦆',+x:+.3,+y:+.9,+s:+30,+p:+12+}]\n++++++++++++};\n++++++++++++var+UPGRADES+=+[\n++++++++++++++++{+id:+'slowHP',+n:+'🛡️+Escudo+Vital',+d:+'Saúde+cai+mais+devagar',+costs:+[50,+120,+250],+max:+3+},\n++++++++++++++++{+id:+'autoFood',+n:+'🍳+Auto+Chef',+d:+'Gera+comida+automaticamente',+costs:+[80,+200,+400],+max:+3+},\n++++++++++++++++{+id:+'autoCoins',+n:+'🍀+Amuleto+Sorte',+d:+'Gera+moedas+raramente',+costs:+[100,+250,+500],+max:+3+}\n++++++++++++];\n\n++++++++++++function+xpNeed()+{+return+Math.floor(50+*+Math.pow(1.5,+lvl+-+1))+}\n\n++++++++++++function+save()+{+try+{+localStorage.setItem('cp2',+JSON.stringify({+S:+S,+food:+food,+room:+room,+lvl:+lvl,+xp:+xp,+upg:+upg,+walls:+walls,+furni:+furni,+poops:+poops,+t:+Date.now()+}))+}+catch+(e)+{+}+}\n++++++++++++function+load()+{\n++++++++++++++++try+{\n++++++++++++++++++++var+r+=+localStorage.getItem('cp2');+if+(!r)+return;+var+d+=+JSON.parse(r);+if+(d.S)+{+S.health+=+d.S.health;+S.hunger+=+d.S.hunger;+S.joy+=+d.S.joy;+S.energy+=+(typeof+d.S.energy+===+'number')+?+d.S.energy+:+100;+S.coins+=+d.S.coins;+S.hygiene+=+(typeof+d.S.hygiene+===+'number')+?+d.S.hygiene+:+100;+S.reviveHearts+=+d.S.reviveHearts+||+0+}\n++++++++++++++++++++if+(typeof+d.food+===+'number')+food+=+d.food;+if+(d.room)+room+=+d.room;+if+(typeof+d.lvl+===+'number')+lvl+=+d.lvl;+if+(typeof+d.xp+===+'number')+xp+=+d.xp;\n++++++++++++++++++++if+(d.upg)+{+upg.slowHP+=+d.upg.slowHP+||+0;+upg.autoFood+=+d.upg.autoFood+||+0;+upg.autoCoins+=+d.upg.autoCoins+||+0+}\n++++++++++++++++++++if+(d.walls)+walls+=+d.walls;+if+(d.furni)+furni+=+d.furni;+if+(Array.isArray(d.poops))+poops+=+d.poops;\n++++++++++++++++++++if+(d.t)+{+var+away+=+(Date.now()+-+d.t)+/+1000,+cy+=+Math.min(Math.floor(away+/+3),+200);+if+(cy+>+0)+{+S.hunger+=+Math.max(0,+S.hunger+-+cy);+S.joy+=+Math.max(0,+S.joy+-+cy+*+.5)+}+}\n++++++++++++++++}+catch+(e)+{+}\n++++++++++++}\n++++++++++++load();\n\n++++++++++++function+resize()+{+w+=+C.width+=+window.innerWidth;+h+=+C.height+=+window.innerHeight;+pet.x+=+w+/+2;+pet.y+=+h+/+2+}\n++++++++++++window.addEventListener('resize',+resize);+resize();\n\n++++++++++++var+msgTo+=+null;\n++++++++++++function+msg(t)+{+var+m+=+document.getElementById('msg');+m.innerText+=+t;+m.style.opacity+=+'1';+if+(msgTo)+clearTimeout(msgTo);+msgTo+=+setTimeout(function+()+{+m.style.opacity+=+'0'+},+1200)+}\n++++++++++++function+addXP(n)+{+xp++=+n;+while+(xp+>=+xpNeed())+{+xp+-=+xpNeed();+lvl++;+msg('⭐+Nível+'+++lvl+++'!')+}+}\n\n++++++++++++function+uUI()+{\n++++++++++++++++['health',+'hunger',+'joy',+'hygiene',+'energy'].forEach(function+(k)+{+S[k]+=+Math.max(0,+Math.min(100,+S[k]))+});\n++++++++++++++++document.getElementById('vh').innerText+=+Math.floor(S.health);\n++++++++++++++++document.getElementById('vhu').innerText+=+Math.floor(S.hunger);\n++++++++++++++++document.getElementById('vj').innerText+=+Math.floor(S.joy);\n++++++++++++++++document.getElementById('vhyg').innerText+=+Math.floor(S.hygiene);\n++++++++++++++++document.getElementById('ve').innerText+=+Math.floor(S.energy);\n++++++++++++++++document.getElementById('bh').style.width+=+S.health+++'%';\n++++++++++++++++document.getElementById('bhu').style.width+=+S.hunger+++'%';\n++++++++++++++++document.getElementById('bj').style.width+=+S.joy+++'%';\n++++++++++++++++document.getElementById('bhyg').style.width+=+S.hygiene+++'%';\n++++++++++++++++document.getElementById('be').style.width+=+S.energy+++'%';\n++++++++++++++++['bh',+'bhu',+'bj',+'bhyg',+'be'].forEach(function+(id,+i)+{\n++++++++++++++++++++var+v+=+[S.health,+S.hunger,+S.joy,+S.hygiene,+S.energy][i];\n++++++++++++++++++++var+b+=+document.getElementById(id);\n++++++++++++++++++++v+<+20+?+b.classList.add('low')+:+b.classList.remove('low')\n++++++++++++++++});\n++++++++++++++++document.getElementById('vc').innerText+=+S.coins;+document.getElementById('vf').innerText+=+food;\n++++++++++++++++document.getElementById('vlv').innerText+=+lvl;\n++++++++++++++++document.getElementById('bxp').style.width+=+Math.floor(xp+/+xpNeed()+*+100)+++'%';\n++++++++++++++++var+energyTxt+=+'Descansado';\n++++++++++++++++if+(sleeping)+energyTxt+=+'💤+Dormindo...';\n++++++++++++++++else+if+(S.energy+<+20)+energyTxt+=+'😫+Cansado';\n++++++++++++++++document.getElementById('venergy').innerText+=+energyTxt;\n++++++++++++++++var+sc+=+document.getElementById('sc');+if+(sc)+sc.innerText+=+S.coins;\n++++++++++++++++if+(S.health+===+0+&&+S.joy+===+0+&&+S.hunger+===+0+&&+S.hygiene+===+0+&&+S.energy+===+0)+{\n++++++++++++++++++++isDead+=+true;\n++++++++++++++++++++pet.emoji+=+'💀';\n++++++++++++++++++++document.getElementById('msg').innerText+=+\"PET+MORTO+💀+(\"+++S.reviveHearts+++\"/100+Corações)\";\n++++++++++++++++++++document.getElementById('msg').style.opacity+=+'1';\n++++++++++++++++}+else+{\n++++++++++++++++++++isDead+=+false;+//+Ensure+isDead+is+false+if+stats+are+restored\n++++++++++++++++++++if+(sleeping)+{+pet.emoji+=+'😸'+}+else+if+(S.health+<+20)+{+pet.emoji+=+'😿'+}+else+if+(S.hygiene+<+20)+{+pet.emoji+=+'🙀'+}+else+if+(S.joy+<+20)+{+pet.emoji+=+'😾'+}+else+if+(S.hunger+<+20)+{+pet.emoji+=+'😼'+}+else+if+(S.health+>+80+&&+S.joy+>+80+&&+S.hunger+>+80+&&+S.hygiene+>+70)+{+pet.emoji+=+'😸'+}+else+{+pet.emoji+=+'😺'+}\n++++++++++++++++}\n\n++++++++++++++++var+btns+=+document.querySelectorAll('.rb');+for+(var+i+=+0;+i+<+btns.length;+i++)+{+btns[i].classList.toggle('active',+btns[i].getAttribute('data-room')+===+room)+}\n++++++++++++++++document.getElementById('bFeed').disabled+=+(room+!==+'kitchen'+||+sleeping+||+isDead);\n++++++++++++++++document.getElementById('bPlay').disabled+=+(room+!==+'living'+||+sleeping+||+isDead);\n++++++++++++++++document.getElementById('bSleep').disabled+=+(room+!==+'bedroom'+||+sleeping+||+isDead);\n++++++++++++++++document.getElementById('bBath').disabled+=+(room+!==+'bathroom'+||+sleeping+||+isDead);\n++++++++++++++++document.getElementById('bMini').disabled+=+(room+!==+'living'+||+sleeping+||+isDead);\n++++++++++++++++document.getElementById('bHit').disabled+=+(sleeping+||+isDead);\n++++++++++++++++save();\n++++++++++++}\n\n++++++++++++function+feedPet()+{+iA();+if+(food+<=+0)+return+msg(\"Sem+comida!+Compre+na+loja.\");+if+(S.hunger+>=+100)+return+msg(\"Estou+cheio!+🤢\");+food--;+S.hunger++=+25;+S.health++=+5;+pet.emoji+=+'😸';+pet.scale+=+1.2;+setTimeout(function+()+{+pet.scale+=+1+},+200);+sfx(400,+1.0,+'square');+if+(Math.random()+>+.6)+spawnP();+addXP(5);+uUI()+}\n++++++++++++function+playPet()+{+iA();+if+(S.hunger+<+20)+return+msg(\"Estou+com+fome+pra+brincar!+😩\");+if+(S.energy+<+20)+return+msg(\"Estou+muito+cansado!+🥱\");+S.joy++=+20;+S.hunger+-=+10;+S.energy+-=+15;+S.coins++=+2;+pet.emoji+=+'😹';+pet.scale+=+1.3;+pet.y+-=+30;+setTimeout(function+()+{+pet.scale+=+1;+pet.y++=+30+},+200);+sfx(600,+1.0);+msg(\"+2+Moedas!+💰\");+addXP(8);+uUI()+}\n++++++++++++function+hitPet()+{+iA();+S.health+-=+15;+S.joy+-=+30;+pet.emoji+=+'🙀';+pet.x++=+20;+setTimeout(function+()+{+pet.x+-=+40+},+50);+setTimeout(function+()+{+pet.x++=+20+},+100);+sfx(150,+1.5,+'sawtooth');+msg(\"Ai!+💔\");+uUI()+}\n++++++++++++function+sleepPet()+{+iA();+if+(sleeping)+return;+sleeping+=+true;+sleepT+=+0;+msg(\"💤+Dormindo...\");+sfx(200,+0.8,+'sine',+.5);+uUI()+}\n++++++++++++function+bathPet()+{+iA();+if+(S.hygiene+>=+100)+return+msg(\"Já+está+limpo!+✨\");+S.hygiene++=+40;+S.health++=+3;+S.joy++=+5;+pet.emoji+=+'😸';+pet.scale+=+1.2;+setTimeout(function+()+{+pet.scale+=+1+},+200);+sfx(500,+1.0,+'triangle');+msg(\"Banho+tomado!+🛁✨\");+addXP(6);+uUI()+}\n++++++++++++function+spawnP()+{+var+px+=+50+++Math.random()+*+(w+-+100),+py+=+h+/+2+++50+++Math.random()+*+100;+poops.push({+x:+px,+y:+py,+size:+40+})+}\n\n++++++++++++document.querySelectorAll('.rb').forEach(function+(b)+{\n++++++++++++++++b.addEventListener('click',+function+()+{\n++++++++++++++++++++room+=+this.getAttribute('data-room');+sfx(300,+0.8,+'sine',+.1);\n++++++++++++++++++++if+(!isDead)+msg('Você+foi+para+'+++{+living:+'Sala',+kitchen:+'Cozinha',+bedroom:+'Quarto',+bathroom:+'Banheiro'+}[room]);\n++++++++++++++++++++else+{\n++++++++++++++++++++++++msg('Procurando+vida...+('+++S.reviveHearts+++'/100)');\n++++++++++++++++++++++++if+(Math.random()+<+0.3)+{\n++++++++++++++++++++++++++++var+hx+=+50+++Math.random()+*+(w+-+100),+hy+=+h+*+0.4+++Math.random()+*+(h+*+0.2);\n++++++++++++++++++++++++++++rHearts.push({+x:+hx,+y:+hy,+s:+45+});\n++++++++++++++++++++++++}\n++++++++++++++++++++}\n++++++++++++++++++++uUI()\n++++++++++++++++})\n++++++++++++});\n++++++++++++document.getElementById('bFeed').addEventListener('click',+function+()+{+if+(!isDead)+feedPet()+});\n++++++++++++document.getElementById('bPlay').addEventListener('click',+function+()+{+if+(!isDead)+playPet()+});\n++++++++++++document.getElementById('bHit').addEventListener('click',+function+()+{+if+(!isDead)+hitPet()+});\n++++++++++++document.getElementById('bSleep').addEventListener('click',+function+()+{+if+(!isDead)+sleepPet()+});\n++++++++++++document.getElementById('bBath').addEventListener('click',+function+()+{+if+(!isDead)+bathPet()+});\n\n++++++++++++function+closeAll()+{+document.getElementById('shopPop').style.display+=+'none';+document.getElementById('mgSelect').style.display+=+'none';+document.getElementById('mgPlay').style.display+=+'none';+document.getElementById('mgStart').style.display+=+'inline-block';+if+(mgInt)+clearInterval(mgInt);+mgActive+=+false;+curMG+=+null+}\n++++++++++++function+openShop()+{+iA();+closeAll();+document.getElementById('shopPop').style.display+=+'block';+renderShop()+}\n++++++++++++function+renderShop()+{\n++++++++++++++++document.getElementById('sc').innerText+=+S.coins;\n++++++++++++++++var+ft+=+document.getElementById('tab-food');+ft.innerHTML+=+'';\n++++++++++++++++[{+n:+'🍔+Comida+x1',+p:+5,+q:+1+},+{+n:+'🍔+Comida+x5',+p:+20,+q:+5+}].forEach(function+(it)+{\n++++++++++++++++++++var+d+=+document.createElement('div');+d.className+=+'shop-item';+d.innerHTML+=+'<span>'+++it.n+++'</span>';\n++++++++++++++++++++var+b+=+document.createElement('button');+b.textContent+=+it.p+++'💰';\n++++++++++++++++++++b.addEventListener('click',+function+()+{+if+(S.coins+>=+it.p)+{+S.coins+-=+it.p;+food++=+it.q;+sfx(500,+.3,+'square');+msg('+'+++it.q+++'+Comida+🍔');+addXP(2);+uUI();+renderShop()+}+else+msg(\"Sem+moedas!\")+});\n++++++++++++++++++++d.appendChild(b);+ft.appendChild(d)\n++++++++++++++++});\n\n++++++++++++++++var+pts+=+document.getElementById('tab-pots');+pts.innerHTML+=+'';\n++++++++++++++++var+POTIONS+=+[\n++++++++++++++++++++{+id:+'cure',+n:+'❤️+Cura',+p:+15,+msg:+'Curado!+❤️'+},\n++++++++++++++++++++{+id:+'damage',+n:+'💔+Tira+Cura',+p:+10,+msg:+'Ai!+💔'+},\n++++++++++++++++++++{+id:+'satiety',+n:+'🍔+Saciedade',+p:+20,+msg:+'Buchinho+cheio!+🍔'+},\n++++++++++++++++++++{+id:+'starve',+n:+'🍕+Fome',+p:+10,+msg:+'Que+fome!+🍕'+},\n++++++++++++++++++++{+id:+'energy',+n:+'⚡+Energético',+p:+20,+msg:+'Ligado+no+220!+⚡'+},\n++++++++++++++++++++{+id:+'sleepy',+n:+'🥱+Sonífero',+p:+10,+msg:+'Zzz...+🥱'+},\n++++++++++++++++++++{+id:+'clean',+n:+'🧼+Perfume',+p:+20,+msg:+'Cheiroso!+✨'+},\n++++++++++++++++++++{+id:+'dirty',+n:+'💩+Lama',+p:+10,+msg:+'Eca!+💩'+},\n++++++++++++++++++++{+id:+'happy',+n:+'⚽+Felicidade',+p:+20,+msg:+'Uhul!+⚽'+},\n++++++++++++++++++++{+id:+'sad',+n:+'👊+Soco',+p:+10,+msg:+'Triste...+👊'+},\n++++++++++++++++++++{+id:+'death',+n:+'💀+Veneno',+p:+35,+msg:+'Adeus...+💀'+},\n++++++++++++++++++++{+id:+'xp',+n:+'⭐+Experiência',+p:+500,+msg:+'SABEDORIA!+⭐'+},\n++++++++++++++++++++{+id:+'huge',+n:+'🦖+Enorme',+p:+100,+msg:+