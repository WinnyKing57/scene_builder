      },
      {
       "type": "SceneText",
       "sceneTextConfig": {
        "enableSelection": false,
        "isBold": false,
        "isItalic": false,
        "text": "Triggers+are+what+cause+your+macro+to+run.+Without+them,+your+macro+will+never+run!",
