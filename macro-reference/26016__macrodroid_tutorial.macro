  {
   "sceneDescription": {
    "itemList": {
     "items": [
      {
       "type": "SceneImage",
       "sceneImageConfig": {
        "alignment": "Center",
        "closeSceneOnPress": false,
        "height": 48,
        "variableUpdateValue": {
         "type": "None"
        },
        "width": 48
       },
       "uniqueId": -5894982722969586949,
       "guid": -5894982722969586949,
       "iconRes": 2131231482,
       "lastRefreshValue": 0
      },
      {
       "type": "SceneText",
       "sceneTextConfig": {
        "enableSelection": false,
        "isBold": false,
        "isItalic": false,
        "text": "Constraints!",
        "textAlignment": "Center",
        "textColor": -12517617,
        "textSize": 33
       },
       "uniqueId": -5154342480138585228,
       "guid": -5154342480138585228,
       "iconRes": 2131232620,
       "lastRefreshValue": 0
      },
      {
       "type": "SceneText",
       "sceneTextConfig": {
        "enableSelection": false,
        "isBold": false,
        "isItalic": false,
        "text": "Constraints+restrict+when+your+macro+can+run.+Constraints+can+be+added+onto+a+whole+macro+or+a+specific+action.",
        "textAlignment": "Center",
        "textColor": -1,
        "textSize": 20
       },
       "uniqueId": -7657641735540960803,
       "guid": -7657641735540960803,
       "iconRes": 2131232620,
       "lastRefreshValue": 0
      },
      {
       "type": "SceneText",
       "sceneTextConfig": {
        "enableSelection": false,
        "isBold": false,
        "isItalic": false,
        "text": "Special+Constraints+can+have+constraints+added+onto+themselves.\nOR:+At+least+one+constraint+has+to+be+true.\nAND:+All+constraints+must+be+true.\nNOT:+All+constraints+must+be+false.\nNOR:+At+least+one+constraint+has+to+be+false.",
        "textAlignment": "Start",
        "textColor": -1,
        "textSize": 17
       },
       "uniqueId": -5439661748968013695,
       "guid": -5439661748968013695,
       "iconRes": 2131232620,
       "lastRefreshValue": 0
      },
      {
       "type": "SceneButton",
       "sceneButtonConfig": {
        "buttonColor": -1,
        "closeSceneOnPress": true,
        "text": "Continue",
        "textColor": -16777216,
        "textSize": 20,
        "variableUpdateValue": {
         "type": "None"
        }
       },
       "uniqueId": -6998189194322633721,
       "guid": -6998189194322633721,
       "iconRes": 2131231189,
       "lastRefreshValue": 0
      }
     ]
    },
    "sceneConfig": {
     "backgroundColor": -16777216,
     "blockNextActions": true,
     "dismissOnBackPress": false,
     "displayOption": {
      "type": "FullScreen",
      "nameRes": 2132021131
     },
     "foregroundColor": -1118482,
     "name": "Constraints",
     "updateValuesOnSceneClose": false
    }
   },
   "disableLogging": false,
   "m_SIGUID": -9123026670104448591,
   "m_classType": "CustomSceneAction",
   "m_constraintList": [],
   "m_isDisabled": false,
   "m_isOrCondition": false
  },
  {
   "sceneDescription": {
    "itemList": {
     "items": [
      {
       "type": "SceneText",
       "sceneTextConfig": {
        "enableSelection": false,
        "isBold": false,
        "isItalic": false,
        "text": "Variables!",
        "textAlignment": "Center",
        "textColor": -1,
        "textSize": 34
       },
       "uniqueId": -5430160290712786232,
       "guid": -5430160290712786232,
       "iconRes": 2131232620,
       "lastRefreshValue": 0
      },
      {
       "type": "SceneText",
       "sceneTextConfig": {
        "enableSelection": false,
        "isBold": false,
        "isItalic": false,
        "text": "Variables+can+be+used+to+store+data+for+use+afterwards.",
        "textAlignment": "Center",
        "textColor": -1,
        "textSize": 20
       },
       "uniqueId": -6525100601303213812,
       "guid": -6525100601303213812,
       "iconRes": 2131232620,
       "lastRefreshValue": 0
      },
      {
       "type": "SceneText",
       "sceneTextConfig": {
        "enableSelection": false,
        "isBold": false,
        "isItalic": false,
        "text": "There+are+different+variable+types+such+as:+\n\nStrings:+Store+any+text.\nIntegers:+Store+numbers.\nDecimals:+Stores+numbers+with+a+decimal+point(.0).\nDictionaries:+Stores+variables+inside+a+list+under+a+different+name:+Keys.\nArrays:+Stores+variables+with+names+as+numbers.",
        "textAlignment": "Start",
        "textColor": -1,
        "textSize": 20
       },
       "uniqueId": -5594332445635892296,
       "guid": -5594332445635892296,
       "iconRes": 2131232620,
       "lastRefreshValue": 0
      },
