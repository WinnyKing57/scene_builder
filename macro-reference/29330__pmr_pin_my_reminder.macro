             "isChecked": false,
             "switchOffColor": -5355681,
             "switchOnColor": -8736944,
             "text": "Enable+Smarty",
             "textColor": -1,
             "textSize": "20",
             "textStart": true
            },
            "guid": -6554495889680969050,
            "iconRes": 2131232051,
