             "enableSelection": false,
             "htmlFormatting": false,
             "isBold": false,
             "isItalic": false,
             "maxLines": "3",
             "maxLinesEnabled": false,
             "text": "If+enabled,+nothing+will+be+deleted+from+jsonData+(history).\nUpon+restore,+notes/tasks+that+you+don't+require+(or+you+have+completed+before)+show+up+again.",
             "textAlignment": "Start",
