           },
           {
            "type": "SceneText",
            "sceneTextConfig": {
             "autoSizeText": false,
             "enableAutoRefresh": false,
             "enableSelection": false,
             "htmlFormatting": false,
             "isBold": false,
             "isItalic": false,
             "maxLines": "",
             "maxLinesEnabled": false,
             "text": "An+assistant+that+enables/adds+multiple+features+in+your+PMR+(if+it+has+phone+number(s),+link(s),+email(s)).\n\nSmarty+let+you:\n1.+Visit+a+link\n2.+Make+a+call\n3.+Send+an+email\n4.+WhatsApp+(WA/WAB)\n5.+Share+selected+text\n6.+Send+simple+text+message",
             "textAlignment": "Start",
             "textColor": -5197648,
             "textSize": "15",
             "visibilityVariable": {
              "dictionaryKeys": {
               "keys": [
                "smartyAssistant"
               ]
              },
              "varName": "pmrSettings"
             }
            },
