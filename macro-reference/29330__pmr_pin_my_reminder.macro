            "type": "SceneHorizontalDivider",
            "config": {
             "dividerColor": -1,
             "dividerHeight": 2,
             "padding": 16
            },
            "guid": -7340364585277053932,
            "iconRes": 2131231863,
            "lastRefreshValue": 0
           },
           {
            "type": "SceneSwitch",
            "checkedValue": false,
            "sceneSwitchConfig": {
             "alignment": "Split",
             "booleanVariable": {
              "dictionaryKeys": {
               "keys": [
                "readKnownErrors"
               ]
              },
              "varName": "pmrSettings"
             },
             "isChecked": false,
             "text": "Read+known+errors",
             "textColor": -1,
             "textSize": "20",
             "textStart": true
            },
            "guid": -6995590888246354653,
            "iconRes": 2131232051,
            "lastRefreshValue": 0
           },
           {
            "type": "SceneText",
            "sceneTextConfig": {
             "autoSizeText": false,
             "enableAutoRefresh": false,
             "enableSelection": false,
             "htmlFormatting": true,
             "isBold": false,
             "isItalic": false,
             "maxLines": "3",
             "maxLinesEnabled": false,
             "text": "1.+Ensure+<span+style=\"color:+red;\">Tasker+is+uninstalled</span>+(this+issue+is+caused+by+Tasker+itself+where+the+plugin+(developed+by+Tasker's+developer+gives+priority+to+Tasker+if+it's+installed)+in+order+for+MacroDroid+to+work+properly+with+Auto+Notification",
             "textAlignment": "Start",
             "textColor": -1,
             "textSize": "16",
             "visibilityVariable": {
              "dictionaryKeys": {
               "keys": [
                "readKnownErrors"
               ]
              },
              "varName": "pmrSettings"
             }
            },
            "guid": -6487138868185972906,
            "iconRes": 2131233027,
            "lastRefreshValue": 0
           },
           {
            "type": "SceneText",
            "sceneTextConfig": {
             "autoSizeText": false,
             "enableAutoRefresh": false,
             "enableSelection": false,
             "htmlFormatting": false,
             "isBold": false,
             "isItalic": false,
             "maxLines": "3",
             "maxLinesEnabled": false,
             "text": "2.+Using+screen+content+to+detect+new+reminders+behaves+weirdly+and+make+your+device+stuck.+Sometimes+detect+incomplete+reminder+(wait+patiently+for+it+to+run+again+after+1+min+pause+duration+to+ensure+while+reminder+is+captured.+Within+this+pause+you+can+complete+your+PMR)",
             "textAlignment": "Start",
             "textColor": -1,
             "textSize": "16",
             "visibilityVariable": {
              "dictionaryKeys": {
               "keys": [
                "readKnownErrors"
               ]
              },
              "varName": "pmrSettings"
             }
            },
            "guid": -7692227462230360125,
            "iconRes": 2131233027,
            "lastRefreshValue": 0
           },
           {
            "type": "SceneText",
            "sceneTextConfig": {
             "autoSizeText": false,
             "enableAutoRefresh": false,
             "enableSelection": false,
             "htmlFormatting": false,
             "isBold": false,
             "isItalic": false,
             "maxLines": "3",
             "maxLinesEnabled": false,
             "text": "3.+Auto+notification+sometimes+don't+work+if+subtext+(id)+is+too+long.+That's+why+JS+uses+`Math.random()*999`+to+generate+id+that+are+smaller+in+number.",
             "textAlignment": "Start",
             "textColor": -1,
             "textSize": "16",
             "visibilityVariable": {
              "dictionaryKeys": {
               "keys": [
                "readKnownErrors"
               ]
              },
              "varName": "pmrSettings"
             }
            },
            "guid": -5240611981618178442,
            "iconRes": 2131233027,
            "lastRefreshValue": 0
           },
           {
            "type": "SceneText",
            "sceneTextConfig": {
             "autoSizeText": false,
             "enableAutoRefresh": false,
             "enableSelection": false,
             "htmlFormatting": false,
             "isBold": false,
             "isItalic": false,
             "maxLines": "3",
             "maxLinesEnabled": false,
             "text": "4.+If+restoration+isn't+summoning+tasks+again+(after+boot+etc)+although+creating+new+task+pin+the+task+then+enter+jsonData+dictionary+and+change+id+to+something+else.\nLet's+say+there+are+multiple+tasks+over+there.+Change+them+to+different+different+IDs+each+(removing+or+adding+one+digit+works+-+too).",
             "textAlignment": "Start",
             "textColor": -1,
             "textSize": "16",
             "visibilityVariable": {
              "dictionaryKeys": {
               "keys": [
                "readKnownErrors"
               ]
              },
              "varName": "pmrSettings"
             }
            },
            "guid": -7162056130767581601,
            "iconRes": 2131233027,
            "lastRefreshValue": 0
           },
           {
            "type": "SceneText",
            "sceneTextConfig": {
             "autoSizeText": false,
             "enableAutoRefresh": false,
             "enableSelection": false,
             "htmlFormatting": true,
             "isBold": false,
             "isItalic": false,
             "maxLines": "3",
             "maxLinesEnabled": false,
             "text": "4.1+<span+style=\"padding:+20px;+border-radius:+5px;+background:+grey;+color:white;\">Restore+History+(Troubleshoot)</span>+does+exactly+this+for+you+automatically.+Use+it+only+when+<span+style=\"padding:+20px;+border-radius:+5px;+background:+grey;+color:white;\">`Restore+History`</span>+is+not+working",
             "textAlignment": "Start",
             "textColor": -5263441,
             "textSize": "16",
             "visibilityVariable": {
              "dictionaryKeys": {
               "keys": [
                "readKnownErrors"
               ]
              },
              "varName": "pmrSettings"
             }
            },
            "guid": -5997185311096329404,
            "iconRes": 2131233027,
            "lastRefreshValue": 0
           },
           {
            "type": "SceneText",
            "sceneTextConfig": {
             "autoSizeText": false,
             "enableAutoRefresh": false,
             "enableSelection": false,
             "htmlFormatting": false,
             "isBold": false,
             "isItalic": false,
             "maxLines": "3",
             "maxLinesEnabled": false,
             "text": "5.+Sometimes+I+have+noticed+that+posting/restoring+notifications+requires+internet.+I+have+no+clue+AT+ALL+why.",
             "textAlignment": "Start",
             "textColor": -1,
             "textSize": "16",
             "visibilityVariable": {
              "dictionaryKeys": {
               "keys": [
                "readKnownErrors"
               ]
              },
              "varName": "pmrSettings"
             }
            },
            "guid": -5050569910112835307,
            "iconRes": 2131233027,
            "lastRefreshValue": 0
           }
          ],
          "label": "Instructions+Manual"
         }
        ],
        "useScrollableTabs": true
       },
