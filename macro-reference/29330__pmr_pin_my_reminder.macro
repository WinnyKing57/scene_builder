             "htmlFormatting": false,
             "isBold": true,
             "isItalic": false,
             "maxLines": "",
             "maxLinesEnabled": false,
             "text": "Usage+method",
             "textAlignment": "Start",
             "textColor": -1,
             "textSize": "18",
             "visibilityVariable": {
              "dictionaryKeys": {
               "keys": [
                "smartyAssistant"
               ]
              },
              "varName": "pmrSettings"
             }
            },
            "guid": -5978509581568089951,
            "iconRes": 2131233027,
            "lastRefreshValue": 0
           },
           {
            "type": "SceneText",
            "sceneTextConfig": {
             "autoSizeText": false,
             "enableAutoRefresh": false,
             "enableSelection": false,
             "htmlFormatting": true,
             "isBold": false,
             "isItalic": false,
             "maxLines": "",
             "maxLinesEnabled": false,
             "text": "<ul>\n<li>Ensure+links+start+from+http(s)://+for+Smarty+to+work+properly.+\n++++++++++<ul><li>+\n++++++++++Sometimes,+work+without+http(s)://+\n++++++++++</li></ul>\n</li>\n<br>\n<li>\nEnsure+phone+numbers+have+no+spaces+or+special+characters+in-between.\n++++++++++<ul>\n++++++++++<li><b>Example</b></li>\n++++++++++<li>✔️+923319999613</li>\n++++++++++</ul>\n</li>\n</ul>",
             "textAlignment": "Start",
             "textColor": -5197648,
             "textSize": "15",
             "visibilityVariable": {
