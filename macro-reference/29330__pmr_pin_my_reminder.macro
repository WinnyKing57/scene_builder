             "switchOffColor": -5355681,
             "switchOnColor": -8736944,
             "text": "Save+history.",
             "textColor": -1,
             "textSize": "20",
             "textStart": true
            },
            "guid": -5470716376607956309,
            "iconRes": 2131232051,
            "lastRefreshValue": 0
           },
           {
            "type": "SceneText",
            "sceneTextConfig": {
             "autoSizeText": false,
             "enableAutoRefresh": false,
             "enableSelection": false,
             "htmlFormatting": false,
             "isBold": false,
             "isItalic": false,
             "maxLines": "3",
             "maxLinesEnabled": false,
             "text": "By+default+notes+are+saved+into+variable+jsonData+dictionary+variable.\nIt+is+used+to+restore+notes+in+case+they+vanish+out+of+blue+or+don't+reappear+on+their+own+after+boot.",
             "textAlignment": "Start",
             "textColor": -5197648,
