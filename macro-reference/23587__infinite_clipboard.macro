   "m_nonRoot": true,
   "m_script": "file=\"{lv=pth852}Infinite_Clipboard/Clipboard_Log.txt\"\ntemp_file=\"$(dirname+\"$file\")/temp_results.txt\"\ndelim=\"『‰』\"\n\nawk+-v+RS=\"$delim\"+-v+OFS=\"\"+'\nfunction+trim(s)+{\n++++gsub(/^[[:space:]]+|[[:space:]]+$/,\"\",s)\n++++return+s\n}\n\n{\n++++#+Check+if+the+entry+is+a+date+line+or+is+empty.\n++++entry+=+trim($0)\n++++if+(entry+~+/^[0-9]+DaT£≈$/+||+entry+==+\"\")+{\n++++++++next++#+If+it+is,+skip+this+entry+completely.\n++++}\n++++entries[++n]+=+$0+#+Otherwise,+add+the+entry+to+our+array.\n}\n\nEND+{\n++++#+Print+the+total+count+to+stderr.\n++++print+n+>+\"/dev/stderr\"\n\n++++#+Find+the+last+valid+entry.\n++++for+(i+=+n;+i+>=+1;+i--)+{\n++++++++t+=+trim(entries[i])\n++++++++#+Skip+empty+entries+and+the+standalone+DaT£≈.\n++++++++if+(t+==+\"\"+||+t+~+/^DaT£≈$/)+{\n++++++++++++continue\n++++++++}\n++++++++#+The+first+non-empty,+non-date+entry+we+find+is+the+one+we+want.\n++++++++print+entries[i],+RS\n++++++++exit\n++++}\n}\n'+\"$file\"+>+\"$temp_file\"\n",
