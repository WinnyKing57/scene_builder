           {
            "type": "SceneWebView",
            "sceneWebViewConfig": {
             "closeSceneOnPress": false,
             "enableJavaScript": true,
             "enableSwipeNavigation": false,
             "height": 75,
             "padding": "0",
             "url": "<!DOCTYPE+html>\n<html+lang=\"en\">\n<head>\n<meta+charset=\"UTF-8\">\n<title>Dynamic+List+-+Trackpad+++Edit+++Delete+Mode</title>\n<style>\n:root{\n++--accent-red:+#ff0000;\n++--accent-red-rgba-20:+rgba(255,0,0,0.2);\n++--accent-red-glow:+rgba(255,0,0,0.8);\n++--trackpad-glow:+rgba(160,160,160,0.65);\n++--trackpad-glow-strong:+rgba(160,160,160,0.95);\n++--delete-line-grey:+grey;\n++--delete-inset:+12px;\n++--pinned-gold:+#ffd700;\n}\n\n/*+PAGE+*/\nbody+{+background:#000;+margin:0;+padding:20px;+font-family:Arial,sans-serif;+color:#fff;+}\n.header-wrap+{+position:relative;+text-align:center;+margin-bottom:30px;+}\nh2+{+font-size:48px;+margin:0;+display:inline-block;+vertical-align:middle;+}\n#addNewBtn+{+position:absolute;+left:calc(50%+++220px);+top:10px;+font-size:36px;+background:transparent;+border:none;+color:grey;+cursor:pointer;+padding:6px+10px;+}\n\n/*+LIST+&+ITEMS+*/\nul+{+list-style:none;+padding:0;+margin:0;+}\nli+{\n++display:flex;\n++align-items:flex-start;\n++background:#111;\n++margin:22px+0;\n++padding:12px;\n++width:100%;\n++color:#fff;\n++border:2px+solid+#fff;\n++border-radius:20px;\n++position:relative;\n++box-sizing:border-box;\n++transition:+background+0.22s,+border-color+0.22s;\n}\nli.highlighted+{+background:#333;+border-color:+var(--accent-red);+}\nli.pinned+{+border-color:+var(--pinned-gold);+}\nli.highlighted.pinned+{+background:#333;+border-color:+var(--pinned-gold);+}\n/*+The+new+pinned+icon+style+*/\n.pinned-icon+{\n++++position:+absolute;\n++++top:+-5px;\n++++left:+50%;\n++++transform:+translateX(-50%);\n++++color:+var(--pinned-gold);\n++++font-size:+24px;\n++++z-index:+10;\n++++pointer-events:+none;\n}\n\n/*+SCROLL+WRAPPER+&+TEXT+BOX+*/\n.scroll-wrapper+{+flex:1;+padding:5px;+overflow:hidden;+position:relative;+max-height:{lv=mxHght692};+}\n.text-box+{\n++box-sizing:+border-box;\n++font-size:{lv=fntSz632}px;\n++line-height:1.45;\n++white-space:pre-wrap;\n++word-break:break-word;\n++padding-top:2ch;\n++padding-bottom:2ch;\n++min-height:+1.5em;\n++/*+Default+padding+(opposite+of+touchpad)+*/\n++padding-left:+2ch;\n++padding-right:+2ch;\n++/*+Prevent+text+selection+*/\n++user-select:+none;\n++-webkit-user-select:+none;\n++-moz-user-select:+none;\n++-ms-user-select:+none;\n}\n/*+Handed-mode+specific+padding+*/\nbody.left-handed+.text-box+{\n++padding-left:+3ch;+/*+Pad+for+touchpad+on+left+*/\n++padding-right:+2ch;\n}\nbody.right-handed+.text-box+{\n++padding-right:+3ch;+/*+Pad+for+touchpad+on+right+*/\n++padding-left:+2ch;\n}\n\n/*+DELETE+TAB+*/\n.delete-tab+{\n++position:+absolute;\n++top:+10px;\n++width:+90px;\n++height:+70px;\n++cursor:+pointer;\n++z-index:+20;\n}\n.delete-tab::before+{\n++content:+'';\n++position:+absolute;\n++top:+0;\n++left:+0;\n++width:+90px;\n++height:+6px;\n++background-color:+var(--delete-line-grey);\n++border-radius:+3px;\n++transition:+background-color+0.18s;\n++animation-delay:+var(--pulse-delay,+0ms);\n++animation-fill-mode:+both;\n}\n.delete-tab.active::before+{\n++animation-name:+delete-line-pulse;\n++animation-duration:+1.2s;\n++animation-iteration-count:+infinite;\n++animation-timing-function:+ease-in-out;\n}\n@keyframes+delete-line-pulse+{\n++0%+{+background-color:+var(--delete-line-grey);+transform:+translateY(0);+opacity:1;+}\n++50%+{+background-color:+var(--accent-red);+transform:+translateY(-1px);+opacity:1;+}\n++100%{+background-color:+var(--delete-line-grey);+transform:+translateY(0);+opacity:1;+}\n}\n\n/*+SLIDER+(TRACKPAD)+*/\n.slider-container+{\n++width:+72px;\n++position:absolute;\n++top:10px;\n++height:calc(100%+-+20px);\n++border-radius:12px;\n++cursor:+grab;\n++touch-action:none;\n++transition:+box-shadow+0.18s,+opacity+0.2s,+transform+0.18s;\n++z-index:15;\n++display:none;\n++opacity:0.7;\n++border:none;\n++background:+linear-gradient(to+left,+rgba(100,100,100,0.55),+rgba(100,100,100,0.15));\n++animation:+trackpad-breathe+2.8s+infinite+ease-in-out;\n}\n.slider-container.dragging+{\n++box-shadow:0+0+22px+var(--trackpad-glow-strong);\n++opacity:0.85;\n++transform:scale(1.01);\n++animation:none;\n}\n@keyframes+trackpad-breathe+{\n++0%+{+box-shadow:0+6px+12px+rgba(160,160,160,0.06);+transform:scale(1);+opacity:0.72;+}\n++50%+{+box-shadow:0+10px+24px+rgba(160,160,160,0.10);+transform:scale(1.01);+opacity:0.82;+}\n++100%+{+box-shadow:0+6p;x+12px+rgba(160,160,160,0.06);+transform:scale(1);+opacity:0.72;+}\n}\nbody.left-handed+.slider-container+{+left:10px;+right:auto;+background:+linear-gradient(to+right,+rgba(100,100,100,0.55),+rgba(100,100,100,0.15));+}\nbody.right-handed+.slider-container+{+right:10px;+left:auto;+background:+linear-gradient(to+left,+rgba(100,100,100,0.55),+rgba(100,100,100,0.15));+}\nbody.right-handed+.delete-tab+{+left:+var(--delete-inset);+right:auto;+}\nbody.left-handed+.delete-tab+{+right:+var(--delete-inset);+left:auto;+}\n\n/*+PULSATE+WHEN+IN+DELETE+MODE+*/\n@keyframes+pulsate-intense+{\n++0%+{+box-shadow:0+0+5px+rgba(255,0,0,0.6),0+0+15px+rgba(255,0,0,0.8);+border-color:+rgba(255,0,0,0.6);+}\n++50%+{+box-shadow:0+0+15px+rgba(255,0,0,1),0+0+35px+rgba(255,0,0,1);+border-color:+rgba(255,0,0,1);+}\n++100%+{+box-shadow:0+0+5px+rgba(255,0,0,0.6),0+0+15px+rgba(255,0,0,0.8);+border-color:+rgba(255,0,0,0.6);+}\n}\nbody.delete-mode+#submitBtn,\nbody.delete-mode+#highlightAllBtn,\nbody.delete-mode+li.highlighted:not(.pinned)+{+animation:+pulsate-intense+1.2s+infinite+ease-in-out;+}\n\n/*+CONTROLS+(submit+&+highlight+all)+*/\n#submitBtn+{\n++position:+fixed;\n++top:+10px;\n++left:+50%;\n++transform:+translateX(-50%);\n++display:+none;\n++padding:+12px+18px;\n++font-size:+36px;\n++background:+rgba(255,0,0,0.35);\n++color:#fff;\n++border:2px+solid+rgba(255,0,0,0.6);\n++border-radius:15px;\n++cursor:pointer;\n++z-index:9999;\n++box-shadow:0+4px+8px+rgba(0,0,0,0.35);\n++transition:+box-shadow+0.18s,+transform+0.08s,+background+0.12s;\n}\n#highlightAllWrapper+{+position:+fixed;+top:+-50px;+left:+calc(50%+-+260px);+width:+120px;+height:+120px;+display:+none;+justify-content:+center;+align-items:+center;+z-index:9999;+padding:+40px;+box-sizing:+content-box;+}\n#highlightAllBtn+{+width:60px;+height:60px;+background:+rgba(0,0,0,0.55)+!important;+color:+var(--accent-red);+border:2px+solid+var(--accent-red);+border-radius:50%;+text-align:center;+line-height:60px;+font-size:30px;+cursor:pointer;+transition:+background+0.2s,+box-shadow+0.18s,+transform+0.1s;+}\n#highlightAllBtn.none-mode+{+background:+var(--accent-red-rgba-20)+!important;+}\n\n/*+EDIT+OVERLAY+*/\n#editorOverlay{+display:none;+position:fixed;+inset:0;+background:linear-gradient(180deg,+rgba(0,0,0,0.95),+rgba(0,0,0,0.98));+z-index:10000;+padding:14px;+box-sizing:border-box;+}\n#editorContainer{\n++height:100%;\n++max-width:900px;\n++margin:0+auto;\n++display:flex;\n++flex-direction:column;\n++gap:10px;\n++background:#111;\n++border-radius:10px;\n++padding:12px;\n++box-sizing:border-box;\n++border:2px+solid+grey;\n++overflow:hidden;\n}\n#editorTextarea{\n++width:100%;\n++background:#000;\n++color:#fff;\n++border:none;\n++border-radius:8px;\n++padding:10px;\n++padding-bottom:1000px;\n++resize:none;\n++font-family:inherit;\n++font-size:{lv=fntSz632}px;\n++flex:1+1+auto;\n++min-height:120px;\n++max-height:100%;\n++overflow:auto;\n++outline:none;\n}\n.editorButtons{+display:flex;+gap:10px;+justify-content:space-between;+padding-top:8px;+}\n.btn{\n++border:none;\n++background:transparent;\n++font-weight:700;\n++cursor:pointer;\n++color:#fff;\n++padding:20px+28px;\n++font-size:32px;\n++border-radius:12px;\n++transition:+transform+0.1s;\n}\n.btn:hover+{+transform:+scale(1.08);+}\n.btn-save{+color:limegreen;+}\n.btn-save:disabled+{+color:+grey;+cursor:not-allowed;+opacity:0.6;+}\n.btn-delete{+color:var(--accent-red);+}\n.btn-cancel{+color:grey;+}\nbutton:focus+{+outline:none;+box-shadow:none;+}\n\n/*+CHARACTER+INFO+*/\n#charInfo+{+color:grey;+font-size:14px;+margin-bottom:6px;+}\n#charError+{\n++display:none;\n++color:#fff;\n++background:+var(--accent-red-rgba-20);\n++border:1px+solid+var(--accent-red);\n++border-radius:6px;\n++padding:10px+14px;+/*+Increased+padding+*/\n++margin-top:6px;\n++font-size:18px;+/*+Increased+font+size+*/\n++text-align:+center;\n}\n</style>\n</head>\n<body>\n++<div+class=\"header-wrap\">\n++++<h2>🗒+Notes</h2>\n++++<button+id=\"addNewBtn\">++Add+New</button>\n++</div>\n\n++<ul+id=\"dynamicList\"></ul>\n\n++<button+id=\"submitBtn\">🗑️</button>\n++<div+id=\"highlightAllWrapper\"><button+id=\"highlightAllBtn\">All</button></div>\n\n++<textarea+id=\"handedVar\"+style=\"display:none\">{lv=orientScrn475}</textarea>\n++<textarea+id=\"rawData\"+style=\"display:none\">{lv=notCntntStrng482}</textarea>\n++<textarea+id=\"pindNotArryData\"+style=\"display:none\">{lv=pindNotArry537}</textarea>\n\n++<div+id=\"editorOverlay\">\n++++<div+id=\"editorContainer\">\n++++++<div+id=\"charInfo\">\n++++++++<span+id=\"charCounter\">0+/+5000</span>\n++++++++<div+id=\"charError\"></div>\n++++++</div>\n++++++<textarea+id=\"editorTextarea\"+placeholder=\"Edit+note...\"></textarea>\n++++++<div+class=\"editorButtons\">\n++++++++<button+class=\"btn+btn-delete\"+id=\"overlayDelete\">Delete</button>\n++++++++<button+class=\"btn+btn-save\"+id=\"overlaySave\">Save</button>\n++++++++<button+class=\"btn+btn-cancel\"+id=\"overlayCancel\">Cancel</button>\n++++++</div>\n++++</div>\n++</div>\n\n<script>\n/*+=====+STATE+&+ELEMENTS+=====+*/\nconst+triggerBase+=+\"http://localhost:8080/infiniteClipboardTrigger\";\nconst+raw+=+document.getElementById('rawData').value+||+'';\nconst+list+=+document.getElementById('dynamicList');\nconst+submitBtn+=+document.getElementById('submitBtn');\nconst+highlightAllWrapper+=+document.getElementById('highlightAllWrapper');\nconst+highlightAllBtn+=+document.getElementById('highlightAllBtn');\nconst+addNewBtn+=+document.getElementById('addNewBtn');\n\nconst+overlay+=+document.getElementById('editorOverlay');\nconst+ta+=+document.getElementById('editorTextarea');\nconst+overlaySave+=+document.getElementById('overlaySave');\nconst+overlayDelete+=+document.getElementById('overlayDelete');\nconst+overlayCancel+=+document.getElementById('overlayCancel');\nconst+charCounter+=+document.getElementById(\"charCounter\");\nconst+charError+=+document.getElementById(\"charError\");\nconst+MAX_CHARS+=+5000;\n\n/*+=====+INIT+STATE+=====+*/\nlet+segments+=+raw.split('『‰』').filter(seg+=>+seg.trim()+!==+'');\nlet+deleteMode+=+false;\nlet+editIndex+=+null;\n\nconst+rawVal+=+document.getElementById(\"handedVar\").value.trim();\nconst+leftHanded+=+rawVal.toLowerCase()+===+\"true\";\ndocument.body.classList.add(leftHanded+?+\"left-handed\"+:+\"right-handed\");\n\nconst+pinnedIndexes+=+[];\ntry+{\n++++const+pinnedData+=+document.getElementById('pindNotArryData').value;\n++++if+(pinnedData)+{\n++++++++pinnedIndexes.push(...pinnedData.split(',').map(item+=>+parseInt(item.trim(),+10)).filter(i+=>+!isNaN(i)));\n++++}\n}+catch(e)+{+console.error(\"Error+parsing+pinned+array:\",+e);+}\n\n\n/*+=====+CHAR+COUNTER+=====+*/\nta.addEventListener(\"input\",+()+=>+{\n++const+len+=+ta.value.length;\n++charCounter.textContent+=+`${len}+/+${MAX_CHARS}`;\n++if(len+>+MAX_CHARS){\n++++charCounter.style.color=\"var(--accent-red)\";\n++++charError.textContent=`❌+Entry+exceeds+5000+characters+by+${len-MAX_CHARS}+characters.`;\n++++charError.style.display=\"block\";\n++++overlaySave.disabled=true;\n++}+else+{\n++++charCounter.style.color=\"grey\";\n++++charError.style.display=\"none\";\n++++overlaySave.disabled=false;\n++}\n});\n\nfunction+resetCharUI(){+ta.dispatchEvent(new+Event(\"input\"));+}\n\n/*+=====+DOM+HELPERS+=====+*/\nfunction+rebuildSegmentsFromDOM(){\n++segments+=+Array.from(list.querySelectorAll('li')).map(li=>li.querySelector('.text-box')?.textContent||'');\n++list.querySelectorAll('li').forEach((li,i)=>li.dataset.index=i);\n}\n\nfunction+updateSubmitBtn(){\n++const+highlightedItems+=+list.querySelectorAll('li.highlighted');\n++deleteMode+=+highlightedItems.length>0;\n++submitBtn.style.display+=+deleteMode?'block':'none';\n++highlightAllWrapper.style.display+=+deleteMode?'flex':'none';\n++document.body.classList.toggle(\"delete-mode\",deleteMode);\n\n++if(!deleteMode)+list.querySelectorAll('li.highlighted').forEach(li=>li.classList.remove('highlighted'));\n\n++if(deleteMode){\n++++const+deletableItems+=+Array.from(list.querySelectorAll('li'));\n++++const+nonPinnedItems+=+Array.from(list.querySelectorAll('li:not(.pinned)'));\n++++const+allHighlighted+=+nonPinnedItems.length>0+&&+nonPinnedItems.every(li=>li.classList.contains('highlighted'));\n++++highlightAllBtn.innerText+=+allHighlighted?\"X\":\"All\";\n++++highlightAllBtn.classList.toggle('none-mode',allHighlighted);\n++}\n}\n\n/*+=====+CREATE+LIST+ITEM+=====+*/\nfunction+createListItem(idx,+content){\n++const+li+=+document.createElement('li');\n++li.dataset.index+=+idx;\n\n++const+wrapper+=+document.createElement('div');\n++wrapper.className='scroll-wrapper';\n\n++const+textDiv+=+document.createElement('div');\n++textDiv.className='text-box';\n++textDiv.textContent=content;\n++\n++wrapper.appendChild(textDiv);\n++li.appendChild(wrapper);\n\n++const+tab=document.createElement('div');\n++tab.className='delete-tab';\n++li.appendChild(tab);\n\n++let+pressTimer=null;\n++const+clearPress=()=>{+if(pressTimer){+clearTimeout(pressTimer);+pressTimer=null;+}+};\n\n++tab.addEventListener('touchstart',+e=>{\n++++e.stopPropagation();\n++++if(li.classList.contains('pinned'))+return;\n++++if(e.touches.length!==1)+return;\n++++clearPress();\n++++pressTimer=setTimeout(()=>{\n++++++if(deleteMode){\n++++++++deleteMode=false;\n++++++++list.querySelectorAll('li.highlighted').forEach(lih=>lih.classList.remove('highlighted'));\n++++++}+else+{\n++++++++deleteMode=true;\n++++++++li.classList.add('highlighted');\n++++++}\n++++++updateSubmitBtn();\n++++},500);\n++},{passive:true});\n++tab.addEventListener('touchend',+e=>{+e.stopPropagation();+clearPress();+},{passive:true});\n++tab.addEventListener('touchcancel',+e=>{+e.stopPropagation();+clearPress();+},{passive:true});\n++tab.addEventListener('click',+e=>e.stopPropagation());\n\n++const+slider=document.createElement('div');\n++slider.className='slider-container';\n++li.appendChild(slider);\n\n++//+**+HOLD-TO-PIN+FUNCTIONALITY+**\n++let+holdTimer+=+null;\n++const+holdDuration+=+500;\n++\n++textDiv.addEventListener('touchstart',+e+=>+{\n++++++e.stopPropagation();\n++++++if+(e.touches.length+!==+1)+return;\n++++++clearTimeout(holdTimer);\n\n++++++const+startY+=+e.touches[0].clientY;\n++++++const+initialScrollTop+=+list.scrollTop;\n++++++let+hasMoved+=+false;\n\n++++++const+checkMovement+=+(ev)+=>+{\n++++++++++const+currentY+=+ev.touches[0].clientY;\n++++++++++const+dy+=+Math.abs(currentY+-+startY);\n++++++++++if+(dy+>+15+||+Math.abs(list.scrollTop+-+initialScrollTop)+>+15)+{\n++++++++++++++hasMoved+=+true;\n++++++++++++++clearTimeout(holdTimer);\n++++++++++++++textDiv.removeEventListener('touchmove',+checkMovement);\n++++++++++}\n++++++};\n\n++++++textDiv.addEventListener('touchmove',+checkMovement,+{+passive:+true+});\n\n++++++holdTimer+=+setTimeout(()+=>+{\n++++++++++textDiv.removeEventListener('touchmove',+checkMovement);\n++++++++++if+(hasMoved)+return;\n\n++++++++++const+originalIndex+=+parseInt(li.dataset.index,+10);\n++++++++++fetch(`${triggerBase}?pindNotEntry837=${originalIndex}&t=${Date.now()}`).catch(()=>{});\n++++++},+holdDuration);\n++},+{+passive:+true+});\n\n++textDiv.addEventListener('touchend',+()+=>+{\n++++++clearTimeout(holdTimer);\n++});\n++\n++textDiv.addEventListener('touchcancel',+()+=>+{\n++++++clearTimeout(holdTimer);\n++});\n++\n++//+Check+if+the+item+is+already+pinned+and+add+the+icon+on+load\n++const+originalIndex+=+parseInt(li.dataset.index,+10);\n++if+(pinnedIndexes.includes(originalIndex))+{\n++++++li.classList.add('pinned');\n++++++const+pinnedIcon+=+document.createElement('div');\n++++++pinnedIcon.className+=+'pinned-icon';\n++++++pinnedIcon.innerHTML+=+'📌';\n++++++li.appendChild(pinnedIcon);\n++}\n\n++const+adjustHeight+=+()=>{\n++++const+contentHeight+=+textDiv.scrollHeight||0;\n++++const+maxHeight+=+Number(String(\"{lv=mxHght692}\").replace(/[^\\d]/g,''))+||+200;\n++++const+finalHeight+=+Math.min(contentHeight,maxHeight);\n++++wrapper.style.height=finalHeight+'px';\n++++wrapper.style.overflow+=+contentHeight>maxHeight?'hidden':'';\n++++slider.style.display+=+contentHeight>maxHeight?'block':'none';\n++++slider.style.height+=+wrapper.style.height;\n++};\n++adjustHeight();\n++const+ro=new+ResizeObserver(adjustHeight);\n++ro.observe(textDiv);\n++li._resizeObserver=ro;\n\n++//+REFINED+SCROLLING+ALGORITHM\n++let+dragging+=+false;\n++let+lastY+=+0;\n++let+lastTime+=+0;\n++let+velocity+=+0;\n++let+animationId+=+null;\n++const+friction+=+0.95;+\n++const+sensitivity+=+0.9;+\n\n++const+sliderMove+=+(e)+=>+{\n++++if+(!dragging)+return;\n++++e.preventDefault();\n++++const+clientY+=+e.touches+?+e.touches[0].clientY+:+e.clientY;\n++++const+now+=+performance.now();\n++++const+dy+=+lastY+-+clientY;\n++++const+dt+=+now+-+lastTime+||+1;\n++++\n++++const+currentVelocity+=+(dy+/+dt)+*+16.666;+\n++++velocity+=+(velocity+*+0.8)+++(currentVelocity+*+0.2);+\n++++\n++++wrapper.scrollTop++=+dy+*+sensitivity;\n++++lastY+=+clientY;\n++++lastTime+=+now;\n++};\n\n++const+sliderEnd+=+()+=>+{\n++++if+(!dragging)+return;\n++++dragging+=+false;\n++++slider.classList.remove('dragging');\n++++\n++++const+decay+=+()+=>+{\n++++++if+(Math.abs(velocity)+<+0.1)+{\n++++++++velocity+=+0;\n++++++++cancelAnimationFrame(animationId);\n++++++++return;\n++++++}\n++++++wrapper.scrollTop++=+velocity;\n++++++velocity+*=+friction;\n++++++animationId+=+requestAnimationFrame(decay);\n++++};\n++++animationId+=+requestAnimationFrame(decay);\n++};\n++\n++const+sliderStart+=+(e)+=>+{\n++++if+(e.touches+&&+e.touches.length+>+1)+return;\n++++e.preventDefault();\n++++dragging+=+true;\n++++slider.classList.add('dragging');\n++++lastY+=+e.touches+?+e.touches[0].clientY+:+e.clientY;\n++++lastTime+=+performance.now();\n++++velocity+=+0;\n++++cancelAnimationFrame(animationId);\n++};\n\n++slider.addEventListener('mousedown',+sliderStart);\n++slider.addEventListener('touchstart',+sliderStart,+{+passive:+false+});\n++window.addEventListener('mousemove',+sliderMove);\n++window.addEventListener('touchmove',+sliderMove,+{+passive:+false+});\n++window.addEventListener('mouseup',+sliderEnd);\n++window.addEventListener('touchend',+sliderEnd);\n++window.addEventListener('touchcancel',+sliderEnd);\n\n++li.addEventListener('click',+e=>{\n++++if(deleteMode){\n++++++if(li.classList.contains('pinned'))+return;\n++++++li.classList.toggle('highlighted');\n++++++updateSubmitBtn();\n++++}+else+{\n++++++editIndex=parseInt(li.dataset.index,10);\n++++++ta.value=textDiv.textContent;\n++++++overlay.style.display='block';\n++++++ta.scrollTop=ta.scrollHeight;\n++++++resetCharUI();\n++++}\n++});\n\n++return+li;\n}\n\n/*+=====+RENDER+INITIAL+=====+*/\nsegments.forEach((seg,i)=>list.appendChild(createListItem(i,seg)));\n\n/*+=====+BUTTONS+=====+*/\nsubmitBtn.addEventListener('click',+()=>{\n++const+toRemove+=+Array.from(list.querySelectorAll('li.highlighted'));\n++const+indexes+=+toRemove.map(li=>parseInt(li.dataset.index,10)).sort((a,b)=>b-a);\n++if(indexes.length===0)+return;\n\n++//+Delete+items+from+DOM\n++indexes.forEach(idx=>list.querySelector(`li[data-index=\"${idx}\"]`)?.remove());\n\n++//+Update+segments\n++segments+=+segments.filter((_,i)=>!indexes.includes(i));\n++rebuildSegmentsFromDOM();\n\n++//+Send+fetch+for+Macrodroid\n++fetch(`${triggerBase}?nwNotEntryIndx472=${encodeURIComponent(indexes.join(','))}&notEntryDlt624=true&t=${Date.now()}`).catch(()=>{});\n\n++deleteMode=false;\n++updateSubmitBtn();\n});\n\nhighlightAllBtn.addEventListener('click',+()=>{\n++const+items+=+Array.from(list.querySelectorAll('li:not(.pinned)'));\n++const+allHighlighted+=+items.length>0+&&+items.every(li=>li.classList.contains('highlighted'));\n++if(allHighlighted){+items.forEach(li=>li.classList.remove('highlighted'));+}\n++else+{+items.forEach(li=>li.classList.add('highlighted'));+}\n++updateSubmitBtn();\n});\n\naddNewBtn.addEventListener('click',+()=>{\n++editIndex+=+segments.length;\n++ta.value='';\n++overlay.style.display='block';\n++ta.scrollTop=ta.scrollHeight;\n++resetCharUI();\n});\n\n/*+=====+OVERLAY+BUTTONS+=====+*/\noverlaySave.addEventListener('click',+()=>{\n++//+Check+if+the+note+is+blank+and+display+an+inline+warning\n++if+(ta.value.trim()+===+'')+{\n++++charError.textContent+=+\"You+cannot+save+a+blank+note.\";\n++++charError.style.display+=+\"block\";\n++++setTimeout(()+=>+{\n++++++charError.style.display+=+\"none\";\n++++},+5000);+//+5+seconds\n++++return;+//+Stop+the+function+here\n++}\n++\n++if(editIndex===null+||+overlaySave.disabled)+return;\n++fetch(`${triggerBase}?nwNotEntryIndx472=${encodeURIComponent(editIndex)}&nwNotEntry924=${encodeURIComponent(ta.value)}&t=${Date.now()}`).catch(()=>{});\n\n++if(editIndex+<+segments.length){\n++++segments[editIndex]+=+ta.value;\n++++const+li+=+list.querySelector(`li[data-index=\"${editIndex}\"]`);\n++++if(li)+li.querySelector('.text-box').textContent+=+ta.value;\n++}+else+{\n++++segments.push(ta.value);\n++++const+li+=+createListItem(editIndex,+ta.value);\n++++list.appendChild(li);\n++}\n\n++editIndex=null;\n++overlay.style.display='none';\n});\n\noverlayDelete.addEventListener('click',+()=>{\n++if(editIndex===null)+return;\n\n++//+Delete+single+entry\n++fetch(`${triggerBase}?nwNotEntryIndx472=${encodeURIComponent(editIndex)}&notEntryDlt624=true&t=${Date.now()}`).catch(()=>{});\n++segments.splice(editIndex,1);\n++list.querySelector(`li[data-index=\"${editIndex}\"]`)?.remove();\n++rebuildSegmentsFromDOM();\n\n++editIndex=null;\n++overlay.style.display='none';\n});\n\noverlayCancel.addEventListener('click',+()=>{\n++editIndex=null;\n++overlay.style.display='none';\n});\n</script>\n</body>\n</html>\n",
