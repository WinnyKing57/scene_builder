   "m_script": "file=\"{lv=pth852}Infinite_Clipboard/Clipboard_Log.txt\"\nclip=\"{lv=clipborrd194}\"\nseparator=$'『‰』\\n'++#+newline+delimiter\n\n#+Ensure+the+file+exists\ntouch+\"$file\"\n\n#+Get+the+last+line+of+the+file,+handling+files+that+are+empty+or+don't+exist\nlast_line=$(tail+-n+1+\"$file\"+|+tr+-d+'\\n')\n\n#+Check+if+the+clipboard+content+is+different+from+the+last+line\nif+[[+\"$clip\"+!=+\"$last_line\"+]];+then\n++++#+Append+safely:+clip+++newline\n++++{\n++++++++printf+'%s'+\"$clip\"\n++++++++printf+'%s'+\"$separator\"\n++++}+>>+\"$file\"\nfi\n",
