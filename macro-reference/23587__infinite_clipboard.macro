  {
   "blockNextAction": true,
   "m_nonRoot": true,
   "m_script": "#!/bin/bash\n\n#+==========================================\n#+1.+MacroDroid+Variables+&+Files\n#+==========================================\ntarget_date_start=\"{lv=serchDatStrt827}\"\ntarget_date_end=\"{lv=serchDatEnd624}\"\nkeyword=\"{lv=serchKy630}\"\ninput_file=\"{lv=pth852}Infinite_Clipboard/Clipboard_Log.txt\"\ntemp_file=\"{lv=pth852}Infinite_Clipboard/temp_results.txt\"\n\nsearch1=\"\"\nsearch2=\"\"\n\n#+==========================================\n#+2.+Find+Start+Marker+(Closest+Future+Date)\n#+==========================================\nif+[+-n+\"$target_date_start\"+];+then\n++++formatted_start=$(echo+\"$target_date_start\"+|+sed+'s/\\(....\\)\\(..\\)\\(..\\)/\\1-\\2-\\3/')\n++++target_ts_start=$(date+-d+\"$formatted_start\"++%s)\n\n++++search1=$(awk+-v+target_ts=\"$target_ts_start\"+'\n++++BEGIN+{+min_diff+=+-1;+closest_line+=+\"\"+}\n++++{\n++++++++if+($0+~+/^[0-9]{8}DaT£≈/)+{\n++++++++++++current_date_raw+=+substr($0,+1,+8)\n++++++++++++formatted_current+=+substr(current_date_raw,+1,+4)+\"-\"+substr(current_date_raw,+5,+2)+\"-\"+substr(current_date_raw,+7,+2)\n++++++++++++\"date+-d+\\\"\"+formatted_current+\"\\\"++%s\"+|+getline+current_timestamp\n++++++++++++diff+=+current_timestamp+-+target_ts\n++++++++++++\n++++++++++++if+(diff+==+0)+{+closest_line+=+$0;+exit+}\n++++++++++++if+(diff+>+0)+{\n++++++++++++++++if+(min_diff+==+-1+||+diff+<+min_diff)+{+min_diff+=+diff;+closest_line+=+$0+}\n++++++++++++}\n++++++++}\n++++}\n++++END+{+print+closest_line+}'+\"$input_file\")\nfi\n\n#+==========================================\n#+3.+Find+End+Marker+(Closest+Past+Date)\n#+==========================================\nif+[+-n+\"$target_date_end\"+];+then\n++++formatted_end=$(echo+\"$target_date_end\"+|+sed+'s/\\(....\\)\\(..\\)\\(..\\)/\\1-\\2-\\3/')\n++++target_ts_end=$(date+-d+\"$formatted_end\"++%s)\n\n++++search2=$(awk+-v+target_ts=\"$target_ts_end\"+'\n++++BEGIN+{+min_diff+=+-1;+closest_line+=+\"\"+}\n++++{\n++++++++if+($0+~+/^[0-9]{8}DaT£≈/)+{\n++++++++++++current_date_raw+=+substr($0,+1,+8)\n++++++++++++formatted_current+=+substr(current_date_raw,+1,+4)+\"-\"+substr(current_date_raw,+5,+2)+\"-\"+substr(current_date_raw,+7,+2)\n++++++++++++\"date+-d+\\\"\"+formatted_current+\"\\\"++%s\"+|+getline+current_timestamp\n++++++++++++diff+=+current_timestamp+-+target_ts\n++++++++++++\n++++++++++++if+(diff+==+0)+{+closest_line+=+$0;+exit+}\n++++++++++++if+(diff+<+0)+{\n++++++++++++++++abs_diff+=+-diff\n++++++++++++++++if+(min_diff+==+-1+||+abs_diff+<+min_diff)+{+min_diff+=+abs_diff;+closest_line+=+$0+}\n++++++++++++}\n++++++++}\n++++}\n++++END+{+print+closest_line+}'+\"$input_file\")\nfi\n\n#+==========================================\n#+4.+Extract+Text+Between+Markers\n#+==========================================\nif+[+-n+\"$search1\"+]+&&+[+-n+\"$search2\"+];+then\n++++#+---+Two-marker+mode+(between)+---\n++++start_line=$(grep+-n+-m+1+\"$search1\"+\"$input_file\"+|+cut+-d:+-f1)\n++++end_line=$(grep+-n+-m+1+\"$search2\"+\"$input_file\"+|+cut+-d:+-f1)\n\n++++if+[+-n+\"$end_line\"+];+then\n++++++++next_marker_offset=$(tail+-n++$((end_line+++1))+\"$input_file\"+|+grep+-m+1+-n+\"DaT£≈\"+|+cut+-d:+-f1)\n++++++++if+[+-n+\"$next_marker_offset\"+];+then\n++++++++++++next_marker_line=$((end_line+++next_marker_offset))\n++++++++++++sed_end_line=$((next_marker_line+-+1))\n++++++++else\n++++++++++++sed_end_line=$(wc+-l+<+\"$input_file\")\n++++++++fi\n++++else\n++++++++sed_end_line=\"\"\n++++fi\n\n++++if+[+-n+\"$start_line\"+]+&&+[+-n+\"$sed_end_line\"+];+then\n++++++++sed+-n+\"$((start_line+++1)),${sed_end_line}p\"+\"$input_file\"+>+\"$temp_file\"\n++++else\n++++++++echo+\"No+content+found+between+markers\"+>+\"$temp_file\"\n++++fi\n\n++++if+[+!+-s+\"$temp_file\"+];+then\n++++++++echo+\"No+content+found+between+markers\"+>+\"$temp_file\"\n++++fi\n\nelif+[+-n+\"$search1\"+];+then\n++++#+---+Single-marker+mode+(append)+---\n++++#+Escaped+the+$p+to+correctly+target+the+end+of+the+file+in+sed\n++++sed+-n+\"/$search1/,\\$p\"+\"$input_file\"+|+sed+\"s/.*$search1//\"+>+\"$temp_file\"\nelse\n++++#+---+Neither+marker+set+---\n++++printf+\"\"+>+\"$temp_file\"\nfi\n\n#+==========================================\n#+5.+Filter+Results+by+Keyword\n#+==========================================\n#+Only+run+the+filter+if+there+is+extracted+content+and+a+keyword+exists\nif+[+-s+\"$temp_file\"+]+&&+[+-n+\"$keyword\"+]+&&+[+\"$(cat+\"$temp_file\")\"+!=+\"No+content+found+between+markers\"+];+then\n++++dir=$(dirname+\"$temp_file\")\n++++tmp=\"$(mktemp+\"$dir/temp_results.XXXXXX\")\"+||+{+echo+\"mktemp+failed\";+exit+1;+}\n++++trap+'rm+-f+\"$tmp\"'+EXIT\n\n++++awk+-v+kw=\"$keyword\"+'\n++++++BEGIN+{+kl+=+tolower(kw)+}\n++++++index(tolower($0),+kl)+{\n++++++++if+(seen)+{\n++++++++++printf+\"『‰』%s\",+$0\n++++++++}+else+{\n++++++++++printf+\"%s\",+$0\n++++++++++seen+=+1\n++++++++}\n++++++}\n++++'+\"$temp_file\"+>+\"$tmp\"+&&+mv+\"$tmp\"+\"$temp_file\"\n\n++++trap+-+EXIT\nfi\n",
