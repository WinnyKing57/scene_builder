           },
           {
            "type": "SceneWebView",
            "sceneWebViewConfig": {
             "closeSceneOnPress": false,
             "enableJavaScript": true,
             "enableSwipeNavigation": false,
             "height": 75,
             "padding": "0",
             "url": "<!DOCTYPE+html>\n<html+lang=\"en\">\n<head>\n<meta+charset=\"UTF-8\">\n<title>Dynamic+List+-+Trackpad+Overlay+Scroll</title>\n<style>\n/*+=========================\n+++ROOT+VARIABLES\n+++-------------------------\n+++Define+commonly+used+colors,+offsets,+and+glow+effects\n+++so+they+can+be+reused+and+easily+updated.\n+++=========================+*/\n:root{\n++--accent-red:+#ff0000;+/*+Primary+red+color+for+delete/highlight+mode+*/\n++--accent-red-rgba-20:+rgba(255,0,0,0.2);+/*+Transparent+red+for+subtle+backgrounds+*/\n++--accent-red-glow:+rgba(255,0,0,0.8);+/*+Strong+red+glow+for+pulsating+effect+*/\n++--trackpad-glow:+rgba(160,160,160,0.65);+/*+Trackpad+light+glow+effect+*/\n++--trackpad-glow-strong:+rgba(160,160,160,0.95);+/*+Stronger+glow+when+dragging+*/\n++--delete-line-grey:+grey;+/*+Default+color+of+the+delete+tab+line+*/\n++--delete-inset:+12px;+/*+Horizontal+padding+for+delete+tab+from+edge+*/\n}\n\n/*+=========================\n+++BODY+AND+TYPOGRAPHY\n+++-------------------------\n+++Main+page+layout+and+global+text+styling\n+++=========================+*/\nbody+{\n++background-color:+#000;+/*+Black+background+for+contrast+*/\n++margin:+0;\n++padding:+20px;+/*+Padding+around+content+*/\n++font-family:+Arial,+sans-serif;\n++color:+#fff;+/*+Default+text+color+*/\n++/*+NEW:+Disable+text+selection+on+the+entire+body+*/\n++-webkit-user-select:+none;\n++-moz-user-select:+none;\n++-ms-user-select:+none;\n++user-select:+none;\n}\n\n/*+Heading+style+*/\nh2+{\n++color:+#fff;\n++text-align:+center;\n++font-size:+48px;+/*+Large+font+for+title+*/\n++margin-bottom:+30px;\n}\n\n/*+Remove+default+list+styling+*/\nul+{\n++list-style:+none;\n++padding:+0;\n++margin:+0;\n}\n\n/*+=========================\n+++LIST+ITEM+STYLING\n+++-------------------------\n+++Each+clipboard+entry+is+a+list+item+<li>\n+++=========================+*/\nli+{\n++display:+flex;+/*+Flex+to+allow+scroll+wrapper+and+delete+tab+side+by+side+*/\n++align-items:+flex-start;+/*+Align+text+at+the+top+*/\n++background:+#111;+/*+Dark+background+for+each+item+*/\n++margin:+30px+0;+/*+Vertical+spacing+between+items+*/\n++padding:+10px;+/*+Inner+spacing+*/\n++width:+100%;\n++color:+#fff;\n++border:+2px+solid+#fff;+/*+Default+border+*/\n++border-radius:+20px;+/*+Rounded+corners+*/\n++box-sizing:+border-box;+/*+Include+padding/border+in+width+*/\n++position:+relative;+/*+Needed+for+delete+tab+positioning+*/\n++transition:+background+0.3s,+border-color+0.3s;+/*+Smooth+highlight+transition+*/\n}\n\n/*+Highlighted+items+during+delete+mode+*/\nli.highlighted+{\n++background:+#333;\n++border-color:+var(--accent-red);+/*+Red+border+to+indicate+selection+*/\n}\n\n/*+=========================\n+++SCROLL+WRAPPER\n+++-------------------------\n+++Container+for+the+text+box.+Handles+scrolling+inside+list+item.\n+++=========================+*/\n.scroll-wrapper+{\n++flex:+1;+/*+Take+remaining+space+*/\n++padding:+5px;\n++overflow:+hidden;+/*+Hide+scroll+until+slider+is+shown+*/\n++position:+relative;\n++max-height:+{lv=mxHght692};+/*+Placeholder+for+dynamic+max+height+*/\n}\n\n/*+=========================\n+++TEXT+BOX+STYLING\n+++-------------------------\n+++Container+for+clipboard+text\n+++=========================+*/\n.text-box+{\n++font-size:+{lv=fntSz632}px;+/*+Placeholder+for+dynamic+font+size+*/\n++white-space:+pre-wrap;+/*+Preserve+line+breaks+and+wrap+text+*/\n++word-break:+break-word;+/*+Break+long+words+*/\n++padding-top:+2ch;+/*+Vertical+padding+*/\n++padding-bottom:+2ch;\n++padding-left:+1ch;\n++padding-right:+1ch;\n}\n\n/*+=========================\n+++SUBMIT+BUTTON+(TRASH)\n+++-------------------------\n+++Button+that+triggers+deletion+of+selected+items\n+++=========================+*/\n#submitBtn+{\n++position:+fixed;+/*+Always+visible+*/\n++top:+10px;\n++left:+50%;\n++transform:+translateX(-50%);+/*+Center+horizontally+*/\n++display:+none;+/*+Hidden+until+delete+mode+is+active+*/\n++padding:+12px+18px;\n++font-size:+36px;\n++background:+rgba(255,0,0,0.35);+/*+Semi-transparent+red+*/\n++color:+#fff;\n++border:+2px+solid+rgba(255,0,0,0.6);\n++border-radius:+15px;\n++cursor:+pointer;\n++z-index:+9999;+/*+Above+all+list+items+*/\n++box-shadow:+0+4px+8px+rgba(0,0,0,0.35);\n++transition:+box-shadow+0.18s,+transform+0.08s,+background+0.12s;\n}\n\n/*+=========================\n+++HIGHLIGHT+ALL+BUTTON\n+++-------------------------\n+++Allows+user+to+toggle+selection+of+all+deletable+items\n+++=========================+*/\n#highlightAllWrapper+{\n++position:+fixed;\n++top:+-50px;+/*+Hidden+by+default,+shown+in+delete+mode+*/\n++left:+calc(50%+-+250px);\n++width:+120px;\n++height:+120px;\n++display:+none;\n++justify-content:+center;\n++align-items:+center;\n++z-index:+9999;\n++padding:+40px;\n++box-sizing:+content-box;\n}\n\n#highlightAllBtn+{\n++width:+60px;\n++height:+60px;\n++background:+rgba(0,0,0,0.55)+!important;+/*+Slightly+transparent+black+*/\n++color:+var(--accent-red);\n++border:+2px+solid+var(--accent-red);\n++border-radius:+50%;\n++text-align:+center;\n++line-height:+60px;+/*+Center+text+vertically+*/\n++font-size:+30px;\n++cursor:+pointer;\n++transition:+background+0.2s,+box-shadow+0.18s,+transform+0.1s;\n}\n#highlightAllBtn.none-mode+{\n++background:+var(--accent-red-rgba-20)+!important;+/*+Visual+feedback+when+all+items+selected+*/\n}\n\n/*+=========================\n+++DELETE+TAB\n+++-------------------------\n+++The+horizontal+bar+that+triggers+delete+mode+on+long-press\n+++=========================+*/\n.delete-tab+{\n++position:+absolute;\n++top:+10px;\n++width:+90px;\n++height:+70px;\n++cursor:+pointer;\n++z-index:+20;+/*+Above+text+but+below+buttons+*/\n}\n\n/*+Line+inside+delete+tab+*/\n.delete-tab::before+{\n++content:+'';\n++position:+absolute;\n++top:+0;\n++left:+0;\n++width:+90px;\n++height:+6px;\n++background-color:+var(--delete-line-grey);\n++border-radius:+3px;\n++transition:+background-color+0.2s;\n++animation-delay:+var(--pulse-delay,+0ms);+/*+Delay+for+staggered+pulse+*/\n++animation-fill-mode:+both;\n}\n\n/*+Pulse+animation+for+delete+tab+*/\n@keyframes+delete-line-pulse+{\n++0%+{+background-color:+var(--delete-line-grey);+transform:+translateY(0);+opacity:1;+}\n++50%+{+background-color:+var(--accent-red);+transform:+translateY(-1px);+opacity:1;+}\n++100%{+background-color:+var(--delete-line-grey);+transform:+translateY(0);+opacity:1;+}\n}\n\n/*+Activate+pulse+when+delete+mode+is+on+*/\n.delete-tab.active::before+{\n++animation-name:+delete-line-pulse;\n++animation-duration:1.2s;\n++animation-iteration-count:infinite;\n++animation-timing-function:ease-in-out;\n}\n\n/*+=========================\n+++SPLIT+LABEL\n+++-------------------------\n+++Indicates+non-deletable+or+boundary+items\n+++=========================+*/\n.split-label+{\n++position:+absolute;\n++top:+10px;+/*+Aligned+with+delete-tab+*/\n++font-size:+16px;\n++color:+yellow;\n++z-index:+10;\n++white-space:+nowrap;+/*+Prevents+text+from+wrapping+*/\n}\n\n/*+Position+split+label+based+on+handedness,+matching+delete-tab+*/\nbody.right-handed+.split-label+{+left:+var(--delete-inset);+right:auto;+}\nbody.left-handed+.split-label+{+right:+var(--delete-inset);+left:auto;+}\n\n/*+=========================\n+++TRACKPAD+SLIDER\n+++-------------------------\n+++Small+scrollbar-like+slider+for+internal+scroll+within+items\n+++=========================+*/\n@keyframes+trackpad-breathe+{\n++0%+{+box-shadow:0+6px+12px+rgba(160,160,160,0.06);+transform:scale(1);+opacity:0.72;+}\n++50%+{+box-shadow:0+10px+24px+rgba(160,160,160,0.10);+transform:scale(1.01);+opacity:0.82;+}\n++100%+{+box-shadow:0+6px+12px+rgba(160,160,160,0.06);+transform:scale(1);+opacity:0.72;+}\n}\n\n.slider-container+{\n++width:+72px;\n++position:absolute;\n++top:10px;\n++height:calc(100%+-+20px);\n++border-radius:12px;\n++cursor:+grab;\n++touch-action:none;+/*+Disable+default+touch+gestures+*/\n++transition:+box-shadow+0.18s,+opacity+0.2s,+transform+0.18s;\n++z-index:15;\n++display:none;+/*+Only+shown+if+scrollable+*/\n++opacity:0.7;\n++border:none;\n++animation:+trackpad-breathe+2.8s+infinite+ease-in-out;+/*+Gentle+breathing+effect+*/\n}\n.slider-container.dragging+{\n++box-shadow:0+0+22px+var(--trackpad-glow-strong);+/*+Strong+glow+when+dragging+*/\n++opacity:0.85;\n++transform:scale(1.01);\n++animation:none;+/*+Stop+breathing+animation+while+dragging+*/\n}\n\n/*+Position+slider+based+on+handedness+*/\nbody.left-handed+.slider-container+{\n++left:10px;\n++right:auto;\n++background:+linear-gradient(to+right,+rgba(100,100,100,0.55),+rgba(100,100,100,0.15));\n}\nbody.right-handed+.slider-container+{\n++right:10px;\n++left:auto;\n++background:+linear-gradient(to+left,+rgba(100,100,100,0.55),+rgba(100,100,100,0.15));\n}\n\n/*+Position+delete+tab+based+on+handedness+*/\nbody.right-handed+.delete-tab+{+left:+var(--delete-inset);+right:auto;+}\nbody.left-handed+.delete-tab+{+right:+var(--delete-inset);+left:auto;+}\n\n/*+=========================\n+++DELETE+MODE+PULSATE\n+++-------------------------\n+++Applies+red+glowing+animation+to+buttons+and+highlighted+items\n+++when+delete+mode+is+active.\n+++=========================+*/\n@keyframes+pulsate-intense+{\n++0%+{+box-shadow:+0+0+5px+rgba(255,0,0,0.6),+0+0+15px+rgba(255,0,0,0.8);+border-color:+rgba(255,0,0,0.6);+}\n++50%+{+box-shadow:+0+0+15px+rgba(255,0,0,1),+0+0+35px+rgba(255,0,0,1);+border-color:+rgba(255,0,0,1);+}\n++100%+{+box-shadow:+0+0+5px+rgba(255,0,0,0.6),+0+0+15px+rgba(255,0,0,0.8);+border-color:+rgba(255,0,0,0.6);+}\n}\nbody.delete-mode+#submitBtn,\nbody.delete-mode+#highlightAllBtn,\nbody.delete-mode+li.highlighted+{\n++animation:+pulsate-intense+1.2s+infinite+ease-in-out;\n++-webkit-animation:+pulsate-intense+1.2s+infinite+ease-in-out;\n}\n\n/*+=========================\n+++NEW+OVERLAY+STYLES\n+++-------------------------\n+++Styles+for+the+fullscreen+view+overlay.\n+++=========================+*/\n#fullscreenOverlay+{\n++position:+fixed;\n++top:+0;\n++left:+0;\n++width:+100%;\n++height:+100%;\n++background:+rgba(0,+0,+0,+0.9);+/*+Semi-transparent+black+background+*/\n++display:+flex;+/*+Flexbox+for+centering+*/\n++justify-content:+center;\n++align-items:+center;\n++z-index:+10000;+/*+High+z-index+to+be+on+top+*/\n++opacity:+0;\n++visibility:+hidden;\n++transition:+opacity+0.3s+ease-in-out,+visibility+0s+0.3s;\n++flex-direction:+column;+/*+Stack+children+vertically+*/\n}\n\n#fullscreenOverlay.visible+{\n++opacity:+1;\n++visibility:+visible;\n++transition:+opacity+0.3s+ease-in-out;\n}\n\n#overlayContent+{\n++background:+#1c1c1c;+/*+Darker+background+for+content+*/\n++color:+#fff;\n++padding:+30px;\n++border-radius:+20px;\n++max-width:+90%;\n++max-height:+90%;\n++overflow-y:+auto;+/*+Enable+scrolling+for+long+content+*/\n++box-shadow:+0+0+50px+rgba(255,+255,+255,+0.1);\n++/*+NEW:+Re-enable+text+selection+for+the+overlay+content+*/\n++-webkit-user-select:+text;\n++-moz-user-select:+text;\n++-ms-user-select:+text;\n++user-select:+text;\n}\n\n#overlayCloseBtn+{\n++position:+absolute;\n++top:+30px;\n++right:+30px;\n++background:+transparent;\n++border:+2px+solid+#fff;\n++color:+#fff;\n++font-size:+24px;\n++padding:+10px+15px;\n++border-radius:+50%;\n++cursor:+pointer;\n++z-index:+10001;+/*+Ensure+close+button+is+on+top+*/\n}\n\n</style>\n</head>\n<body>\n\n<h2>📋+Clipboard</h2>\n\n<ul+id=\"dynamicList\"></ul>\n\n<button+id=\"submitBtn\">🗑️</button>\n\n<div+id=\"highlightAllWrapper\">\n++<button+id=\"highlightAllBtn\">All</button>\n</div>\n\n<div+id=\"fullscreenOverlay\">\n++<button+id=\"overlayCloseBtn\">X</button>\n++<div+id=\"overlayContent\"></div>\n</div>\n\n<textarea+id=\"handedVar\"+style=\"display:none\">{lv=orientScrn475}</textarea>\n<textarea+id=\"rawData\"+style=\"display:none\">{lv=cntntStrng742}</textarea>\n\n<script>\n/*+=========================\n+++JavaScript+Logic\n+++=========================+*/\n\n/*+Server+endpoint+for+triggering+actions+*/\nconst+triggerBase+=+\"http://localhost:8080/infiniteClipboardTrigger\";\n\n/*+Read+raw+clipboard+data+*/\nconst+raw+=+document.getElementById('rawData').value+||+'';\nconst+list+=+document.getElementById('dynamicList');\nconst+submitBtn+=+document.getElementById('submitBtn');\nconst+highlightAllWrapper+=+document.getElementById('highlightAllWrapper');\nconst+highlightAllBtn+=+document.getElementById('highlightAllBtn');\n\nlet+deleteMode+=+false;\nlet+isHoldingDeleteTab+=+false;+//+New+flag+to+track+if+the+delete+tab+is+being+held\n\n/*+Determine+handedness+from+hidden+variable+*/\nconst+rawVal+=+document.getElementById(\"handedVar\").value.trim();\nconst+leftHanded+=+rawVal.toLowerCase()+===+\"true\";\ndocument.body.classList.add(leftHanded+?+\"left-handed\"+:+\"right-handed\");\n\n/*+NEW:+Get+overlay+elements+*/\nconst+fullscreenOverlay+=+document.getElementById('fullscreenOverlay');\nconst+overlayContent+=+document.getElementById('overlayContent');\nconst+overlayCloseBtn+=+document.getElementById('overlayCloseBtn');\n\n/*+NEW:+Function+to+show+overlay+with+content+*/\nfunction+showOverlay(content)+{\n++overlayContent.innerHTML+=+content;\n++fullscreenOverlay.classList.add('visible');\n++document.body.style.overflow+=+'hidden';+/*+Prevents+scrolling+behind+the+overlay+*/\n}\n\n/*+NEW:+Function+to+hide+overlay+*/\nfunction+hideOverlay()+{\n++fullscreenOverlay.classList.remove('visible');\n++document.body.style.overflow+=+'auto';\n}\n\n/*+NEW:+Close+button+event+listener+*/\noverlayCloseBtn.addEventListener('click',+hideOverlay);\n\n/*+=========================\n+++UPDATE+DELETE+MODE\n+++-------------------------\n+++Shows/hides+buttons,+toggles+animations+and+delete+tabs\n+++=========================+*/\nfunction+updateSubmitBtn()+{\n++const+highlightedItems+=+list.querySelectorAll('li.highlighted');\n++if(highlightedItems.length+===+0+&&+deleteMode)+deleteMode+=+false;\n\n++/*+Show+or+hide+buttons+based+on+delete+mode+*/\n++submitBtn.style.display+=+deleteMode+?+'block'+:+'none';\n++highlightAllWrapper.style.display+=+deleteMode+?+'flex'+:+'none';\n++document.body.classList.toggle(\"delete-mode\",+deleteMode);\n\n++/*+Animate+all+delete+tabs+*/\n++const+tabs+=+Array.from(document.querySelectorAll('.delete-tab'));\n++tabs.forEach((tab,+i)+=>+{\n++++++if+(deleteMode)+{\n++++++++++tab.classList.add('active');\n++++++++++const+delayMs+=+i+*+90;+/*+staggered+pulse+animation+*/\n++++++++++tab.style.setProperty('--pulse-delay',+`${delayMs}ms`);\n++++++}+else+{\n++++++++++tab.classList.remove('active');\n++++++++++tab.style.removeProperty('--pulse-delay');\n++++++}\n++});\n\n++/*+Remove+highlight+if+delete+mode+is+off+*/\n++if(!deleteMode)+list.querySelectorAll('li.highlighted').forEach(li+=>+li.classList.remove('highlighted'));\n\n++/*+Update+highlight+all+button+text+*/\n++if(deleteMode){\n++++++const+deletableItems+=+Array.from(list.querySelectorAll('li')).filter(li+=>+{\n++++++++++const+idx+=+parseInt(li.dataset.index);\n++++++++++return+idx+>+0+&&+idx+<+raw.split('『‰』').length+-+1;+/*+Only+middle+items+deletable+*/\n++++++});\n++++++const+allHighlighted+=+deletableItems.length+>+0+&&+deletableItems.every(li+=>+li.classList.contains('highlighted'));\n++++++highlightAllBtn.innerText+=+allHighlighted+?+\"X\"+:+\"All\";\n++++++highlightAllBtn.classList.toggle('none-mode',+allHighlighted);\n++}\n}\n\n/*+=========================\n+++SUBMIT+BUTTON+CLICK\n+++-------------------------\n+++Deletes+highlighted+items+and+sends+request+to+server\n+++=========================+*/\nsubmitBtn.onclick+=+()+=>+{\n++const+highlightedItems+=+Array.from(list.querySelectorAll('li.highlighted'));\n++if(highlightedItems.length+===+0)+return;\n\n++const+allIndexes+=+highlightedItems.map(li+=>+li.dataset.index).join('『‰』');\n\n++/*+Send+deletion+request+*/\n++fetch(`${triggerBase}?slctedItm147=${encodeURIComponent(allIndexes)}&dlteSlectd738=true&t=${Date.now()}`).catch(()=>{});\n\n++/*+Disconnect+observers+and+remove+from+DOM+*/\n++highlightedItems.forEach(li+=>+li._resizeObserver?.disconnect());\n++highlightedItems.forEach(li+=>+li.remove());\n\n++updateSubmitBtn();\n};\n\n/*+=========================\n+++HIGHLIGHT+ALL+BUTTON+CLICK\n+++-------------------------\n+++Toggles+all+deletable+items\n+++=========================+*/\nhighlightAllBtn.onclick+=+()+=>+{\n++if(!deleteMode)+return;\n\n++const+deletableItems+=+Array.from(list.querySelectorAll('li')).filter(li+=>+{\n++++++const+idx+=+parseInt(li.dataset.index);\n++++++return+idx+>+0+&&+idx+<+raw.split('『‰』').length+-+1;\n++});\n++const+allHighlighted+=+deletableItems.every(li+=>+li.classList.contains('highlighted'));\n++deletableItems.forEach(li+=>+li.classList.toggle('highlighted',+!allHighlighted));\n++highlightAllBtn.innerText+=+allHighlighted+?+\"All\"+:+\"None\";\n++highlightAllBtn.classList.toggle('none-mode',+!allHighlighted);\n++updateSubmitBtn();\n};\n\n/*+=========================\n+++BUILD+LIST+ITEMS\n+++-------------------------\n+++Loops+through+raw+data+segments+to+create+list+items+dynamically\n+++=========================+*/\nconst+segments+=+raw.split('『‰』');+//+split+raw+data\nsegments.forEach((segment,+idx)+=>+{\n++const+item+=+segment.trim();\n++if(item+===+'')+return;+//+skip+empty+segments\n\n++const+li+=+document.createElement('li');\n++li.dataset.index+=+idx;+//+store+index+for+reference\n\n++/*+Scroll+wrapper+for+internal+scrollable+text+*/\n++const+wrapper+=+document.createElement('div');\n++wrapper.className+=+'scroll-wrapper';\n\n++/*+Text+box+inside+wrapper+*/\n++const+textDiv+=+document.createElement('div');\n++textDiv.className+=+'text-box';\n++textDiv.innerHTML+=+item.replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\")\n++++++++++++++++++++++++.replace(/\"/g,\"&quot;\").replace(/'/g,\"&#039;\");\n\n++/*+Adjust+padding+based+on+handedness+*/\n++if(leftHanded){\n++++++textDiv.style.paddingLeft+=+'3ch';\n++++++textDiv.style.paddingRight+=+'1ch';\n++}+else+{\n++++++textDiv.style.paddingRight+=+'3ch';\n++++++textDiv.style.paddingLeft+=+'1ch';\n++}\n++textDiv.style.paddingTop+=+'2ch';\n++textDiv.style.paddingBottom+=+'2ch';\n\n++wrapper.appendChild(textDiv);\n++li.appendChild(wrapper);\n\n++/*+Determine+if+delete+tab+is+needed+*/\n++const+hasLeading+=+idx+>+0;\n++const+hasTrailing+=+idx+<+segments.length+-+1;\n\n++if(hasLeading+&&+hasTrailing){\n++++++const+tab+=+document.createElement('div');\n++++++tab.className='delete-tab';\n++++++li.appendChild(tab);\n\n++++++/*+LONG+PRESS+HANDLER+TO+TOGGLE+DELETE+MODE+*/\n++++++let+pressTimer=null;\n++++++const+clearPress=()=>{if(pressTimer){clearTimeout(pressTimer);pressTimer=null;}};\n\n++++++tab.addEventListener('touchstart',e=>{\n++++++++++isHoldingDeleteTab+=+true;+//+Set+the+new+flag\n++++++++++e.stopPropagation();\n++++++++++if(e.touches.length!==1)+return;\n++++++++++clearPress();\n++++++++++pressTimer=setTimeout(()=>{\n++++++++++++++deleteMode=!deleteMode;\n++++++++++++++if(deleteMode)+li.classList.add('highlighted');\n++++++++++++++updateSubmitBtn();\n++++++++++++++isHoldingDeleteTab+=+false;+//+Reset+on+timeout\n++++++++++},500);+//+500ms+long+press\n++++++},{passive:false});\n\n++++++tab.addEventListener('touchend',e=>{\n++++++++isHoldingDeleteTab+=+false;+//+Reset+the+flag\n++++++++e.stopPropagation();\n++++++++clearPress();\n++++++},{passive:true});\n\n++++++tab.addEventListener('touchcancel',e=>{\n++++++++isHoldingDeleteTab+=+false;+//+Reset+the+flag\n++++++++e.stopPropagation();\n++++++++clearPress();\n++++++},{passive:true});\n\n++++++tab.addEventListener('click',+e+=>+e.stopPropagation());+//+Prevent+click+bubbling\n\n++}+else+{\n++++++/*+For+non-deletable+items,+show+a+split+label+*/\n++++++const+label=document.createElement('div');\n++++++label.className='split-label';\n++++++label.innerText='Entry+split+between+two+pages+(unable+to+delete)';\n++++++li.appendChild(label);\n++}\n\n++/*+=========================\n+++++REFINED:+Long-press+and+Tap+event+handling\n+++++=========================+*/\n++let+longPressTimer;\n++let+isTapped+=+false;\n++const+longPressDuration+=+500;\n++const+swipeThreshold+=+20;\n++let+startX,+startY;\n\n++li.addEventListener('touchstart',+(e)+=>+{\n++++//+Check+the+new+flag+here\n++++if+(e.target.closest('.delete-tab')+||+e.target.closest('.slider-container'))+{\n++++++++return;\n++++}\n\n++++startX+=+e.touches[0].clientX;\n++++startY+=+e.touches[0].clientY;\n++++isTapped+=+true;\n\n++++clearTimeout(longPressTimer);\n++++longPressTimer+=+setTimeout(()+=>+{\n++++++++if+(isTapped)+{+//+Check+if+it's+still+a+tap\n++++++++++++showOverlay(textDiv.outerHTML);\n++++++++}\n++++++++isTapped+=+false;+//+Action+is+no+longer+a+tap,+so+reset+the+flag\n++++},+longPressDuration);\n++},+{passive:+true});\n\n++li.addEventListener('touchmove',+(e)+=>+{\n++++if+(isTapped)+{\n++++++const+dx+=+startX+-+e.touches[0].clientX;\n++++++const+dy+=+startY+-+e.touches[0].clientY;\n++++++const+distance+=+Math.sqrt(dx+*+dx+++dy+*+dy);\n\n++++++if+(distance+>+swipeThreshold)+{\n++++++++clearTimeout(longPressTimer);\n++++++++isTapped+=+false;+//+It's+a+swipe,+not+a+tap\n++++++}\n++++}\n++},+{passive:+true});\n\n++li.addEventListener('touchend',+(e)+=>+{\n++++clearTimeout(longPressTimer);+//+Clear+the+timer+on+touch+end\n\n++++if+(isTapped)+{\n++++++++isTapped+=+false;+//+Reset+immediately+to+prevent+double+triggers\n++++++++if+(deleteMode+&&+hasLeading+&&+hasTrailing+&&+!isHoldingDeleteTab)+{\n++++++++++++li.classList.toggle('highlighted');\n++++++++++++updateSubmitBtn();\n++++++++}+else+if+(!deleteMode+&&+!isHoldingDeleteTab)+{\n++++++++++++fetch(`${triggerBase}?slctedItm147=${encodeURIComponent(idx)}&t=${Date.now()}`).catch(()=>{});\n++++++++}\n++++}\n++},+{passive:+true});\n\n++li.addEventListener('touchcancel',+(e)+=>+{\n++++clearTimeout(longPressTimer);\n++++isTapped+=+false;\n++},+{passive:+true});\n\n++//+Also+add+a+pointerdown+handler+for+desktop+compatibility\n++li.addEventListener('pointerdown',+(e)+=>+{\n++++//+Check+the+new+flag+here\n++++if+(e.button+!==+0+||+e.target.closest('.delete-tab')+||+e.target.closest('.slider-container'))+{\n++++++return;\n++++}\n++++startX+=+e.clientX;\n++++startY+=+e.clientY;\n++++isTapped+=+true;\n\n++++clearTimeout(longPressTimer);\n++++longPressTimer+=+setTimeout(()+=>+{\n++++++++if+(isTapped)+{+//+Check+if+it's+still+a+tap\n++++++++++++showOverlay(textDiv.outerHTML);\n++++++++}\n++++++++isTapped+=+false;\n++++},+longPressDuration);\n++++li.setPointerCapture?.(e.pointerId);\n++});\n\n++li.addEventListener('pointermove',+(e)+=>+{\n++++if+(isTapped)+{\n++++++const+dx+=+startX+-+e.clientX;\n++++++const+dy+=+startY+-+e.clientY;\n++++++const+distance+=+Math.sqrt(dx+*+dx+++dy+*+dy);\n++++++if+(distance+>+swipeThreshold)+{\n++++++++clearTimeout(longPressTimer);\n++++++++isTapped+=+false;\n++++++}\n++++}\n++});\n\n++li.addEventListener('pointerup',+(e)+=>+{\n++++clearTimeout(longPressTimer);+//+Clear+the+timer+on+pointer+up\n\n++++if+(isTapped)+{\n++++++++isTapped+=+false;+//+Reset+immediately\n++++++++if+(deleteMode+&&+hasLeading+&&+hasTrailing+&&+!isHoldingDeleteTab)+{\n++++++++++++li.classList.toggle('highlighted');\n++++++++++++updateSubmitBtn();\n++++++++}+else+if+(!deleteMode+&&+!isHoldingDeleteTab)+{\n++++++++++++fetch(`${triggerBase}?slctedItm147=${encodeURIComponent(idx)}&t=${Date.now()}`).catch(()=>{});\n++++++++}\n++++}\n++++li.releasePointerCapture?.(e.pointerId);\n++});\n\n++li.addEventListener('pointercancel',+(e)+=>+{\n++++clearTimeout(longPressTimer);\n++++isTapped+=+false;\n++++li.releasePointerCapture?.(e.pointerId);\n++});\n\n++//+Keep+the+`contextmenu`+handler+for+right-click+on+desktop\n++textDiv.addEventListener('contextmenu',+(e)+=>+{\n++++++e.preventDefault();\n++++++if+(!isHoldingDeleteTab)+{\n++++++++++showOverlay(textDiv.outerHTML);\n++++++}\n++});\n\n++/*+=========================\n+++++TRACKPAD+SLIDER+FOR+SCROLLING\n+++++=========================+*/\n++const+sliderContainer=document.createElement('div');\n++sliderContainer.className='slider-container';\n++li.appendChild(sliderContainer);\n\n++sliderContainer.addEventListener('click',+e+=>+e.stopPropagation());\n\n++/*+=========================\n+++++RESIZE+OBSERVER+TO+ADJUST+HEIGHT\n+++++=========================+*/\n++const+adjustHeights=()=>{\n++++++const+style=window.getComputedStyle(textDiv);\n++++++const+paddingTop=parseFloat(style.paddingTop)||0;\n++++++const+paddingBottom=parseFloat(style.paddingBottom)||0;\n++++++const+contentHeight=textDiv.scrollHeight-paddingTop-paddingBottom;\n++++++const+maxHeight={lv=mxHght692};\n++++++const+finalHeight=Math.min(contentHeight+paddingTop+paddingBottom,maxHeight);\n++++++wrapper.style.height=finalHeight+'px';\n++++++wrapper.style.overflow='hidden';\n++++++if(contentHeight+paddingTop+paddingBottom>maxHeight){\n++++++++++sliderContainer.style.display='block';\n++++++++++sliderContainer.style.height=finalHeight+'px';\n++++++}+else+sliderContainer.style.display='none';\n++};\n++adjustHeights();\n++const+ro=new+ResizeObserver(adjustHeights);\n++ro.observe(textDiv);\n++li._resizeObserver=ro;\n\n++/*+=========================\n+++++POINTER+DRAGGING+FOR+TRACKPAD+SCROLL\n+++++=========================+*/\n++let+dragging=false,lastY=0,lastTime=0,velocityPxPerSec=0,lastPositions=[];\n++sliderContainer.addEventListener('pointerdown',e=>{\n++++++dragging=true;lastY=e.clientY;lastTime=performance.now();lastPositions=[];velocityPxPerSec=0;\n++++++sliderContainer.classList.add('dragging');\n++++++sliderContainer.setPointerCapture?.(e.pointerId);\n++++++if(wrapper._momentumAnim){cancelAnimationFrame(wrapper._momentumAnim);wrapper._momentumAnim=null;}\n++});\n\n++const+onMove=ev=>{\n++++++if(!dragging)+return;\n++++++const+now=performance.now();\n++++++const+dt=now-lastTime;\n++++++const+dy=ev.clientY-lastY;\n++++++wrapper.scrollTop-=dy;\n++++++if(dt>0){+lastPositions.push({dy,dt});+if(lastPositions.length>6)+lastPositions.shift();\n++++++++++let+sum=0,div=0;+for(const+s+of+lastPositions){sum+=(s.dy/s.dt);div+=1;}\n++++++++++velocityPxPerSec=(sum/div)*1000;\n++++++}\n++++++lastY=ev.clientY;+lastTime=now;\n++};\n\n++const+onUp=ev=>{\n++++++if(!dragging)+return;\n++++++dragging=false;\n++++++sliderContainer.classList.remove('dragging');\n++++++try{sliderContainer.releasePointerCapture?.(ev.pointerId);}catch(e){}\n++++++let+velocity=-velocityPxPerSec;\n++++++const+density=window.devicePixelRatio||1;\n++++++const+MIN_FLING_PX_PER_SEC=50*density;\n++++++const+MAX_FLING_PX_PER_SEC=8000*density;\n++++++const+SCROLL_FRICTION=0.015;\n++++++const+GRAVITY_EARTH=9.80665,INCHES_PER_METER=39.37;\n++++++const+PHYSICAL_COEFF=GRAVITY_EARTH*INCHES_PER_METER*density*160*0.84;\n++++++const+DECELERATION_RATE=Math.log(0.78)/Math.log(0.9);\n++++++const+getDecel=l=>Math.log(0.35*Math.abs(l)/(SCROLL_FRICTION*PHYSICAL_COEFF));\n++++++const+getDistance=v=>{\n++++++++++const+l=getDecel(v);\n++++++++++return+SCROLL_FRICTION*PHYSICAL_COEFF*Math.exp(DECELERATION_RATE/(DECELERATION_RATE-1)*l);\n++++++};\n++++++const+getDuration=v=>{\n++++++++++const+l=getDecel(v);\n++++++++++return+Math.round(1000*Math.exp(l/(DECELERATION_RATE-1)));\n++++++};\n++++++if(Math.abs(velocity)<MIN_FLING_PX_PER_SEC)+return;\n++++++velocity=Math.max(-MAX_FLING_PX_PER_SEC,Math.min(MAX_FLING_PX_PER_SEC,velocity));\n++++++const+distance=getDistance(velocity)*Math.sign(velocity);\n++++++const+duration=getDuration(velocity);\n++++++if(!duration||!distance)+return;\n++++++const+start=wrapper.scrollTop;\n++++++const+maxScroll=wrapper.scrollHeight-wrapper.clientHeight;\n++++++let+target=Math.round(start+distance);\n++++++if(target<0)+target=0;\n++++++if(target>maxScroll)+target=maxScroll;\n++++++const+startTime=performance.now();\n++++++function+easeOut(t){return+1-Math.pow(1-t,3);}\n++++++function+step(){\n++++++++++const+now=performance.now();\n++++++++++const+t=Math.min((now-startTime)/duration,1);\n++++++++++wrapper.scrollTop=start+(target-start)*easeOut(t);\n++++++++++if(t<1)+wrapper._momentumAnim=requestAnimationFrame(step);\n++++++}\n++++++step();\n++};\n\n++sliderContainer.addEventListener('pointermove',onMove);\n++sliderContainer.addEventListener('pointerup',onUp);\n++sliderContainer.addEventListener('pointercancel',onUp);\n\n++/*+Append+final+li+to+list+*/\n++list.appendChild(li);\n});\n</script>\n</body>\n</html>\n",
