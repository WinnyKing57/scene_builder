  {
   "blockNextAction": true,
   "m_nonRoot": true,
   "m_script": "file=\"{lv=pth852}Infinite_Clipboard/Clipboard_Log.txt\"\nselected='{iterator_value}『‰』'\ntmpfile=\"${file}.tmp\"\n\n#+PASS+1:+Find+the+exact+line+number+of+the+LAST+matching+line\nlast_line_num=$(awk+-v+sel=\"$selected\"+'\n{\n++#+Copy+the+line+and+trim+whitespace\n++trimmed+=+$0\n++sub(/^[[:space:]]+/,+\"\",+trimmed)\n++sub(/[[:space:]]+$/,+\"\",+trimmed)\n++\n++#+If+it+matches,+update+our+tracker+with+the+current+line+number+(NR)\n++if+(trimmed+==+sel)+{\n++++last_match+=+NR\n++}\n}\n#+At+the+end+of+the+file,+output+the+highest+line+number+we+found+(or+0)\nEND+{+print+last_match+++0+}\n'+\"$file\")\n\n#+PASS+2:+If+we+actually+found+a+match,+write+a+new+file+skipping+ONLY+that+line\nif+[+\"$last_line_num\"+-gt+0+];+then\n++awk+-v+skip=\"$last_line_num\"+'NR+!=+skip'+\"$file\"+>+\"$tmpfile\"\n++\n++#+Replace+the+original+file\n++if+[+-e+\"$tmpfile\"+];+then\n++++mv+-f+\"$tmpfile\"+\"$file\"\n++fi\nfi\n",
   "timeoutSeconds": 30,
   "useHelper": false,
   "useShizuku": false,
   "disableLogging": false,
   "m_SIGUID": -7451828458209349693,
   "m_classType": "ShellScriptAction",
   "m_comment": "delete+entry+new",
   "m_constraintList": [],
