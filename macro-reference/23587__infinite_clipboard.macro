  {
   "blockNextAction": true,
   "m_nonRoot": true,
   "m_script": "#!/bin/bash\n\n#+---+MacroDroid-friendly+variables+---\nfile='{lv=pth852}Infinite_Clipboard/Clipboard_Log.txt'\nbytes_per_page={lv=chrSze835}\npage_index={lv=substrngIndx428}\n\n#+---+Get+the+total+number+of+bytes+in+the+file+---\ntotal_bytes=$(wc+-c+<+\"$file\")\n\n#+---+Calculate+the+starting+byte+position+for+the+requested+page+---\nstart_byte=$((+total_bytes+-+(page_index+*+bytes_per_page)+))\n\n#+---+Handle+the+case+for+the+very+first+page+---\nif+((+start_byte+<+0+));+then\n++++count_bytes=$((+bytes_per_page+++start_byte+))\n++++start_byte=0\nelse\n++++count_bytes=$bytes_per_page\nfi\n\n#+---+Extract+the+page+and+process+it+---\n#+This+command+block+will+first+replace+the+delimiter+with+a+newline,\n#+then+reverse+the+order+of+the+lines,+and+finally+add+the+delimiter\n#+to+the+end+of+each+line+while+removing+any+blank+lines.\ndd+if=\"$file\"+bs=1+skip=$start_byte+count=$count_bytes+2>/dev/null+|+\\\nsed+'s/『‰』/\\n/g'+|+tac+|+sed+'/^$/d'+|+sed+'s/$/『‰』/'\n",
