             "maxLines": "3",
             "maxLinesEnabled": false,
             "text": "<p+style=\"font-size:+{lv=fntSz632}px;\"><u>🗒+Notes+Tab+Information:</u></p>\n",
             "textAlignment": "Center",
             "textColor": -1,
             "textSize": "16",
             "visibilityVariable": {
