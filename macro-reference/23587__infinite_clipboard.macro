           {
            "type": "SceneWebView",
            "sceneWebViewConfig": {
             "closeSceneOnPress": false,
             "enableJavaScript": true,
             "enableSwipeNavigation": false,
             "height": 60,
             "padding": "0",
             "url": "<!DOCTYPE+html>\n<html+lang=\"en\">\n<head>\n<meta+charset=\"UTF-8\">\n<title>Dynamic+List+-+Trackpad+Overlay+Scroll</title>\n<style>\n/*+=========================\n+++NEW:+Text+Selection\n+++-------------------------\n+++Disable+text+selection+on+the+body,+enable+on+the+overlay\n+++=========================+*/\nbody+{\n++-webkit-user-select:+none;\n++-moz-user-select:+none;\n++-ms-user-select:+none;\n++user-select:+none;\n}\n#overlayContent+{\n++-webkit-user-select:+text;\n++-moz-user-select:+text;\n++-ms-user-select:+text;\n++user-select:+text;\n++/*+NEW:+Link+the+font+size+to+the+same+variable+*/\n++font-size:+{lv=fntSz632}px;\n}\n\n/*+=========================\n+++Existing+Styles+(Condensed)\n+++-------------------------\n+++These+styles+have+not+been+changed.\n+++=========================+*/\n:root{\n++--accent-red:+#ff0000;\n++--accent-red-rgba-20:+rgba(255,0,0,0.2);\n++--accent-red-glow:+rgba(255,0,0,0.8);\n++--trackpad-glow:+rgba(160,160,160,0.65);\n++--trackpad-glow-strong:+rgba(160,160,160,0.95);\n++--delete-line-grey:+grey;\n++--delete-inset:+12px;\n++--slider-width:+72px;\n}\nbody+{+background-color:+#000;+margin:+0;+padding:+20px;+font-family:+Arial,+sans-serif;+color:+#fff;+}\nh2+{+color:+#fff;+text-align:+center;+font-size:+48px;+margin:+0;+}\n.header-container+{+display:+flex;+justify-content:+center;+align-items:+center;+margin-bottom:+10px;+position:+relative;+}\n/*+NEW:+Larger,+more+tappable+calendar+toggle+button+for+mobile+*/\n#toggleDatesBtn+{+position:+absolute;+left:+calc(50%+++250px);+transform:+translateX(-50%);+padding:+12px+18px;+background:+rgba(0,0,0,0.55);+color:+var(--accent-red);+border:+2px+solid+var(--accent-red);+border-radius:+10px;+font-size:+24px;+cursor:+pointer;+z-index:+9998;+transition:+background+0.2s,+box-shadow+0.18s,+transform+0.1s;+}\n#toggleDatesBtn.active+{+background:+var(--accent-red-rgba-20);+}\n\n/*+NEW:+Styles+for+the+date+pickers+and+labels+*/\n.date-pickers+{\n++display:+flex;\n++justify-content:+center;\n++align-items:+center;+/*+Align+items+vertically+*/\n++gap:+15px;\n++margin-top:+20px;\n}\n.date-picker-container+{\n++display:+flex;\n++flex-direction:+column;\n++align-items:+center;\n}\n.date-picker-label+{\n++font-size:+14px;+/*+Small+letters+for+the+label+*/\n++color:+#fff;\n++margin-bottom:+5px;+/*+Spacing+between+label+and+input+*/\n}\n.date-pickers+input[type=\"date\"]+{\n++background:+#111;\n++color:+#fff;\n++border:+1px+solid+#fff;\n++border-radius:+8px;\n++padding:+10px+15px;\n++font-size:+24px;\n}\n.date-picker-separator+{\n++font-size:+24px;\n++color:+#fff;\n++align-self:+flex-end;+/*+Align+the+dash+with+the+inputs+*/\n++margin-bottom:+15px;+/*+Adjust+vertical+alignment+*/\n}\n\nul+{+list-style:+none;+padding:+0;+margin:+0;+}\nli+{+display:+flex;+align-items:+flex-start;+background:+#111;+margin:+30px+0;+padding:+10px;+width:+100%;+color:+#fff;+border:+2px+solid+#fff;+border-radius:+20px;+box-sizing:+border-box;+position:+relative;+transition:+background+0.3s,+border-color+0.3s;+}\nli.highlighted+{+background:+#333;+border-color:+var(--accent-red);+}\n\n.scroll-wrapper+{\n++flex:+1;\n++padding:+5px;\n++overflow:+hidden;\n++max-height:+{lv=mxHght692}px;\n++position:+relative;\n++box-sizing:+border-box;\n}\n\n.text-box+{\n++font-size:+{lv=fntSz632}px;\n++white-space:+pre-wrap;\n++word-break:+break-word;\n++padding:+2ch+1ch;\n++box-sizing:+border-box;\n++overflow:+hidden;\n}\n\n.highlight-word+{+background-color:+green;+color:+black;+font-weight:+bold;+border-radius:+4px;+padding:+0+2px;+}\n\n#submitBtn+{+position:+fixed;+top:+10px;+left:+50%;+transform:+translateX(-50%);+display:+none;+padding:+12px+18px;+font-size:+36px;+background:+rgba(255,0,0,0.35);+color:+#fff;+border:+2px+solid+rgba(255,0,0,0.6);+border-radius:+15px;+cursor:+pointer;+z-index:+9999;+}\n\n#highlightAllWrapper+{+position:+fixed;+top:+-50px;+left:+calc(50%+-+250px);+width:+120px;+height:+120px;+display:+none;+justify-content:+center;+align-items:+center;+z-index:+9999;+padding:+40px;+}\n#highlightAllBtn+{+width:+60px;+height:+60px;+background:+rgba(0,0,0,0.55)+!important;+color:+var(--accent-red);+border:+2px+solid+var(--accent-red);+border-radius:+50%;+font-size:+30px;+cursor:+pointer;+}\n#highlightAllBtn.none-mode+{+background:+var(--accent-red-rgba-20)+!important;+}\n\n.delete-tab+{+position:+absolute;+top:+10px;+width:+90px;+height:+70px;+cursor:+pointer;+z-index:+20;+}\n.delete-tab::before+{+content:+'';+position:+absolute;+top:+0;+left:+0;+width:+90px;+height:+6px;+background-color:+var(--delete-line-grey);+border-radius:+3-px;+}\n.delete-tab.active::before+{+animation-name:+delete-line-pulse;+animation-duration:1.2s;+animation-iteration-count:infinite;+animation-timing-function:ease-in-out;+}\n@keyframes+delete-line-pulse+{+0%+{+background-color:+var(--delete-line-grey);+transform:+translateY(0);+opacity:1;+}+50%+{+background-color:+var(--accent-red);+transform:+translateY(-1px);+opacity:1;+}+100%{+background-color:+var(--delete-line-grey);+transform:+translateY(0);+opacity:1;+}+}\n\n/*+MODIFIED:+Styles+for+the+\"Entry+split\"+label+*/\n.split-label+{\n++++position:+absolute;\n++++top:+10px;\n++++font-size:+16px;\n++++color:+yellow;\n++++white-space:+normal;\n++++word-break:+normal;\n++++z-index:+20;\n++++max-width:+80%;\n}\n\n.slider-container+{\n++width:+var(--slider-width);\n++position:+absolute;\n++top:+10px;\n++border-radius:+12px;\n++cursor:+grab;\n++touch-action:+none;\n++z-index:+9997;\n++display:+block;\n++opacity:+0.7;\n++border:+none;\n++background:+linear-gradient(to+top,+rgba(160,160,160,0.35),+rgba(80,80,80,0.08));\n++box-shadow:+0+4px+10px+rgba(160,160,160,0.18);\n++padding:+6px;\n++animation:+trackpad-breathe+2.8s+infinite+ease-in-out;\n}\n.slider-container.dragging+{+box-shadow:0+0+22px+var(--trackpad-glow-strong);+opacity:0.95;+transform:scale(1.01);+animation:none;+}\n@keyframes+trackpad-breathe+{+0%+{+box-shadow:0+6px+12px+rgba(160,160,160,0.06);+transform:scale(1);+opacity:0.72;+}+50%+{+box-shadow:0+10px+24px+rgba(160,160,160,0.10);+transform:scale(1.01);+opacity:0.82;+}+100%+{+box-shadow:0+6px+12px+rgba(160,160,160,0.06);+transform:scale(1);+opacity:0.72;+}+}\n\nbody.left-handed+.slider-container+{+left:+10px;+right:+auto;+background:+linear-gradient(to+right,+rgba(100,100,100,0.55),+rgba(100,100,100,0.15));+}\nbody.right-handed+.slider-container+{+right:+10px;+left:+auto;+background:+linear-gradient(to+left,+rgba(100,100,100,0.55),+rgba(100,100,100,0.15));+}\nbody.right-handed+.delete-tab+{+left:+var(--delete-inset);+}\nbody.left-handed+.delete-tab+{+right:+var(--delete-inset);+}\n/*+MODIFIED:+Add+split-label+positioning+based+on+handedness+*/\nbody.right-handed+.split-label+{+left:+var(--delete-inset);+}\nbody.left-handed+.split-label+{+right:+var(--delete-inset);+}\n\nbody.delete-mode+#submitBtn,+body.delete-mode+#highlightAllBtn,+body.delete-mode+li.highlighted+{+animation:+pulsate-intense+1.2s+infinite+ease-in-out;+}\n@keyframes+pulsate-intense+{+0%+{+box-shadow:0+0+5px+rgba(255,0,0,0.6),0+0+15px+rgba(255,0,0,0.8);+border-color:+rgba(255,0,0,0.6);+}+50%+{+box-shadow:0+0+15px+rgba(255,0,0,1),0+0+35px+rgba(255,0,0,1);+border-color:+rgba(255,0,0,1);+}+100%+{+box-shadow:0+0+5px+rgba(255,0,0,0.6),0+0+15px+rgba(255,0,0,0.8);+border-color:+rgba(255,0,0,0.6);+}+}\n\n/*+NEW:+Fullscreen+Overlay+Styles+*/\n#fullscreenOverlay+{\n++position:+fixed;\n++top:+0;\n++left:+0;\n++width:+100%;\n++height:+100%;\n++background:+rgba(0,+0,+0,+0.9);\n++display:+flex;\n++justify-content:+center;\n++align-items:+center;\n++z-index:+10000;\n++opacity:+0;\n++visibility:+hidden;\n++transition:+opacity+0.3s+ease-in-out,+visibility+0s+0.3s;\n++flex-direction:+column;\n}\n#fullscreenOverlay.visible+{\n++opacity:+1;\n++visibility:+visible;\n++transition:+opacity+0.3s+ease-in-out;\n}\n#overlayContent+{\n++background:+#1c1c1c;\n++color:+#fff;\n++padding:+30px;\n++border-radius:+20px;\n++max-width:+90%;\n++max-height:+90%;\n++overflow-y:+auto;\n++box-shadow:+0+0+50px+rgba(255,+255,+255,+0.1);\n}\n#overlayCloseBtn+{\n++position:+absolute;\n++top:+30px;\n++right:+30px;\n++background:+transparent;\n++border:+2px+solid+#fff;\n++color:+#fff;\n++font-size:+24px;\n++padding:+10px+15px;\n++border-radius:+50%;\n++cursor:+pointer;\n++z-index:+10001;\n}\n</style>\n</head>\n<body>\n<div+class=\"header-container\">\n++<h2>🔍Search</h2>\n++<button+id=\"toggleDatesBtn\">📅</button>\n</div>\n<div+class=\"date-pickers\"+id=\"datePickers\">\n++<div+class=\"date-picker-container\">\n++++<span+class=\"date-picker-label\">Start</span>\n++++<input+type=\"date\"+id=\"date1\"+value=\"{lv=serchDat513}\">\n++</div>\n++<span+class=\"date-picker-separator\">-</span>\n++<div+class=\"date-picker-container\">\n++++<span+class=\"date-picker-label\">End</span>\n++++<input+type=\"date\"+id=\"date2\"+value=\"{lv=serchDat2x623}\">\n++</div>\n</div>\n<ul+id=\"dynamicList\"></ul>\n<button+id=\"submitBtn\">🗑️</button>\n<div+id=\"highlightAllWrapper\">\n++<button+id=\"highlightAllBtn\">All</button>\n</div>\n<div+id=\"fullscreenOverlay\">\n++<button+id=\"overlayCloseBtn\">X</button>\n++<div+id=\"overlayContent\"></div>\n</div>\n<textarea+id=\"handedVar\"+style=\"display:none\">{lv=orientScrn475}</textarea>\n<textarea+id=\"rawData\"+style=\"display:none\">{lv=serchStrng693}</textarea>\n<textarea+id=\"searchKey\"+style=\"display:none\">{lv=serchKy630}</textarea>\n\n<script>\n//+=========================\n//+Date+Pickers+&+Toggle\n//+=========================\nconst+triggerBase=\"http://localhost:8080/infiniteClipboardTrigger\";\nconst+toggleBtn=document.getElementById('toggleDatesBtn');\nconst+datePickers=document.getElementById('datePickers');\nconst+date1=document.getElementById('date1');\nconst+date2=document.getElementById('date2');\nif(date1.value||date2.value){datePickers.style.display='flex';+toggleBtn.classList.add('active');}+else{datePickers.style.display='none';+toggleBtn.classList.remove('active');}\ntoggleBtn.addEventListener('click',()=>{+const+visible=datePickers.style.display==='flex';+datePickers.style.display=visible?'none':'flex';+toggleBtn.classList.toggle('active',!visible);+});\nfunction+sendDates(){+fetch(`${triggerBase}?serchDat513=${encodeURIComponent(date1.value)}&serchDat2x623=${encodeURIComponent(date2.value)}&t=${Date.now()}`).catch(()=>{});+}\ndate1.addEventListener('change',sendDates);+date2.addEventListener('change',sendDates);\n\n//+=========================\n//+Main+list+logic\n//+=========================\nconst+raw=document.getElementById('rawData').value||'';\nconst+searchKeys=(document.getElementById('searchKey').value||'').split(/\\s+/).filter(Boolean);\nconst+list=document.getElementById('dynamicList');\nconst+submitBtnEl=document.getElementById('submitBtn');\nconst+highlightAllWrapper=document.getElementById('highlightAllWrapper');\nconst+highlightAllBtn=document.getElementById('highlightAllBtn');\nlet+deleteMode=false;\nconst+leftHanded=document.getElementById(\"handedVar\").value.trim().toLowerCase()===\"true\";\ndocument.body.classList.add(leftHanded?\"left-handed\":\"right-handed\");\n\n//+NEW:+Global+flag+from+the+working+example\nlet+isHoldingDeleteTab+=+false;\n\n//+NEW:+Get+overlay+elements+and+add+listeners\nconst+fullscreenOverlay+=+document.getElementById('fullscreenOverlay');\nconst+overlayContent+=+document.getElementById('overlayContent');\nconst+overlayCloseBtn+=+document.getElementById('overlayCloseBtn');\n\nfunction+showOverlay(content)+{\n++overlayContent.innerHTML+=+content;\n++fullscreenOverlay.classList.add('visible');\n++document.body.style.overflow+=+'hidden';\n}\nfunction+hideOverlay()+{\n++fullscreenOverlay.classList.remove('visible');\n++document.body.style.overflow+=+'auto';\n}\noverlayCloseBtn.addEventListener('click',+hideOverlay);\n\nfunction+escapeRegExp(str){return+str.replace(/[.*+?^${}()|[\\]\\\\]/g,'\\\\$&');}\nfunction+highlightMatches(text){if(searchKeys.length===0)return+text;+const+regex=new+RegExp(\"(\"+searchKeys.map(escapeRegExp).join(\"|\")+\")\",\"gi\");+return+text.replace(regex,m=>`<span+class=\"highlight-word\">${m}</span>`);}\nfunction+updateSubmitBtn(){\n++const+highlightedItems=list.querySelectorAll('li.highlighted');\n++//+Check+if+there+are+any+highlighted+items,+and+if+not,+exit+delete+mode\n++if(highlightedItems.length+===+0+&&+deleteMode)+{\n++++++deleteMode+=+false;\n++}\n++submitBtnEl.style.display=deleteMode?'block':'none';\n++highlightAllWrapper.style.display=deleteMode?'flex':'none';\n++document.body.classList.toggle(\"delete-mode\",deleteMode);\n++list.querySelectorAll('.delete-tab').forEach((tab,i)=>{+if(deleteMode){+tab.classList.add('active');+tab.style.setProperty('--pulse-delay',`${i*90}ms`);}+else{+tab.classList.remove('active');+tab.style.removeProperty('--pulse-delay');+}});\n++if(!deleteMode)+list.querySelectorAll('li.highlighted').forEach(li=>li.classList.remove('highlighted'));\n++if(deleteMode){\n++++const+deletableItems=Array.from(list.querySelectorAll('li')).filter(li=>{+const+idx=parseInt(li.dataset.index);+return+idx>0+&&+idx<raw.split('『‰』').length-1;+});\n++++const+allHighlighted=deletableItems.length>0+&&+deletableItems.every(li=>li.classList.contains('highlighted'));\n++++highlightAllBtn.innerText=allHighlighted?\"X\":\"All\";\n++++highlightAllBtn.classList.toggle('none-mode',allHighlighted);\n++}\n}\nsubmitBtnEl.onclick=()=>{\n++const+highlightedItems=Array.from(list.querySelectorAll('li.highlighted'));\n++if(highlightedItems.length===0)return;\n++const+allIndexes=highlightedItems.map(li=>li.dataset.index).join('『‰』');\n++fetch(`${triggerBase}?slctedItm147=${encodeURIComponent(allIndexes)}&dlteSlectd738=true&serchItm574=true&t=${Date.now()}`).catch(()=>{});\n++highlightedItems.forEach(li=>li._resizeObserver?.disconnect());\n++highlightedItems.forEach(li=>li.remove());\n++updateSubmitBtn();\n};\nhighlightAllBtn.onclick=()=>{\n++if(!deleteMode)return;\n++const+deletableItems=Array.from(list.querySelectorAll('li')).filter(li=>{+const+idx=parseInt(li.dataset.index);+return+idx>0+&&+idx<raw.split('『‰』').length-1;+});\n++const+allHighlighted=deletableItems.every(li=>li.classList.contains('highlighted'));\n++deletableItems.forEach(li=>li.classList.toggle('highlighted',!allHighlighted));\n++highlightAllBtn.innerText=allHighlighted?\"All\":\"None\";\n++highlightAllBtn.classList.toggle('none-mode',!allHighlighted);\n++updateSubmitBtn();\n};\n\n//+=========================\n//+Build+list\n//+=========================\nconst+segments=raw.split('『‰』');\nsegments.forEach((segment,idx)=>{\n++const+item=segment.trim();+if(item==='')return;\n++const+li=document.createElement('li');+li.dataset.index=idx;\n\n++const+hasLeading=idx>0;+const+hasTrailing=idx<segments.length-1;\n++if(hasLeading+&&+hasTrailing){\n++++const+tab=document.createElement('div');+tab.className='delete-tab';+li.appendChild(tab);\n++++let+pressTimer=null;+const+clearPress=()=>{if(pressTimer){clearTimeout(pressTimer);+pressTimer=null;}};\n++++\n++++//+NEW:+Use+the+working+example's+logic\n++++tab.addEventListener('touchstart',e=>{\n++++++++e.stopPropagation();\n++++++++isHoldingDeleteTab+=+true;+//+Set+the+flag+immediately\n++++++++clearPress();\n++++++++pressTimer=setTimeout(()=>{\n++++++++++++deleteMode=!deleteMode;\n++++++++++++if(deleteMode)+li.classList.add('highlighted');\n++++++++++++updateSubmitBtn();\n++++++++++++isHoldingDeleteTab+=+false;+//+Reset+on+timeout\n++++++++},500);\n++++},{passive:false});\n++++\n++++tab.addEventListener('touchend',e=>{\n++++++++e.stopPropagation();\n++++++++clearPress();\n++++++++isHoldingDeleteTab+=+false;+//+Reset+the+flag\n++++},{passive:true});\n++++tab.addEventListener('touchcancel',e=>{\n++++++++e.stopPropagation();\n++++++++clearPress();\n++++++++isHoldingDeleteTab+=+false;+//+Reset+the+flag\n++++},{passive:true});\n++++\n++++tab.addEventListener('click',+e+=>+e.stopPropagation());\n++}+else{\n++++const+label=document.createElement('div');\n++++label.className='split-label';\n++++label.innerText='Entry+split+between+two+pages+(unable+to+delete)';\n++++li.appendChild(label);\n++}\n\n++const+wrapper=document.createElement('div');+wrapper.className='scroll-wrapper';\n++const+textDiv=document.createElement('div');+textDiv.className='text-box';\n++textDiv.innerHTML=highlightMatches(item.replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\").replace(/\"/g,\"&quot;\").replace(/'/g,\"&#039;\"));\n++if(leftHanded){+\n++++textDiv.style.paddingLeft='3ch';+\n++++textDiv.style.paddingRight='2ch';\n++++wrapper.style.paddingLeft='5px';+\n++++wrapper.style.paddingRight='calc(var(--slider-width)+12px)';+\n++}+else{+\n++++textDiv.style.paddingRight='3ch';+\n++++textDiv.style.paddingLeft='2ch';\n++++wrapper.style.paddingRight='5px';+\n++++wrapper.style.paddingLeft='calc(var(--slider-width)+12px)';+\n++}\n++wrapper.appendChild(textDiv);\n++li.appendChild(wrapper);\n\n++//+=========================\n++//+REFINED:+Long-press+and+Tap+event+handling\n++//+=========================\n++let+longPressTimer;\n++let+isTapped+=+false;\n++const+longPressDuration+=+500;\n++const+swipeThreshold+=+20;\n++let+startX,+startY;\n\n++li.addEventListener('touchstart',+(e)+=>+{\n++++//+NEW:+Check+the+new+flag+here\n++++if+(isHoldingDeleteTab+||+e.target.closest('.slider-container'))+{\n++++++return;\n++++}\n++++\n++++startX+=+e.touches[0].clientX;\n++++startY+=+e.touches[0].clientY;\n++++isTapped+=+true;\n\n++++clearTimeout(longPressTimer);\n++++longPressTimer+=+setTimeout(()+=>+{\n++++++++//+NEW:+The+overlay+now+opens+regardless+of+delete+mode\n++++++++if+(isTapped+&&+!isHoldingDeleteTab)+{\n++++++++++showOverlay(textDiv.innerHTML);\n++++++++}\n++++++++isTapped+=+false;\n++++},+longPressDuration);\n++},+{passive:+true});\n\n++li.addEventListener('touchmove',+(e)+=>+{\n++++if+(isTapped)+{\n++++++const+dx+=+startX+-+e.touches[0].clientX;\n++++++const+dy+=+startY+-+e.touches[0].clientY;\n++++++const+distance+=+Math.sqrt(dx+*+dx+++dy+*+dy);\n\n++++++if+(distance+>+swipeThreshold)+{\n++++++++clearTimeout(longPressTimer);\n++++++++isTapped+=+false;\n++++++}\n++++}\n++},+{passive:+true});\n\n++li.addEventListener('touchend',+(e)+=>+{\n++++clearTimeout(longPressTimer);\n\n++++if+(isTapped)+{+//+Check+for+isTapped+and+handle+single-tap+behavior\n++++++++isTapped+=+false;\n++++++++//+The+tap+logic+remains+the+same\n++++++++if+(deleteMode+&&+hasLeading+&&+hasTrailing)+{\n++++++++++++li.classList.toggle('highlighted');\n++++++++++++updateSubmitBtn();\n++++++++}+else+if+(!deleteMode)+{\n++++++++++++fetch(`${triggerBase}?slctedItm147=${encodeURIComponent(idx)}&serchItm574=true&t=${Date.now()}`).catch(()=>{});\n++++++++}\n++++}\n++},+{passive:+true});\n\n++li.addEventListener('touchcancel',+(e)+=>+{\n++++clearTimeout(longPressTimer);\n++++isTapped+=+false;\n++},+{passive:+true});\n\n++//+Also+add+a+pointerdown+handler+for+desktop+compatibility\n++li.addEventListener('pointerdown',+(e)+=>+{\n++++//+NEW:+Check+the+new+flag+here\n++++if+(e.button+!==+0+||+e.target.closest('.delete-tab')+||+e.target.closest('.slider-container')+||+isHoldingDeleteTab)+{\n++++++return;\n++++}\n++++startX+=+e.clientX;\n++++startY+=+e.clientY;\n++++isTapped+=+true;\n\n++++clearTimeout(longPressTimer);\n++++longPressTimer+=+setTimeout(()+=>+{\n++++++++//+NEW:+The+overlay+now+opens+regardless+of+delete+mode\n++++++++if+(isTapped+&&+!isHoldingDeleteTab)+{\n++++++++++showOverlay(textDiv.innerHTML);\n++++++++}\n++++++++isTapped+=+false;\n++++},+longPressDuration);\n++++li.setPointerCapture?.(e.pointerId);\n++});\n\n++li.addEventListener('pointermove',+(e)+=>+{\n++++if+(isTapped)+{\n++++++const+dx+=+startX+-+e.clientX;\n++++++const+dy+=+startY+-+e.clientY;\n++++++const+distance+=+Math.sqrt(dx+*+dx+++dy+*+dy);\n++++++if+(distance+>+swipeThreshold)+{\n++++++++clearTimeout(longPressTimer);\n++++++++isTapped+=+false;\n++++++}\n++++}\n++});\n\n++li.addEventListener('pointerup',+(e)+=>+{\n++++clearTimeout(longPressTimer);\n\n++++if+(isTapped)+{+//+Check+for+isTapped+and+handle+single-tap+behavior\n++++++++isTapped+=+false;\n++++++++//+The+tap+logic+remains+the+same\n++++++++if+(deleteMode+&&+hasLeading+&&+hasTrailing)+{\n++++++++++++li.classList.toggle('highlighted');\n++++++++++++updateSubmitBtn();\n++++++++}+else+if+(!deleteMode)+{\n++++++++++++fetch(`${triggerBase}?slctedItm147=${encodeURIComponent(idx)}&serchItm574=true&t=${Date.now()}`).catch(()=>{});\n++++++++}\n++++}\n++++li.releasePointerCapture?.(e.pointerId);\n++});\n\n++li.addEventListener('pointercancel',+(e)+=>+{\n++++clearTimeout(longPressTimer);\n++++isTapped+=+false;\n++++li.releasePointerCapture?.(e.pointerId);\n++});\n\n++//+Keep+the+`contextmenu`+handler+for+right-click+on+desktop\n++textDiv.addEventListener('contextmenu',+(e)+=>+{\n++++++e.preventDefault();\n++++++//+NEW:+The+overlay+now+opens+regardless+of+delete+mode\n++++++if+(!isHoldingDeleteTab)+{\n++++++++++showOverlay(textDiv.innerHTML);\n++++++}\n++});\n\n++//+=========================\n++//+Clipboard-style+Trackpad+Slider\n++//+=========================\n++const+sliderContainer+=+document.createElement('div');\n++sliderContainer.className+=+'slider-container';\n++li.appendChild(sliderContainer);\n++sliderContainer.addEventListener('click',+e+=>+e.stopPropagation());\n\n++const+adjustHeights+=+()+=>+{\n++++++const+style+=+window.getComputedStyle(textDiv);\n++++++const+paddingTop+=+parseFloat(style.paddingTop)+||+0;\n++++++const+paddingBottom+=+parseFloat(style.paddingBottom)+||+0;\n++++++const+contentHeight+=+textDiv.scrollHeight+-+paddingTop+-+paddingBottom;\n++++++const+maxHeight+=+{lv=mxHght692};\n++++++const+finalHeight+=+Math.min(contentHeight+++paddingTop+++paddingBottom,+maxHeight);\n++++++wrapper.style.height+=+finalHeight+++'px';\n++++++wrapper.style.overflow+=+'hidden';\n++++++if+(contentHeight+++paddingTop+++paddingBottom+>+maxHeight)+{\n++++++++++sliderContainer.style.display+=+'block';\n++++++++++sliderContainer.style.height+=+finalHeight+++'px';\n++++++}+else+sliderContainer.style.display+=+'none';\n++};\n++adjustHeights();\n++const+ro+=+new+ResizeObserver(adjustHeights);\n++ro.observe(textDiv);\n++li._resizeObserver+=+ro;\n\n++let+dragging+=+false,+lastY+=+0,+lastTime+=+0,+velocityPxPerSec+=+0,+lastPositions+=+[];\n++sliderContainer.addEventListener('pointerdown',+e+=>+{\n++++++dragging+=+true;\n++++++lastY+=+e.clientY;\n++++++lastTime+=+performance.now();\n++++++lastPositions+=+[];\n++++++velocityPxPerSec+=+0;\n++++++sliderContainer.classList.add('dragging');\n++++++sliderContainer.setPointerCapture?.(e.pointerId);\n++++++if+(wrapper._momentumAnim)+{+cancelAnimationFrame(wrapper._momentumAnim);+wrapper._momentumAnim+=+null;+}\n++});\n\n++const+onMove+=+ev+=>+{\n++++++if+(!dragging)+return;\n++++++const+now+=+performance.now();\n++++++const+dt+=+now+-+lastTime;\n++++++const+dy+=+ev.clientY+-+lastY;\n++++++wrapper.scrollTop+-=+dy;\n++++++if+(dt+>+0)+{\n++++++++++lastPositions.push({+dy,+dt+});\n++++++++++if+(lastPositions.length+>+6)+lastPositions.shift();\n++++++++++let+sum+=+0,+div+=+0;\n++++++++++for+(const+s+of+lastPositions)+{+sum++=+(s.dy+/+s.dt);+div++=+1;+}\n++++++++++velocityPxPerSec+=+(sum+/+div)+*+1000;\n++++++}\n++++++lastY+=+ev.clientY;\n++++++lastTime+=+now;\n++};\n\n++const+onUp+=+ev+=>+{\n++++++if+(!dragging)+return;\n++++++dragging+=+false;\n++++++sliderContainer.classList.remove('dragging');\n++++++try+{+sliderContainer.releasePointerCapture?.(ev.pointerId);+}+catch+(e)+{+}\n++++++let+velocity+=+-velocityPxPerSec;\n++++++const+density+=+window.devicePixelRatio+||+1;\n++++++const+MIN_FLING_PX_PER_SEC+=+50+*+density;\n++++++const+MAX_FLING_PX_PER_SEC+=+8000+*+density;\n++++++const+SCROLL_FRICTION+=+0.015;\n++++++const+GRAVITY_EARTH+=+9.80665,+INCHES_PER_METER+=+39.37;\n++++++const+PHYSICAL_COEFF+=+GRAVITY_EARTH+*+INCHES_PER_METER+*+density+*+160+*+0.84;\n++++++const+DECELERATION_RATE+=+Math.log(0.78)+/+Math.log(0.9);\n++++++const+getDecel+=+l+=>+Math.log(0.35+*+Math.abs(l)+/+(SCROLL_FRICTION+*+PHYSICAL_COEFF));\n++++++const+getDistance+=+v+=>+{\n++++++++++const+l+=+getDecel(v);\n++++++++++return+SCROLL_FRICTION+*+PHYSICAL_COEFF+*+Math.exp(DECELERATION_RATE+/+(DECELERATION_RATE+-+1)+*+l);\n++++++};\n++++++const+getDuration+=+v+=>+{\n++++++++++const+l+=+getDecel(v);\n++++++++++return+Math.round(1000+*+Math.exp(l+/+(DECELERATION_RATE+-+1)));\n++++++};\n++++++if+(Math.abs(velocity)+<+MIN_FLING_PX_PER_SEC)+return;\n++++++velocity+=+Math.max(-MAX_FLING_PX_PER_SEC,+Math.min(MAX_FLING_PX_PER_SEC,+velocity));\n++++++const+distance+=+getDistance(velocity)*Math.sign(velocity);\n++++++const+duration+=+getDuration(velocity);\n++++++if+(!duration+||+!distance)+return;\n++++++const+start+=+wrapper.scrollTop;\n++++++const+maxScroll+=+wrapper.scrollHeight+-+wrapper.clientHeight;\n++++++let+target+=+Math.round(start+++distance);\n++++++if+(target+<+0)+target+=+0;\n++++++if+(target+>+maxScroll)+target+=+maxScroll;\n++++++const+startTime+=+performance.now();\n++++++function+easeOut(t)+{+return+1+-+Math.pow(1-t,+3);+}\n++++++function+step()+{\n++++++++++const+now+=+performance.now();\n++++++++++const+t+=+Math.min((now+-+startTime)+/+duration,+1);\n++++++++++wrapper.scrollTop+=+start+++(target+-+start)+*+easeOut(t);\n++++++++++if+(t+<+1)+wrapper._momentumAnim+=+requestAnimationFrame(step);\n++++++}\n++++++step();\n++};\n\n++sliderContainer.addEventListener('pointermove',+onMove);\n++sliderContainer.addEventListener('pointerup',+onUp);\n++sliderContainer.addEventListener('pointercancel',+onUp);\n\n++list.appendChild(li);\n});\n</script>\n</body>\n</html>\n",
