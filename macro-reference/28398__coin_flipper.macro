  {
   "sceneDescription": {
    "itemList": {
     "items": [
      {
       "type": "SceneWebView",
       "sceneWebViewConfig": {
        "closeSceneOnPress": false,
        "enableJavaScript": true,
        "enableSwipeNavigation": true,
        "height": 20,
        "url": "<!DOCTYPE+html>\n<html+lang=\"en\">\n<head>\n++++<meta+charset=\"UTF-8\">\n++++<meta+name=\"viewport\"+content=\"width=device-width,+initial-scale=1.0\">\n++++<title>Realistic+Animated+Coin+Flip</title>\n++++<style>\n++++++++/*+1.+Centering+&+Background+*/\n++++++++body+{\n++++++++++++display:+flex;\n++++++++++++justify-content:+center;\n++++++++++++align-items:+center;\n++++++++++++min-height:+100vh;\n++++++++++++/*+💥+MODIFIED:+Changed+to+pure+black+*/\n++++++++++++background-color:+#000000;+\n++++++++++++margin:+0;\n++++++++++++perspective:+1000px;+\n++++++++++++overflow:+hidden;+\n++++++++}\n\n++++++++/*+2.+Coin+Container+(Handles+3D+space+and+overall+animation)+*/\n++++++++.coin+{\n++++++++++++--coin-size:+150px;+\n++++++++++++--coin-depth:+10px;+\n++++++++++++--flip-duration:+4s;+/*+Default+for+fallback+*/\n++++++++++++width:+var(--coin-size);\n++++++++++++height:+var(--coin-size);\n++++++++++++position:+relative;\n++++++++++++transform-style:+preserve-3d;\n++++++++++++cursor:+pointer;\n++++++++++++transition:+transform+0.1s;+\n++++++++}\n\n++++++++/*+3.+Coin+Rim/Edge+(The+3D+Depth)+*/\n++++++++.coin::before+{\n++++++++++++content:+'';\n++++++++++++position:+absolute;\n++++++++++++width:+100%;\n++++++++++++height:+100%;\n++++++++++++border-radius:+50%;\n++++++++++++transform:+translateZ(calc(var(--coin-depth)+/+-2));+\n++++++++++++\n++++++++++++/*+MODIFIED:+Changed+to+a+silver/nickel+look+for+better+contrast+*/\n++++++++++++background-image:+linear-gradient(\n++++++++++++++++90deg,+\n++++++++++++++++#4e4e4e,+\n++++++++++++++++#cccccc,+\n++++++++++++++++#4e4e4e,+\n++++++++++++++++#cccccc,+\n++++++++++++++++#4e4e4e++\n++++++++++++);\n++++++++++++background-size:+10%+100%;\n++++++++++++\n++++++++++++box-shadow:+\n++++++++++++++++0+0+10px+rgba(0,+0,+0,+0.5),+\n++++++++++++++++inset+0+0+5px+rgba(255,+255,+255,+0.5),+\n++++++++++++++++inset+0+0+10px+rgba(0,+0,+0,+0.8);\n++++++++}\n\n++++++++/*+4.+Coin+Faces+(The+heads/tails)+*/\n++++++++.side+{\n++++++++++++width:+100%;\n++++++++++++height:+100%;\n++++++++++++position:+absolute;\n++++++++++++backface-visibility:+hidden;\n++++++++++++border-radius:+50%;\n++++++++++++display:+flex;\n++++++++++++justify-content:+center;\n++++++++++++align-items:+center;\n++++++++++++font-size:+70px;+\n++++++++++++font-family:+'Times+New+Roman',+Times,+serif;\n++++++++++++font-weight:+bold;\n++++++++++++box-sizing:+border-box;\n++++++++++++\n++++++++++++transform:+translateZ(calc(var(--coin-depth)+/+2));\n++++++++++++\n++++++++++++/*+Refined+Metallic+Look+for+the+Faces+*/\n++++++++++++color:+#d1b162;\n++++++++++++border:+4px+solid+#ccaa42;\n++++++++++++\n++++++++++++background-image:+radial-gradient(\n++++++++++++++++circle+at+45%+45%,+\n++++++++++++++++#fffbe6+0%,++++++\n++++++++++++++++#f0d7a1+25%,+++++\n++++++++++++++++#b59a5d+50%,+++++\n++++++++++++++++#ccaa42+75%,+++++\n++++++++++++++++#9b813f+100%+++++\n++++++++++++);\n++++++++++++\n++++++++++++box-shadow:+\n++++++++++++++++0+0+15px+rgba(255,+255,+255,+0.3),+/*+Adjusted+shadow+for+black+background+*/\n++++++++++++++++inset+0+0+20px+rgba(255,+255,+255,+0.3),+\n++++++++++++++++inset+0+0+15px+rgba(0,+0,+0,+0.7);+\n++++++++++++text-shadow:+2px+2px+3px+rgba(0,+0,+0,+0.8),+-1px+-1px+1px+rgba(255,+255,+255,+0.5);\n++++++++}\n\n++++++++.tails+{\n++++++++++++transform:+rotateX(180deg)+translateZ(calc(var(--coin-depth)+/+2));+\n++++++++}\n\n++++++++/*+---+Animation+Keyframes+(Vertical+Flip)+---+*/\n++++++++@keyframes+flip-heads+{\n++++++++++++0%+{+transform:+rotateX(0deg);+}\n++++++++++++/*+Spin+many+times+to+ensure+fast+start+*/\n++++++++++++100%+{+transform:+rotateX(3600deg);+}+\n++++++++}\n\n++++++++@keyframes+flip-tails+{\n++++++++++++0%+{+transform:+rotateX(0deg);+}\n++++++++++++/*+Spin+many+times+++180deg+to+land+on+tails+*/\n++++++++++++100%+{+transform:+rotateX(3780deg);+}+\n++++++++}\n++++++++\n++++++++.flipping-heads+{\n++++++++++++/*+*+💥+KEY+CHANGE:+Using+'ease-out'+makes+it+start+fast+and+slow+down.\n+++++++++++++*+This+timing+function+is+critical+for+the+effect+you+want.\n+++++++++++++*+The+'ease-out'+is+applied+to+the+rotation+speed.\n+++++++++++++*/\n++++++++++++animation:+flip-heads+var(--flip-duration)+ease-out+forwards;\n++++++++}\n\n++++++++.flipping-tails+{\n++++++++++++/*+Using+the+duration+variable+and+the+timing+function+*/\n++++++++++++animation:+flip-tails+var(--flip-duration)+ease-out+forwards;\n++++++++}\n\n++++++++/*+If+you+want+a+more+pronounced+slow-down,+you+can+use+a+custom+cubic-bezier:+*/\n++++++++/*\n++++++++.flipping-heads-custom+{\n++++++++++++animation:+flip-heads+var(--flip-duration)+cubic-bezier(0.1,+0.9,+0.2,+1)+forwards;\n++++++++}\n++++++++*/\n\n++++</style>\n</head>\n<body>\n\n++++<div+id=\"coin\"+class=\"coin\">\n++++++++<div+class=\"side+heads\">{lv=headsVar}</div>+\n++++++++<div+class=\"side+tails\">{lv=tailsVar}</div>+\n++++</div>\n\n++++<script>\n++++++++document.addEventListener('DOMContentLoaded',+(event)+=>+{\n++++++++++++const+coin+=+document.getElementById('coin');\n++++++++++++\n++++++++++++//+💥+Define+the+variable+for+flip+time+(in+seconds)\n++++++++++++//+Increased+the+time+to+5s+to+make+the+slow-down+effect+more+obvious.\n++++++++++++const+lvTime+=+{lv=time};+\n++++++++++++\n++++++++++++//+Set+the+CSS+variable+--flip-duration+on+the+element\n++++++++++++coin.style.setProperty('--flip-duration',+`${lvTime}s`);\n\n\n++++++++++++//+Randomly+choose+0+(Heads)+or+1+(Tails)\n++++++++++++const+result+=+Math.floor(Math.random()+*+2);+\n\n++++++++++++//+Wait+a+moment+before+starting+the+animation\n++++++++++++setTimeout(()+=>+{\n++++++++++++++++if+(result+===+0)+{\n++++++++++++++++++++coin.classList.add('flipping-heads');\n++++++++++++++++}+else+{\n++++++++++++++++++++coin.classList.add('flipping-tails');\n++++++++++++++++}\n++++++++++++},+100);+\n++++++++});\n++++</script>\n\n</body>\n</html>\n",
