  {
   "sceneDescription": {
    "itemList": {
     "items": [
      {
       "type": "SceneWebView",
       "sceneWebViewConfig": {
        "closeSceneOnPress": false,
        "enableJavaScript": true,
        "enableSwipeNavigation": true,
        "height": 21,
        "url": "<!DOCTYPE+html>\n<html+lang=\"en\">\n<head>\n++++<meta+charset=\"UTF-8\">\n++++<meta+name=\"viewport\"+content=\"width=device-width,+initial-scale=1.0\">\n++++<title>Realistic+Animated+Coin+Flip</title>\n\n++++<style>\n++++++++body+{\n++++++++++++display:+flex;\n++++++++++++flex-direction:+column;\n++++++++++++justify-content:+center;\n++++++++++++align-items:+center;\n++++++++++++min-height:+100vh;\n++++++++++++background-color:+#000000;+\n++++++++++++margin:+0;\n++++++++++++perspective:+1000px;+\n++++++++++++overflow:+hidden;+\n++++++++++++color:+#fff;\n++++++++++++font-family:+Arial,+sans-serif;\n++++++++++++user-select:+none;+\n++++++++++++-webkit-user-select:+none;\n++++++++}\n\n++++++++.coin+{\n++++++++++++--coin-size:+150px;+\n++++++++++++--coin-depth:+10px;+\n++++++++++++--flip-duration:+4s;\n++++++++++++width:+var(--coin-size);\n++++++++++++height:+var(--coin-size);\n++++++++++++position:+relative;\n++++++++++++transform-style:+preserve-3d;\n++++++++++++cursor:+pointer;\n++++++++++++transition:+transform+0.1s;+\n++++++++++++margin-bottom:+40px;\n++++++++++++-webkit-tap-highlight-color:+transparent;+\n++++++++++++outline:+none;\n++++++++}\n\n++++++++.coin::before+{\n++++++++++++content:+'';\n++++++++++++position:+absolute;\n++++++++++++width:+100%;\n++++++++++++height:+100%;\n++++++++++++border-radius:+50%;\n++++++++++++transform:+translateZ(calc(var(--coin-depth)+/+-2));+\n++++++++++++background-image:+linear-gradient(90deg,+#4e4e4e,+#cccccc,+#4e4e4e,+#cccccc,+#4e4e4e);\n++++++++++++background-size:+10%+100%;\n++++++++++++box-shadow:+0+0+10px+rgba(0,+0,+0,+0.5),+inset+0+0+5px+rgba(255,+255,+255,+0.5),+inset+0+0+10px+rgba(0,+0,+0,+0.8);\n++++++++}\n\n++++++++.side+{\n++++++++++++width:+100%;\n++++++++++++height:+100%;\n++++++++++++position:+absolute;\n++++++++++++backface-visibility:+hidden;\n++++++++++++border-radius:+50%;\n++++++++++++display:+flex;\n++++++++++++justify-content:+center;\n++++++++++++align-items:+center;\n++++++++++++font-size:+70px;+\n++++++++++++font-family:+'Times+New+Roman',+Times,+serif;\n++++++++++++font-weight:+bold;\n++++++++++++box-sizing:+border-box;\n++++++++++++transform:+translateZ(calc(var(--coin-depth)+/+2));\n++++++++++++color:+#d1b162;\n++++++++++++border:+4px+solid+#ccaa42;\n++++++++++++background-image:+radial-gradient(circle+at+45%+45%,+#fffbe6+0%,+#f0d7a1+25%,+#b59a5d+50%,+#ccaa42+75%,+#9b813f+100%);\n++++++++++++box-shadow:+0+0+15px+rgba(255,+255,+255,+0.3),+inset+0+0+20px+rgba(255,+255,+255,+0.3),+inset+0+0+15px+rgba(0,+0,+0,+0.7);+\n++++++++++++text-shadow:+2px+2px+3px+rgba(0,+0,+0,+0.8),+-1px+-1px+1px+rgba(255,+255,+255,+0.5);\n++++++++}\n\n++++++++.tails+{+transform:+rotateX(180deg)+translateZ(calc(var(--coin-depth)+/+2));+}\n\n++++++++@keyframes+flip-heads+{+0%+{+transform:+rotateX(0deg);+}+100%+{+transform:+rotateX(3600deg);+}+}\n++++++++@keyframes+flip-tails+{+0%+{+transform:+rotateX(0deg);+}+100%+{+transform:+rotateX(3780deg);+}+}\n++++++++\n++++++++.flipping-heads+{+animation:+flip-heads+var(--flip-duration)+ease-out+forwards;+}\n++++++++.flipping-tails+{+animation:+flip-tails+var(--flip-duration)+ease-out+forwards;+}\n\n++++++++.play-btn+{\n++++++++++++padding:+12px+24px;\n++++++++++++font-size:+18px;\n++++++++++++background:+#333;\n++++++++++++color:+#fff;\n++++++++++++border:+2px+solid+#666;\n++++++++++++border-radius:+8px;\n++++++++++++cursor:+pointer;\n++++++++++++margin-top:+20px;\n++++++++++++-webkit-tap-highlight-color:+transparent;\n++++++++++++outline:+none;\n++++++++}\n\n++++++++.info+{+margin-top:+20px;+font-size:+14px;+opacity:+0.7;+text-align:+center;+}\n++++</style>\n</head>\n<body>\n\n++++<div+id=\"coin\"+class=\"coin\"+onclick=\"startFlip()\">\n++++++++<div+class=\"side+heads\">{lv=headsVar}</div>+\n++++++++<div+class=\"side+tails\">{lv=tailsVar}</div>+\n++++</div>\n\n++++<button+class=\"play-btn\"+onclick=\"startFlip()\">🪙+Flip+Coin</button>\n\n++++<div+class=\"info\">Tap+to+hear+the+sound,+then+watch+the+flip!</div>\n\n++++<script>\n++++++++const+rawData+=+\"{lv=soundBase}\";\n++++++++const+audioSrc+=+rawData.startsWith('data:audio')+\n++++++++++++?+rawData+\n++++++++++++:+\"data:audio/mp3;base64,\"+++rawData.trim();\n\n++++++++let+audio+=+new+Audio(audioSrc);\n++++++++let+isFlipping+=+false;\n\n++++++++function+startFlip()+{\n++++++++++++if+(isFlipping)+return;+\n++++++++++++\n++++++++++++isFlipping+=+true;\n++++++++++++const+coin+=+document.getElementById('coin');\n++++++++++++\n++++++++++++//+1.+Reset+any+previous+animation+immediately\n++++++++++++coin.classList.remove('flipping-heads',+'flipping-tails');\n++++++++++++void+coin.offsetWidth;+\n\n++++++++++++//+2.+Play+the+sound+immediately\n++++++++++++audio.currentTime+=+0;\n++++++++++++audio.play().catch(e+=>+console.log(\"Audio+blocked.+Interact+with+the+page+first.\"));\n\n++++++++++++//+3.+Wait+0.5+seconds+before+starting+the+visual+flip\n++++++++++++setTimeout(()+=>+{\n++++++++++++++++const+lvTime+=+{lv=time}+||+4;+\n++++++++++++++++coin.style.setProperty('--flip-duration',+`${lvTime}s`);\n++++++++++++++++\n++++++++++++++++const+result+=+Math.floor(Math.random()+*+2);+\n\n++++++++++++++++if+(result+===+0)+{\n++++++++++++++++++++coin.classList.add('flipping-heads');\n++++++++++++++++}+else+{\n++++++++++++++++++++coin.classList.add('flipping-tails');\n++++++++++++++++}\n\n++++++++++++++++//+Reset+flipping+state+after+the+animation+duration\n++++++++++++++++setTimeout(()+=>+{\n++++++++++++++++++++isFlipping+=+false;\n++++++++++++++++},+lvTime+*+1000);\n++++++++++++},+400);+//+This+is+the+0.5s+delay\n++++++++}\n\n++++++++//+Global+click+listener+for+first-time+interaction\n++++++++document.body.addEventListener('click',+(e)+=>+{\n++++++++++++if+(e.target.tagName+!==+'BUTTON'+&&+e.target.closest('#coin')+===+null+&&+!isFlipping)+{\n++++++++++++++++startFlip();\n++++++++++++}\n++++++++},+{+once:+true+});\n\n++++</script>\n</body>\n</html>",
