  {
   "blockNextAction": true,
   "consoleVariableName": "",
   "javascriptEngine": "QuickJS",
   "scriptText": "//+Tetapkan+panjang+lalai+jika+tidak+ditetapkan\nvar+panjang+=+parseInt(\"[lv=password_length]\")+||+12;+\n\n//+Ambil+pilihan+dari+variabel+MacroDroid+(boolean+dalam+bentuk+true/false)\nvar+gunaHurufBesar+=+\"[lv=use_uppercase]\"+===+\"True\";\nvar+gunaHurufKecil+=+\"[lv=use_lowercase]\"+===+\"True\";\nvar+gunaNombor+=+\"[lv=use_numbers]\"+===+\"True\";\nvar+gunaSimbol+=+\"[lv=use_symbols]\"+===+\"True\";\n\n//+Definisi+aksara+yang+boleh+digunakan\nvar+hurufBesar+=+\"ABCDEFGHIJKLMNOPQRSTUVWXYZ\";\nvar+hurufKecil+=+\"abcdefghijklmnopqrstuvwxyz\";\nvar+nombor+=+\"0123456789\";\nvar+simbol+=+\"!@#$%^&*()-_=+[]{}|;:,.<>?/\";\n\n//+Kumpulkan+aksara+yang+dibenarkan\nvar+aksaraDibenarkan+=+\"\";\nif+(gunaHurufBesar)+aksaraDibenarkan++=+hurufBesar;\nif+(gunaHurufKecil)+aksaraDibenarkan++=+hurufKecil;\nif+(gunaNombor)+aksaraDibenarkan++=+nombor;\nif+(gunaSimbol)+aksaraDibenarkan++=+simbol;\n\n//+Jika+tiada+aksara+dipilih,+gunakan+huruf+kecil+dan+nombor+secara+lalai\nif+(aksaraDibenarkan+===+\"\")+aksaraDibenarkan+=+hurufKecil+++nombor;\n\n//+Fungsi+untuk+menjana+kata+laluan\nfunction+janaKataLaluan(panjang)+{\n++++var+kataLaluan+=+\"\";\n++++for+(var+i+=+0;+i+<+panjang;+i++)+{\n++++++++var+randomIndex+=+Math.floor(Math.random()+*+aksaraDibenarkan.length);\n++++++++kataLaluan++=+aksaraDibenarkan[randomIndex];\n++++}\n++++return+kataLaluan;\n}\n\n//+Jana+kata+laluan\njanaKataLaluan(panjang);",
   "stringVariableName": "result",
   "disableLogging": false,
