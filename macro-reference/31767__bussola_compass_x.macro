        "stateId": -6178217201392613991,
        "url": "<!DOCTYPE+html>\n<html>\n<head>\n<style>\n++/*+Rimuove+i+margini+e+centra+il+contenuto+in+modo+semplice+*/\n++html,+body+{\n++++margin:+0;\n++++padding:+0;\n++++background-color:+transparent;\n++++font-family:+sans-serif;\n++++text-align:+center;\n++}\n\n++/*+Contenitore+principale+compatto+(Triplicato:+da+200px+a+600px)+*/\n++.gauge-container+{\n++++position:+relative;\n++++width:+600px;\n++++height:+600px;\n++++margin:+60px+auto+30px+auto;+/*+Spazi+verticali+triplicati+*/\n++}\n\n++/*+Il+quadrante+della+bussola+(Triplicato)+*/\n++.gauge-background+{\n++++position:+absolute;\n++++width:+100%;\n++++height:+100%;\n++++border-radius:+50%;\n++++background-color:+#FFC107;+/*+Tutto+Giallo+*/\n++++border:+15px+solid+#2c3e50;+/*+Spessore+triplicato:+da+5px+a+15px+*/\n++++box-shadow:+0+12px+24px+rgba(0,0,0,0.3);+/*+Ombra+triplicata+*/\n++++box-sizing:+border-box;\n++++transition:+transform+0.1s+ease-out;\n++}\n\n++/*+Linee+del+mirino+interno+*/\n++.gauge-background::before,+.gauge-background::after+{\n++++content:+'';\n++++position:+absolute;\n++++background-color:+rgba(44,+62,+80,+0.2);\n++++top:+50%;+left:+50%;\n++++transform:+translate(-50%,+-50%);\n++}\n++.gauge-background::before+{+width:+6px;+height:+80%;+}+/*+Spessore+da+2px+a+6px+*/\n++.gauge-background::after+{+width:+80%;+height:+6px;+}++/*+Spessore+da+2px+a+6px+*/\n\n++/*+Punti+Cardinali+(Dimensioni+e+distanze+triplicate)+*/\n++.punto+{\n++++position:+absolute;\n++++font-weight:+900;\n++++font-size:+60px;+/*+Da+20px+a+60px+*/\n++++color:+#2c3e50;\n++}\n++.n+{+top:+24px;+left:+50%;+transform:+translateX(-50%);+color:+#e74c3c;+font-size:+66px;+}+/*+Da+8px/22px+a+24px/66px+*/\n++.s+{+bottom:+24px;+left:+50%;+transform:+translateX(-50%);+}+/*+Da+8px+a+24px+*/\n++.e+{+right:+36px;+top:+50%;+transform:+translateY(-50%);+}+/*+Da+12px+a+36px+*/\n++.o+{+left:+36px;+top:+50%;+transform:+translateY(-50%);+}++/*+Da+12px+a+36px+*/\n\n++/*+Il+mirino+superiore+rosso+fisso+(Triplicato)+*/\n++.mirino-superiore+{\n++++position:+absolute;\n++++width:+12px;+/*+Da+4px+a+12px+*/\n++++height:+60px;+/*+Da+20px+a+60px+*/\n++++background-color:+#e74c3c;\n++++top:+-30px;+/*+Da+-10px+a+-30px+*/\n++++left:+50%;\n++++transform:+translateX(-50%);\n++++z-index:+10;\n++++border-radius:+6px;\n++}\n\n++/*+Perno+centrale+(Triplicato)+*/\n++.perno+{\n++++position:+absolute;\n++++width:+30px;+/*+Da+10px+a+30px+*/\n++++height:+30px;+/*+Da+10px+a+30px+*/\n++++background-color:+#2c3e50;\n++++border-radius:+50%;\n++++top:+50%;+left:+50%;\n++++transform:+translate(-50%,+-50%);\n++++z-index:+5;\n++++border:+6px+solid+#fff;+/*+Da+2px+a+6px+*/\n++}\n\n++/*+Valore+in+gradi+posizionato+sotto+(Triplicato)+*/\n++.gauge-value+{\n++++font-size:+78px;+/*+Da+26px+a+78px+*/\n++++font-weight:+bold;\n++++color:+#2c3e50;\n++++background-color:+rgba(255,+255,+255,+0.9);\n++++display:+inline-block;\n++++padding:+12px+45px;+/*+Da+4px/15px+a+12px/45px+*/\n++++border-radius:+45px;+/*+Da+15px+a+45px+*/\n++++box-shadow:+0+6px+12px+rgba(0,0,0,0.1);\n++++margin-top:+30px;+/*+Da+10px+a+30px+*/\n++}\n</style>\n</head>\n<body>\n\n<div+class=\"gauge-container\">\n++<div+class=\"mirino-superiore\"></div>\n++<div+id=\"quadrante-bussola\"+class=\"gauge-background\">\n++++<div+class=\"perno\"></div>\n++++<div+class=\"punto+n\">N</div>\n++++<div+class=\"punto+e\">E</div>\n++++<div+class=\"punto+s\">S</div>\n++++<div+class=\"punto+o\">O</div>\n++</div>\n</div>\n\n<div+class=\"gauge-value\">\n++<span+id=\"pdkw-datatext\">{lv=Gradi+x}</span>°\n</div>\n\n<script>\n++function+aggiornaBussola()+{\n++++let+rawText+=+document.getElementById(\"pdkw-datatext\").innerText.replace(',',+'.');\n++++let+gradi+=+parseFloat(rawText);\n++++\n++++if+(isNaN(gradi))+gradi+=+0;\n++++\n++++gradi+=+gradi+%+360;\n++++if+(gradi+<+0)+gradi++=+360;\n++++\n++++document.getElementById(\"quadrante-bussola\").style.transform+=+\"rotate(\"+++(-gradi)+++\"deg)\";\n++}\n\n++//+Controlla+e+aggiorna+la+posizione+ogni+100ms\n++setInterval(aggiornaBussola,+100);\n</scrip