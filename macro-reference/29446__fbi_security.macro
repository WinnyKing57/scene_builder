   "m_script": "#!/system/bin/sh\n\n#+Caminho+do+arquivo\nFILE=\"/sdcard/Documents/Meu+rec/log_gps.txt\"\n\n#+1.+Força+o+sistema+a+atualizar+a+localização+(Garante+que+o+hardware+acorde)\n#+O+comando+'providers'+solicita+uma+atualização+imediata\ncmd+location+get-last-location+>+/dev/null+2>&1\nsleep+2+#+Pequena+pausa+para+o+hardware+processar\n\n#+2.+Tenta+extrair+a+localização+do+dumpsys\n#+Melhoramos+o+grep+para+capturar+diferentes+formatos+de+saída+do+Android\nLATLON=$(dumpsys+location+|+grep+-E+\"last+location|last_location\"+|+head+-n+1+|+grep+-oE+\"\\-?[0-9]+\\.[0-9]+,\\-?[0-9]+\\.[0-9]+\")\n\n#+3.+Se+falhar,+tenta+usar+o+comando+'cmd+location'+diretamente+(mais+moderno)\nif+[+-z+\"$LATLON\"+];+then\n++++LATLON=$(cmd+location+get-last-location+|+grep+-oE+\"\\-?[0-9]+\\.[0-9]+,\\-?[0-9]+\\.[0-9]+\")\nfi\n\n#+Validação+e+Registro\nif+[+!+-z+\"$LATLON\"+];+then\n++++echo+\"$(date+'+%Y-%m-%d+%H:%M:%S')+-+Coordenadas:+$LATLON\"+>>+\"$FILE\"\n++++echo+\"Sucesso:+$LATLON\"\nelse\n++++#+Se+ainda+assim+falhar,+registra+o+erro\n++++echo+\"$(date+'+%Y-%m-%d+%H:%M:%S')+-+Erro:+GPS+não+respondeu+a+tempo.\"+>>+\"$FILE\"\n++++echo+\"Erro:+Não+foi+possível+forçar+a+localização.\"\nfi\n",
   "timeoutSeconds": 60,
   "useHelper": false,
   "useShizuku": true,
   "disableLogging": false,
