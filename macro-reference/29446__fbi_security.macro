   "m_stringValue": "<!DOCTYPE+html>\n<html+lang=\"en\">\n++++<head>\n\t++++++++<link+rel=\"canonical\"+href=\"https://www.itilog.com/\"+/>\t\t<meta+charset=\"utf-8\">\n++++++++<meta+http-equiv=\"X-UA-Compatible\"+content=\"IE=edge\">\n++++++++<meta+name=\"viewport\"+content=\"width=device-width,+initial-scale=1\">\n++++++++<meta+name=\"description\"+content=\"What+are+GPS+Coordinates?+Enjoy+our+free+interactive+maps+with+GPS+Coordinates+tools.+Easy+to+use+latitude+and+longitude+finder.\">\n\n++++++++<title>GPS+Coordinates+-->+Latitude+and+Longitude+Finder</title>\n\t\t\n++++++++<link+rel=\"stylesheet\"+href=\"/css/bootstrap.css\"+type=\"text/css\"+/>\n\t<link+rel=\"stylesheet\"+href=\"/css/itilogstyleinv3.css\"+type=\"text/css\"+/>\n\t\t+\n\t\n\t\t<!--+For+IE+9+and+below.+ICO+should+be+32x32+pixels+in+size+-->\n\t<!--[if+IE]><link+rel=\"shortcut+icon\"+href=\"favicon.ico?v3\"><![endif]-->\n\t<!--+Touch+Icons+-+iOS+and+Android+2.1++180x180+pixels+in+size.+-->+\n\t<link+rel=\"apple-touch-icon\"+href=\"/apple-touch-icon.png\">\n\t<link+rel=\"icon\"+type=\"image/png\"+href=\"/android-chrome-192x192.png\"+sizes=\"192x192\">\n\t<!--+Firefox,+Chrome,+Safari,+IE+11++and+Opera.+192x192+pixels+in+size.+-->\n\t<link+rel=\"icon\"+href=\"/favicon.ico\">\n\n\t<!--+HTML5+shim+and+Respond.js+for+IE8+support+of+HTML5+elements+and+media+queries+-->\n++++++++<!--[if+lt+IE+9]>\n\t++++<script+src=\"https://oss.maxcdn.com/html5shiv/3.7.2/html5shiv.min.js\"></script>\n\t++++<script+src=\"https://oss.maxcdn.com/respond/1.4.2/respond.min.js\"></script>\n\t<![endif]-->\n++++\n\t<script+src=\"https://ajax.googleapis.com/ajax/libs/jquery/1.11.2/jquery.min.js\"></script>\n\t<script+src=\"https://code.jquery.com/ui/1.11.4/jquery-ui.min.js\"></script>\n\t<script+src=\"/js/bootstrap.min.js\"></script>\n\t\t<!--+IE10+viewport+hack+for+Surface/desktop+Windows+8+bug+-->\n\t<script+src=\"/js/ie10-viewport-bug-workaround.js\"></script>\n\t<script>var+markerPath+=+\"/images/marker_\"</script>\n\t\t\n<s