   "consoleVariableName": "behindTheScene",
   "javascriptEngine": "JetPack+JavascriptEngine",
   "scriptText": "var+from+=+`{lv=behindTheScene[from]}`;\nvar+regex+=+/\\$|£|€/m\n//console.log(regex.test(!from));\nif+(from===\"$\"){\nconsole.log(from.replace(\"$\",+\"USD\"))\n}\nelse+if+(from===\"€\"){\nconsole.log(from.replace(\"€\",+\"EUR\"))\n}\nelse+if+(from===\"£\"){\nconsole.log(from.replace(\"£\",+\"AUD\"))\n}\nif+(from.search(regex)+===+-1){\nconsole.log(from);\n}",
   "stringVariableName": "",
   "disableLogging": false,
