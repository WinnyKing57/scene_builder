  {
   "sceneDescription": {
    "itemList": {
     "items": [
      {
       "type": "SceneWebView",
       "sceneWebViewConfig": {
        "closeSceneOnPress": false,
        "enableJavaScript": true,
        "enableSwipeNavigation": true,
        "height": 50,
        "url": "<!DOCTYPE+html>\n<html>\n<head>\n<style>\n\n*+{\n++margin:+0;\n++padding:+0;\n++box-sizing:+border-box;\n++font-size:+3.5vw;\n}\n\nbody+{\n++margin:+0+auto;\n++/*background:+hsla(60.8,41.3%,59.2%,0.299);*/\n}\n.container{\n++++padding:+20px;\n++++margin:+30px+auto;\n++++font-family:+Arial,+sans-serif;\n}\n\ntable{\n++++width:+100%;\n++++border-collapse:+collapse;\n}\n\nth,+td{\n++++border:+1px+solid+#ccc;\n++++padding:+20px;\n++++text-align:+center;\n}\n\nth{\n++++background:+#f2f2f2;\n++++font-weight:+bold;\n}\n\n.amount{\n++++background:+#e8f4ff;\n}\n</style>\n<link+rel=\"stylesheet\"+href=\"style.css\"+/>\n</head>\n<body>\n\n<div+class=\"container\">\n<table>\n\n<tr>\n++++<th+colspan=\"2\">Current+Amount</th>\n++++<!--+<th+class=\"curr\"></th>+-->\n++++<th+class=\"amount\"></th>\n</tr>\n\n<tr>\n++++<th>Currency+Name</th>\n++++<th+class=\"excR\">Exchange+Rate</th>\n++++<th>ER+×+Current+Amount</th>\n</tr>\n\n</table>\n</div>\n\n<script>\nlet+amount+=+`{lv=behindTheScene[amountToExchange]}`\nlet+curr+=+`{lv=behindTheScene[from]}`.toUpperCase()\ndocument.querySelector(\".excR\").textContent++=+`+(1+${curr}+equals)`\ndocument.querySelector(\".amount\").textContent+=+amount+++\"+\"+++curr.toUpperCase()\nlet+allCurr+=+JSON.parse(`{lv=setting[allCurr]}`)\nallCurr.forEach(e+=>+{\n++if+(e.toLowerCase()+===+curr.toLowerCase())+return+false\nfetch(`https://hexarate.paikama.co/api/rates/latest/${curr}?target=${e}`)\n.then(res+=>+{\n++return+res.json()\n})\n.then(o+=>+{\nconsole.log(o.data)\nlet+table+=+document.querySelector(\"table\")\n\ntable.insertAdjacentHTML(\"beforeend\",+`\n<tr>\n++++<td>${o.data.target}</td>\n++++<td>${o.data.mid}</td>\n++++<td>${(o.data.mid+*+amount).toFixed(3)}</td>\n</tr>\n`)\n})\n.catch(err+=>+document.body.innerHTML+=+err+++`<br>\n<ul>+\n<li>Ensure+you+are+connected+to+a+stable+internet.</li>\n</ul>\n`)\n})\n</script>\n</html>",
        "variableUpdateValue": {
         "type": "None"
        },
