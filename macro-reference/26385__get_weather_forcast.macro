   "sceneDescription": {
    "itemList": {
     "items": [
      {
       "type": "SceneIcon",
       "sceneIconConfig": {
        "alignment": "Center",
        "closeSceneOnPress": true,
        "padding": "16",
        "sceneIconData": {
         "imagePackageName": "com.arlosoft.macrodroid",
         "imageResourceId": 2131231770,
         "imageResourceName": "ic_do_not_disturb_white_24dp"
        },
        "size": 30,
