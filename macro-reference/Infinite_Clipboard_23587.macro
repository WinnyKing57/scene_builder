eshValue":0},{"type":"SceneButton","sceneButtonConfig":{"buttonColor":16777215,"closeSceneOnPress":false,"htmlFormatting":false,"text":"➕️+Add","textColor":-1,"textSize":"10","variableToUpdate":{"varName":"shwFvTxtBx491"},"variableUpdateValue":{"type":"BooleanValue","isToggle":false,"label":true}},"guid":-6693435211815296498,"iconRes":2131231205,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":false,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"","textAlignment":"Start","textColor":-1,"textSize":"20"},"guid":-9083351898200359042,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneIcon","sceneIconConfig":{"alignment":"End","closeSceneOnPress":false,"sceneIconData":{"imagePackageName":"com.arlosoft.macrodroid","imageResourceId":2131231873,"imageResourceName":"ic_list_white_24dp"},"size":23,"tintColor":-1118482,"tintEnabled":true,"variableToUpdate":{"varName":"shwMnu247"},"variableUpdateValue":{"type":"BooleanValue","isToggle":true,"label":false}},"guid":-8452815218711105327,"iconRes":2131231505,"lastRefreshValue":0}],"sceneHorizontalLayoutConfig":{"alignment":"Center","visibilityVariable":{"varName":"shwClpbord537"}},"iconResId":2131231503,"guid":-6752184191170314964,"iconRes":2131231503,"lastRefreshValue":0},{"type":"SceneEditText","enteredText":"","lastEnteredText":"","sceneEditTextConfig":{"hintText":"Enter+text","horizontalLayoutWidth":50,"isBold":true,"isItalic":false,"isPassword":false,"populateWithValue":false,"singleLineOnly":true,"stringVariable":{"varName":"nwFavrite924"},"textColor":-1,"visibilityVariable":{"varName":"shwFvTxtBx491"}},"guid":-6687848284902933067,"iconRes":2131231685,"lastRefreshValue":0},{"type":"SceneWebView","sceneWebViewConfig":{"closeSceneOnPress":false,"enableJavaScript":true,"enableSwipeNavigation":false,"height":70,"padding":"0","url":"\u003c!DOCTYPE+html\u003e\n\u003chtml+lang\u003d\"en\"\u003e\n\u003chead\u003e\n\u003cmeta+charset\u003d\"UTF-8\"\u003e\n\u003ctitle\u003eDynamic+List+-+Trackpad+Overlay+Scroll\u003c/title\u003e\n\u003cstyle\u003e\n:root{\n++--accent-red:+#ff0000;\n++--accent-red-rgba-20:+rgba(255,0,0,0.2);\n++--accent-red-glow:+rgba(255,0,0,0.8);\n++--trackpad-glow:+rgba(160,160,160,0.65);\n++--trackpad-glow-strong:+rgba(160,160,160,0.95);\n++--delete-line-grey:+grey;\n++--delete-inset:+12px;\n++--pinned-gold:+#ffd700;\n}\nbody+{\n++background-color:+#000;\n++margin:+0;\n++padding:+20px;\n++font-family:+Arial,+sans-serif;\n++color:+#fff;\n}\nh2+{\n++color:+#fff;\n++text-align:+center;\n++font-size:+48px;\n++margin-bottom:+30px;\n}\nul+{+list-style:+none;+padding:+0;+margin:+0;+}\nli+{\n++display:+flex;\n++align-items:+flex-start;\n++background:+#111;\n++margin:+30px+0;\n++padding:+10px;\n++width:+100%;\n++color:+#fff;\n++border:+2px+solid+#fff;\n++border-radius:+20px;\n++box-sizing:+border-box;\n++position:+relative;\n++transition:+background+0.3s,+border-color+0.3s;\n}\nli.highlighted+{\n++background:+#333;\n++border-color:+var(--accent-red);\n}\nli.pinned+{\n++border-color:+var(--pinned-gold);\n}\nli.highlighted.pinned+{\n++background:+#333;\n++border-color:+var(--pinned-gold);\n}\n.scroll-wrapper+{\n++flex:+1;\n++padding:+5px;\n++overflow:+hidden;\n++position:+relative;\n++max-height:+{lv\u003dmxHght692};\n}\n.text-box+{\n++font-size:+{lv\u003dfntSz632}px;\n++white-space:+pre-wrap;\n++word-break:+break-word;\n++padding-top:+2ch;\n++padding-bottom:+2ch;\n++user-select:+none;\n++-webkit-user-select:+none;\n++-moz-user-select:+none;\n++-ms-user-select:+none;\n}\n#submitBtn+{\n++position:+fixed;\n++top:+10px;\n++left:+50%;\n++transform:+translateX(-50%);\n++display:+none;\n++padding:+12px+18px;\n++font-size:+36px;\n++background:+rgba(255,0,0,0.35);\n++color:+#fff;\n++border:+2px+solid+rgba(255,0,0,0.6);\n++border-radius:+15px;\n++cursor:+pointer;\n++z-index:+9999;\n++box-shadow:+0+4px+8px+rgba(0,0,0,0.35);\n++transition:+box-shadow+0.18s,+transform+0.08s,+background+0.12s;\n}\n#highlightAllWrapper+{\n++position:+fixed;\n++top:+-50px;\n++left:+calc(50%+-+250px);\n++width:+120px;\n++height:+120px;\n++display:+none;\n++justify-content:+center;\n++align-items:+center;\n++z-index:+9999;\n++padding:+40px;\n++box-sizing:+content-box;\n}\n#highlightAllBtn+{\n++width:+60px;\n++height:+60px;\n++background:+rgba(0,0,0,0.55)+!important;\n++color:+var(--accent-red);\n++border:+2px+solid+var(--accent-red);\n++border-radius:+50%;\n++text-align:+center;\n++line-height:+60px;\n++font-size:+30px;\n++cursor:+pointer;\n++transition:+background+0.2s,+box-shadow+0.18s,+transform+0.1s;\n}\n#highlightAllBtn.none-mode+{\n++background:+var(--accent-red-rgba-20)+!important;\n}\n.delete-tab+{\n++position:+absolute;\n++top:+10px;\n++width:+90px;\n++height:+70px;\n++cursor:+pointer;\n++z-index:+20;\n}\n.delete-tab::before+{\n++content:+\u0027\u0027;\n++position:+absolute;\n++top:+0;\n++left:+0;\n++width:+90px;\n++height:+6px;\n++background-color:+var(--delete-line-grey);\n++border-radius:+3px;\n++transition:+background-color+0.2s;\n++animation-delay:+var(--pulse-delay,+0ms);\n++animation-fill-mode:+both;\n}\n@keyframes+delete-line-pulse+{\n++0%+{+background-color:+var(--delete-line-grey);+transform:+translateY(0);+opacity:1;+}\n++50%+{+background-color:+var(--accent-red);+transform:+translateY(-1px);+opacity:1;+}\n++100%+{+background-color:+var(--delete-line-grey);+transform:+translateY(0);+opacity:1;+}\n}\n.delete-tab.active::before+{\n++animation-name:+delete-line-pulse;\n++animation-duration:1.2s;\n++animation-iteration-count:infinite;\n++animation-timing-function:ease-in-out;\n}\n@keyframes+trackpad-breathe+{\n++0%+{+box-shadow:0+6px+12px+rgba(160,160,160,0.06);+transform:scale(1);+opacity:0.72;+}\n++50%+{+box-shadow:0+10px+24px+rgba(160,160,160,0.10);+transform:scale(1.01);+opacity:0.82;+}\n++100%+{+box-shadow:0+6px+12px+rgba(160,160,160,0.06);+transform:scale(1);+opacity:0.72;+}\n}\n.slider-container+{\n++width:+72px;\n++position:absolute;\n++top:10px;\n++height:calc(100%+-+20px);\n++border-radius:12px;\n++cursor:+grab;\n++touch-action:none;\n++transition:+box-shadow+0.18s,+opacity+0.2s,+transform+0.18s;\n++z-index:15;\n++display:none;\n++opacity:0.7;\n++border:none;\n++animation:+trackpad-breathe+2.8s+infinite+ease-in-out;\n}\n.slider-container.dragging+{\n++box-shadow:0+0+22px+var(--trackpad-glow-strong);\n++opacity:0.85;\n++transform:scale(1.01);\n++animation:none;\n}\nbody.left-handed+.slider-container+{\n++left:10px;\n++right:auto;\n++background:+linear-gradient(to+right,+rgba(100,100,100,0.55),+rgba(100,100,100,0.15));\n}\nbody.right-handed+.slider-container+{\n++right:10px;\n++left:auto;\n++background:+linear-gradient(to+left,+rgba(100,100,100,0.55),+rgba(100,100,100,0.15));\n}\nbody.right-handed+.delete-tab+{+left:+var(--delete-inset);+right:auto;+}\nbody.left-handed+.delete-tab+{+right:+var(--delete-inset);+left:auto;+}\n@keyframes+pulsate-intense+{\n++0%+{+box-shadow:+0+0+5px+rgba(255,0,0,0.6),+0+0+15px+rgba(255,0,0,0.8);+border-color:+rgba(255,0,0,0.6);+}\n++50%+{+box-shadow:+0+0+15px+rgba(255,0,0,1),+0+0+35px+rgba(255,0,0,1);+border-color:+rgba(255,0,0,1);+}\n++100%+{+box-shadow:+0+0+5px+rgba(255,0,0,0.6),+0+0+15px+rgba(255,0,0,0.8);+border-color:+rgba(255,0,0,0.6);+}\n}\nbody.delete-mode+#submitBtn,\nbody.delete-mode+#highlightAllBtn,\nbody.delete-mode+li.highlighted:not(.pinned)+{\n++animation:+pulsate-intense+1.2s+infinite+ease-in-out;\n++-webkit-animation:+pulsate-intense+1.2s+infinite+ease-in-out;\n}\n\n.pinned-icon+{\n++++position:+absolute;\n++++top:+5px;\n++++left:+50%;\n++++transform:+translateX(-50%);\n++++color:+#ffd700;\n++++font-size:+24px;\n++++z-index:+10;\n++++pointer-events:+none;\n}\n\u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\u003ch2\u003e⭐️+Favorites\u003c/h2\u003e\n\u003cul+id\u003d\"dynamicList\"\u003e\u003c/ul\u003e\n\u003cbutton+id\u003d\"submitBtn\"\u003e🗑️\u003c/button\u003e\n\u003cdiv+id\u003d\"highlightAllWrapper\"\u003e\n++\u003cbutton+id\u003d\"highlightAllBtn\"\u003eAll\u003c/button\u003e\n\u003c/div\u003e\n\u003ctextarea+id\u003d\"handedVar\"+style\u003d\"display:none\"\u003e{lv\u003dorientScrn475}\u003c/textarea\u003e\n\u003ctextarea+id\u003d\"rawData\"+style\u003d\"display:none\"\u003e{lv\u003dfavritsStrng724}\u003c/textarea\u003e\n\u003ctextarea+id\u003d\"pindArryData\"+style\u003d\"display:none\"\u003e{lv\u003dpindArry834}\u003c/textarea\u003e\n\n\u003cscript\u003e\nconst+triggerBase+\u003d+\"http://localhost:8080/infiniteClipboardTrigger\";\nconst+raw+\u003d+document.getElementById(\u0027rawData\u0027).value+||+\u0027\u0027;\nconst+list+\u003d+document.getElementById(\u0027dynamicList\u0027);\nconst+submitBtn+\u003d+document.getElementById(\u0027submitBtn\u0027);\nconst+highlightAllWrapper+\u003d+document.getElementById(\u0027highlightAllWrapper\u0027);\nconst+highlightAllBtn+\u003d+document.getElementById(\u0027highlightAllBtn\u0027);\nlet+deleteMode+\u003d+false;\nconst+rawVal+\u003d+document.getElementById(\"handedVar\").value.trim();\nconst+leftHanded+\u003d+rawVal.toLowerCase()+\u003d\u003d\u003d+\"true\";\ndocument.body.classList.add(leftHanded+?+\"left-handed\"+:+\"right-handed\");\n\n//+Parse+the+MacroDroid+array+variable\nconst+pinnedIndexes+\u003d+[];\ntry+{\n++++const+pinnedData+\u003d+document.getElementById(\u0027pindArryData\u0027).value;\n++++if+(pinnedData)+{\n++++++++pinnedIndexes.push(...pinnedData.split(\u0027,\u0027).map(item+\u003d\u003e+parseInt(item.trim(),+10)).filter(i+\u003d\u003e+!isNaN(i)));\n++++}\n}+catch(e)+{+console.error(\"Error+parsing+pinned+array:\",+e);+}\n\nfunction+updateSubmitBtn()+{\n++const+highlightedItems+\u003d+list.querySelectorAll(\u0027li.highlighted\u0027);\n++if(highlightedItems.length+\u003d\u003d\u003d+0)+deleteMode+\u003d+false;\n++submitBtn.style.display+\u003d+deleteMode+?+\u0027block\u0027+:+\u0027none\u0027;\n++highlightAllWrapper.style.display+\u003d+deleteMode+?+\u0027flex\u0027+:+\u0027none\u0027;\n++document.body.classList.toggle(\"delete-mode\",+deleteMode);\n++const+tabs+\u003d+Array.from(document.querySelectorAll(\u0027.delete-tab\u0027));\n++tabs.forEach((tab,+i)+\u003d\u003e+{\n++++++if+(deleteMode)+{\n++++++++++tab.classList.add(\u0027active\u0027);\n++++++++++tab.style.setProperty(\u0027--pulse-delay\u0027,+`${i*90}ms`);\n++++++}+else+{\n++++++++++tab.classList.remove(\u0027active\u0027);\n++++++++++tab.style.removeProperty(\u0027--pulse-delay\u0027);\n++++++}\n++});\n++if(!deleteMode)+list.querySelectorAll(\u0027li.highlighted\u0027).forEach(li+\u003d\u003e+li.classList.remove(\u0027highlighted\u0027));\n++if(deleteMode){\n++++++const+nonPinnedItems+\u003d+Array.from(list.querySelectorAll(\u0027li:not(.pinned)\u0027));\n++++++const+allHighlighted+\u003d+nonPinnedItems.length+\u003e+0+\u0026\u0026+nonPinnedItems.every(li+\u003d\u003e+li.classList.contains(\u0027highlighted\u0027));\n++++++highlightAllBtn.innerText+\u003d+allHighlighted+?+\"X\"+:+\"All\";\n++++++highlightAllBtn.classList.toggle(\u0027none-mode\u0027,+allHighlighted);\n++}\n}\n\nsubmitBtn.onclick+\u003d+()+\u003d\u003e+{\n++const+highlightedItems+\u003d+Array.from(list.querySelectorAll(\u0027li.highlighted\u0027));\n++if(highlightedItems.length+\u003d\u003d\u003d+0)+return;\n++const+allIndexes+\u003d+highlightedItems.map(li+\u003d\u003e+li.dataset.originalIndex).join(\u0027『‰』\u0027);\n++fetch(`${triggerBase}?slctedItm147\u003d${encodeURIComponent(allIndexes)}\u0026dlteFavrite427\u003dtrue\u0026favritsItm264\u003dtrue\u0026t\u003d${Date.now()}`).catch(()\u003d\u003e{});\n++highlightedItems.forEach(li+\u003d\u003e+li._resizeObserver?.disconnect());\n++highlightedItems.forEach(li+\u003d\u003e+li.remove());\n++updateSubmitBtn();\n};\n\nhighlightAllBtn.onclick+\u003d+()+\u003d\u003e+{\n++if(!deleteMode)+return;\n++const+nonPinnedItems+\u003d+Array.from(list.querySelectorAll(\u0027li:not(.pinned)\u0027));\n++const+allHighlighted+\u003d+nonPinnedItems.every(li+\u003d\u003e+li.classList.contains(\u0027highlighted\u0027));\n++nonPinnedItems.forEach(li+\u003d\u003e+li.classList.toggle(\u0027highlighted\u0027,+!allHighlighted));\n++highlightAllBtn.innerText+\u003d+allHighlighted+?+\"X\"+:+\"All\";\n++highlightAllBtn.classList.toggle(\u0027none-mode\u0027,+allHighlighted);\n++updateSubmitBtn();\n};\n\nconst+entries+\u003d+raw.split(\u0027『‰』\u0027).filter(entry+\u003d\u003e+entry.trim()+!\u003d\u003d+\u0027\u0027);\n\nif+(entries.length+\u003e+0)+{\n++++entries.forEach((text,+index)+\u003d\u003e+{\n++++++++const+li+\u003d+document.createElement(\u0027li\u0027);\n++++++++li.dataset.originalIndex+\u003d+index;\n++++++++\n++++++++const+wrapper+\u003d+document.createElement(\u0027div\u0027);\n++++++++wrapper.className+\u003d+\u0027scroll-wrapper\u0027;\n++++++++\n++++++++const+textDiv+\u003d+document.createElement(\u0027div\u0027);\n++++++++textDiv.className+\u003d+\u0027text-box\u0027;\n++++++++textDiv.innerHTML+\u003d+text.replace(/\u0026/g,\"\u0026amp;\").replace(/\u003c/g,\"\u0026lt;\").replace(/\u003e/g,\"\u0026gt;\")\n++++++++++++++++++++++++++++++++.replace(/\"/g,\"\u0026quot;\").replace(/\u0027/g,\"\u0026#039;\");\n++++++++if(leftHanded){+textDiv.style.paddingLeft\u003d\u00273ch\u0027;+textDiv.style.paddingRight\u003d\u00271ch\u0027;+}\n++++++++else{+textDiv.style.paddingRight\u003d\u00273ch\u0027;+textDiv.style.paddingLeft\u003d\u00271ch\u0027;+}\n++++++++textDiv.style.paddingTop\u003d\u00272ch\u0027;+textDiv.style.paddingBottom\u003d\u00272ch\u0027;\n++++++++wrapper.appendChild(textDiv);\n++++++++li.appendChild(wrapper);\n\n++++++++//+---+DELETE+TAB+FOR+ALL+ITEMS+---\n++++++++const+tab+\u003d+document.createElement(\u0027div\u0027);\n++++++++tab.className\u003d\u0027delete-tab\u0027;\n++++++++li.appendChild(tab);\n++++++++let+pressTimer\u003dnull;\n++++++++const+clearPress\u003d()\u003d\u003e{if(pressTimer){clearTimeout(pressTimer);pressTimer\u003dnull;}};\n++++++++tab.addEventListener(\u0027touchstart\u0027,+e+\u003d\u003e+{\n++++++++++++e.stopPropagation();\n++++++++++++if(li.classList.contains(\u0027pinned\u0027))+return;\n++++++++++++if(e.touches.length!\u003d\u003d1)+return;\n++++++++++++clearPress();\n++++++++++++pressTimer\u003dsetTimeout(()\u003d\u003e{\n++++++++++++++++deleteMode\u003d!deleteMode;\n++++++++++++++++if(deleteMode)+li.classList.add(\u0027highlighted\u0027);\n++++++++++++++++updateSubmitBtn();\n++++++++++++},500);\n++++++++},{passive:true});\n++++++++tab.addEventListener(\u0027touchend\u0027,+e\u003d\u003e{+e.stopPropagation();+clearPress();+},{passive:true});\n++++++++tab.addEventListener(\u0027touchcancel\u0027,+e\u003d\u003e{+e.stopPropagation();+clearPress();+},{passive:true});\n++++++++tab.addEventListener(\u0027click\u0027,+e+\u003d\u003e+e.stopPropagation());\n\n++++++++//+---+SLIDER+---\n++++++++const+sliderContainer+\u003d+document.createElement(\u0027div\u0027);\n++++++++sliderContainer.className\u003d\u0027slider-container\u0027;\n++++++++li.appendChild(sliderContainer);\n++++++++sliderContainer.addEventListener(\u0027click\u0027,+e\u003d\u003ee.stopPropagation());\n++++++++\n++++++++//+**+SIMPLIFIED+HOLD-TO-PIN+LOGIC+**\n++++++++let+holdTimer+\u003d+null;\n++++++++const+holdDuration+\u003d+500;\n++++++++\n++++++++textDiv.addEventListener(\u0027touchstart\u0027,+e+\u003d\u003e+{\n++++++++++++e.stopPropagation();\n++++++++++++if+(e.touches.length+!\u003d\u003d+1)+return;\n++++++++++++clearTimeout(holdTimer);\n\n++++++++++++const+startY+\u003d+e.touches[0].clientY;\n++++++++++++const+initialScrollTop+\u003d+list.scrollTop;\n++++++++++++let+hasMoved+\u003d+false;\n\n++++++++++++const+checkMovement+\u003d+(ev)+\u003d\u003e+{\n++++++++++++++++const+currentY+\u003d+ev.touches[0].clientY;\n++++++++++++++++const+dy+\u003d+Math.abs(currentY+-+startY);\n++++++++++++++++if+(dy+\u003e+15+||+Math.abs(list.scrollTop+-+initialScrollTop)+\u003e+15)+{\n++++++++++++++++++++hasMoved+\u003d+true;\n++++++++++++++++++++clearTimeout(holdTimer);\n++++++++++++++++++++textDiv.removeEventListener(\u0027touchmove\u0027,+checkMovement);\n++++++++++++++++}\n++++++++++++};\n\n++++++++++++textDiv.addEventListener(\u0027touchmove\u0027,+checkMovement,+{+passive:+true+});\n\n++++++++++++holdTimer+\u003d+setTimeout(()+\u003d\u003e+{\n++++++++++++++++textDiv.removeEventListener(\u0027touchmove\u0027,+checkMovement);\n++++++++++++++++if+(hasMoved)+return;\n\n++++++++++++++++const+originalIndex+\u003d+parseInt(li.dataset.originalIndex,+10);\n++++++++++++++++fetch(`${triggerBase}?pindEntry628\u003d${originalIndex}\u0026t\u003d${Date.now()}`).catch(()\u003d\u003e{});\n++++++++++++++++li.classList.toggle(\u0027pinned\u0027);\n++++++++++++},+holdDuration);\n++++++++},+{+passive:+true+});\n\n++++++++textDiv.addEventListener(\u0027touchend\u0027,+()+\u003d\u003e+{\n++++++++++++clearTimeout(holdTimer);\n++++++++});\n++++++++\n++++++++textDiv.addEventListener(\u0027touchcancel\u0027,+()+\u003d\u003e+{\n++++++++++++clearTimeout(holdTimer);\n++++++++});\n++++++++\n++++++++//+Check+if+the+item+is+already+pinned+and+add+the+icon+on+load\n++++++++const+originalIndex+\u003d+parseInt(li.dataset.originalIndex,+10);\n++++++++if+(pinnedIndexes.includes(originalIndex))+{\n++++++++++++li.classList.add(\u0027pinned\u0027);\n++++++++++++const+pinnedIcon+\u003d+document.createElement(\u0027div\u0027);\n++++++++++++pinnedIcon.className+\u003d+\u0027pinned-icon\u0027;\n++++++++++++pinnedIcon.innerHTML+\u003d+\u0027📌\u0027;\n++++++++++++li.appendChild(pinnedIcon);\n++++++++}\n\n++++++++//+---+HEIGHT+\u0026+TOUCHPAD+LOGIC+---\n++++++++const+adjustHeights+\u003d+()+\u003d\u003e+{\n++++++++++++const+style+\u003d+window.getComputedStyle(textDiv);\n++++++++++++const+paddingTop+\u003d+parseFloat(style.paddingTop)||0;\n++++++++++++const+paddingBottom+\u003d+parseFloat(style.paddingBottom)||0;\n++++++++++++const+contentHeight+\u003d+textDiv.scrollHeight-paddingTop-paddingBottom;\n++++++++++++const+maxHeight+\u003d+{lv\u003dmxHght692};\n++++++++++++const+finalHeight+\u003d+Math.min(contentHeight+paddingTop+paddingBottom,+maxHeight);\n++++++++++++wrapper.style.height\u003dfinalHeight+\u0027px\u0027;\n++++++++++++wrapper.style.overflow\u003d\u0027hidden\u0027;\n++++++++++++if(contentHeight+paddingTop+paddingBottom\u003emaxHeight){\n++++++++++++++++sliderContainer.style.display\u003d\u0027block\u0027;\n++++++++++++++++sliderContainer.style.height\u003dfinalHeight+\u0027px\u0027;\n++++++++++++}+else+sliderContainer.style.display\u003d\u0027none\u0027;\n++++++++};\n++++++++adjustHeights();\n++++++++const+ro+\u003d+new+ResizeObserver(adjustHeights);\n++++++++ro.observe(textDiv);\n++++++++li._resizeObserver+\u003d+ro;\n\n++++++++let+dragging\u003dfalse,lastY\u003d0,lastTime\u003d0,velocityPxPerSec\u003d0,lastPositions\u003d[];\n++++++++sliderContainer.addEventListener(\u0027pointerdown\u0027,+e\u003d\u003e{\n++++++++++++dragging\u003dtrue;lastY\u003de.clientY;lastTime\u003dperformance.now();lastPositions\u003d[];velocityPxPerSec\u003d0;\n++++++++++++sliderContainer.classList.add(\u0027dragging\u0027);\n++++++++++++sliderContainer.setPointerCapture?.(e.pointerId);\n++++++++++++if(wrapper._momentumAnim){cancelAnimationFrame(wrapper._momentumAnim);wrapper._momentumAnim\u003dnull;}\n++++++++});\n++++++++const+onMove\u003dev\u003d\u003e{\n++++++++++++if(!dragging)+return;\n++++++++++++const+now\u003dperformance.now();\n++++++++++++const+dt\u003dnow-lastTime;\n++++++++++++const+dy\u003dev.clientY-lastY;\n++++++++++++wrapper.scrollTop-\u003ddy;\n++++++++++++if(dt\u003e0){+lastPositions.push({dy,dt});+if(lastPositions.length\u003e6)+lastPositions.shift();\n++++++++++++++++let+sum\u003d0,div\u003d0;+for(const+s+of+lastPositions){sum+\u003d(s.dy/s.dt);div+\u003d1;}\n++++++++++++++++velocityPxPerSec\u003d(sum/div)*1000;\n++++++++++++}\n++++++++++++lastY\u003dev.clientY;+lastTime\u003dnow;\n++++++++};\n++++++++const+onUp\u003dev\u003d\u003e{\n++++++++++++if(!dragging)+return;\n++++++++++++dragging\u003dfalse;\n++++++++++++sliderContainer.classList.remove(\u0027dragging\u0027);\n++++++++++++try{sliderContainer.releasePointerCapture?.(ev.pointerId);}catch(e){}\n++++++++++++let+velocity\u003d-velocityPxPerSec;\n++++++++++++const+density\u003dwindow.devicePixelRatio||1;\n++++++++++++const+MIN_FLING_PX_PER_SEC\u003d50*density;\n++++++++++++const+MAX_FLING_PX_PER_SEC\u003d8000*density;\n++++++++++++const+SCROLL_FRICTION\u003d0.015;\n++++++++++++const+GRAVITY_EARTH\u003d9.80665,INCHES_PER_METER\u003d39.37;\n++++++++++++const+PHYSICAL_COEFF\u003dGRAVITY_EARTH*INCHES_PER_METER*density*160*0.84;\n++++++++++++const+DECELERATION_RATE\u003dMath.log(0.78)/Math.log(0.9);\n++++++++++++const+getDecel\u003dl\u003d\u003eMath.log(0.35*Math.abs(l)/(SCROLL_FRICTION*PHYSICAL_COEFF));\n++++++++++++const+getDistance\u003dv\u003d\u003e{\n++++++++++++++++const+l\u003dgetDecel(v);\n++++++++++++++++return+SCROLL_FRICTION*PHYSICAL_COEFF*Math.exp(DECELERATION_RATE/(DECELERATION_RATE-1)*l);\n++++++++++++};\n++++++++++++const+getDuration\u003dv\u003d\u003e{\n++++++++++++++++const+l\u003dgetDecel(v);\n++++++++++++++++return+Math.round(1000*Math.exp(l/(DECELERATION_RATE-1)));\n++++++++++++};\n++++++++++++if(Math.abs(velocity)\u003cMIN_FLING_PX_PER_SEC)+return;\n++++++++++++velocity\u003dMath.max(-MAX_FLING_PX_PER_SEC,Math.min(MAX_FLING_PX_PER_SEC,velocity));\n++++++++++++const+distance\u003dgetDistance(velocity)*Math.sign(velocity);\n++++++++++++const+duration\u003dgetDuration(velocity);\n++++++++++++if(!duration||!distance)+return;\n++++++++++++const+start\u003dwrapper.scrollTop;\n++++++++++++const+maxScroll\u003dwrapper.scrollHeight-wrapper.clientHeight;\n++++++++++++let+target\u003dMath.round(start+distance);\n++++++++++++if(target\u003c0)+target\u003d0;\n++++++++++++if(target\u003emaxScroll)+target\u003dmaxScroll;\n++++++++++++const+startTime\u003dperformance.now();\n++++++++++++function+easeOut(t){return+1-Math.pow(1-t,3);}\n++++++++++++function+step(){\n++++++++++++++++const+now\u003dperformance.now();\n++++++++++++++++const+t\u003dMath.min((now-startTime)/duration,1);\n++++++++++++++++wrapper.scrollTop\u003dstart+(target-start)*easeOut(t);\n++++++++++++++++if(t\u003c1)+wrapper._momentumAnim\u003drequestAnimationFrame(step);\n++++++++++++}\n++++++++++++step();\n++++++++};\n++++++++sliderContainer.addEventListener(\u0027pointermove\u0027,onMove);\n++++++++sliderContainer.addEventListener(\u0027pointerup\u0027,onUp);\n++++++++sliderContainer.addEventListener(\u0027pointercancel\u0027,onUp);\n\n++++++++//+---+CLICK+HANDLER+---\n++++++++li.addEventListener(\u0027click\u0027,+e\u003d\u003e{\n++++++++++++if(deleteMode){\n++++++++++++++++if(li.classList.contains(\u0027pinned\u0027))+return;\n++++++++++++++++li.classList.toggle(\u0027highlighted\u0027);\n++++++++++++++++updateSubmitBtn();\n++++++++++++}+else+{\n++++++++++++++++const+originalIndex+\u003d+parseInt(li.dataset.originalIndex,+10);\n++++++++++++++++fetch(`${triggerBase}?slctedItm147\u003d${encodeURIComponent(originalIndex)}\u0026favritsItm264\u003dtrue\u0026t\u003d${Date.now()}`).catch(()\u003d\u003e{});\n++++++++++++}\n++++++++});\n\n++++++++list.appendChild(li);\n++++});\n}\nupdateSubmitBtn();\n\u003c/script\u003e\n\u003c/body\u003e\n\u003c/html\u003e\n","variableUpdateValue":{"type":"None"},"visibilityVariable":{"varName":"shwClpbord537"},"width":100},"guid":-6233522398748139778,"iconRes":2131231733,"lastRefreshValue":0},{"type":"SceneHorizontalLayout","children":[{"type":"SceneIcon","sceneIconConfig":{"alignment":"Start","closeSceneOnPress":false,"sceneIconData":{"imagePackageName":"com.arlosoft.macrodroid","imageResourceId":2131231781,"imageResourceName":"ic_error_outline_white_24dp"},"size":25,"tintColor":-1118482,"tintEnabled":true,"variableToUpdate":{"varName":"shwInfo534"},"variableUpdateValue":{"type":"BooleanValue","isToggle":true,"label":false}},"guid":-4637552634547144126,"iconRes":2131231505,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":false,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"++++++++++++++++++++++++++++++","textAlignment":"Start","textColor":-1,"textSize":"20","visibilityVariable":{"varName":"shwMnu247"}},"guid":-7059819180842117567,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneIcon","sceneIconConfig":{"alignment":"End","closeSceneOnPress":false,"sceneIconData":{"imagePackageName":"com.arlosoft.macrodroid","imageResourceId":2131231873,"imageResourceName":"ic_list_white_24dp"},"size":23,"tintColor":-1118482,"tintEnabled":true,"variableToUpdate":{"varName":"shwMnu247"},"variableUpdateValue":{"type":"BooleanValue","isToggle":true,"label":false}},"guid":-6571462159544729217,"iconRes":2131231505,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":false,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"+++++\n","textAlignment":"Start","textColor":-1,"textSize":"20"},"guid":-6548736193459284538,"iconRes":2131232676,"lastRefreshValue":0}],"sceneHorizontalLayoutConfig":{"alignment":"End","visibilityVariable":{"varName":"shwMnu247"}},"iconResId":2131231503,"guid":-6377742501017029862,"iconRes":2131231503,"lastRefreshValue":0},{"type":"SceneHorizontalDivider","config":{"dividerColor":-1,"dividerHeight":2,"padding":16,"visibilityVariable":{"varName":"shwMnu247"}},"guid":-5456630672902777100,"iconRes":2131231504,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":true,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"\u003cp+style\u003d\"font-size:+{lv\u003dfntSz632}px;\"\u003e\u003cu\u003e⭐️+Favorites+Tab+Information:\u003c/u\u003e\u003c/p\u003e\n","textAlignment":"Center","textColor":-1,"textSize":"16","visibilityVariable":{"varName":"shwInfo534"}},"guid":-7487037744727588419,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":false,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"-+Pinning:\nHold+an+entry+to+pin/unpin+it+to+the+top+of+the+list.+Pinned+entries+will+not+be+selectable+for+deletion.\n\n-+Delete+Mode:+\nTo+delete+an+entry,+hold+the+line+icon+in+the+top+corner+of+the+text+box+to+activate+delete+mode.+While+in+delete+mode,+a+\"Select+All\"+button+and+a+trash+can+icon+(\"🗑\")+will+appear+at+the+top+of+the+page.+Tap+an+entry+to+highlight+or+unhighlight+it+for+deletion.+Tap+the+trash+button+to+confirm+and+delete+the+selected+entries.It+will+delete+the+first+occurrence+of+a+duplicate+entry+unless+the+duplicates+are+also+highlighted.\n\n-+Import+entry+into+clipboard:\nTap+the+entry+to+import+it+into+your+device\u0027s+clipboard.++++\n\n-+Scrollbar:\nOn+entry+boxes+with+large+text+entries+that+exceed+the+\"box+size\"+limit,+a+scrollbar+will+appear+on+the+side+of+the+textbox.+Use+this+to+scroll+the+text.\n\n","textAlignment":"Start","textColor":-1,"textSize":"12","visibilityVariable":{"varName":"shwInfo534"}},"guid":-6697721261623873826,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":true,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"\n\u003ca+href\u003d\"https://www.macrodroidforum.com/index.php?threads/%F0%9F%93%8B-infinite-clipboard-%E2%99%BE%EF%B8%8F.8342/\"\u003e【Click+here+to+visit+the+forum+page】\u003c/a\u003e\n\n","textAlignment":"Center","textColor":-1,"textSize":"16","visibilityVariable":{"varName":"shwInfo534"}},"guid":-8225105953890078385,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneHorizontalDivider","config":{"dividerColor":-1,"dividerHeight":2,"padding":16,"visibilityVariable":{"varName":"shwInfo534"}},"guid":-6088028487903923825,"iconRes":2131231504,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig