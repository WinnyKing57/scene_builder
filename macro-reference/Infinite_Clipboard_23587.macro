23}","textAlignment":"Start","textColor":-1,"textSize":"10"},"guid":-8539563301056485989,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":false,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"","textAlignment":"Start","textColor":-1,"textSize":"10","visibilityVariable":{"varName":"shwSpcr841"}},"guid":-4850099003889462489,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneIcon","sceneIconConfig":{"alignment":"End","closeSceneOnPress":false,"sceneIconData":{"imagePackageName":"com.arlosoft.macrodroid","imageResourceId":2131231873,"imageResourceName":"ic_list_white_24dp"},"size":23,"tintColor":-1118482,"tintEnabled":true,"variableToUpdate":{"varName":"shwMnu247"},"variableUpdateValue":{"type":"BooleanValue","isToggle":true,"label":false}},"guid":-7847397488319726500,"iconRes":2131231505,"lastRefreshValue":0}],"sceneHorizontalLayoutConfig":{"alignment":"Center","visibilityVariable":{"varName":"shwClpbord537"}},"iconResId":2131231503,"guid":-5917476496798599073,"iconRes":2131231503,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":false,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"Logger+is+disabled","textAlignment":"Center","textColor":-4456444,"textSize":"8","visibilityVariable":{"varName":"shwDisbldNote724"}},"guid":-7910212227629339572,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneWebView","sceneWebViewConfig":{"closeSceneOnPress":false,"enableJavaScript":true,"enableSwipeNavigation":false,"height":75,"padding":"0","url":"\u003c!DOCTYPE+html\u003e\n\u003chtml+lang\u003d\"en\"\u003e\n\u003chead\u003e\n\u003cmeta+charset\u003d\"UTF-8\"\u003e\n\u003ctitle\u003eDynamic+List+-+Trackpad+Overlay+Scroll\u003c/title\u003e\n\u003cstyle\u003e\n/*+\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n+++ROOT+VARIABLES\n+++-------------------------\n+++Define+commonly+used+colors,+offsets,+and+glow+effects\n+++so+they+can+be+reused+and+easily+updated.\n+++\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d+*/\n:root{\n++--accent-red:+#ff0000;+/*+Primary+red+color+for+delete/highlight+mode+*/\n++--accent-red-rgba-20:+rgba(255,0,0,0.2);+/*+Transparent+red+for+subtle+backgrounds+*/\n++--accent-red-glow:+rgba(255,0,0,0.8);+/*+Strong+red+glow+for+pulsating+effect+*/\n++--trackpad-glow:+rgba(160,160,160,0.65);+/*+Trackpad+light+glow+effect+*/\n++--trackpad-glow-strong:+rgba(160,160,160,0.95);+/*+Stronger+glow+when+dragging+*/\n++--delete-line-grey:+grey;+/*+Default+color+of+the+delete+tab+line+*/\n++--delete-inset:+12px;+/*+Horizontal+padding+for+delete+tab+from+edge+*/\n}\n\n/*+\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n+++BODY+AND+TYPOGRAPHY\n+++-------------------------\n+++Main+page+layout+and+global+text+styling\n+++\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d+*/\nbody+{\n++background-color:+#000;+/*+Black+background+for+contrast+*/\n++margin:+0;\n++padding:+20px;+/*+Padding+around+content+*/\n++font-family:+Arial,+sans-serif;\n++color:+#fff;+/*+Default+text+color+*/\n++/*+NEW:+Disable+text+selection+on+the+entire+body+*/\n++-webkit-user-select:+none;\n++-moz-user-select:+none;\n++-ms-user-select:+none;\n++user-select:+none;\n}\n\n/*+Heading+style+*/\nh2+{\n++color:+#fff;\n++text-align:+center;\n++font-size:+48px;+/*+Large+font+for+title+*/\n++margin-bottom:+30px;\n}\n\n/*+Remove+default+list+styling+*/\nul+{\n++list-style:+none;\n++padding:+0;\n++margin:+0;\n}\n\n/*+\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n+++LIST+ITEM+STYLING\n+++-------------------------\n+++Each+clipboard+entry+is+a+list+item+\u003cli\u003e\n+++\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d+*/\nli+{\n++display:+flex;+/*+Flex+to+allow+scroll+wrapper+and+delete+tab+side+by+side+*/\n++align-items:+flex-start;+/*+Align+text+at+the+top+*/\n++background:+#111;+/*+Dark+background+for+each+item+*/\n++margin:+30px+0;+/*+Vertical+spacing+between+items+*/\n++padding:+10px;+/*+Inner+spacing+*/\n++width:+100%;\n++color:+#fff;\n++border:+2px+solid+#fff;+/*+Default+border+*/\n++border-radius:+20px;+/*+Rounded+corners+*/\n++box-sizing:+border-box;+/*+Include+padding/border+in+width+*/\n++position:+relative;+/*+Needed+for+delete+tab+positioning+*/\n++transition:+background+0.3s,+border-color+0.3s;+/*+Smooth+highlight+transition+*/\n}\n\n/*+Highlighted+items+during+delete+mode+*/\nli.highlighted+{\n++background:+#333;\n++border-color:+var(--accent-red);+/*+Red+border+to+indicate+selection+*/\n}\n\n/*+\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n+++SCROLL+WRAPPER\n+++-------------------------\n+++Container+for+the+text+box.+Handles+scrolling+inside+list+item.\n+++\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d+*/\n.scroll-wrapper+{\n++flex:+1;+/*+Take+remaining+space+*/\n++padding:+5px;\n++overflow:+hidden;+/*+Hide+scroll+until+slider+is+shown+*/\n++position:+relative;\n++max-height:+{lv\u003dmxHght692};+/*+Placeholder+for+dynamic+max+height+*/\n}\n\n/*+\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n+++TEXT+BOX+STYLING\n+++-------------------------\n+++Container+for+clipboard+text\n+++\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d+*/\n.text-box+{\n++font-size:+{lv\u003dfntSz632}px;+/*+Placeholder+for+dynamic+font+size+*/\n++white-space:+pre-wrap;+/*+Preserve+line+breaks+and+wrap+text+*/\n++word-break:+break-word;+/*+Break+long+words+*/\n++padding-top:+2ch;+/*+Vertical+padding+*/\n++padding-bottom:+2ch;\n++padding-left:+1ch;\n++padding-right:+1ch;\n}\n\n/*+\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n+++SUBMIT+BUTTON+(TRASH)\n+++-------------------------\n+++Button+that+triggers+deletion+of+selected+items\n+++\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d+*/\n#submitBtn+{\n++position:+fixed;+/*+Always+visible+*/\n++top:+10px;\n++left:+50%;\n++transform:+translateX(-50%);+/*+Center+horizontally+*/\n++display:+none;+/*+Hidden+until+delete+mode+is+active+*/\n++padding:+12px+18px;\n++font-size:+36px;\n++background:+rgba(255,0,0,0.35);+/*+Semi-transparent+red+*/\n++color:+#fff;\n++border:+2px+solid+rgba(255,0,0,0.6);\n++border-radius:+15px;\n++cursor:+pointer;\n++z-index:+9999;+/*+Above+all+list+items+*/\n++box-shadow:+0+4px+8px+rgba(0,0,0,0.35);\n++transition:+box-shadow+0.18s,+transform+0.08s,+background+0.12s;\n}\n\n/*+\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n+++HIGHLIGHT+ALL+BUTTON\n+++-------------------------\n+++Allows+user+to+toggle+selection+of+all+deletable+items\n+++\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d+*/\n#highlightAllWrapper+{\n++position:+fixed;\n++top:+-50px;+/*+Hidden+by+default,+shown+in+delete+mode+*/\n++left:+calc(50%+-+250px);\n++width:+120px;\n++height:+120px;\n++display:+none;\n++justify-content:+center;\n++align-items:+center;\n++z-index:+9999;\n++padding:+40px;\n++box-sizing:+content-box;\n}\n\n#highlightAllBtn+{\n++width:+60px;\n++height:+60px;\n++background:+rgba(0,0,0,0.55)+!important;+/*+Slightly+transparent+black+*/\n++color:+var(--accent-red);\n++border:+2px+solid+var(--accent-red);\n++border-radius:+50%;\n++text-align:+center;\n++line-height:+60px;+/*+Center+text+vertically+*/\n++font-size:+30px;\n++cursor:+pointer;\n++transition:+background+0.2s,+box-shadow+0.18s,+transform+0.1s;\n}\n#highlightAllBtn.none-mode+{\n++background:+var(--accent-red-rgba-20)+!important;+/*+Visual+feedback+when+all+items+selected+*/\n}\n\n/*+\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n+++DELETE+TAB\n+++-------------------------\n+++The+horizontal+bar+that+triggers+delete+mode+on+long-press\n+++\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d+*/\n.delete-tab+{\n++position:+absolute;\n++top:+10px;\n++width:+90px;\n++height:+70px;\n++cursor:+pointer;\n++z-index:+20;+/*+Above+text+but+below+buttons+*/\n}\n\n/*+Line+inside+delete+tab+*/\n.delete-tab::before+{\n++content:+\u0027\u0027;\n++position:+absolute;\n++top:+0;\n++left:+0;\n++width:+90px;\n++height:+6px;\n++background-color:+var(--delete-line-grey);\n++border-radius:+3px;\n++transition:+background-color+0.2s;\n++animation-delay:+var(--pulse-delay,+0ms);+/*+Delay+for+staggered+pulse+*/\n++animation-fill-mode:+both;\n}\n\n/*+Pulse+animation+for+delete+tab+*/\n@keyframes+delete-line-pulse+{\n++0%+{+background-color:+var(--delete-line-grey);+transform:+translateY(0);+opacity:1;+}\n++50%+{+background-color:+var(--accent-red);+transform:+translateY(-1px);+opacity:1;+}\n++100%{+background-color:+var(--delete-line-grey);+transform:+translateY(0);+opacity:1;+}\n}\n\n/*+Activate+pulse+when+delete+mode+is+on+*/\n.delete-tab.active::before+{\n++animation-name:+delete-line-pulse;\n++animation-duration:1.2s;\n++animation-iteration-count:infinite;\n++animation-timing-function:ease-in-out;\n}\n\n/*+\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n+++SPLIT+LABEL\n+++-------------------------\n+++Indicates+non-deletable+or+boundary+items\n+++\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d+*/\n.split-label+{\n++position:+absolute;\n++top:+10px;+/*+Aligned+with+delete-tab+*/\n++font-size:+16px;\n++color:+yellow;\n++z-index:+10;\n++white-space:+nowrap;+/*+Prevents+text+from+wrapping+*/\n}\n\n/*+Position+split+label+based+on+handedness,+matching+delete-tab+*/\nbody.right-handed+.split-label+{+left:+var(--delete-inset);+right:auto;+}\nbody.left-handed+.split-label+{+right:+var(--delete-inset);+left:auto;+}\n\n/*+\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n+++TRACKPAD+SLIDER\n+++-------------------------\n+++Small+scrollbar-like+slider+for+internal+scroll+within+items\n+++\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d+*/\n@keyframes+trackpad-breathe+{\n++0%+{+box-shadow:0+6px+12px+rgba(160,160,160,0.06);+transform:scale(1);+opacity:0.72;+}\n++50%+{+box-shadow:0+10px+24px+rgba(160,160,160,0.10);+transform:scale(1.01);+opacity:0.82;+}\n++100%+{+box-shadow:0+6px+12px+rgba(160,160,160,0.06);+transform:scale(1);+opacity:0.72;+}\n}\n\n.slider-container+{\n++width:+72px;\n++position:absolute;\n++top:10px;\n++height:calc(100%+-+20px);\n++border-radius:12px;\n++cursor:+grab;\n++touch-action:none;+/*+Disable+default+touch+gestures+*/\n++transition:+box-shadow+0.18s,+opacity+0.2s,+transform+0.18s;\n++z-index:15;\n++display:none;+/*+Only+shown+if+scrollable+*/\n++opacity:0.7;\n++border:none;\n++animation:+trackpad-breathe+2.8s+infinite+ease-in-out;+/*+Gentle+breathing+effect+*/\n}\n.slider-container.dragging+{\n++box-shadow:0+0+22px+var(--trackpad-glow-strong);+/*+Strong+glow+when+dragging+*/\n++opacity:0.85;\n++transform:scale(1.01);\n++animation:none;+/*+Stop+breathing+animation+while+dragging+*/\n}\n\n/*+Position+slider+based+on+handedness+*/\nbody.left-handed+.slider-container+{\n++left:10px;\n++right:auto;\n++background:+linear-gradient(to+right,+rgba(100,100,100,0.55),+rgba(100,100,100,0.15));\n}\nbody.right-handed+.slider-container+{\n++right:10px;\n++left:auto;\n++background:+linear-gradient(to+left,+rgba(100,100,100,0.55),+rgba(100,100,100,0.15));\n}\n\n/*+Position+delete+tab+based+on+handedness+*/\nbody.right-handed+.delete-tab+{+left:+var(--delete-inset);+right:auto;+}\nbody.left-handed+.delete-tab+{+right:+var(--delete-inset);+left:auto;+}\n\n/*+\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n+++DELETE+MODE+PULSATE\n+++-------------------------\n+++Applies+red+glowing+animation+to+buttons+and+highlighted+items\n+++when+delete+mode+is+active.\n+++\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d+*/\n@keyframes+pulsate-intense+{\n++0%+{+box-shadow:+0+0+5px+rgba(255,0,0,0.6),+0+0+15px+rgba(255,0,0,0.8);+border-color:+rgba(255,0,0,0.6);+}\n++50%+{+box-shadow:+0+0+15px+rgba(255,0,0,1),+0+0+35px+rgba(255,0,0,1);+border-color:+rgba(255,0,0,1);+}\n++100%+{+box-shadow:+0+0+5px+rgba(255,0,0,0.6),+0+0+15px+rgba(255,0,0,0.8);+border-color:+rgba(255,0,0,0.6);+}\n}\nbody.delete-mode+#submitBtn,\nbody.delete-mode+#highlightAllBtn,\nbody.delete-mode+li.highlighted+{\n++animation:+pulsate-intense+1.2s+infinite+ease-in-out;\n++-webkit-animation:+pulsate-intense+1.2s+infinite+ease-in-out;\n}\n\n/*+\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n+++NEW+OVERLAY+STYLES\n+++-------------------------\n+++Styles+for+the+fullscreen+view+overlay.\n+++\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d+*/\n#fullscreenOverlay+{\n++position:+fixed;\n++top:+0;\n++left:+0;\n++width:+100%;\n++height:+100%;\n++background:+rgba(0,+0,+0,+0.9);+/*+Semi-transparent+black+background+*/\n++display:+flex;+/*+Flexbox+for+centering+*/\n++justify-content:+center;\n++align-items:+center;\n++z-index:+10000;+/*+High+z-index+to+be+on+top+*/\n++opacity:+0;\n++visibility:+hidden;\n++transition:+opacity+0.3s+ease-in-out,+visibility+0s+0.3s;\n++flex-direction:+column;+/*+Stack+children+vertically+*/\n}\n\n#fullscreenOverlay.visible+{\n++opacity:+1;\n++visibility:+visible;\n++transition:+opacity+0.3s+ease-in-out;\n}\n\n#overlayContent+{\n++background:+#1c1c1c;+/*+Darker+background+for+content+*/\n++color:+#fff;\n++padding:+30px;\n++border-radius:+20px;\n++max-width:+90%;\n++max-height:+90%;\n++overflow-y:+auto;+/*+Enable+scrolling+for+long+content+*/\n++box-shadow:+0+0+50px+rgba(255,+255,+255,+0.1);\n++/*+NEW:+Re-enable+text+selection+for+the+overlay+content+*/\n++-webkit-user-select:+text;\n++-moz-user-select:+text;\n++-ms-user-select:+text;\n++user-select:+text;\n}\n\n#overlayCloseBtn+{\n++position:+absolute;\n++top:+30px;\n++right:+30px;\n++background:+transparent;\n++border:+2px+solid+#fff;\n++color:+#fff;\n++font-size:+24px;\n++padding:+10px+15px;\n++border-radius:+50%;\n++cursor:+pointer;\n++z-index:+10001;+/*+Ensure+close+button+is+on+top+*/\n}\n\n\u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\n\u003ch2\u003e📋+Clipboard\u003c/h2\u003e\n\n\u003cul+id\u003d\"dynamicList\"\u003e\u003c/ul\u003e\n\n\u003cbutton+id\u003d\"submitBtn\"\u003e🗑️\u003c/button\u003e\n\n\u003cdiv+id\u003d\"highlightAllWrapper\"\u003e\n++\u003cbutton+id\u003d\"highlightAllBtn\"\u003eAll\u003c/button\u003e\n\u003c/div\u003e\n\n\u003cdiv+id\u003d\"fullscreenOverlay\"\u003e\n++\u003cbutton+id\u003d\"overlayCloseBtn\"\u003eX\u003c/button\u003e\n++\u003cdiv+id\u003d\"overlayContent\"\u003e\u003c/div\u003e\n\u003c/div\u003e\n\n\u003ctextarea+id\u003d\"handedVar\"+style\u003d\"display:none\"\u003e{lv\u003dorientScrn475}\u003c/textarea\u003e\n\u003ctextarea+id\u003d\"rawData\"+style\u003d\"display:none\"\u003e{lv\u003dcntntStrng742}\u003c/textarea\u003e\n\n\u003cscript\u003e\n/*+\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n+++JavaScript+Logic\n+++\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d+*/\n\n/*+Server+endpoint+for+triggering+actions+*/\nconst+triggerBase+\u003d+\"http://localhost:8080/infiniteClipboardTrigger\";\n\n/*+Read+raw+clipboard+data+*/\nconst+raw+\u003d+document.getElementById(\u0027rawData\u0027).value+||+\u0027\u0027;\nconst+list+\u003d+document.getElementById(\u0027dynamicList\u0027);\nconst+submitBtn+\u003d+document.getElementById(\u0027submitBtn\u0027);\nconst+highlightAllWrapper+\u003d+document.getElementById(\u0027highlightAllWrapper\u0027);\nconst+highlightAllBtn+\u003d+document.getElementById(\u0027highlightAllBtn\u0027);\n\nlet+deleteMode+\u003d+false;\nlet+isHoldingDeleteTab+\u003d+false;+//+New+flag+to+track+if+the+delete+tab+is+being+held\n\n/*+Determine+handedness+from+hidden+variable+*/\nconst+rawVal+\u003d+document.getElementById(\"handedVar\").value.trim();\nconst+leftHanded+\u003d+rawVal.toLowerCase()+\u003d\u003d\u003d+\"true\";\ndocument.body.classList.add(leftHanded+?+\"left-handed\"+:+\"right-handed\");\n\n/*+NEW:+Get+overlay+elements+*/\nconst+fullscreenOverlay+\u003d+document.getElementById(\u0027fullscreenOverlay\u0027);\nconst+overlayContent+\u003d+document.getElementById(\u0027overlayContent\u0027);\nconst+overlayCloseBtn+\u003d+document.getElementById(\u0027overlayCloseBtn\u0027);\n\n/*+NEW:+Function+to+show+overlay+with+content+*/\nfunction+showOverlay(content)+{\n++overlayContent.innerHTML+\u003d+content;\n++fullscreenOverlay.classList.add(\u0027visible\u0027);\n++document.body.style.overflow+\u003d+\u0027hidden\u0027;+/*+Prevents+scrolling+behind+the+overlay+*/\n}\n\n/*+NEW:+Function+to+hide+overlay+*/\nfunction+hideOverlay()+{\n++fullscreenOverlay.classList.remove(\u0027visible\u0027);\n++document.body.style.overflow+\u003d+\u0027auto\u0027;\n}\n\n/*+NEW:+Close+button+event+listener+*/\noverlayCloseBtn.addEventListener(\u0027click\u0027,+hideOverlay);\n\n/*+\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n+++UPDATE+DELETE+MODE\n+++-------------------------\n+++Shows/hides+buttons,+toggles+animations+and+delete+tabs\n+++\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d+*/\nfunction+updateSubmitBtn()+{\n++const+highlightedItems+\u003d+list.querySelectorAll(\u0027li.highlighted\u0027);\n++if(highlightedItems.length+\u003d\u003d\u003d+0+\u0026\u0026+deleteMode)+deleteMode+\u003d+false;\n\n++/*+Show+or+hide+buttons+based+on+delete+mode+*/\n++submitBtn.style.display+\u003d+deleteMode+?+\u0027block\u0027+:+\u0027none\u0027;\n++highlightAllWrapper.style.display+\u003d+deleteMode+?+\u0027flex\u0027+:+\u0027none\u0027;\n++document.body.classList.toggle(\"delete-mode\",+deleteMode);\n\n++/*+Animate+all+delete+tabs+*/\n++const+tabs+\u003d+Array.from(document.querySelectorAll(\u0027.delete-tab\u0027));\n++tabs.forEach((tab,+i)+\u003d\u003e+{\n++++++if+(deleteMode)+{\n++++++++++tab.classList.add(\u0027active\u0027);\n++++++++++const+delayMs+\u003d+i+*+90;+/*+staggered+pulse+animation+*/\n++++++++++tab.style.setProperty(\u0027--pulse-delay\u0027,+`${delayMs}ms`);\n++++++}+else+{\n++++++++++tab.classList.remove(\u0027active\u0027);\n++++++++++tab.style.removeProperty(\u0027--pulse-delay\u0027);\n++++++}\n++});\n\n++/*+Remove+highlight+if+delete+mode+is+off+*/\n++if(!deleteMode)+list.querySelectorAll(\u0027li.highlighted\u0027).forEach(li+\u003d\u003e+li.classList.remove(\u0027highlighted\u0027));\n\n++/*+Update+highlight+all+button+text+*/\n++if(deleteMode){\n++++++const+deletableItems+\u003d+Array.from(list.querySelectorAll(\u0027li\u0027)).filter(li+\u003d\u003e+{\n++++++++++const+idx+\u003d+parseInt(li.dataset.index);\n++++++++++return+idx+\u003e+0+\u0026\u0026+idx+\u003c+raw.split(\u0027『‰』\u0027).length+-+1;+/*+Only+middle+items+deletable+*/\n++++++});\n++++++const+allHighlighted+\u003d+deletableItems.length+\u003e+0+\u0026\u0026+deletableItems.every(li+\u003d\u003e+li.classList.contains(\u0027highlighted\u0027));\n++++++highlightAllBtn.innerText+\u003d+allHighlighted+?+\"X\"+:+\"All\";\n++++++highlightAllBtn.classList.toggle(\u0027none-mode\u0027,+allHighlighted);\n++}\n}\n\n/*+\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n+++SUBMIT+BUTTON+CLICK\n+++-------------------------\n+++Deletes+highlighted+items+and+sends+request+to+server\n+++\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d+*/\nsubmitBtn.onclick+\u003d+()+\u003d\u003e+{\n++const+highlightedItems+\u003d+Array.from(list.querySelectorAll(\u0027li.highlighted\u0027));\n++if(highlightedItems.length+\u003d\u003d\u003d+0)+return;\n\n++const+allIndexes+\u003d+highlightedItems.map(li+\u003d\u003e+li.dataset.index).join(\u0027『‰』\u0027);\n\n++/*+Send+deletion+request+*/\n++fetch(`${triggerBase}?slctedItm147\u003d${encodeURIComponent(allIndexes)}\u0026dlteSlectd738\u003dtrue\u0026t\u003d${Date.now()}`).catch(()\u003d\u003e{});\n\n++/*+Disconnect+observers+and+remove+from+DOM+*/\n++highlightedItems.forEach(li+\u003d\u003e+li._resizeObserver?.disconnect());\n++highlightedItems.forEach(li+\u003d\u003e+li.remove());\n\n++updateSubmitBtn();\n};\n\n/*+\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n+++HIGHLIGHT+ALL+BUTTON+CLICK\n+++-------------------------\n+++Toggles+all+deletable+items\n+++\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d+*/\nhighlightAllBtn.onclick+\u003d+()+\u003d\u003e+{\n++if(!deleteMode)+return;\n\n++const+deletableItems+\u003d+Array.from(list.querySelectorAll(\u0027li\u0027)).filter(li+\u003d\u003e+{\n++++++const+idx+\u003d+parseInt(li.dataset.index);\n++++++return+idx+\u003e+0+\u0026\u0026+idx+\u003c+raw.split(\u0027『‰』\u0027).length+-+1;\n++});\n++const+allHighlighted+\u003d+deletableItems.every(li+\u003d\u003e+li.classList.contains(\u0027highlighted\u0027));\n++deletableItems.forEach(li+\u003d\u003e+li.classList.toggle(\u0027highlighted\u0027,+!allHighlighted));\n++highlightAllBtn.innerText+\u003d+allHighlighted+?+\"All\"+:+\"None\";\n++highlightAllBtn.classList.toggle(\u0027none-mode\u0027,+!allHighlighted);\n++updateSubmitBtn();\n};\n\n/*+\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n+++BUILD+LIST+ITEMS\n+++-------------------------\n+++Loops+through+raw+data+segments+to+create+list+items+dynamically\n+++\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d+*/\nconst+segments+\u003d+raw.split(\u0027『‰』\u0027);+//+split+raw+data\nsegments.forEach((segment,+idx)+\u003d\u003e+{\n++const+item+\u003d+segment.trim();\n++if(item+\u003d\u003d\u003d+\u0027\u0027)+return;+//+skip+empty+segments\n\n++const+li+\u003d+document.createElement(\u0027li\u0027);\n++li.dataset.index+\u003d+idx;+//+store+index+for+reference\n\n++/*+Scroll+wrapper+for+internal+scrollable+text+*/\n++const+wrapper+\u003d+document.createElement(\u0027div\u0027);\n++wrapper.className+\u003d+\u0027scroll-wrapper\u0027;\n\n++/*+Text+box+inside+wrapper+*/\n++const+textDiv+\u003d+document.createElement(\u0027div\u0027);\n++textDiv.className+\u003d+\u0027text-box\u0027;\n++textDiv.innerHTML+\u003d+item.replace(/\u0026/g,\"\u0026amp;\").replace(/\u003c/g,\"\u0026lt;\").replace(/\u003e/g,\"\u0026gt;\")\n++++++++++++++++++++++++.replace(/\"/g,\"\u0026quot;\").replace(/\u0027/g,\"\u0026#039;\");\n\n++/*+Adjust+padding+based+on+handedness+*/\n++if(leftHanded){\n++++++textDiv.style.paddingLeft+\u003d+\u00273ch\u0027;\n++++++textDiv.style.paddingRight+\u003d+\u00271ch\u0027;\n++}+else+{\n++++++textDiv.style.paddingRight+\u003d+\u00273ch\u0027;\n++++++textDiv.style.paddingLeft+\u003d+\u00271ch\u0027;\n++}\n++textDiv.style.paddingTop+\u003d+\u00272ch\u0027;\n++textDiv.style.paddingBottom+\u003d+\u00272ch\u0027;\n\n++wrapper.appendChild(textDiv);\n++li.appendChild(wrapper);\n\n++/*+Determine+if+delete+tab+is+needed+*/\n++const+hasLeading+\u003d+idx+\u003e+0;\n++const+hasTrailing+\u003d+idx+\u003c+segments.length+-+1;\n\n++if(hasLeading+\u0026\u0026+hasTrailing){\n++++++const+tab+\u003d+document.createElement(\u0027div\u0027);\n++++++tab.className\u003d\u0027delete-tab\u0027;\n++++++li.appendChild(tab);\n\n++++++/*+LONG+PRESS+HANDLER+TO+TOGGLE+DELETE+MODE+*/\n++++++let+pressTimer\u003dnull;\n++++++const+clearPress\u003d()\u003d\u003e{if(pressTimer){clearTimeout(pressTimer);pressTimer\u003dnull;}};\n\n++++++tab.addEventListener(\u0027touchstart\u0027,e\u003d\u003e{\n++++++++++isHoldingDeleteTab+\u003d+true;+//+Set+the+new+flag\n++++++++++e.stopPropagation();\n++++++++++if(e.touches.length!\u003d\u003d1)+return;\n++++++++++clearPress();\n++++++++++pressTimer\u003dsetTimeout(()\u003d\u003e{\n++++++++++++++deleteMode\u003d!deleteMode;\n++++++++++++++if(deleteMode)+li.classList.add(\u0027highlighted\u0027);\n++++++++++++++updateSubmitBtn();\n++++++++++++++isHoldingDeleteTab+\u003d+false;+//+Reset+on+timeout\n++++++++++},500);+//+500ms+long+press\n++++++},{passive:false});\n\n++++++tab.addEventListener(\u0027touchend\u0027,e\u003d\u003e{\n++++++++isHoldingDeleteTab+\u003d+false;+//+Reset+the+flag\n++++++++e.stopPropagation();\n++++++++clearPress();\n++++++},{passive:true});\n\n++++++tab.addEventListener(\u0027touchcancel\u0027,e\u003d\u003e{\n++++++++isHoldingDeleteTab+\u003d+false;+//+Reset+the+flag\n++++++++e.stopPropagation();\n++++++++clearPress();\n++++++},{passive:true});\n\n++++++tab.addEventListener(\u0027click\u0027,+e+\u003d\u003e+e.stopPropagation());+//+Prevent+click+bubbling\n\n++}+else+{\n++++++/*+For+non-deletable+items,+show+a+split+label+*/\n++++++const+label\u003ddocument.createElement(\u0027div\u0027);\n++++++label.className\u003d\u0027split-label\u0027;\n++++++label.innerText\u003d\u0027Entry+split+between+two+pages+(unable+to+delete)\u0027;\n++++++li.appendChild(label);\n++}\n\n++/*+\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n+++++REFINED:+Long-press+and+Tap+event+handling\n+++++\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d+*/\n++let+longPressTimer;\n++let+isTapped+\u003d+false;\n++const+longPressDuration+\u003d+500;\n++const+swipeThreshold+\u003d+20;\n++let+startX,+startY;\n\n++li.addEventListener(\u0027touchstart\u0027,+(e)+\u003d\u003e+{\n++++//+Check+the+new+flag+here\n++++if+(e.target.closest(\u0027.delete-tab\u0027)+||+e.target.closest(\u0027.slider-container\u0027))+{\n++++++++return;\n++++}\n\n++++startX+\u003d+e.touches[0].clientX;\n++++startY+\u003d+e.touches[0].clientY;\n++++isTapped+\u003d+true;\n\n++++clearTimeout(longPressTimer);\n++++longPressTimer+\u003d+setTimeout(()+\u003d\u003e+{\n++++++++if+(isTapped)+{+//+Check+if+it\u0027s+still+a+tap\n++++++++++++showOverlay(textDiv.outerHTML);\n++++++++}\n++++++++isTapped+\u003d+false;+//+Action+is+no+longer+a+tap,+so+reset+the+flag\n++++},+longPressDuration);\n++},+{passive:+true});\n\n++li.addEventListener(\u0027touchmove\u0027,+(e)+\u003d\u003e+{\n++++if+(isTapped)+{\n++++++const+dx+\u003d+startX+-+e.touches[0].clientX;\n++++++const+dy+\u003d+startY+-+e.touches[0].clientY;\n++++++const+distance+\u003d+Math.sqrt(dx+*+dx+++dy+*+dy);\n\n++++++if+(distance+\u003e+swipeThreshold)+{\n++++++++clearTimeout(longPressTimer);\n++++++++isTapped+\u003d+false;+//+It\u0027s+a+swipe,+not+a+tap\n++++++}\n++++}\n++},+{passive:+true});\n\n++li.addEventListener(\u0027touchend\u0027,+(e)+\u003d\u003e+{\n++++clearTimeout(longPressTimer);+//+Clear+the+timer+on+touch+end\n\n++++if+(isTapped)+{\n++++++++isTapped+\u003d+false;+//+Reset+immediately+to+prevent+double+triggers\n++++++++if+(deleteMode+\u0026\u0026+hasLeading+\u0026\u0026+hasTrailing+\u0026\u0026+!isHoldingDeleteTab)+{\n++++++++++++li.classList.toggle(\u0027highlighted\u0027);\n++++++++++++updateSubmitBtn();\n++++++++}+else+if+(!deleteMode+\u0026\u0026+!isHoldingDeleteTab)+{\n++++++++++++fetch(`${triggerBase}?slctedItm147\u003d${encodeURIComponent(idx)}\u0026t\u003d${Date.now()}`).catch(()\u003d\u003e{});\n++++++++}\n++++}\n++},+{passive:+true});\n\n++li.addEventListener(\u0027touchcancel\u0027,+(e)+\u003d\u003e+{\n++++clearTimeout(longPressTimer);\n++++isTapped+\u003d+false;\n++},+{passive:+true});\n\n++//+Also+add+a+pointerdown+handler+for+desktop+compatibility\n++li.addEventListener(\u0027pointerdown\u0027,+(e)+\u003d\u003e+{\n++++//+Check+the+new+flag+here\n++++if+(e.button+!\u003d\u003d+0+||+e.target.closest(\u0027.delete-tab\u0027)+||+e.target.closest(\u0027.slider-container\u0027))+{\n++++++return;\n++++}\n++++startX+\u003d+e.clientX;\n++++startY+\u003d+e.clientY;\n++++isTapped+\u003d+true;\n\n++++clearTimeout(longPressTimer);\n++++longPressTimer+\u003d+setTimeout(()+\u003d\u003e+{\n++++++++if+(isTapped)+{+//+Check+if+it\u0027s+still+a+tap\n++++++++++++showOverlay(textDiv.outerHTML);\n++++++++}\n++++++++isTapped+\u003d+false;\n++++},+longPressDuration);\n++++li.setPointerCapture?.(e.pointerId);\n++});\n\n++li.addEventListener(\u0027pointermove\u0027,+(e)+\u003d\u003e+{\n++++if+(isTapped)+{\n++++++const+dx+\u003d+startX+-+e.clientX;\n++++++const+dy+\u003d+startY+-+e.clientY;\n++++++const+distance+\u003d+Math.sqrt(dx+*+dx+++dy+*+dy);\n++++++if+(distance+\u003e+swipeThreshold)+{\n++++++++clearTimeout(longPressTimer);\n++++++++isTapped+\u003d+false;\n++++++}\n++++}\n++});\n\n++li.addEventListener(\u0027pointerup\u0027,+(e)+\u003d\u003e+{\n++++clearTimeout(longPressTimer);+//+Clear+the+timer+on+pointer+up\n\n++++if+(isTapped)+{\n++++++++isTapped+\u003d+false;+//+Reset+immediately\n++++++++if+(deleteMode+\u0026\u0026+hasLeading+\u0026\u0026+hasTrailing+\u0026\u0026+!isHoldingDeleteTab)+{\n++++++++++++li.classList.toggle(\u0027highlighted\u0027);\n++++++++++++updateSubmitBtn();\n++++++++}+else+if+(!deleteMode+\u0026\u0026+!isHoldingDeleteTab)+{\n++++++++++++fetch(`${triggerBase}?slctedItm147\u003d${encodeURIComponent(idx)}\u0026t\u003d${Date.now()}`).catch(()\u003d\u003e{});\n++++++++}\n++++}\n++++li.releasePointerCapture?.(e.pointerId);\n++});\n\n++li.addEventListener(\u0027pointercancel\u0027,+(e)+\u003d\u003e+{\n++++clearTimeout(longPressTimer);\n++++isTapped+\u003d+false;\n++++li.releasePointerCapture?.(e.pointerId);\n++});\n\n++//+Keep+the+`contextmenu`+handler+for+right-click+on+desktop\n++textDiv.addEventListener(\u0027contextmenu\u0027,+(e)+\u003d\u003e+{\n++++++e.preventDefault();\n++++++if+(!isHoldingDeleteTab)+{\n++++++++++showOverlay(textDiv.outerHTML);\n++++++}\n++});\n\n++/*+\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n+++++TRACKPAD+SLIDER+FOR+SCROLLING\n+++++\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d+*/\n++const+sliderContainer\u003ddocument.createElement(\u0027div\u0027);\n++sliderContainer.className\u003d\u0027slider-container\u0027;\n++li.appendChild(sliderContainer);\n\n++sliderContainer.addEventListener(\u0027click\u0027,+e+\u003d\u003e+e.stopPropagation());\n\n++/*+\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n+++++RESIZE+OBSERVER+TO+ADJUST+HEIGHT\n+++++\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d+*/\n++const+adjustHeights\u003d()\u003d\u003e{\n++++++const+style\u003dwindow.getComputedStyle(textDiv);\n++++++const+paddingTop\u003dparseFloat(style.paddingTop)||0;\n++++++const+paddingBottom\u003dparseFloat(style.paddingBottom)||0;\n++++++const+contentHeight\u003dtextDiv.scrollHeight-paddingTop-paddingBottom;\n++++++const+maxHeight\u003d{lv\u003dmxHght692};\n++++++const+finalHeight\u003dMath.min(contentHeight+paddingTop+paddingBottom,maxHeight);\n++++++wrapper.style.height\u003dfinalHeight+\u0027px\u0027;\n++++++wrapper.style.overflow\u003d\u0027hidden\u0027;\n++++++if(contentHeight+paddingTop+paddingBottom\u003emaxHeight){\n++++++++++sliderContainer.style.display\u003d\u0027block\u0027;\n++++++++++sliderContainer.style.height\u003dfinalHeight+\u0027px\u0027;\n++++++}+else+sliderContainer.style.display\u003d\u0027none\u0027;\n++};\n++adjustHeights();\n++const+ro\u003dnew+ResizeObserver(adjustHeights);\n++ro.observe(textDiv);\n++li._resizeObserver\u003dro;\n\n++/*+\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n+++++POINTER+DRAGGING+FOR+TRACKPAD+SCROLL\n+++++\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d+*/\n++let+dragging\u003dfalse,lastY\u003d0,lastTime\u003d0,velocityPxPerSec\u003d0,lastPositions\u003d[];\n++sliderContainer.addEventListener(\u0027pointerdown\u0027,e\u003d\u003e{\n++++++dragging\u003dtrue;lastY\u003de.clientY;lastTime\u003dperformance.now();lastPositions\u003d[];velocityPxPerSec\u003d0;\n++++++sliderContainer.classList.add(\u0027dragging\u0027);\n++++++sliderContainer.setPointerCapture?.(e.pointerId);\n++++++if(wrapper._momentumAnim){cancelAnimationFrame(wrapper._momentumAnim);wrapper._momentumAnim\u003dnull;}\n++});\n\n++const+onMove\u003dev\u003d\u003e{\n++++++if(!dragging)+return;\n++++++const+now\u003dperformance.now();\n++++++const+dt\u003dnow-lastTime;\n++++++const+dy\u003dev.clientY-lastY;\n++++++wrapper.scrollTop-\u003ddy;\n++++++if(dt\u003e0){+lastPositions.push({dy,dt});+if(lastPositions.length\u003e6)+lastPositions.shift();\n++++++++++let+sum\u003d0,div\u003d0;+for(const+s+of+lastPositions){sum+\u003d(s.dy/s.dt);div+\u003d1;}\n++++++++++velocityPxPerSec\u003d(sum/div)*1000;\n++++++}\n++++++lastY\u003dev.clientY;+lastTime\u003dnow;\n++};\n\n++const+onUp\u003dev\u003d\u003e{\n++++++if(!dragging)+return;\n++++++dragging\u003dfalse;\n++++++sliderContainer.classList.remove(\u0027dragging\u0027);\n++++++try{sliderContainer.releasePointerCapture?.(ev.pointerId);}catch(e){}\n++++++let+velocity\u003d-velocityPxPerSec;\n++++++const+density\u003dwindow.devicePixelRatio||1;\n++++++const+MIN_FLING_PX_PER_SEC\u003d50*density;\n++++++const+MAX_FLING_PX_PER_SEC\u003d8000*density;\n++++++const+SCROLL_FRICTION\u003d0.015;\n++++++const+GRAVITY_EARTH\u003d9.80665,INCHES_PER_METER\u003d39.37;\n++++++const+PHYSICAL_COEFF\u003dGRAVITY_EARTH*INCHES_PER_METER*density*160*0.84;\n++++++const+DECELERATION_RATE\u003dMath.log(0.78)/Math.log(0.9);\n++++++const+getDecel\u003dl\u003d\u003eMath.log(0.35*Math.abs(l)/(SCROLL_FRICTION*PHYSICAL_COEFF));\n++++++const+getDistance\u003dv\u003d\u003e{\n++++++++++const+l\u003dgetDecel(v);\n++++++++++return+SCROLL_FRICTION*PHYSICAL_COEFF*Math.exp(DECELERATION_RATE/(DECELERATION_RATE-1)*l);\n++++++};\n++++++const+getDuration\u003dv\u003d\u003e{\n++++++++++const+l\u003dgetDecel(v);\n++++++++++return+Math.round(1000*Math.exp(l/(DECELERATION_RATE-1)));\n++++++};\n++++++if(Math.abs(velocity)\u003cMIN_FLING_PX_PER_SEC)+return;\n++++++velocity\u003dMath.max(-MAX_FLING_PX_PER_SEC,Math.min(MAX_FLING_PX_PER_SEC,velocity));\n++++++const+distance\u003dgetDistance(velocity)*Math.sign(velocity);\n++++++const+duration\u003dgetDuration(velocity);\n++++++if(!duration||!distance)+return;\n++++++const+start\u003dwrapper.scrollTop;\n++++++const+maxScroll\u003dwrapper.scrollHeight-wrapper.clientHeight;\n++++++let+target\u003dMath.round(start+distance);\n++++++if(target\u003c0)+target\u003d0;\n++++++if(target\u003emaxScroll)+target\u003dmaxScroll;\n++++++const+startTime\u003dperformance.now();\n++++++function+easeOut(t){return+1-Math.pow(1-t,3);}\n++++++function+step(){\n++++++++++const+now\u003dperformance.now();\n++++++++++const+t\u003dMath.min((now-startTime)/duration,1);\n++++++++++wrapper.scrollTop\u003dstart+(target-start)*easeOut(t);\n++++++++++if(t\u003c1)+wrapper._momentumAnim\u003drequestAnimationFrame(step);\n++++++}\n++++++step();\n++};\n\n++sliderContainer.addEventListener(\u0027pointermove\u0027,onMove);\n++sliderContainer.addEventListener(\u0027pointerup\u0027,onUp);\n++sliderContainer.addEventListener(\u0027pointercancel\u0027,onUp);\n\n++/*+Append+final+li+to+list+*/\n++list.appendChild(li);\n});\n\u003c/script\u003e\n\u003c/body\u003e\n\u003c/html\u003e\n","variableUpdateValue":{"type":"None"},"visibilityVariable":{"varName":"shwClpbord537"},"width":100},"guid":-8321052628759984065,"iconRes":2131231733,"lastRefreshValue":0},{"type":"SceneHorizontalLayout","children":[{"type":"SceneIcon","sceneIconConfig":{"alignment":"Start","closeSceneOnPress":false,"sceneIconData":{"imagePackageName":"com.arlosoft.macrodroid","imageResourceId":2131231781,"imageResourceName":"ic_error_outline_white_24dp"},"size":25,"tintColor":-1118482,"tintEnabled":true,"variableToUpdate":{"varName":"shwInfo534"},"variableUpdateValue":{"type":"BooleanValue","isToggle":true,"label":false}},"guid":-4875815494012898217,"iconRes":2131231505,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":false,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"++++++++++++++++++++++++++++++","textAlignment":"Start","textColor":-1,"textSize":"20"},"guid":-6743529603989501787,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneIcon","sceneIconConfig":{"alignment":"End","closeSceneOnPress":false,"sceneIconData":{"imagePackageName":"com.arlosoft.macrodroid","imageResourceId":2131231873,"imageResourceName":"ic_list_white_24dp"},"size":23,"tintColor":-1118482,"tintEnabled":true,"variableToUpdate":{"varName":"shwMnu247"},"variableUpdateValue":{"type":"BooleanValue","isToggle":true,"label":false}},"guid":-6169894069979673687,"iconRes":2131231505,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":false,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"+++++\n","textAlignment":"Start","textColor":-1,"textSize":"20"},"guid":-5235348242276821800,"iconRes":2131232676,"lastRefreshValue":0}],"sceneHorizontalLayoutConfig":{"alignment":"End","visibilityVariable":{"varName":"shwMnu247"}},"iconResId":2131231503,"guid":-5486423941707007842,"iconRes":2131231503,"lastRefreshValue":0},{"type":"SceneHorizontalDivider","config":{"dividerColor":-1,"dividerHeight":2,"padding":16,"visibilityVariable":{"varName":"shwInfo534"}},"guid":-5022089106855858722,"iconRes":2131231504,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":true,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"\u003cp+style\u003d\"font-size:+{lv\u003dfntSz632}px;\"\u003e\u003cu\u003e📋+Clipboard+Tab+Information:\u003c/u\u003e\u003c/p\u003e\n","textAlignment":"Center","textColor":-1,"textSize":"16","visibilityVariable":{"varName":"shwInfo534"}},"guid":-6553973850858382547,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":false,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"-+Delete+Mode:\nTo+delete+an+entry,+hold+the+line+icon+in+the+top+corner+of+the+text+box+to+activate+delete+mode.+While+in+delete+mode,+a+\"Select+All\"+button+and+a+trash+can+icon+(\"🗑\")+will+appear+at+the+top+of+the+page.+Tap+an+entry+to+highlight+or+unhighlight+it+for+deletion.+Tap+the+trash+button+to+confirm+and+delete+the+selected+entries.+It+will+delete+the+first+occurrence+of+a+duplicate+entry+unless+the+duplicates+are+also+highlighted.\n\n-+Import+Entry+into+Clipboard:+Tap+the+entry+to+import+it+into+your+device\u0027s+clipboard.+\n+\n-+Copyable+Overlay:+\nHold+an+entry+to+activate+a+full-screen+overlay+of+the+entry.+This+is+useful+for+copying+specific+text+from+an+entry.+\n+\n-+Scrollbar:+\nOn+entry+boxes+with+large+text+that+exceeds+the+box+size+limit,+a+scrollbar+will+appear+on+the+side+of+the+textbox.+Use+this+to+scroll+the+text.\n++\n-+Turning+Pages:\nThis+macro+retrieves+entries+from+the+file+in+chunks+to+prevent+system+overload+when+the+file+becomes+large.+These+chunks+are+organized+into+pages.+The+size+of+the+chunks+can+be+adjusted+to+be+larger+or+smaller+using+the+\"chrSze835\"+variable,+depending+on+your+device’s+capabilities.+Increasing+the+chunk+size+may+improve+performance+(WARNING:+Do+not+set+this+above+50,000,+as+it+may+cause+issues).+Tap+the+\"↪\"+icon+to+turn+the+page.\n++\n-+Split+Entries:+\nDue+to+the+\"chunking\"+method+mentioned+above,+it+is+possible+for+an+entry+to+be+split+between+two+pages.+If+an+entry+is+cut+off+at+the+end+or+beginning+of+a+page,+it+is+likely+a+\"split+entry\"+and+will+be+temporarily+unavailable+for+deletion.+Split+entries+are+marked+in+the+corner+of+the+block+and+will+not+display+the+delete+tab.","textAlignment":"Start","textColor":-1,"textSize":"12","visibilityVariable":{"varName":"shwInfo534"}},"guid":-9127165786045247014,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":true,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"\n\u003ca+href\u003d\"https://www.macrodroidforum.com/index.php?threads/%F0%9F%93%8B-infinite-clipboard-%E2%99%BE%EF%B8%8F.8342/\"\u003e【Click+here+to+visit+the+forum+page】\u003c/a\u003e\n\n","textAlignment":"Center","textColor":-1,"textSize":"16","visibilityVariable":{"varName":"shwInfo534"}},"guid":-6317333953781088178,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneHorizontalDivider","config":{"dividerColor":-1,"dividerHeight":2,"padding":16,"visibilityVariable":{"varName":"shwInfo534"}},"guid":-8576695542617808467,"iconRes":2131231504,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":true,"isBold":true,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"\u003cp+style\u003d\"font-size:+{lv\u003dfntSz632}px;\"\u003e\u003cu\u003eSettings\u003c/u\u003e\u003c/p\u003e\n","textAlignment":"Center","textColor"