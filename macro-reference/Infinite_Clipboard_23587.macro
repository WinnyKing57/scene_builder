03d\ntarget_date_start\u003d\"{lv\u003dserchDatStrt827}\"\ntarget_date_end\u003d\"{lv\u003dserchDatEnd624}\"\nkeyword\u003d\"{lv\u003dserchKy630}\"\ninput_file\u003d\"{lv\u003dpth852}Infinite_Clipboard/Clipboard_Log.txt\"\ntemp_file\u003d\"{lv\u003dpth852}Infinite_Clipboard/temp_results.txt\"\n\nsearch1\u003d\"\"\nsearch2\u003d\"\"\n\n#+\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n#+2.+Find+Start+Marker+(Closest+Future+Date)\n#+\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\nif+[+-n+\"$target_date_start\"+];+then\n++++formatted_start\u003d$(echo+\"$target_date_start\"+|+sed+\u0027s/\\(....\\)\\(..\\)\\(..\\)/\\1-\\2-\\3/\u0027)\n++++target_ts_start\u003d$(date+-d+\"$formatted_start\"++%s)\n\n++++search1\u003d$(awk+-v+target_ts\u003d\"$target_ts_start\"+\u0027\n++++BEGIN+{+min_diff+\u003d+-1;+closest_line+\u003d+\"\"+}\n++++{\n++++++++if+($0+~+/^[0-9]{8}DaT£≈/)+{\n++++++++++++current_date_raw+\u003d+substr($0,+1,+8)\n++++++++++++formatted_current+\u003d+substr(current_date_raw,+1,+4)+\"-\"+substr(current_date_raw,+5,+2)+\"-\"+substr(current_date_raw,+7,+2)\n++++++++++++\"date+-d+\\\"\"+formatted_current+\"\\\"++%s\"+|+getline+current_timestamp\n++++++++++++diff+\u003d+current_timestamp+-+target_ts\n++++++++++++\n++++++++++++if+(diff+\u003d\u003d+0)+{+closest_line+\u003d+$0;+exit+}\n++++++++++++if+(diff+\u003e+0)+{\n++++++++++++++++if+(min_diff+\u003d\u003d+-1+||+diff+\u003c+min_diff)+{+min_diff+\u003d+diff;+closest_line+\u003d+$0+}\n++++++++++++}\n++++++++}\n++++}\n++++END+{+print+closest_line+}\u0027+\"$input_file\")\nfi\n\n#+\u003d\u003d\u003d\u003d\u003d\u0