ignment":"Center","booleanVariable":{"varName":"orientScrn475"},"isChecked":false,"switchOffColor":-4520679,"switchOnColor":-16732652,"text":"","textColor":-1,"textSize":"10","textStart":false},"guid":-8988334783558903371,"iconRes":2131231699,"lastRefreshValue":0}],"sceneGridLayoutConfig":{"itemsPerRow":3,"rowHeight":66,"visibilityVariable":{"varName":"shwMnu247"}},"iconResId":2131232196,"guid":-7024900625930138026,"iconRes":2131232196,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":false,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"Are+you+sure+you+want+to+delete+the+entire+log+and+begin+again?","textAlignment":"Center","textColor":-1,"textSize":"15","visibilityVariable":{"varName":"shwRfrsh582"}},"guid":-8563726553616456937,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneButton","sceneButtonConfig":{"buttonColor":-3407858,"closeSceneOnPress":false,"htmlFormatting":false,"text":"Confirm+Clipboard+Refresh","textColor":-1,"textSize":"10","variableToUpdate":{"varName":"refrshClpbord274"},"variableUpdateValue":{"type":"BooleanValue","isToggle":false,"label":true},"visibilityVariable":{"varName":"shwRfrsh582"}},"guid":-8253013971894619498,"iconRes":2131231205,"lastRefreshValue":0},{"type":"SceneHorizontalDivider","config":{"dividerColor":-1,"dividerHeight":2,"padding":16,"visibilityVariable":{"varName":"showInfo"}},"guid":-6824761235320584547,"iconRes":2131231504,"lastRefreshValue":0}],"label":"⭐️"},{"children":[{"type":"SceneHorizontalLayout","children":[{"type":"SceneButton","sceneButtonConfig":{"buttonColor":16777215,"closeSceneOnPress":false,"htmlFormatting":false,"text":"↩","textColor":-1,"textSize":"30","variableToUpdate":{"varName":"serchstrngIndx284"},"variableUpdateValue":{"type":"IntDecrement"},"visibilityVariable":{"varName":"shwSerchBttonL713"}},"guid":-6273248623777108970,"iconRes":2131231205,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":false,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"Page:+{lv\u003dserchstrngIndx284}\nEntries:+{size\u003dserchArry924}","textAlignment":"Center","textColor":-1,"textSize":"10"},"guid":-8682453375638607460,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneButton","sceneButtonConfig":{"buttonColor":16777215,"closeSceneOnPress":false,"htmlFormatting":false,"text":"↪","textColor":-1,"textSize":"30","variableToUpdate":{"varName":"serchstrngIndx284"},"variableUpdateValue":{"type":"IntIncrement"},"visibilityVariable":{"varName":"shwSerchBttonR946"}},"guid":-8775094912102517099,"iconRes":2131231205,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":false,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"Total:+{lv\u003dtotlCount623}","textAlignment":"Center","textColor":-1,"textSize":"10"},"guid":-8512030193527901105,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":false,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"+++","textAlignment":"Center","textColor":-1,"textSize":"10","visibilityVariable":{"varName":"shwSpcr841"}},"guid":-5691485731987455417,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneIcon","sceneIconConfig":{"alignment":"End","closeSceneOnPress":false,"sceneIconData":{"imagePackageName":"com.arlosoft.macrodroid","imageResourceId":2131231873,"imageResourceName":"ic_list_white_24dp"},"size":23,"tintColor":-1118482,"tintEnabled":true,"variableToUpdate":{"varName":"shwMnu247"},"variableUpdateValue":{"type":"BooleanValue","isToggle":true,"label":false}},"guid":-8277889964614726836,"iconRes":2131231505,"lastRefreshValue":0}],"sceneHorizontalLayoutConfig":{"alignment":"Center","visibilityVariable":{"varName":"shwClpbord537"}},"iconResId":2131231503,"guid":-8964598679934507259,"iconRes":2131231503,"lastRefreshValue":0},{"type":"SceneEditText","enteredText":"","lastEnteredText":"","sceneEditTextConfig":{"hintText":"Enter+text","horizontalLayoutWidth":50,"isBold":true,"isItalic":false,"isPassword":false,"populateWithValue":true,"singleLineOnly":true,"stringVariable":{"varName":"serchKy630"},"textColor":-1,"visibilityVariable":{"varName":"shwClpbord537"}},"guid":-6619743925529223812,"iconRes":2131231685,"lastRefreshValue":0},{"type":"SceneWebView","sceneWebViewConfig":{"closeSceneOnPress":false,"enableJavaScript":true,"enableSwipeNavigation":false,"height":60,"padding":"0","url":"\u003c!DOCTYPE+html\u003e\n\u003chtml+lang\u003d\"en\"\u003e\n\u003chead\u003e\n\u003cmeta+charset\u003d\"UTF-8\"\u003e\n\u003ctitle\u003eDynamic+List+-+Trackpad+Overlay+Scroll\u003c/title\u003e\n\u003cstyle\u003e\n/*+\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n+++NEW:+Text+Selection\n+++-------------------------\n+++Disable+text+selection+on+the+body,+enable+on+the+overlay\n+++\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d+*/\nbody+{\n++-webkit-user-select:+none;\n++-moz-user-select:+none;\n++-ms-user-select:+none;\n++user-select:+none;\n}\n#overlayContent+{\n++-webkit-user-select:+text;\n++-moz-user-select:+text;\n++-ms-user-select:+text;\n++user-select:+text;\n++/*+NEW:+Link+the+font+size+to+the+same+variable+*/\n++font-size:+{lv\u003dfntSz632}px;\n}\n\n/*+\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n+++Existing+Styles+(Condensed)\n+++-------------------------\n+++These+styles+have+not+been+changed.\n+++\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d+*/\n:root{\n++--accent-red:+#ff0000;\n++--accent-red-rgba-20:+rgba(255,0,0,0.2);\n++--accent-red-glow:+rgba(255,0,0,0.8);\n++--trackpad-glow:+rgba(160,160,160,0.65);\n++--trackpad-glow-strong:+rgba(160,160,160,0.95);\n++--delete-line-grey:+grey;\n++--delete-inset:+12px;\n++--slider-width:+72px;\n}\nbody+{+background-color:+#000;+margin:+0;+padding:+20px;+font-family:+Arial,+sans-serif;+color:+#fff;+}\nh2+{+color:+#fff;+text-align:+center;+font-size:+48px;+margin:+0;+}\n.header-container+{+display:+flex;+justify-content:+center;+align-items:+center;+margin-bottom:+10px;+position:+relative;+}\n/*+NEW:+Larger,+more+tappable+calendar+toggle+button+for+mobile+*/\n#toggleDatesBtn+{+position:+absolute;+left:+calc(50%+++250px);+transform:+translateX(-50%);+padding:+12px+18px;+background:+rgba(0,0,0,0.55);+color:+var(--accent-red);+border:+2px+solid+var(--accent-red);+border-radius:+10px;+font-size:+24px;+cursor:+pointer;+z-index:+9998;+transition:+background+0.2s,+box-shadow+0.18s,+transform+0.1s;+}\n#toggleDatesBtn.active+{+background:+var(--accent-red-rgba-20);+}\n\n/*+NEW:+Styles+for+the+date+pickers+and+labels+*/\n.date-pickers+{\n++display:+flex;\n++justify-content:+center;\n++align-items:+center;+/*+Align+items+vertically+*/\n++gap:+15px;\n++margin-top:+20px;\n}\n.date-picker-container+{\n++display:+flex;\n++flex-direction:+column;\n++align-items:+center;\n}\n.date-picker-label+{\n++font-size:+14px;+/*+Small+letters+for+the+label+*/\n++color:+#fff;\n++margin-bottom:+5px;+/*+Spacing+between+label+and+input+*/\n}\n.date-pickers+input[type\u003d\"date\"]+{\n++background:+#111;\n++color:+#fff;\n++border:+1px+solid+#fff;\n++border-radius:+8px;\n++padding:+10px+15px;\n++font-size:+24px;\n}\n.date-picker-separator+{\n++font-size:+24px;\n++color:+#fff;\n++align-self:+flex-end;+/*+Align+the+dash+with+the+inputs+*/\n++margin-bottom:+15px;+/*+Adjust+vertical+alignment+*/\n}\n\nul+{+list-style:+none;+padding:+0;+margin:+0;+}\nli+{+display:+flex;+align-items:+flex-start;+background:+#111;+margin:+30px+0;+padding:+10px;+width:+100%;+color:+#fff;+border:+2px+solid+#fff;+border-radius:+20px;+box-sizing:+border-box;+position:+relative;+transition:+background+0.3s,+border-color+0.3s;+}\nli.highlighted+{+background:+#333;+border-color:+var(--accent-red);+}\n\n.scroll-wrapper+{\n++flex:+1;\n++padding:+5px;\n++overflow:+hidden;\n++max-height:+{lv\u003dmxHght692}px;\n++position:+relative;\n++box-sizing:+border-box;\n}\n\n.text-box+{\n++font-size:+{lv\u003dfntSz632}px;\n++white-space:+pre-wrap;\n++word-break:+break-word;\n++padding:+2ch+1ch;\n++box-sizing:+border-box;\n++overflow:+hidden;\n}\n\n.highlight-word+{+background-color:+green;+color:+black;+font-weight:+bold;+border-radius:+4px;+padding:+0+2px;+}\n\n#submitBtn+{+position:+fixed;+top:+10px;+left:+50%;+transform:+translateX(-50%);+display:+none;+padding:+12px+18px;+font-size:+36px;+background:+rgba(255,0,0,0.35);+color:+#fff;+border:+2px+solid+rgba(255,0,0,0.6);+border-radius:+15px;+cursor:+pointer;+z-index:+9999;+}\n\n#highlightAllWrapper+{+position:+fixed;+top:+-50px;+left:+calc(50%+-+250px);+width:+120px;+height:+120px;+display:+none;+justify-content:+center;+align-items:+center;+z-index:+9999;+padding:+40px;+}\n#highlightAllBtn+{+width:+60px;+height:+60px;+background:+rgba(0,0,0,0.55)+!important;+color:+var(--accent-red);+border:+2px+solid+var(--accent-red);+border-radius:+50%;+font-size:+30px;+cursor:+pointer;+}\n#highlightAllBtn.none-mode+{+background:+var(--accent-red-rgba-20)+!important;+}\n\n.delete-tab+{+position:+absolute;+top:+10px;+width:+90px;+height:+70px;+cursor:+pointer;+z-index:+20;+}\n.delete-tab::before+{+content:+\u0027\u0027;+position:+absolute;+top:+0;+left:+0;+width:+90px;+height:+6px;+background-color:+var(--delete-line-grey);+border-radius:+3-px;+}\n.delete-tab.active::before+{+animation-name:+delete-line-pulse;+animation-duration:1.2s;+animation-iteration-count:infinite;+animation-timing-function:ease-in-out;+}\n@keyframes+delete-line-pulse+{+0%+{+background-color:+var(--delete-line-grey);+transform:+translateY(0);+opacity:1;+}+50%+{+background-color:+var(--accent-red);+transform:+translateY(-1px);+opacity:1;+}+100%{+background-color:+var(--delete-line-grey);+transform:+translateY(0);+opacity:1;+}+}\n\n/*+MODIFIED:+Styles+for+the+\"Entry+split\"+label+*/\n.split-label+{\n++++position:+absolute;\n++++top:+10px;\n++++font-size:+16px;\n++++color:+yellow;\n++++white-space:+normal;\n++++word-break:+normal;\n++++z-index:+20;\n++++max-width:+80%;\n}\n\n.slider-container+{\n++width:+var(--slider-width);\n++position:+absolute;\n++top:+10px;\n++border-radius:+12px;\n++cursor:+grab;\n++touch-action:+none;\n++z-index:+9997;\n++display:+block;\n++opacity:+0.7;\n++border:+none;\n++background:+linear-gradient(to+top,+rgba(160,160,160,0.35),+rgba(80,80,80,0.08));\n++box-shadow:+0+4px+10px+rgba(160,160,160,0.18);\n++padding:+6px;\n++animation:+trackpad-breathe+2.8s+infinite+ease-in-out;\n}\n.slider-container.dragging+{+box-shadow:0+0+22px+var(--trackpad-glow-strong);+opacity:0.95;+transform:scale(1.01);+animation:none;+}\n@keyframes+trackpad-breathe+{+0%+{+box-shadow:0+6px+12px+rgba(160,160,160,0.06);+transform:scale(1);+opacity:0.72;+}+50%+{+box-shadow:0+10px+24px+rgba(160,160,160,0.10);+transform:scale(1.01);+opacity:0.82;+}+100%+{+box-shadow:0+6px+12px+rgba(160,160,160,0.06);+transform:scale(1);+opacity:0.72;+}+}\n\nbody.left-handed+.slider-container+{+left:+10px;+right:+auto;+background:+linear-gradient(to+right,+rgba(100,100,100,0.55),+rgba(100,100,100,0.15));+}\nbody.right-handed+.slider-container+{+right:+10px;+left:+auto;+background:+linear-gradient(to+left,+rgba(100,100,100,0.55),+rgba(100,100,100,0.15));+}\nbody.right-handed+.delete-tab+{+left:+var(--delete-inset);+}\nbody.left-handed+.delete-tab+{+right:+var(--delete-inset);+}\n/*+MODIFIED:+Add+split-label+positioning+based+on+handedness+*/\nbody.right-handed+.split-label+{+left:+var(--delete-inset);+}\nbody.left-handed+.split-label+{+right:+var(--delete-inset);+}\n\nbody.delete-mode+#submitBtn,+body.delete-mode+#highlightAllBtn,+body.delete-mode+li.highlighted+{+animation:+pulsate-intense+1.2s+infinite+ease-in-out;+}\n@keyframes+pulsate-intense+{+0%+{+box-shadow:0+0+5px+rgba(255,0,0,0.6),0+0+15px+rgba(255,0,0,0.8);+border-color:+rgba(255,0,0,0.6);+}+50%+{+box-shadow:0+0+15px+rgba(255,0,0,1),0+0+35px+rgba(255,0,0,1);+border-color:+rgba(255,0,0,1);+}+100%+{+box-shadow:0+0+5px+rgba(255,0,0,0.6),0+0+15px+rgba(255,0,0,0.8);+border-color:+rgba(255,0,0,0.6);+}+}\n\n/*+NEW:+Fullscreen+Overlay+Styles+*/\n#fullscreenOverlay+{\n++position:+fixed;\n++top:+0;\n++left:+0;\n++width:+100%;\n++height:+100%;\n++background:+rgba(0,+0,+0,+0.9);\n++display:+flex;\n++justify-content:+center;\n++align-items:+center;\n++z-index:+10000;\n++opacity:+0;\n++visibility:+hidden;\n++transition:+opacity+0.3s+ease-in-out,+visibility+0s+0.3s;\n++flex-direction:+column;\n}\n#fullscreenOverlay.visible+{\n++opacity:+1;\n++visibility:+visible;\n++transition:+opacity+0.3s+ease-in-out;\n}\n#overlayContent+{\n++background:+#1c1c1c;\n++color:+#fff;\n++padding:+30px;\n++border-radius:+20px;\n++max-width:+90%;\n++max-height:+90%;\n++overflow-y:+auto;\n++box-shadow:+0+0+50px+rgba(255,+255,+255,+0.1);\n}\n#overlayCloseBtn+{\n++position:+absolute;\n++top:+30px;\n++right:+30px;\n++background:+transparent;\n++border:+2px+solid+#fff;\n++color:+#fff;\n++font-size:+24px;\n++padding:+10px+15px;\n++border-radius:+50%;\n++cursor:+pointer;\n++z-index:+10001;\n}\n\u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\u003cdiv+class\u003d\"header-container\"\u003e\n++\u003ch2\u003e🔍Search\u003c/h2\u003e\n++\u003cbutton+id\u003d\"toggleDatesBtn\"\u003e📅\u003c/button\u003e\n\u003c/div\u003e\n\u003cdiv+class\u003d\"date-pickers\"+id\u003d\"datePickers\"\u003e\n++\u003cdiv+class\u003d\"date-picker-container\"\u003e\n++++\u003cspan+class\u003