urn;\n++++}\n++++startX+\u003d+e.clientX;\n++++startY+\u003d+e.clientY;\n++++isTapped+\u003d+true;\n\n++++clearTimeout(longPressTimer);\n++++longPressTimer+\u003d+setTimeout(()+\u003d\u003e+{\n++++++++//+NEW:+The+overlay+now+opens+regardless+of+delete+mode\n++++++++if+(isTapped+\u0026\u0026+!isHoldingDeleteTab)+{\n++++++++++showOverlay(textDiv.innerHTML);\n++++++++}\n++++++++isTapped+\u003d+false;\n++++},+longPressDuration);\n++++li.setPointerCapture?.(e.pointerId);\n++});\n\n++li.addEventListener(\u0027pointermove\u0027,+(e)+\u003d\u003e+{\n++++if+(isTapped)+{\n++++++const+dx+\u003d+startX+-+e.clientX;\n++++++const+dy+\u003d+startY+-+e.clientY;\n++++++const+distance+\u003d+Math.sqrt(dx+*+dx+++dy+*+dy);\n++++++if+(distance+\u003e+swipeThreshold)+{\n++++++++clearTimeout(longPressTimer);\n++++++++isTapped+\u003d+false;\n++++++}\n++++}\n++});\n\n++li.addEventListener(\u0027pointerup\u0027,+(e)+\u003d\u003e+{\n++++clearTimeout(longPressTimer);\n\n++++if+(isTapped)+{+//+Check+for+isTapped+and+handle+single-tap+behavior\n++++++++isTapped+\u003d+false;\n++++++++//+The+tap+logic+remains+the+same\n++++++++if+(deleteMode+\u0026\u0026+hasLeading+\u0026\u0026+hasTrailing)+{\n++++++++++++li.classList.toggle(\u0027highlighted\u0027);\n++++++++++++updateSubmitBtn();\n++++++++}+else+if+(!deleteMode)+{\n++++++++++++fetch(`${triggerBase}?slctedItm147\u003d${encodeURIComponent(idx)}\u0026serchItm574\u003dtrue\u0026t\u003d${Date.now()}`).catch(()\u003d\u003e{});\n++++++++}\n++++}\n++++li.releasePointerCapture?.(e.pointerId);\n++});\n\n++li.addEventListener(\u0027pointercancel\u0027,+(e)+\u003d\u003e+{\n++++clearTimeout(longPressTimer);\n++++isTapped+\u003d+false;\n++++li.releasePointerCapture?.(e.pointerId);\n++});\n\n++//+Keep+the+`contextmenu`+handler+for+right-click+on+desktop\n++textDiv.addEventListener(\u0027contextmenu\u0027,+(e)+\u003d\u003e+{\n++++++e.preventDefault();\n++++++//+NEW:+The+overlay+now+opens+regardless+of+delete+mode\n++++++if+(!isHoldingDeleteTab)+{\n++++++++++showOverlay(textDiv.innerHTML);\n++++++}\n++});\n\n++//+\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n++//+Clipboard-style+Trackpad+Slider\n++//+\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n++const+sliderContainer+\u003d+document.createElement(\u0027div\u0027);\n++sliderContainer.className+\u003d+\u0027slider-container\u0027;\n++li.appendChild(sliderContainer);\n++sliderContainer.addEventListener(\u0027click\u0027,+e+\u003d\u003e+e.stopPropagation());\n\n++const+adjustHeights+\u003d+()+\u003d\u003e+{\n++++++const+style+\u003d+window.getComputedStyle(textDiv);\n++++++const+paddingTop+\u003d+parseFloat(style.paddingTop)+||+0;\n++++++const+paddingBottom+\u003d+parseFloat(style.paddingBottom)+||+0;\n++++++const+contentHeight+\u003d+textDiv.scrollHeight+-+paddingTop+-+paddingBottom;\n++++++const+maxHeight+\u003d+{lv\u003dmxHght692};\n++++++const+finalHeight+\u003d+Math.min(contentHeight+++paddingTop+++paddingBottom,+maxHeight);\n++++++wrapper.style.height+\u003d+finalHeight+++\u0027px\u0027;\n++++++wrapper.style.overflow+\u003d+\u0027hidden\u0027;\n++++++if+(contentHeight+++paddingTop+++paddingBottom+\u003e+maxHeight)+{\n++++++++++sliderContainer.style.display+\u003d+\u0027block\u0027;\n++++++++++sliderContainer.style.height+\u003d+finalHeight+++\u0027px\u0027;\n++++++}+else+sliderContainer.style.display+\u003d+\u0027none\u0027;\n++};\n++adjustHeights();\n++const+ro+\u003d+new+ResizeObserver(adjustHeights);\n++ro.observe(textDiv);\n++li._resizeObserver+\u003d+ro;\n\n++let+dragging+\u003d+false,+lastY+\u003d+0,+lastTime+\u003d+0,+velocityPxPerSec+\u003d+0,+lastPositions+\u003d+[];\n++sliderContainer.addEventListener(\u0027pointerdown\u0027,+e+\u003d\u003e+{\n++++++dragging+\u003d+true;\n++++++lastY+\u003d+e.clientY;\n++++++lastTime+\u003d+performance.now();\n++++++lastPositions+\u003d+[];\n++++++velocityPxPerSec+\u003d+0;\n++++++sliderContainer.classList.add(\u0027dragging\u0027);\n++++++sliderContainer.setPointerCapture?.(e.pointerId);\n++++++if+(wrapper._momentumAnim)+{+cancelAnimationFrame(wrapper._momentumAnim);+wrapper._momentumAnim+\u003d+null;+}\n++});\n\n++const+onMove+\u003d+ev+\u003d\u003e+{\n++++++if+(!dragging)+return;\n++++++const+now+\u003d+performance.now();\n++++++const+dt+\u003d+now+-+lastTime;\n++++++const+dy+\u003d+ev.clientY+-+lastY;\n++++++wrapper.scrollTop+-\u003d+dy;\n++++++if+(dt+\u003e+0)+{\n++++++++++lastPositions.push({+dy,+dt+});\n++++++++++if+(lastPositions.length+\u003e+6)+lastPositions.shift();\n++++++++++let+sum+\u003d+0,+div+\u003d+0;\n++++++++++for+(const+s+of+lastPositions)+{+sum++\u003d+(s.dy+/+s.dt);+div++\u003d+1;+}\n++++++++++velocityPxPerSec+\u003d+(sum+/+div)+*+1000;\n++++++}\n++++++lastY+\u003d+ev.clientY;\n++++++lastTime+\u003d+now;\n++};\n\n++const+onUp+\u003d+ev+\u003d\u003e+{\n++++++if+(!dragging)+return;\n++++++dragging+\u003d+false;\n++++++sliderContainer.classList.remove(\u0027dragging\u0027);\n++++++try+{+sliderContainer.releasePointerCapture?.(ev.pointerId);+}+catch+(e)+{+}\n++++++let+velocity+\u003d+-velocityPxPerSec;\n++++++const+density+\u003d+window.devicePixelRatio+||+1;\n++++++const+MIN_FLING_PX_PER_SEC+\u003d+50+*+density;\n++++++const+MAX_FLING_PX_PER_SEC+\u003d+8000+*+density;\n++++++const+SCROLL_FRICTION+\u003d+0.015;\n++++++const+GRAVITY_EARTH+\u003d+9.80665,+INCHES_PER_METER+\u003d+39.37;\n++++++const+PHYSICAL_COEFF+\u003d+GRAVITY_EARTH+*+INCHES_PER_METER+*+density+*+160+*+0.84;\n++++++const+DECELERATION_RATE+\u003d+Math.log(0.78)+/+Math.log(0.9);\n++++++const+getDecel+\u003d+l+\u003d\u003e+Math.log(0.35+*+Math.abs(l)+/+(SCROLL_FRICTION+*+PHYSICAL_COEFF));\n++++++const+getDistance+\u003d+v+\u003d\u003e+{\n++++++++++const+l+\u003d+getDecel(v);\n++++++++++return+SCROLL_FRICTION+*+PHYSICAL_COEFF+*+Math.exp(DECELERATION_RATE+/+(DECELERATION_RATE+-+1)+*+l);\n++++++};\n++++++const+getDuration+\u003d+v+\u003d\u003e+{\n++++++++++const+l+\u003d+getDecel(v);\n++++++++++return+Math.round(1000+*+Math.exp(l+/+(DECELERATION_RATE+-+1)));\n++++++};\n++++++if+(Math.abs(velocity)+\u003c+MIN_FLING_PX_PER_SEC)+return;\n++++++velocity+\u003d+Math.max(-MAX_FLING_PX_PER_SEC,+Math.min(MAX_FLING_PX_PER_SEC,+velocity));\n++++++const+distance+\u003d+getDistance(velocity)*Math.sign(velocity);\n++++++const+duration+\u003d+getDuration(velocity);\n++++++if+(!duration+||+!distance)+return;\n++++++const+start+\u003d+wrapper.scrollTop;\n++++++const+maxScroll+\u003d+wrapper.scrollHeight+-+wrapper.clientHeight;\n++++++let+target+\u003d+Math.round(start+++distance);\n++++++if+(target+\u003c+0)+target+\u003d+0;\n++++++if+(target+\u003e+maxScroll)+target+\u003d+maxScroll;\n++++++const+startTime+\u003d+performance.now();\n++++++function+easeOut(t)+{+return+1+-+Math.pow(1-t,+3);+}\n++++++function+step()+{\n++++++++++const+now+\u003d+performance.now();\n++++++++++const+t+\u003d+Math.min((now+-+startTime)+/+duration,+1);\n++++++++++wrapper.scrollTop+\u003d+start+++(target+-+start)+*+easeOut(t);\n++++++++++if+(t+\u003c+1)+wrapper._momentumAnim+\u003d+requestAnimationFrame(step);\n++++++}\n++++++step();\n++};\n\n++sliderContainer.addEventListener(\u0027pointermove\u0027,+onMove);\n++sliderContainer.addEventListener(\u0027pointerup\u0027,+onUp);\n++sliderContainer.addEventListener(\u0027pointercancel\u0027,+onUp);\n\n++list.appendChild(li);\n});\n\u003c/script\u003e\n\u003c/body\u003e\n\u003c/html\u003e\n","variableUpdateValue":{"type":"None"},"visibilityVariable":{"varName":"shwClpbord537"},"width":100},"guid":-4618088745369638515,"iconRes":2131231733,"lastRefreshValue":0},{"type":"SceneHorizontalLayout","children":[{"type":"SceneIcon","sceneIconConfig":{"alignment":"Start","closeSceneOnPress":false,"sceneIconData":{"imagePackageName":"com.arlosoft.macrodroid","imageResourceId":2131231781,"imageResourceName":"ic_error_outline_white_24dp"},"size":25,"tintColor":-1118482,"tintEnabled":true,"variableToUpdate":{"varName":"shwInfo534"},"variableUpdateValue":{"type":"BooleanValue","isToggle":true,"label":false}},"guid":-7620426521290309194,"iconRes":2131231505,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":false,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"++++++++++++++++++++++++++++++","textAlignment":"Start","textColor":-1,"textSize":"20","visibilityVariable":{"varName":"shwMnu247"}},"guid":-4896121978484941306,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneIcon","sceneIconConfig":{"alignment":"End","closeSceneOnPress":false,"sceneIconData":{"imagePackageName":"com.arlosoft.macrodroid","imageResourceId":2131231873,"imageResourceName":"ic_list_white_24dp"},"size":23,"tintColor":-1118482,"tintEnabled":true,"variableToUpdate":{"varName":"shwMnu247"},"variableUpdateValue":{"type":"BooleanValue","isToggle":true,"label":false}},"guid":-8506139034242588627,"iconRes":2131231505,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":false,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"+++++\n","textAlignment":"Start","textColor":-1,"textSize":"20"},"guid":-8537919620477058056,"iconRes":2131232676,"lastRefreshValue":0}],"sceneHorizontalLayoutConfig":{"alignment":"End","visibilityVariable":{"varName":"shwMnu247"}},"iconResId":2131231503,"guid":-8413084776961243223,"iconRes":2131231503,"lastRefreshValue":0},{"type":"SceneHorizontalDivider","config":{"dividerColor":-1,"dividerHeight":2,"padding":16,"visibilityVariable":{"varName":"shwMnu247"}},"guid":-6736802268841870040,"iconRes":2131231504,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":true,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"\u003cp+style\u003d\"font-size:+{lv\u003dfntSz632}px;\"\u003e\u003cu\u003e🔍+Search+Tab+Information:\u003c/u\u003e\u003c/p\u003e\n","textAlignment":"Center","textColor":-1,"textSize":"16","visibilityVariable":{"varName":"shwInfo534"}},"guid":-7969874835211112433,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":false,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"-Searching:\nYou+can+search+the+clipboard+log+for+keywords.+Additionally,+you+can+search+by+specific+dates+or+between+two+dates.+If+the+entered+date+is+not+found,+the+system+will+return+the+closest+matching+date.+The+search+may+take+longer+the+larger+the+log+gets.\n\n-+Delete+Mode:+\nTo+delete+an+entry,+hold+the+line+icon+in+the+top+corner+of+the+text+box+to+activate+delete+mode.+While+in+delete+mode,+a+\"Select+All\"+button+and+a+trash+can+icon+(\"🗑\")+will+appear+at+the+top+of+the+page.+Tap+an+entry+to+highlight+or+unhighlight+it+for+deletion.+Tap+the+trash+button+to+confirm+and+delete+the+selected+entries.It+will+delete+the+first+occurrence+of+a+duplicate+entry+unless+the+duplicates+are+also+highlighted.\n+\n-+Import+entry+into+clipboard:\nTap+the+entry+to+import+it+into+your+device\u0027s+clipboard.++\n\n-+Copyable+overlay:+\nHold+an+entry+to+activate+a+full-screen+overlay+of+the+entry.+This+is+useful+for+copying+specific+text+from+an+entry.++\n\n-+Scrollbar:\nOn+entry+boxes+with+large+text+entries+that+exceed+the+\"box+size\"+limit,+a+scrollbar+will+appear+on+the+side+of+the+textbox.+Use+this+to+scroll+the+text.\n++\n-+Turning+Pages:+\nThis+macro+retrieves+entries+from+the+file+in+chunks+to+prevent+system+overload+when+the+file+becomes+large.+These+chunks+are+organized+into+pages.+The+size+of+the+chunks+can+be+adjusted+to+be+larger+or+smaller+using+the+\"chrSze835\"+variable,+depending+on+your+device\u0027s+capabilities.+This+will+increase+the+page+sizes+(WARNING-+Do+not+adjust+this+to+be+over+50000+or+it+may+cause+issues).Tap+the+\"↪\"+icon+to+turn+the+page.\n\n-+Split+entries:\nDue+to+the+\"chunking\"+method+mentioned+above,+it+is+possible+for+an+entry+to+be+split+between+two+pages.+If+an+entry+is+cut+off+at+the+end+or+beginning+of+a+page,+it+is+likely+a+\"split+entry\"+and+will+be+temporarily+unavailable+for+deletion.+Split+entries+are+marked+in+the+corner+of+the+block+and+will+not+display+the+delete+tab.\n\n","textAlignment":"Start","textColor":-1,"textSize":"12","visibilityVariable":{"varName":"shwInfo534"}},"guid":-4841338429072137183,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":true,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"\n\u003ca+href\u003d\"https://www.macrodroidforum.com/index.php?threads/%F0%9F%93%8B-infinite-clipboard-%E2%99%BE%EF%B8%8F.8342/\"\u003e【Click+here+to+visit+the+forum+page】\u003c/a\u003e\n\n","textAlignment":"Center","textColor":-1,"textSize":"16","visibilityVariable":{"varName":"shwInfo534"}},"guid":-6014829638155850846,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneHorizontalDivider","config":{"dividerColor":-1,"dividerHeight":2,"padding":16,"visibilityVariable":{"varName":"shwInfo534"}},"guid":-9057723056353885076,"iconRes":2131231504,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":true,"isBold":true,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"\u003cp+style\u003d\"font-size:+{lv\u003dfntSz632}px;\"\u003e\u003cu\u003eSettings\u003c/u\u003e\u003c/p\u003e\n","textAlignment":"Center","textColor":-1,"textSize":"20","visibilityVariable":{"varName":"shwMnu247"}},"guid":-8643106629787904156,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":true,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"Font+size","textAlignment":"Center","textColor":-1,"textSize":"12","visibilityVariable":{"varName":"shwMnu247"}},"guid":-5192616748294002433,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneSlider","sceneSliderConfig":{"alignment":"Center","current":"{lv\u003dfntSzInt738}","max":"85","min":"25","numberVariable":{"varName":"fntSzInt738"},"sliderColor":-1,"stepSize":"2","textColor":-1,"textSize":"10","valuePosition":0,"visibilityVariable":{"varName":"shwMnu247"},"widthPercent":100},"guid":-7574507401221673486,"iconRes":2131231656,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":true,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"Box+size","textAlignment":"Center","textColor":-1,"textSize":"12","visibilityVariable":{"varName":"shwMnu247"}},"guid":-7394291113074632899,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneSlider","sceneSliderConfig":{"alignment":"Center","current":"{lv\u003dmxHghtInt483}","max":"2500","min":"150","numberVariable":{"varName":"mxHghtInt483"},"sliderColor":-1,"stepSize":"25","textColor":-1,"textSize":"10","valuePosition":0,"visibilityVariable":{"varName":"shwMnu247"},"widthPercent":100},"guid":-8682530762781168373,"iconRes":2131231656,"lastRefreshValue":0},{"type":"SceneGridLayout","children":[{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":false,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"{lv\u003dpausDsplyTxt924}\nOff/On","textAlignment":"Center","textColor":-1,"textSize":"12"},"guid":-7698269895617668743,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":false,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"Refresh+log","textAlignment":"Center","textColor":-1,"textSize":"12"},"guid":-9148897335134403076,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":false,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"Right/Left+Handed","textAlignment":"Center","textColor":-1,"textSize":"12"},"guid":-6869526716956377347,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneSwitch","checkedValue":false,"sceneSwitchConfig":{"alignment":"Center","booleanVariable":{"varName":"pausLggr268"},"isChecked":false,"switchOffColor":-4520679,"switchOnColor":-16732652,"text":"","textColor":-1,"textSize":"10","textStart":false},"guid":-7308376404211123381,"iconRes":2131231699,"lastRefreshValue":0},{"type":"SceneIcon","sceneIconConfig":{"alignment":"Center","closeSceneOnPress":false,"sceneIconData":{"imagePackageName":"com.arlosoft.macrodroid","imageResourceId":2131232014,"imageResourceName":"ic_sync_white_24dp"},"size":23,"tintColor":-1118482,"tintEnabled":true,"variableToUpdate":{"varName":"shwRfrsh582"},"variableUpdateValue":{"type":"BooleanValue","isToggle":true,"label":false}},"guid":-8792760088787585499,"iconRes":2131231505,"lastRefreshValue":0},{"type":"SceneSwitch","checkedValue":false,"sceneSwitchConfig":{"alignment":"Center","booleanVariable":{"varName":"orientScrn475"},"isChecked":false,"switchOffColor":-4520679,"switchOnColor":-16732652,"text":"","textColor":-1,"textSize":"10","textStart":false},"guid":-8423627402589216208,"iconRes":2131231699,"lastRefreshValue":0}],"sceneGridLayoutConfig":{"itemsPerRow":3,"rowHeight":66,"visibilityVariable":{"varName":"shwMnu247"}},"iconResId":2131232196,"guid":-4645698231956271645,"iconRes":2131232196,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":false,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"Are+you+sure+you+want+to+delete+the+entire+log+and+begin+again?","textAlignment":"Center","textColor":-1,"textSize":"15","visibilityVariable":{"varName":"shwRfrsh582"}},"guid":-7895877384328237222,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneButton","sceneButtonConfig":{"buttonColor":-3407858,"closeSceneOnPress":false,"htmlFormatting":false,"text":"Confirm+Clipboard+Refresh","textColor":-1,"textSize":"10","variableToUpdate":{"varName":"refrshClpbord274"},"variableUpdateValue":{"type":"BooleanValue","isToggle":false,"label":true},"visibilityVariable":{"varName":"shwRfrsh582"}},"guid":-7492510042637175289,"iconRes":2131231205,"lastRefreshValue":0},{"type":"SceneHorizontalDivider","config":{"dividerColor":-1,"dividerHeight":2,"padding":16,"visibilityVariable":{"varName":"showInfo"}},"guid":-6177567580395445821,"iconRes":2131231504,"lastRefreshValue":0}],"label":"🔍"},{"children":[{"type":"SceneHorizontalLayout","children":[{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":false,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"Entries:+{size\u003dnotCntntArry835}","textAlignment":"Start","textColor":-1,"textSize":"10"},"guid":-8183048977211920434,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":false,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"++++++++++","textAlignment":"Start","textColor":-1,"textSize":"20"},"guid":-7040695179134193883,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneText","sceneTextConfig":{"autoSizeText":false,"enableAutoRefresh":false,"enableSelection":false,"htmlFormatting":false,"isBold":false,"isItalic":false,"maxLines":"3","maxLinesEnabled":false,"text":"","textAlignment":"Start","textColor":-1,"textSize":"20"},"guid":-8711240326453738238,"iconRes":2131232676,"lastRefreshValue":0},{"type":"SceneIcon","sceneIconConfig":{"alignment":"End","closeSceneOnPress":false,"sceneIconData":{"imagePackageName":"com.arlosoft.macrodroid","imageResourceId":2131231873,"imageResourceName":"ic_list_white_24dp"},"size":23,"tintColor":-1118482,"tintEnabled":true,"variableToUpdate":{"varName":"shwMnu247"},"variableUpdateValue":{"type":"BooleanValue","isToggle":true,"label":false}},"guid":-8235758883851687151,"iconRes":2131231505,"lastRefreshValue":0}],"sceneHorizontalLayoutConfig":{"alignment":"Center","visibilityVariable":{"varName":"shwClpbord537"}},"iconResId":2131231503,"guid":-8684786869262195555,"iconRes":2131231503,"lastRefreshValue":0},{"type":"SceneWebView","sceneWebViewConfig":{"closeSceneOnPress":false,"enableJavaScript":true,"enableSwipeNavigation":false,"height":75,"padding":"0","url":"\u003c!DOCTYPE+html\u003e\n\u003chtml+lang\u003d\"en\"\u003e\n\u003chead\u003e\n\u003cmeta+charset\u003d\"UTF-8\"\u003e\n\u003ctitle\u003eDynamic+List+-+Trackpad+++Edit+++Delete+Mode\u003c/title\u003e\n\u003cstyle\u003e\n:root{\n++--accent-red:+#ff0000;\n++--accent-red-rgba-20:+rgba(255,0,0,0.2);\n++--accent-red-glow:+rgba(255,0,0,0.8);\n++--trackpad-glow:+rgba(160,160,160,0.65);\n++--trackpad-glow-strong:+rgba(160,160,160,0.95);\n++--delete-line-grey:+grey;\n++--delete-inset:+12px;\n++--pinned-gold:+#ffd700;\n}\n\n/*+PAGE+*/\nbody+{+background:#000;+margin:0;+padding:20px;+font-family:Arial,sans-serif;+color:#fff;+}\n.header-wrap+{+position:relative;+text-align:center;+margin-bottom:30px;+}\nh2+{+font-size:48px;+margin:0;+display:inline-block;+vertical-align:middle;+}\n#addNewBtn+{+position:absolute;+left:calc(50%+++220px);+top:10px;+font-size:36px;+background:transparent;+border:none;+color:grey;+cursor:pointer;+padding:6px+10px;+}\n\n/*+LIST+\u0026+ITEMS+*/\nul+{+list-style:none;+padding:0;+margin:0;+}\nli+{\n++display:flex;\n++align-items:flex-start;\n++background:#111;\n++margin:22px+0;\n++padding:12px;\n++width:100%;\n++color:#fff;\n++border:2px+solid+#fff;\n++border-radius:20px;\n++position:relative;\n++box-sizing:border-box;\n++transition:+background+0.22s,+border-color+0.22s;\n}\nli.highlighted+{+background:#333;+border-color:+var(--accent-red);+}\nli.pinned+{+border-color:+var(--pinned-gold);+}\nli.highlighted.pinned+{+background:#333;+border-color:+var(--pinned-gold);+}\n/*+The+new+pinned+icon+style+*/\n.pinned-icon+{\n++++position:+absolute;\n++++top:+-5px;\n++++left:+50%;\n++++transform:+translateX(-50%);\n++++color:+var(--pinned-gold);\n++++font-size:+24px;\n++++z-index:+10;\n++++pointer-events:+none;\n}\n\n/*+SCROLL+WRAPPER+\u0026+TEXT+BOX+*/\n.scroll-wrapper+{+flex:1;+padding:5px;+overflow:hidden;+position:relative;+max-height:{lv\u003dmxHght692};+}\n.text-box+{\n++box-sizing:+border-box;\n++font-size:{lv\u003dfntSz632}px;\n++line-height:1.45;\n++white-space:pre-wrap;\n++word-break:break-word;\n++padding-top:2ch;\n++padding-bottom:2ch;\n++min-height:+1.5em;\n++/*+Default+padding+(opposite+of+touchpad)+*/\n++padding-left:+2ch;\n++padding-right:+2ch;\n++/*+Prevent+text+selection+*/\n++user-select:+none;\n++-webkit-user-select:+none;\n++-moz-user-select:+none;\n++-ms-user-select:+none;\n}\n/*+Handed-mode+specific+padding+*/\nbody.left-handed+.text-box+{\n++padding-left:+3ch;+/*+Pad+for+touchpad+on+left+*/\n++padding-right:+2ch;\n}\nbody.right-handed+.text-box+{\n++padding-right:+3ch;+/*+Pad+for+touchpad+on+right+*/\n++padding-left:+2ch;\n}\n\n/*+DELETE+TAB+*/\n.delete-tab+{\n++position:+absolute;\n++top:+10px;\n++width:+90px;\n++height:+70px;\n++cursor:+pointer;\n++z-index:+20;\n}\n.delete-tab::before+{\n++content:+\u0027\u0027;\n++position:+absolute;\n++top:+0;\n++left:+0;\n++width:+90px;\n++height:+6px;\n++background-color:+var(--delete-line-grey);\n++border-radius:+3px;\n++transition:+background-color+0.18s;\n++animation-delay:+var(--pulse-delay,+0ms);\n++animation-fill-mode:+both;\n}\n.delete-tab.active::before+{\n++animation-name:+delete-line-pulse;\n++animation-duration:+1.2s;\n++animation-iteration-count:+infinite;\n++animation-timing-function:+ease-in-out;\n}\n@keyframes+delete-line-pulse+{\n++0%+{+background-color:+var(--delete-line-grey);+transform:+translateY(0);+opacity:1;+}\n++50%+{+background-color:+var(--accent-red);+transform:+translateY(-1px);+opacity:1;+}\n++100%{+background-color:+var(--delete-line-grey);+transform:+translateY(0);+opacity:1;+}\n}\n\n/*+SLIDER+(TRACKPAD)+*/\n.slider-container+{\n++width:+72px;\n++position:absolute;\n++top:10px;\n++height:calc(100%+-+20px);\n++border-radius:12px;\n++cursor:+grab;\n++touch-action:none;\n++transition:+box-shadow+0.18s,+opacity+0.2s,+transform+0.18s;\n++z-index:15;\n++display:none;\n++opacity:0.7;\n++border:none;\n++background:+linear-gradient(to+left,+rgba(100,100,100,0.55),+rgba(100,100,100,0.15));\n++animation:+trackpad-breathe+2.8s+infinite+ease-in-out;\n}\n.slider-container.dragging+{\n++box-shadow:0+0+22px+var(--trackpad-glow-strong);\n++opacity:0.85;\n++transform:scale(1.01);\n++animation:none;\n}\n@keyframes+trackpad-breathe+{\n++0%+{+box-shadow:0+6px+12px+rgba(160,160,160,0.06);+transform:scale(1);+opacity:0.72;+}\n++50%+{+box-shadow:0+10px+24px+rgba(160,160,160,0.10);+transform:scale(1.01);+opacity:0.82;+}\n++100%+{+box-shadow:0+6p;x+12px+rgba(160,160,160,0.06);+transform:scale(1);+opacity:0.72;+}\n}\nbody.left-handed+.slider-container+{+left:10px;+right:auto;+background:+linear-gradient(to+right,+rgba(100,100,100,0.55),+rgba(100,100,100,0.15));+}\nbody.right-handed+.slider-container+{+right:10px;+left:auto;+background:+linear-gradient(to+left,+rgba(100,100,100,0.55),+rgba(100,100,100,0.15));+}\nbody.right-handed+.delete-tab+{+left:+var(--delete-inset);+right:auto;+}\nbody.left-handed+.delete-tab+{+right:+var(--delete-inset);+left:auto;+}\n\n/*+PULSATE+WHEN+IN+DELETE+MODE+*/\n@keyframes+pulsate-intense+{\n++0%+{+box-shadow:0+0+5px+rgba(255,0,0,0.6),0+0+15px+rgba(255,0,0,0.8);+border-color:+rgba(255,0,0,0.6);+}\n++50%+{+box-shadow:0+0+15px+rgba(255,0,0,1),0+0+35px+rgba(255,0,0,1);+border-color:+rgba(255,0,0,1);+}\n++100%+{+box-shadow:0+0+5px+rgba(255,0,0,0.6),0+0+15px+rgba(255,0,0,0.8);+border-color:+rgba(255,0,0,0.6);+}\n}\nbody.delete-mode+#submitBtn,\nbody.delete-mode+#highlightAllBtn,\nbody.delete-mode+li.highlighted:not(.pinned)+{+animation:+pulsate-intense+1.2s+infinite+ease-in-out;+}\n\n/*+CONTROLS+(submit+\u0026+highlight+all)+*/\n#submitBtn+{\n++position:+fixed;\n++top:+10px;\n++left:+50%;\n++transform:+translateX(-50%);\n++display:+none;\n++padding:+12px+18px;\n++font-size:+36px;\n++background:+rgba(255,0,0,0.35);\n++color:#fff;\n++border:2px+solid+rgba(255,0,0,0.6);\n++border-radius:15px;\n++cursor:pointer;\n++z-index:9999;\n++box-shadow:0+4px+8px+rgba(0,0,0,0.35);\n++transition:+box-shadow+0.18s,+transform+0.08s,+background+0.12s;\n}\n#highlightAllWrapper+{+position:+fixed;+top:+-50px;+left:+calc(50%+-+260px);+width:+120px;+height:+120px;+display:+none;+justify-content:+center;+align-items:+center;+z-index:9999;+padding:+40px;+box-sizing:+content-box;+}\n#highlightAllBtn+{+width:60px;+height:60px;+background:+rgba(0,0,0,0.55)+!important;+color:+var(--accent-red);+border:2px+solid+var(--accent-red);+border-radius:50%;+text-align:center;+line-height:60px;+font-size:30px;+cursor:pointer;+transition:+background+0.2s,+box-shadow+0.18s,+transform+0.1s;+}\n#highlightAllBtn.none-mode+{+background:+var(--accent-red-rgba-20)+!important;+}\n\n/*+EDIT+OVERLAY+*/\n#editorOverlay{+display:none;+position:fixed;+inset:0;+background:linear-gradient(180deg,+rgba(0,0,0,0.95),+rgba(0,0,0,0.98));+z-index:10000;+padding:14px;+box-sizing:border-box;+}\n#editorContainer{\n++height:100%;\n++max-width:900px;\n++margin:0+auto;\n++display:flex;\n++flex-direction:column;\n++gap:10px;\n++background:#111;\n++border-radius:10px;\n++padding:12px;\n++box-sizing:border-box;\n++border:2px+solid+grey;\n++overflow:hidden;\n}\n#editorTextarea{\n++width:100%;\n++background:#000;\n++color:#fff;\n++border:none;\n++border-radius:8px;\n++padding:10px;\n++padding-bottom:1000px;\n++resize:none;\n++font-family:inherit;\n++font-size:{lv\u003dfntSz632}px;\n++flex:1+1+auto;\n++min-height:120px;\n++max-height:100%;\n++overflow:auto;\n++outline:none;\n}\n.editorButtons{+display:flex;+gap:10px;+justify-content:space-between;+padding-top:8px;+}\n.btn{\n++border:none;\n++background:transparent;\n++font-weight:700;\n++cursor:pointer;\n++color:#fff;\n++padding:20px+28px;\n++font-size:32px;\n++border-radius:12px;\n++transition:+transform+0.1s;\n}\n.btn:hover+{+transform:+scale(1.08);+}\n.btn-save{+color:limegreen;+}\n.btn-save:disabled+{+color:+grey;+cursor:not-allowed;+opacity:0.6;+}\n.btn-delete{+color:var(--accent-red);+}\n.btn-cancel{+color:grey;+}\nbutton:focus+{+outline:none;+box-shadow:none;+}\n\n/*+CHARACTER+INFO+*/\n#charInfo+{+color:grey;+font-size:14px;+margin-bottom:6px;+}\n#charError+{\n++display:none;\n++color:#fff;\n++background:+var(--accent-red-rgba-20);\n++border:1px+solid+var(--accent-red);\n++border-radius:6px;\n++padding:10px+14px;+/*+Increased+padding+*/\n++margin-top:6px;\n++font-size:18px;+/*+Increased+font+size+*/\n++text-align:+center;\n}\n\u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n++\u003cdiv+class\u003d\"header-wrap\"\u003e\n++++\u003ch2\u003e🗒+Notes\u003c/h2\u003e\n++++\u003cbutton+id\u003d\"addNewBtn\"\u003e++Add+New\u003c/button\u003e\n++\u003c/div\u003e\n\n++\u003cul+id\u003d\"dynamicList\"\u003e\u003c/ul\u003e\n\n++\u003cbutton+id\u003d\"submitBtn\"\u003e🗑️\u003c/button\u003e\n++\u003cdiv+id\u003d\"highlightAllWrapper\"\u003e\u003cbutton+id\u003d\"highlightAllBtn\"\u003eAll\u003c/button\u003e\u003c/div\u003e\n\n++\u003ctextarea+id\u003d\"handedVar\"+style\u003d\"display:none\"\u003e{lv\u003dorientScrn475}\u003c/textarea\u003e\n++\u003ctextarea+id\u003d\"rawData\"+style\u003d\"display:none\"\u003e{lv\u003dnotCntntStrng482}\u003c/textar