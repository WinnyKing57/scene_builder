        "enableSwipeNavigation": true,
        "height": 100,
        "padding": "0",
        "url": "<!DOCTYPE+html>\n<html+lang=\"en\">\n<head>\n++++<meta+charset=\"UTF-8\">\n++++<meta+name=\"viewport\"+content=\"width=device-width,+initial-scale=1.0,+maximum-scale=1.0,+user-scalable=no,+viewport-fit=cover\">\n++++<title>Teddy+Shuffle:+Arena</title>\n++++<style>\n++++++++@import+url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;900&display=swap');\n\n++++++++:root+{\n++++++++++++--bg-gradient:+linear-gradient(135deg,+#fdfbf7+0%,+#fff0d4+100%);\n++++++++++++--text-dark:+#5d4037;\n++++++++++++--primary:+#ffb300;\n++++++++++++--primary-dark:+#e6a000;\n++++++++++++--accent:+#ff6f00;\n++++++++++++--white:+#ffffff;\n++++++++}\n\n++++++++*+{+box-sizing:+border-box;+margin:+0;+padding:+0;+user-select:+none;+font-family:+'Nunito',+sans-serif;+-webkit-tap-highlight-color:+transparent;+}\n++++++++html,+body+{+width:+100%;+height:+100%;+background:+var(--bg-gradient);+color:+var(--text-dark);+overflow:+hidden;+}\n\n++++++++#bg-canvas+{+position:+fixed;+top:+0;+left:+0;+width:+100%;+height:+100%;+pointer-events:+none;+z-index:+1;+overflow:+hidden;+}\n++++++++.falling-item+{+position:+absolute;+top:+-50px;+font-size:+24px;+animation:+fall+linear+infinite;+opacity:+0.3;+}\n++++++++@keyframes+fall+{+to+{+transform:+translateY(110vh)+rotate(360deg);+}+}\n\n++++++++.screen+{+position:+fixed;+top:+0;+left:+0;+width:+100%;+height:+100%;+display:+flex;+flex-direction:+column;+z-index:+10;+}\n++++++++.is-hidden+{+display:+none+!important;+}\n++++++++.scroll-area+{+flex:+1;+overflow-y:+auto;+padding:+20px;+display:+flex;+flex-direction:+column;+align-items:+center;+-webkit-overflow-scrolling:+touch;+}\n++++++++.spacer+{+flex:+1;+min-height:+20px;+}\n\n++++++++/*+---+CLEAN+ARENA+LOGIN+---+*/\n++++++++.card+{\n++++++++++++background:+var(--white);+border-radius:+35px;\n++++++++++++box-shadow:+0+20px+45px+rgba(93,+64,+55,+0.15);\n++++++++++++padding:+40px+25px;+width:+100%;+max-width:+340px;\n++++++++++++text-align:+center;+margin:+auto;+position:+relative;\n++++++++++++border:+4px+solid+var(--white);\n++++++++}\n++++++++.arena-badge+{+\n++++++++++++display:+inline-block;+background:+#fff3e0;+color:+var(--accent);\n++++++++++++padding:+6px+16px;+border-radius:+50px;+font-weight:+900;+font-size:+0.75rem;\n++++++++++++letter-spacing:+1px;+margin-bottom:+15px;\n++++++++}\n\n++++++++.title-group+h1+{+font-size:+2rem;+font-weight:+900;+margin-bottom:+5px;+color:+var(--text-dark);+}\n++++++++.title-group+p+{+font-size:+0.9rem;+font-weight:+700;+color:+#8d6e63;+margin-bottom:+25px;+}\n\n++++++++.input-group+{+position:+relative;+width:+100%;+margin-bottom:+15px;+}\n++++++++.inp+{\n++++++++++++width:+100%;+padding:+18px;+border:+2px+solid+#f5f5f5;+border-radius:+20px;\n++++++++++++background:+#fafafa;+color:+var(--text-dark);+font-size:+1rem;+font-weight:+700;+outline:+none;\n++++++++}\n++++++++.inp:focus+{+border-color:+var(--primary);+background:+#fff;+}\n++++++++.toggle-pwd+{+position:+absolute;+right:+18px;+top:+50%;+transform:+translateY(-50%);+cursor:+pointer;+opacity:+0.6;+}\n\n++++++++.btn+{\n++++++++++++width:+100%;+padding:+18px;+border:+none;+border-radius:+22px;\n++++++++++++background:+var(--primary);+color:+#fff;+font-size:+1.1rem;+font-weight:+900;\n++++++++++++box-shadow:+0+6px+0+var(--primary-dark);+cursor:+pointer;+text-transform:+uppercase;\n++++++++}\n++++++++.btn:active+{+transform:+translateY(4px);+box-shadow:+0+2px+0+var(--primary-dark);+}\n\n++++++++/*+---+GAME+UI+---+*/\n++++++++.hud+{+width:+100%;+max-width:+340px;+display:+flex;+justify-content:+space-between;+margin-bottom:+20px;+}\n++++++++.pill+{+background:+white;+padding:+10px+18px;+border-radius:+50px;+font-weight:+900;+box-shadow:+0+4px+10px+rgba(0,0,0,0.05);+}\n\n++++++++.game-board+{+position:+relative;+width:+100%;+max-width:+320px;+height:+180px;+margin:+25px+0;+}\n++++++++.pot+{+position:+absolute;+bottom:+0;+width:+85px;+height:+105px;+cursor:+pointer;+z-index:+5;+transition:+left+0.55s+cubic-bezier(0.45,+0.05,+0.55,+0.95),+transform+0.3s;+}\n++++++++.pot-body+{+width:+100%;+height:+100%;+background:+linear-gradient(145deg,+#ffca28,+#f57c00);+border-radius:+15px+15px+40px+40px;+border-bottom:+6px+solid+#bf360c;+position:+relative;+}\n++++++++.pot-label+{+position:+absolute;+bottom:+12px;+width:+100%;+text-align:+center;+font-size:+8px;+font-weight:+900;+color:+rgba(255,255,255,0.6);+letter-spacing:+0.5px;+}\n++++++++.pot.lifted+{+transform:+translateY(-80px)+rotate(-5deg);+}\n++++++++.honey+{+position:+absolute;+bottom:+20px;+width:+35px;+height:+35px;+background:+radial-gradient(circle+at+30%+30%,+#ffd740,+#ff8f00);+border-radius:+50%;+border:+3px+solid+#fff;+box-shadow:+0+0+15px+#ffb300;+z-index:+2;+}\n\n++++++++/*+---+LEADERBOARD+---+*/\n++++++++.lb-header+{+width:+100%;+background:+var(--primary);+color:+white;+padding:+55px+20px+25px;+text-align:+center;+border-radius:+0+0+35px+35px;+position:+relative;+}\n++++++++.btn-close-x+{+position:+absolute;+top:+15px;+right:+20px;+background:+rgba(0,0,0,0.1);+border:+none;+color:+white;+width:+36px;+height:+36px;+border-radius:+50%;+font-weight:+900;+cursor:+pointer;+}\n++++++++.lb-scroll-container+{+flex:+1;+overflow-y:+scroll;+width:+100%;+display:+flex;+flex-direction:+column;+align-items:+center;+padding-bottom:+30px;+-webkit-overflow-scrolling:+touch;+}\n++++++++.lb-content+{+width:+100%;+max-width:+360px;+padding:+25px+20px;+}\n++++++++.lb-row+{+display:+flex;+align-items:+center;+background:+white;+padding:+18px;+border-radius:+22px;+margin-bottom:+12px;+border:+1px+solid+#f0f0f0;+}\n++++++++.rank-circle+{+width:+38px;+height:+38px;+background:+#fff8e1;+border-radius:+50%;+display:+flex;+align-items:+center;+justify-content:+center;+font-weight:+900;+margin-right:+15px;+border:+1px+solid+var(--primary);+}\n++++++++.player-box+{+flex:+1;+}\n++++++++.player-score+{+font-weight:+900;+color:+var(--primary-dark);+font-size:+1.4rem;+}\n\n++++++++.status+{+font-size:+1.6rem;+font-weight:+900;+color:+var(--accent);+margin-bottom:+15px;+text-align:+center;+min-height:+45px;+}\n\n++++</style>\n</head>\n<body>\n\n++++<div+id=\"bg-canvas\"></div>\n\n++++<div+id=\"view-login\"+class=\"screen\">\n++++++++<div+class=\"scroll-area\">\n++++++++++++<div+class=\"spacer\"></div>\n++++++++++++<div+class=\"card\">\n++++++++++++++++<div+class=\"arena-badge\">Welcome+To+Honey+Arena</div>\n++++++++++++++++<div+class=\"title-group\">\n++++++++++++++++++++<h1>Teddy+Shuffle+🍯</h1>\n++++++++++++++++++++<p>Enter+a+unique+username+to+register+and+play.+Make+sure+you+remember+your+details.</p>\n++++++++++++++++</div>\n++++++++++++++++<div+class=\"input-group\">\n++++++++++++++++++++<input+type=\"text\"+id=\"inp-handle\"+class=\"inp\"+placeholder=\"Username\"+maxlength=\"12\">\n++++++++++++++++</div>\n++++++++++++++++<div+class=\"input-group\">\n++++++++++++++++++++<input+type=\"password\"+id=\"inp-pwd\"+class=\"inp\"+placeholder=\"Password\">\n++++++++++++++++++++<span+class=\"toggle-pwd\"+id=\"btn-toggle\">👁️</span>\n++++++++++++++++</div>\n++++++++++++++++<p+id=\"login-msg\"+style=\"color:red;+font-size:0.8rem;+font-weight:bold;+margin-bottom:15px;+height:15px;\"></p>\n++++++++++++++++<button+class=\"btn\"+id=\"btn-login\">Join+Game</button>\n++++++++++++++++<div+style=\"margin-top:25px;+padding:5px;+font-size:12px;+background-color:#f5f5f5;+border-radius:6px;\">\n+++++++++++++++++If+you+are+facing+any+error+or+forgotten+your+details+then+contact+\"unskyit@gmail.com\".\n</div>\n++++++++++++</div>\n++++++++++++<div+class=\"spacer\"></div>\n++++++++</div>\n++++</div>\n\n++++<div+id=\"view-game\"+class=\"screen+is-hidden\">\n++++++++<div+class=\"scroll-area\">\n++++++++++++<div+class=\"hud\">\n++++++++++++++++<div+class=\"pill\">🍯+<span+id=\"txt-score\">0</span></div>\n++++++++++++++++<div+class=\"pill\"+id=\"btn-show-lb\"+style=\"color:var(--accent);+cursor:pointer;\">🏆+Ranking</div>\n++++++++++++</div>\n++++++++++++<div+class=\"spacer\"></div>\n++++++++++++<div+class=\"status\"+id=\"game-status\">Ready?</div>\n++++++++++++<div+class=\"game-board\"+id=\"table\"></div>\n++++++++++++<div+class=\"spacer\"></div>\n++++++++++++<button+class=\"btn\"+id=\"btn-action\"+style=\"max-width:+280px;\">Shuffle+Pots</button>\n++++++++++++<div+class=\"spacer\"></div>\n++++++++</div>\n++++</div>\n\n++++<div+id=\"view-lb\"+class=\"screen+is-hidden\"+style=\"background:+#fffbf2;\">\n++++++++<div+class=\"lb-header\">\n++++++++++++<button+class=\"btn-close-x\"+id=\"btn-hide-lb-top\">✕</button>\n++++++++++++<h2+style=\"font-weight:+900;+font-size:+1.8rem;\">LEADERBOARD</h2>\n++++++++</div>\n++++++++<div+class=\"lb-scroll-container\">\n++++++++++++<div+class=\"lb-content\"+id=\"lb-list\"></div>\n++++++++</div>\n++++</div>\n\n++++<script+type=\"module\">\n++++++++import+{+initializeApp+}+from+\"https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js\";\n++++++++import+{+getAuth,+signInWithEmailAndPassword,+createUserWithEmailAndPassword,+onAuthStateChanged+}+from+\"https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js\";\n++++++++import+{+getFirestore,+doc,+setDoc,+getDoc,+collection,+query,+orderBy,+limit,+getDocs+}+from+\"https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js\";\n\n++++++++const+firebaseConfig+=+{\n++++++++++++apiKey:+\"AIzaSyC26LXwQc5EnEkRIjKQi4d2SzJRKNemGm4\",\n++++++++++++authDomain:+\"teddy-shuffel.firebaseapp.com\",\n++++++++++++projectId:+\"teddy-shuffel\",\n++++++++++++storageBucket:+\"teddy-shuffel.firebasestorage.app\",\n++++++++++++messagingSenderId:+\"858055132182\",\n++++++++++++appId:+\"1:858055132182:web:92bad25ddcb8f852e2e137\"\n++++++++};\n++++++++const+app+=+initializeApp(firebaseConfig);\n++++++++const+auth+=+getAuth(app);\n++++++++const+db+=+getFirestore(app);\n\n++++++++const+state+=+{+score:+0,+isPlaying:+false,+winId:+0,+handle:+\"\",+cups:+[]+};\n++++++++const+POSITIONS+=+['10px',+'115px',+'220px'];+\n\n++++++++//+---+CALM+AUDIO+ENGINE+---\n++++++++let+audioCtx+=+null;\n++++++++function+initAudio()+{+if(!audioCtx)+audioCtx+=+new+(window.AudioContext+||+window.webkitAudioContext)();+}\n\n++++++++function+playTone(freq,+duration,+type+=+'sine',+vol+=+0.05)+{\n++++++++++++initAudio();\n++++++++++++if(audioCtx.state+===+'suspended')+audioCtx.resume();\n++++++++++++const+osc+=+audioCtx.createOscillator();\n++++++++++++const+gain+=+audioCtx.createGain();\n++++++++++++osc.type+=+type;\n++++++++++++osc.frequency.setValueAtTime(freq,+audioCtx.currentTime);\n++++++++++++gain.gain.setValueAtTime(vol,+audioCtx.currentTime);\n++++++++++++gain.gain.exponentialRampToValueAtTime(0.0001,+audioCtx.currentTime+++duration);\n++++++++++++osc.connect(gain);\n++++++++++++gain.connect(audioCtx.destination);\n++++++++++++osc.start();\n++++++++++++osc.stop(audioCtx.currentTime+++duration);\n++++++++}\n\n++++++++const+sounds+=+{\n++++++++++++click:+()+=>+playTone(440,+0.15,+'sine',+0.04),\n++++++++++++shuffle:+()+=>+playTone(220,+0.08,+'triangle',+0.03),\n++++++++++++win:+()+=>+{+playTone(523,+0.3);+setTimeout(()+=>+playTone(659,+0.4),+100);+},\n++++++++++++fail:+()+=>+playTone(110,+0.5,+'sawtooth',+0.04)\n++++++++};\n\n++++++++//+---+UI+---\n++++++++document.getElementById('btn-toggle').onclick+=+()+=>+{\n++++++++++++sounds.click();\n++++++++++++const+inp+=+document.getElementById('inp-pwd');\n++++++++++++inp.type+=+inp.type+===+'password'+?+'text'+:+'password';\n++++++++++++document.getElementById('btn-toggle').innerText+=+inp.type+===+'password'+?+'👁️'+:+'🙈';\n++++++++};\n\n++++++++setInterval(()+=>+{\n++++++++++++const+el+=+document.createElement('div');\n++++++++++++el.className+=+'falling-item';\n++++++++++++el.innerText+=+Math.random()+>+0.5+?+'🍯'+:+'🧸';\n++++++++++++el.style.left+=+Math.random()+*+95+++'vw';\n++++++++++++el.style.animationDuration+=+(Math.random()+*+3+++4)+++'s';\n++++++++++++document.getElementById('bg-canvas').appendChild(el);\n++++++++++++setTimeout(()+=>+el.remove(),+7000);\n++++++++},+2000);\n\n++++++++//+---+AUTH+---\n++++++++document.getElementById('btn-login').onclick+=+async+()+=>+{\n++++++++++++sounds.click();\n++++++++++++const+h+=+document.getElementById('inp-handle').value.trim();\n++++++++++++const+p+=+document.getElementById('inp-pwd').value;\n++++++++++++const+msg+=+document.getElementById('login-msg');\n++++++++++++if(!h+||+!p)+{+msg.innerText+=+\"Check+details!\";+return;+}\n++++++++++++msg.innerText+=+\"Connecting...\";\n++++++++++++const+email+=+`${h.toLowerCase().replace(/[^a-z0-9]/g,'')}@teddy.game`;\n++++++++++++try+{\n++++++++++++++++await+signInWithEmailAndPassword(auth,+email,+p);\n++++++++++++}+catch(e)+{\n++++++++++++++++try+{\n++++++++++++++++++++const+c+=+await+createUserWithEmailAndPassword(auth,+email,+p);\n++++++++++++++++++++await+setDoc(doc(db,+\"users\",+c.user.uid),+{+handle:+h,+bestScore:+0+});\n++++++++++++++++++++await+setDoc(doc(db,+\"leaderboard\",+c.user.uid),+{+handle:+h,+score:+0+});\n++++++++++++++++}+catch(err)+{+msg.innerText+=+\"Error+or+Name+Taken.\";+}\n++++++++++++}\n++++++++};\n\n++++++++onAuthStateChanged(auth,+async+(u)+=>+{\n++++++++++++if(u)+{\n++++++++++++++++document.getElementById('view-login').classList.add('is-hidden');\n++++++++++++++++document.getElementById('view-game').classList.remove('is-hidden');\n++++++++++++++++const+d+=+await+getDoc(doc(db,+\"users\",+u.uid));\n++++++++++++++++if(d.exists())+{+state.handle+=+d.data().handle;+state.score+=+0;+}\n++++++++++++++++initBoard();\n++++++++++++}\n++++++++});\n\n++++++++function+initBoard()+{\n++++++++++++const+table+=+document.getElementById('table');\n++++++++++++table.innerHTML+=+'<div+class=\"honey\"+id=\"coin\"+style=\"opacity:0\"></div>';\n++++++++++++state.cups+=+[];\n++++++++++++for(let+i=0;+i<3;+i++)+{\n++++++++++++++++const+c+=+document.createElement('div');\n++++++++++++++++c.className+=+'pot';\n++++++++++++++++c.style.left+=+POSITIONS[i];\n++++++++++++++++c.innerHTML+=+`<div+class=\"pot-body\"><div+class=\"pot-label\">unskyit.com</div></div>`;\n++++++++++++++++state.cups.push({+id:+i,+posIndex:+i,+el:+c+});\n++++++++++++++++c.onclick+=+()+=>+checkGuess(i);\n++++++++++++++++table.appendChild(c);\n++++++++++++}\n++++++++}\n\n++++++++document.getElementById('btn-action').onclick+=+async+()+=>+{\n++++++++++++if(state.isPlaying)+return;\n++++++++++++sounds.click();\n++++++++++++state.isPlaying+=+true;\n++++++++++++state.winId+=+Math.floor(Math.random()*3);\n++++++++++++const+winCup+=+state.cups.find(c+=>+c.id+===+state.winId);\n++++++++++++const+coin+=+document.getElementById('coin');\n++++++++++++const+status+=+document.getElementById('game-status');\n++++++++++++\n++++++++++++status.innerText+=+\"Watch!\";\n++++++++++++coin.style.left+=+`calc(${POSITIONS[winCup.posIndex]}+++24px)`;\n++++++++++++coin.style.opacity+=+1;\n++++++++++++winCup.el.classList.add('lifted');\n++++++++++++await+new+Promise(r+=>+setTimeout(r,+1000));\n++++++++++++winCup.el.classList.remove('lifted');\n++++++++++++coin.style.opacity+=+0;\n++++++++++++await+new+Promise(r+=>+setTimeout(r,+600));\n\n++++++++++++status.innerText+=+\"Shuffling...\";\n++++++++++++let+count+=+6+++Math.min(state.score,+10);\n++++++++++++for(let+k=0;+k<count;+k++)+{\n++++++++++++++++sounds.shuffle();\n++++++++++++++++let+p1+=+Math.floor(Math.random()*3),+p2+=+Math.floor(Math.random()*3);\n++++++++++++++++while(p1===p2)+p2+=+Math.floor(Math.random()*3);\n++++++++++++++++let+c1+=+state.cups.find(c+=>+c.posIndex+===+p1),+c2+=+state.cups.find(c+=>+c.posIndex+===+p2);\n++++++++++++++++c1.el.style.left+=+POSITIONS[p2];+c2.el.style.left+=+POSITIONS[p1];\n++++++++++++++++c1.posIndex+=+p2;+c2.posIndex+=+p1;\n++++++++++++++++await+new+Promise(r+=>+setTimeout(r,+550+-+Math.min(state.score+*+15,+250)));\n++++++++++++}\n++++++++++++status.innerText+=+\"Where+is+it?\";\n++++++++++++state.isPlaying+=+false;\n++++++++++++state.waiting+=+true;\n++++++++};\n\n++++++++async+function+checkGuess(id)+{\n++++++++++++if(state.isPlaying+||+!state.waiting)+return;\n++++++++++++state.waiting+=+false;\n++++++++++++const+coin+=+document.getElementById('coin');\n++++++++++++const+winCup+=+state.cups.find(c+=>+c.id+===+state.winId);\n++++++++++++const+clicked+=+state.cups.find(c+=>+c.id+===+id);\n++++++++++++\n++++++++++++coin.style.left+=+`calc(${POSITIONS[winCup.posIndex]}+++24px)`;\n++++++++++++clicked.el.classList.add('lifted');\n\n++++++++++++if(id+===+state.winId)+{\n++++++++++++++++sounds.win();\n++++++++++++++++document.getElementById('game-status').innerText+=+\"Found!+🍯\";\n++++++++++++++++coin.style.opacity+=+1;\n++++++++++++++++state.score++;\n++++++++++++++++document.getElementById('txt-score').innerText+=+state.score;\n++++++++++++++++setDoc(doc(db,+\"leaderboard\",+auth.currentUser.uid),+{+handle:+state.handle,+score:+state.score+},+{merge:+true});\n++++++++++++++++await+new+Promise(r+=>+setTimeout(r,+1200));\n++++++++++++++++clicked.el.classList.remove('lifted');\n++++++++++++++++document.getElementById('btn-action').click();\n++++++++++++}+else+{\n++++++++++++++++sounds.fail();\n++++++++++++++++document.getElementById('game-status').innerText+=+\"Oops!+🐻\";\n++++++++++++++++await+new+Promise(r+=>+setTimeout(r,+800));\n++++++++++++++++winCup.el.classList.add('lifted');\n++++++++++++++++coin.style.opacity+=+1;\n++++++++++++++++state.score+=+0;\n++++++++++++++++document.getElementById('txt-score').innerText+=+0;\n++++++++++++++++await+new+Promise(r+=>+setTimeout(r,+2000));\n++++++++++++++++initBoard();\n++++++++++++++++document.getElementById('game-status').innerText+=+\"Try+Again?\";\n++++++++++++}\n++++++++}\n\n++++++++function+getTitle(s)+{\n++++++++++++if(s+>=+50)+return+\"<br><p+style='font-size:11px;'>Legendary+🔥</p>\";\n++++++++++++if(s+>=+25)+return+\"<br><p+style='font-size:11px;'>Elite+⚡</p>\";\n++++++++++++if(s+>=+15)+return+\"<br><p+style='font-size:11px;'>Master+🏆</p>\";\n++++++++++++if(s+>=+5)+return+\"<br><p+style='font-size:11px;'>Pro+⭐</p>\";+\n++++++++++++return+\"<br><p+style='font-size:11px;'>Rookie+🌱</p>\";\n++++++++}\n\n++++++++document.getElementById('btn-show-lb').onclick+=+async+()+=>+{\n++++++++++++sounds.click();\n++++++++++++document.getElementById('view-game').classList.add('is-hidden');\n++++++++++++document.getElementById('view-lb').classList.remove('is-hidden');\n++++++++++++const+list+=+document.getElementById('lb-list');\n++++++++++++list.innerHTML+=+\"<p+style='text-align:center;+padding:20px;'>Syncing...</p>\";\n++++++++++++try+{\n++++++++++++++++const+q+=+query(collection(db,+\"leaderboard\"),+orderBy(\"score\",+\"desc\"),+limit(40));\n++++++++++++++++const+snap+=+await+getDocs(q);\n++++++++++++++++let+html+=+\"\";+let+i+=+1;\n++++++++++++++++snap.forEach(d+=>+{\n++++++++++++++++++++const+v+=+d.data();\n++++++++++++++++++++const+rank+=+i+===+1+?+'🥇'+:+i+===+2+?+'🥈'+:+i+===+3+?+'🥉'+:+i;\n++++++++++++++++++++html++=+`<div+class=\"lb-row\"><div+class=\"rank-circle\">${rank}</div><div+class=\"player-box\"><span+class=\"player-name\">${v.handle}</span><span+class=\"player-title\">${getTitle(v.score)}</span></div><div+class=\"player-score\">${v.score}</div></div>`;\n++++++++++++++++++++i++;\n++++++++++++++++});\n++++++++++++++++list.innerHTML+=+html+||+\"Empty+Arena.\";\n++++++++++++}+catch(e)+{+list.innerHTML+=+\"Sync+Error.\";+}\n++++++++};\n\n++++++++document.getElementById('btn-hide-lb-top').onclick+=+()+=>+{\n++++++++++++sounds.click();\n++++++++++++document.getElementById('view-lb').classList.add('is-hidden');\n++++++++++++document.getElementById('view-game').classList.remove('is-hidden');\n++++++++};\n\n++++</script>\n</body>\n</html>",
        "variableUpdateValue": {
