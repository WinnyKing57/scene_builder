    {
     "blockNextAction": true,
     "m_nonRoot": true,
     "m_script": "#!/bin/bash\n\n#+Define+the+start+and+end+times+in+a+compatible+format\nstart_time=\"{lv=currentTime}\"++#+Example:+December+25,+2024,+at+2:30+PM\nend_time=\"{lv=alarmTime}\"++++#+Example:+December+26,+2024,+at+9:15+AM\n\n#+Convert+the+start+time+to+total+minutes\nstart_year=$(echo+$start_time+|+cut+-d'-'+-f1)\nstart_month=$(echo+$start_time+|+cut+-d'-'+-f2)\nstart_day=$(echo+$start_time+|+cut+-d'-'+-f3+|+cut+-d'+'+-f1)\nstart_hour=$(echo+$start_time+|+cut+-d'+'+-f2+|+cut+-d':'+-f1)\nstart_minute=$(echo+$start_time+|+cut+-d':'+-f2)\n\n#+Convert+the+end+time+to+total+minutes\nend_year=$(echo+$end_time+|+cut+-d'-'+-f1)\nend_month=$(echo+$end_time+|+cut+-d'-'+-f2)\nend_day=$(echo+$end_time+|+cut+-d'-'+-f3+|+cut+-d'+'+-f1)\nend_hour=$(echo+$end_time+|+cut+-d'+'+-f2+|+cut+-d':'+-f1)\nend_minute=$(echo+$end_time+|+cut+-d':'+-f2)\n\n#+Function+to+calculate+total+minutes+from+a+reference+date\ntotal_minutes()+{\n++++year=$1\n++++month=$2\n++++day=$3\n++++hour=$4\n++++minute=$5\n\n++++#+Calculate+total+minutes+since+a+reference+point+(e.g.,+1970-01-01)\n++++total=$((+(year+-+1970)+*+525600+++(month+-+1)+*+43800+++(day+-+1)+*+1440+++hour+*+60+++minute+))\n++++echo+$total\n}\n\n#+Calculate+total+minutes+for+start+and+end+times\nstart_total=$(total_minutes+$start_year+$start_month+$start_day+$start_hour+$start_minute)\nend_total=$(total_minutes+$end_year+$end_month+$end_day+$end_hour+$end_minute)\n\n#+Calculate+the+difference+in+minutes\ndiff_minutes=$((end_total+-+start_total))\n\n#+Output+the+result\necho+\"$diff_minutes\"\n",
     "m_variableToSaveResponse": {
