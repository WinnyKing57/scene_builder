     "m_script": "#!/system/bin/sh\n\n#+Define+the+directory\nDIRECTORY=\"{lv=path}\"\n\n#+Define+an+array+of+keywords\nKEYWORDS=({lv=InputArrayString})++#+Add+more+keywords+as+needed\n\n#+Loop+through+each+keyword+in+the+array\nfor+keyword+in+\"${KEYWORDS[@]}\";+do\n++++#+Use+the+find+command+to+search+for+files+containing+the+keyword+in+the+title+(case+insensitive)\n++++find+\"$DIRECTORY\"+-type+f+-iname+\"*$keyword*\"+|+tr+'\\n'+'*'\ndone\n",
