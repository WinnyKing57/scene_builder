    {
     "blockNextAction": true,
     "m_nonRoot": true,
     "m_script": "#!/system/bin/sh\n\n#+Function+to+convert+12-hour+format+to+24-hour+format\nconvert_to_24_hour()+{\n+++++input_time=\"{lv=time}.\"\n++++\n++++#+Check+if+input+is+empty\n++++if+[+-z+\"$input_time\"+];+then\n++++++++echo+\"No+input+provided.+Please+enter+a+time+in+12-hour+format+(hh:mm+AM/PM).\"\n++++++++return\n++++fi\n\n++++#+Remove+periods+from+the+input+and+convert+to+lowercase\n++++input_time=$(echo+\"$input_time\"+|+tr+-d+'.'+|+tr+'[:upper:]'+'[:lower:]')\n\n++++\n++++#+Extract+the+hour,+minute,+and+period+(AM/PM)\n++++hour=$(echo+\"$input_time\"+|+awk+'{print+$1}'+|+cut+-d':'+-f1)\n++++minute=$(echo+\"$input_time\"+|+awk+'{print+$1}'+|+cut+-d':'+-f2)\n++++period=$(echo+\"$input_time\"+|+awk+'{print+$2}')\n\n+++\n\n++++#+Convert+hour+to+24-hour+format\n++++if+[+\"$period\"+=+\"pm\"+]+&&+[+\"$hour\"+-ne+12+];+then\n++++++++hour=$((hour+++12))\n++++elif+[+\"$period\"+=+\"am\"+]+&&+[+\"$hour\"+-eq+12+];+then\n++++++++hour=0\n++++fi\n\n++++#+Format+the+output+to+ensure+two+digits+for+hour\n++++printf+\"%02d:%02d\\n\"+\"$hour\"+\"$minute\"\n}\n\n#+Example+usage\n\n\nconverted_time=$(convert_to_24_hour+\"$time_12hr\")\necho+\"$converted_time\"\n",
     "m_variableToSaveResponse": {
      "description": "",
      "dictionary": {
       "entries": [],
       "isArray": false,
       "variableType": 4,
       "type": "Dictionary"
      },
      "isActionBlockWorkingVar": false,
      "isLocalVar": true,
      "isSecure": false,
      "m_booleanValue": false,
      "m_decimalValue": 0.0,
      "m_intValue": 0,
      "m_name": "time",
      "m_stringValue": "",
      "m_type": 2,
      "supportsInput": false,
      "supportsOutput": true
     },
     "timeoutSeconds": 30,
     "useHelper": false,
     "useShizuku": false,
     "disableLogging": false,
     "m_SIGUID": -6435354428790593362,
