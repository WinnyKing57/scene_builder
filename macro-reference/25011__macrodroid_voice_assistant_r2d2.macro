  {
   "dictionary": {
    "entries": [
     {
      "key": "-+Get+current+weather+update:\n\n\"What's+the+weather\"",
      "variable": {
       "textValue": "This+will+gather+recent+weather+data+from+Accuweather.com+on+your+last+known+location.+It+will+get+the+current+conditions+as+well+as+a+7+day+forcast+and+the+current+radar.\n\nNOTE:+You+can+force+it+to+use+metric+system+measurements+via+the+\"+get+weather\"+action+block.+Just+set+the+variable+\"metric\"+to+say+\"true\"+or+\"True\".\n\nSay:\n\n\"What's+the+weather?\"\n\nExample:\n\n\"What's+the+weather\"",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     },
     {
      "key": "-+List+commands:\n\n\"List+commands\"",
      "variable": {
       "textValue": "This+command+will+list+all+available+commands+and+info+about+each+command.+This+command+is+recognized+when+the+input+starts+with+the+word+\"list\"+and+ends+with+the+word+\"commands\".\n\nSay:\n\n\"List+commands\"\n\nor\n\n\"List+all+commands\"",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     },
     {
      "key": "-+Search+a+song:\n\n\"What+song+is+this?\"",
      "variable": {
       "textValue": "This+command+will+use+Google+song+search+to+find+what+song+is+playing+(like+Shazam)+and+tell+you+what+song+is+playing.\n\nSay:\n\n\"What+song+is+this?\"\n\nor+\n\n\"What+song+is+playing?\"",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     },
     {
      "key": "-+Cancel:\n\n\"Cancel\"",
      "variable": {
       "textValue": "This+command+will+cancel+the+macro.+It+is+recognized+when+any+voice+input+is+ended+with+the+word+\"Cancel\".\n\nSay:\n\n\"Cancel\"\n\nExample:\n\n\"Call+mom+cancel\"",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     },
     {
      "key": "-+Get+directions+to+location:\n\n\"Get+directions+to+'location'+\"",
      "variable": {
       "textValue": "This+command+will+open+Google+maps+and+give+you+directions+to+a+specified+address+or+any+labeled+saved+location+you+have+saved+in+Google+maps.+This+command+is+recognized+when...\n\nSay:\n\n\"Get+directions+to+'location+name'+\"\n\nExample:\n\n\"Get+directions+to+walmart\"\n\nor\n\n\"Get+directions+to+'saved+location+name'+\"\n\nExample:\n\n\"Get+directions+to+Johnny's+house.\"\n\nor\n\n\"Get+directions+to+'address'+\"\n\nExample:\n\n\"Get+directions+to+123+Main+Street.\"\n",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     },
     {
      "key": "-+Open+application:\n\n\"Open+app+'app+name'+\"",
      "variable": {
       "textValue": "This+command+will+open+any+app+by+name.+This+command+is+recognized+when+any+voice+input+begins+with+the+words+\"open+app\".\n\nSay:\n\n\"Open+app+'app+name'+\"\n\nExample:\n\n\"Open+app+YouTube.\"",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     },
     {
      "key": "-+Open+setting:\n\n\"Open+setting+'setting+to+open'+\"",
      "variable": {
       "textValue": "This+command+will+open+the+settings+app+and+perform+a+search+of+any+setting.+This+command+is+recognized+when+any+voice+input+begins+with+the+words+\"open+setting\"+or+\"open+settings\"+Note,+the+setting+name+must+be+EXACT.\n\nSay:\n\n\"Open+setting+'setting+to+open'+\"\n\nExample:\n\n\"Open+setting+developer+options\"",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     },
     {
      "key": "-+Play+a+song:\n\n\"Play+song+'song+name'+\"",
      "variable": {
       "textValue": "This+command+will+play+songs+by+name+that+you+have+stored+on+your+device.\n\nSay:\n\n\"Play+song+'song+name'+\"\n\nExample:\n\n\"Play+song+Houdini.\"\n",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     },
     {
      "key": "-+Run+a+macro:\n\n\"Run+macro+'macro+name'+\"",
      "variable": {
       "textValue": "This+macro+will+run+macros+you+have+on+your+device.\n\nSay:\n\n\"Run+macro+'macro+name'+\"\n\nor\n\n\"Run+program+'macro+name'+\"\n\nExample:\n\n\"Run+macro+Infinite+clipboard\".",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     },
     {
      "key": "-+Search+any+website:\n\n\"Search+'websiteName.com'+for+'search+query'+\"",
      "variable": {
       "textValue": "This+command+will+search+any+website.+This+command+is+recognized+when+any+voice+input+begins+with+the+word+\"search\"+and+also+contain+a+\".com\",+\".net\",+or+\".org\".\n\nSay:\n\n\"Search+'websiteName.com'+for+'search+query'+\"\n\nor\n\n\"Search+'websiteName.net'+for+'search+query'+\"\n\nor\n\n\"Search+'websiteName.org'+for+'search+query'+\"\n\nExample:\n\n\"Search+youtube.com+for+funny+cats.\"\n\nor\n\n\"Search+Amazon.com+for+galaxy+phones.\"",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     },
     {
      "key": "-+Set+a+calendar+event:\n\n\"Set+an+event+on+'event+date+and+time'+\"",
      "variable": {
       "textValue": "This+command+will+set+a+calendar+event+on+a+specified+date+and+time.+Uses+\"My+Calendar\"+app+by+default.\n\nNote:\n-+If+it+fails+to+enter+the+event,+you+may+have+to+go+into+the+\"set+event\"+action+block+and+open+the+\"set+calendar+event\"+action+and+push+\"ok\"+for+it+to+register+for+some+reason.+You+canbalso+change+your+calendar+from+there.\n-+This+event+may+take+several+minutes+to+show+up+on+your+calendar.+\n\nSay:\n\n\"Set+an+event+on+'event+date+and+time'+\"\n\nor\n\n\"Set+an+event+on+'event+date+and+time'+titled+'example+title'++\"\n\nExample:\n\n\"Set+an+event+on+Sunday+at+2130\"\n\nor\n\n\"Set+an+event+for+tomorrow+at+9:30am+titled+John's+birthday.+\"\n\nor\n\n\"Set+an+event+for+January+1st+at+9:30am+titled+John's+birthday.+\"",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     },
     {
      "key": "-+Set+a+timer:\n\n\"Set+a+timer+for+'#+hours+and/or+#+minutes+and/or+#+seconds'+\"",
      "variable": {
       "textValue": "This+command+will+start+a+timer++for+a+specified+time.\n\nSay:\n\n\"Set+a+timer+for+'#+hours+and/or+#+minutes+and/or+#+seconds'+\"\n\nExample:\n\n\"Set+a+timer+for+30+seconds\"\n\nor\n\n\"Set+a+timer+for+a+minute\"\n\nor+\n\n\"Set+a+time+for+1+hour+30+minutes+and+30+seconds\"\n\nClock+app+is+required.+If+not+already+installed,+find+it+here:\n\nhttps://play.google.com/store/apps/details?id=com.sec.android.app.clockpackage",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     },
     {
      "key": "-+Set+an+alarm:\n\n\"Set+an+alarm+for+'alarm+day+and/or+time\"",
      "variable": {
       "textValue": "This+command+will+set+an+alarm+at+a+specified+day+and+time.+This+command+can+only+set+an+alarm+one+week+into+the+future.+if+you+set+a+date+more+than+a+week+away,+it+well+set+a+calendar+event+instead.\n\n\nSay:\n\n\"Set+an+alarm+for+'alarm+day+and/or+time\"\n\nExample:\n\n\"Set+an+alarm+on+Sunday+at+2130.\"\n\nor+\n\n\"Set+an+alarm+for+the+22nd+at+8:30+pm\"\n\nor\n\n\"Set+an+alarm+for+8:30.\"\n\nor+\n\n\"Set+an+alarm+for+tomorrow+at+8:30am.\"\n\n\n\nClock+app+is+required.+If+not+already+installed,+find+it+here:\n\nhttps://play.google.com/store/apps/details?id=com.sec.android.app.clockpackage",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     },
     {
      "key": "-+Analyze+clipboard+text:+\n\n\"Clipboard+text\"",
      "variable": {
       "textValue": "This+command+will+substitute+the+words+\"clipboard+text\"+with+the+text+in+you+Clipboard.+It+is+intended+to+be+used+in+tandem+with+other+commands.+\n\nSay:\n\n\"Clipboard+text\"\n\nExample:\n\n\"Search+google.com+for+clipboard+text.\"\n\nor\n\n\"Fix+errors+in+this+text+clipboard+text.\"\n\n",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     },
     {
      "key": "-+Call+mobile+number:\n\n\"Call+'contact+name'+\"",
      "variable": {
       "textValue": "This+command+recognizes+the+keyword+Call+if+its+the+first+word+of+the+command.+In+case+the+input+contains+a+phone+number,+it+will+just+call+the+phone+number+you+input.+In+case+you+input+a+contact+name,+it+will+search+for+the+contacts+mobile+phone+number+and+call+thay+number.\n\nSay:\n\n\"Call+'contact+name'+\"\n\nExample:\n\n\"Call+mom\"\n\nor\n\n\"Call+'phone+number'+\"\n\nExample:\n\n\"Call+1234568690\"",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     },
     {
      "key": "-+Make+new+note:\n\n\"Make+a+note+to+'note'+\"",
      "variable": {
       "textValue": "This+command+will+make+a+new+note+Google+Note+Keep+app+or+Samsung+Notes+app.+This+command+is+recognized+when+any+voice+input+begins+with+the+words+\"make+note\"+or+\"make+a+note\".\n\nSay:\n\n\"Make+a+note+to+'note'+\"\n\nor\n\n\"Make+note+'note'+\"\n\nExample:\n\n\"Make+a+note+to+get+eggs\"\n\n\nGet+Google+keep+here+(recommended):\n\nhttps://play.google.com/store/apps/details?id=com.google.android.keep",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     },
     {
      "key": "-+Open+website:\n\n\"Open+'websiteName.com'+\"",
      "variable": {
       "textValue": "This+command+will+open+any+website+by+name.+This+command+is+recognized+if+the+input+begins+with+the+word+\"open\"+and+ends+with+a+\".com\",+\".net\",+or+\".org\"\n\nSay:\n\n\"Open+'websiteName.com'+\"\n\n+or\n\n\"Open+'websiteName.net'+\"\n\nor\n\n\"Open+'websiteName+.org'+\"\n\nExample:\n\n\"Open+youtube.com\"",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     },
     {
      "key": "-+Play+a+movie:\n\n\"Play+movie+'movie+name'+\"",
      "variable": {
       "textValue": "This+command+will+play+movies+by+name+that+you+have+stored+on+your+device.+This+function+will+search+a+specified+folder+for+video+files+by+name.+This+function+will+find+the+file+with+the+name+of+the+closest+match+to+the+name+given+in+the+input.+\n\nNote:+This+action+may+require+MacroDroid+Helper.+(you+will+need+to+tick+the+MacroDroid+Helper+tick+box+inside+of+the+action+block's+scripts+for+this+action+also+if+required)\n\nSay:\n\n\"Play+movie+'movie+name'+\"\n\nExample:\n\n\"Play+movie+Inception.\"\n\nExample+output:\n\nThe+file+named+Inception.mp4+will+play++",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     },
     {
      "key": "-+Send+a+text+message:\n\n\"Send+text+to+'contact+name'+\"",
      "variable": {
       "textValue": "This+command+will+send+a+text+message+to+any+phone+number+or+contact+name.\n\nSay:\n\n\"Send+text+to+'contact+name'+\"\n\nor\n\n\"Send+a+message+to+'phone+number'+\"\n\nor+\n\n\"Send+sms+to+'contact+name'+\"\n\nExample:\n\n\"Send+a+text+to+mom\"\n\nor\n\n\"Send+message+to+1234567890\"\n",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     },
     {
      "key": "-+Send+an+email:\n\n\"Send+email+to+'contact+name'+\"",
      "variable": {
       "textValue": "This+command+will+send+an+email+to+an+email+address+or+a+contact's+email.\n\n\nSay:\n\n\"Send+email+to+'contact+name'+\"\n\nor\n\n\"Send+email+to+'email+address'+\"\n\nor\n\n\"Send+email+to+'contact+name'+titled+'example+title'+\"\n\nor\n\n\"Send+email+to+'contact+name'+subject+'subject+name'+\"\n\nExample:\n\n\"Send+email+to+John+Smith+titled+Fishing+trip\"\n",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     },
     {
      "key": "-+Set+the+volume+of+the+voice+assistant:\n\n\"Set+your+volume+to+'volume'+\"",
      "variable": {
       "textValue": "This+command+will+set+the+volume+of+the+voice+assistant.\n\nSay:\n\n-+\"Set+your+volume+to+'volume'+\"\n\nExample:\n\n\"Set+your+volume+to+30\"\nor\n\"Set+your+volume+to+50%\"",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     },
     {
      "key": "-+Search+news+headlines:\n\n\"Search+news+for+'keywords'+\"",
      "variable": {
       "textValue": "This+command+will+search+today's+stories+for+specified+keywords.+Im+case+of+multiple+keywords,+the+search+will+search+stories+that+each+word+separately.\n\nSay:\n\n\"Search+news+for+'keywords'+\"\n\nExample:\n\n\"Search+news+for+Elon+Musk\"",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     },
     {
      "key": "-+Open+folder\n\n\"Open+folder+'folder+name'+\"",
      "variable": {
       "textValue": "This+command+will+open+any+folder+on+your+device.+it+is+set+search+5+layers+deep+for+the+specified+folder+but+this+can+be+adjusted+in+the+action+block+via+the+\"maxDepth\"+variable.+\"Android\"+folders+will+be+excluded.\n\nSay:\n\n\"Open+folder+'folder+name'+\"\n\nExample:\n\n\"Open+folder+Download\"\n\n\nMy+Files+app+or+Xplore+app+are+required.+If+My+Files+is+not+already+installed,+find+Xplore+here:\n\nhttps://play.google.com/store/apps/details?id=com.lonelycatgames.Xplore",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     },
     {
      "key": "-+Get+news+updates\n\n\"Get+news+update\"",
      "variable": {
       "textValue": "This+command+will+get+you+news+updates\n\nSay:\n\n\"Get+news+update\"\n\nor\n\n\"What's+the+news\"",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     },
     {
      "key": "-+AI+Query:\n\nAsk+any+question",
      "variable": {
       "textValue": "If+the+command+is+not+recognized+it+will+perform+an+AI+query.+Just+ask+any+question.+To+ask+a+follow-up+question,+tap+the+small+floating+GIF+at+the+top+of+the+sceen.+The+chat+will+start+a+new+chat+if+not+activated+by+the+mini+GIF+at+the+top+of+the+screen\n\nNote:+\n\n-This+action+will+timout+in+30+secs\n\nExample:\n\n\"Why+is+the+sky+blue.\"\n",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     },
     {
      "key": "-+Image+Search:\n\n\"Search+for+pictures+of+'search+content'+\"",
      "variable": {
       "textValue": "This+command+will+perform+a+DuckDuckGo+image+search\n\nSay:\n\n\"Search+for+pictures+of+'search+content'+\"\n\nor\n\n\"Search+for+images+of+'search+content'+\"\n\nor+\n\n\"Search+for+photos+of+'search+content'+\"\n\nor\n\n\"Search+for+photographs+of+'search+content'+\"\n\nExample:\n\n\"Search+for+pictures+of+dogs.\"\n",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     },
     {
      "key": "-+AI+Image+Creation:\n\"Make+a+picture\"",
      "variable": {
       "textValue": "This+action+will+display+an+AI+created+image+that+you+describe.\n\nSay:\n\n\"Make+an+image+of+'image+description'+\"\n\nor\n\n\"Create+a+picture+of+'image+description'+\"\n\nor+\n\n\"Make+a+picture+of+'image+description'+\"\n\nor+\n\n\"Create+an+image+of+'image+description'+\"\n\nExample:\n\n\"Make+an+image+of+a+kitten\"\n\nor\n\n\"Create+a+picture+of+a+dog\"\n",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     },
     {
      "key": "-+Open+macro+to+edit+mode:\n\n\"Open+macro+'macro+name'+\"",
      "variable": {
       "textValue": "This+action+will+open+macros+you+have+on+your+device+into+its+editing+mode.\n\nSay:\n\n\"Open+macro+'macro+name'+\"\n\nor\n\n\"Open+program+'macro+name'+\"\n\nor+\n\n\"Edit+macro+'macro+name'+\"\n\nExample:\n\n\"Edit+macro+Infinite+clipboard\".",
       "variableType": 2,
       "type": "StringValue"
      },
      "variableType": 11,
      "type": "DictionaryEntry"
     }
    ],
    "isArray": false,
    "parents": [],
    "variableType": 4,
    "parentKeys": [],
    "type": "Dictionary"
   },
