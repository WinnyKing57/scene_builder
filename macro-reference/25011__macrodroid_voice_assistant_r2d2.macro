    {
     "blockNextAction": true,
     "m_nonRoot": true,
     "m_script": "#!/bin/sh\n\n#+Specify+the+target+day+and+time\nTARGET_DAY=\"{lv=day}\"++#+Change+this+to+your+desired+day\nTARGET_TIME=\"{lv=time}\"++#+Change+this+to+your+desired+time\n\n#+Get+the+current+date+and+time\nCURRENT_TIME=$(date++%s)\n\n#+Get+the+current+day+of+the+week+(1=Monday,+...,+7=Sunday)\nCURRENT_DAY=$(date++%u)\n\n#+Map+the+target+day+to+a+number+(1=Monday,+...,+7=Sunday)\ncase+$TARGET_DAY+in\n++++Sunday)++++TARGET_DAY_NUM=7+;;\n++++Monday)++++TARGET_DAY_NUM=1+;;\n++++Tuesday)+++TARGET_DAY_NUM=2+;;\n++++Wednesday)+TARGET_DAY_NUM=3+;;\n++++Thursday)++TARGET_DAY_NUM=4+;;\n++++Friday)++++TARGET_DAY_NUM=5+;;\n++++Saturday)++TARGET_DAY_NUM=6+;;\n++++*)+++++++++echo+\"Invalid+day+specified\";+exit+1+;;\nesac\n\n#+Calculate+the+number+of+days+until+the+next+target+day\nif+[+\"$CURRENT_DAY\"+-le+\"$TARGET_DAY_NUM\"+];+then\n++++DAYS_UNTIL_TARGET=$((TARGET_DAY_NUM+-+CURRENT_DAY))\nelse\n++++DAYS_UNTIL_TARGET=$((7+-+CURRENT_DAY+++TARGET_DAY_NUM))\nfi\n\n#+Get+the+current+date+components\nCURRENT_YEAR=$(date++%Y)\nCURRENT_MONTH=$(date++%m)\nCURRENT_DAY_OF_MONTH=$(date++%d)\n\n#+Calculate+the+next+target+date\nNEXT_TARGET_DAY=$((CURRENT_DAY_OF_MONTH+++DAYS_UNTIL_TARGET))\n\n#+Check+if+we+need+to+adjust+the+month+and+year\nif+[+\"$NEXT_TARGET_DAY\"+-gt+31+];+then\n++++NEXT_TARGET_DAY=$((NEXT_TARGET_DAY+-+31))\n++++CURRENT_MONTH=$((CURRENT_MONTH+++1))\nfi\n\n#+Handle+month+overflow\nif+[+\"$CURRENT_MONTH\"+-gt+12+];+then\n++++CURRENT_MONTH=1\n++++CURRENT_YEAR=$((CURRENT_YEAR+++1))\nfi\n\n#+Handle+month-end+days\nif+[+\"$CURRENT_MONTH\"+-eq+2+];+then\n++++if+[+$((CURRENT_YEAR+%+4))+-eq+0+]+&&+{+[+$((CURRENT_YEAR+%+100))+-ne+0+]+||+[+$((CURRENT_YEAR+%+400))+-eq+0+];+};+then\n++++++++MAX_DAYS=29++#+Leap+year\n++++else\n++++++++MAX_DAYS=28\n++++fi\nelif+[+\"$CURRENT_MONTH\"+-eq+4+]+||+[+\"$CURRENT_MONTH\"+-eq+6+]+||+[+\"$CURRENT_MONTH\"+-eq+9+]+||+[+\"$CURRENT_MONTH\"+-eq+11+];+then\n++++MAX_DAYS=30\nelse\n++++MAX_DAYS=31\nfi\n\n#+Adjust+for+month-end\nif+[+\"$NEXT_TARGET_DAY\"+-gt+\"$MAX_DAYS\"+];+then\n++++NEXT_TARGET_DAY=$((NEXT_TARGET_DAY+-+MAX_DAYS))\n++++CURRENT_MONTH=$((CURRENT_MONTH+++1))\nfi\n\n#+Handle+month+overflow+again\nif+[+\"$CURRENT_MONTH\"+-gt+12+];+then\n++++CURRENT_MONTH=1\n++++CURRENT_YEAR=$((CURRENT_YEAR+++1))\nfi\n\n#+Format+the+next+target+date\nNEXT_TARGET_DATE=$(printf+\"%04d-%02d-%02d\"+\"$CURRENT_YEAR\"+\"$CURRENT_MONTH\"+\"$NEXT_TARGET_DAY\")\n\n#+Combine+the+target+date+with+the+target+time\nNEXT_TARGET=\"$NEXT_TARGET_DATE+$TARGET_TIME\"\n\n\n#+Manually+calculate+the+target+timestamp\nTARGET_YEAR=$(echo+\"$NEXT_TARGET\"+|+cut+-d'-'+-f1)\nTARGET_MONTH=$(echo+\"$NEXT_TARGET\"+|+cut+-d'-'+-f2)\nTARGET_DAY=$(echo+\"$NEXT_TARGET\"+|+cut+-d'-'+-f3+|+cut+-d'+'+-f1)\nTARGET_HOUR=$(echo+\"$TARGET_TIME\"+|+cut+-d':'+-f1)\nTARGET_MINUTE=$(echo+\"$TARGET_TIME\"+|+cut+-d':'+-f2)\n\n#+Calculate+the+target+timestamp+manually\nTARGET_TIMESTAMP=$(date+-d+\"$TARGET_YEAR-$TARGET_MONTH-$TARGET_DAY+$TARGET_HOUR:$TARGET_MINUTE\"++%s+2>/dev/null)\n\n#+If+the+above+command+fails,+we+need+to+calculate+it+manually\nif+[+$?+-ne+0+];+then\n++++#+Calculate+the+timestamp+manually\n++++CURRENT_TIMESTAMP=$(date++%s)\n++++SECONDS_IN_A_DAY=86400\n\n++++#+Calculate+the+number+of+days+until+the+next+target+day\n++++if+[+\"$CURRENT_DAY\"+-le+\"$TARGET_DAY_NUM\"+];+then\n++++++++DAYS_UNTIL_TARGET=$((TARGET_DAY_NUM+-+CURRENT_DAY))\n++++else\n++++++++DAYS_UNTIL_TARGET=$((7+-+CURRENT_DAY+++TARGET_DAY_NUM))\n++++fi\n\n++++#+Calculate+the+target+timestamp\n++++TARGET_TIMESTAMP=$((CURRENT_TIMESTAMP+++(DAYS_UNTIL_TARGET+*+SECONDS_IN_A_DAY)))\n\n++++#+Add+the+target+time+to+the+target+timestamp\n++++TARGET_TIMESTAMP=$((TARGET_TIMESTAMP+++(TARGET_HOUR+*+3600)+++(TARGET_MINUTE+*+60)))\nfi\n\n\n#+Calculate+the+current+timestamp\nCURRENT_TIMESTAMP=$(date++%s)\n\n#+Calculate+the+difference+in+seconds\nDIFFERENCE=$((TARGET_TIMESTAMP+-+CURRENT_TIMESTAMP))\n\n#+Check+if+the+target+time+is+in+the+future\nif+[+\"$DIFFERENCE\"+-gt+0+];+then\n++++#+Convert+seconds+to+minutes\n++++MINUTES_UNTIL_TARGET=$((DIFFERENCE+/+60))\n++++echo+\"$MINUTES_UNTIL_TARGET\"\nelse\n++++echo+\"The+target+time+has+already+passed.\"\nfi\n\n\n\n",
     "m_variableToSaveResponse": {
      "description": "",
