    {
     "blockNextAction": true,
     "m_nonRoot": true,
     "m_script": "#!/bin/bash\n\n#+Define+the+start+and+end+times\nstart_time=\"{lv=currentTime}\"++#+Example:+December+25,+2024,+at+2:30+PM\nend_time=\"{lv=eventTime}\"++++#+Example:+December+26,+2024,+at+9:15+AM\n\n#+Convert+the+times+to+epoch+seconds\nstart_epoch=$(date+-d+\"$start_time\"++%s)\nend_epoch=$(date+-d+\"$end_time\"++%s)\n\n#+Calculate+the+difference+in+seconds\ndiff_seconds=$((end_epoch+-+start_epoch))\n\n#+Convert+seconds+to+minutes\ndiff_minutes=$((diff_seconds+/+60))\n\n#+Output+the+result\necho+\"$diff_seconds\"\n",
     "m_variableToSaveResponse": {
      "dictionary": {
       "entries": [],
       "isArray": false,
