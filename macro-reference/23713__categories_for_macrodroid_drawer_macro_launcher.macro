       "type": "SceneWebView",
       "sceneWebViewConfig": {
        "closeSceneOnPress": false,
        "enableJavaScript": true,
        "enableSwipeNavigation": false,
        "height": 100,
        "padding": "0",
        "url": "<!DOCTYPE+html>\n<html>\n<head>\n<meta+charset=\"UTF-8\">\n<meta+name=\"viewport\"+content=\"width=device-width,+initial-scale=1.0,+maximum-scale=1.0,+user-scalable=no\">\n<title>Dynamic+List</title>\n<style>\n++/*+---+Global+Styles+---+*/\n++body+{\n++++margin:+0;\n++++background:+#000;\n++++color:+white;\n++++font-family:+-apple-system,+BlinkMacSystemFont,+\"Segoe+UI\",+Roboto,+Helvetica,+Arial,+sans-serif;\n++++display:+flex;\n++++flex-direction:+column;\n++++align-items:+center;\n++++min-height:+100vh;\n++++padding-bottom:+100px;+\n++++box-sizing:+border-box;\n++++user-select:+none;\n++++-webkit-user-select:+none;\n++++overflow-x:+hidden;\n++++overflow-y:+auto;\n++}\n\n++h1+{\n++++font-size:+24px;\n++++margin:+20px+0;\n++++text-align:+center;\n++++transition:+color+0.3s;\n++++font-weight:+600;\n++}\n\n++/*+---+Button+Styles+---+*/\n++#buttonContainer+{\n++++width:+100%;\n++++max-width:+500px;\n++++display:+flex;\n++++flex-direction:+column;\n++++align-items:+center;\n++++padding:+0+15px;\n++++box-sizing:+border-box;\n++}\n\n++.btn+{\n++++width:+100%;\n++++padding:+18px+20px;\n++++background:+#1a1a1a;\n++++font-size:+18px;\n++++text-align:+center;\n++++border-radius:+12px;\n++++margin:+6px+0;\n++++cursor:+pointer;\n++++border:+1px+solid+#333;\n++++transition:+background+0.2s,+transform+0.2s,+border-color+0.3s;\n++++touch-action:+pan-y;+\n++++position:+relative;\n++++box-sizing:+border-box;\n++}\n\n++.btn:active+{\n++++background:+#333;\n++}\n\n++/*+Visual+feedback+that+a+long-press+is+happening+*/\n++.btn.preparing-drag+{\n++++transform:+scale(0.96);\n++++background:+#252525;\n++}\n\n++.highlight+{\n++++background:+#444+!important;\n++++border-color:+#00b894;\n++}\n\n++/*+---+Reorder+Mode+Styles+---+*/\n++body.sort-mode+.btn+{\n++++border:+1px+dashed+#00b894;\n++++background:+#111;\n++++animation:+shake+0.5s+infinite+alternate;\n++++touch-action:+pan-y;+\n++}\n\n++@keyframes+shake+{\n++++0%+{+transform:+rotate(-0.5deg);+}\n++++100%+{+transform:+rotate(0.5deg);+}\n++}\n\n++.dragging+{\n++++opacity:+0.9;\n++++background:+#333+!important;\n++++transform:+scale(1.05)+!important;\n++++box-shadow:+0+10px+25px+rgba(0,0,0,0.8);\n++++z-index:+1000;\n++++border:+1px+solid+#00b894+!important;\n++++animation:+none+!important;\n++++touch-action:+none+!important;\n++}\n\n++/*+---+Floating+Save+Button+---+*/\n++#saveContainer+{\n++++position:+fixed;\n++++top:+-120px;+\n++++left:+50%;\n++++transform:+translateX(-50%);\n++++width:+100%;\n++++padding:+30px+0;\n++++background:+linear-gradient(rgba(0,0,0,0.9)+60%,+transparent);\n++++display:+flex;+\n++++justify-content:+center;\n++++align-items:+center;\n++++z-index:+1500;\n++++transition:+top+0.5s+cubic-bezier(0.175,+0.885,+0.32,+1.275);\n++++pointer-events:+none;\n++}\n\n++body.sort-mode+#saveContainer+{\n++++top:+0;\n++++pointer-events:+auto;\n++}\n\n++#saveBtn+{\n++++background:+#00b894;\n++++color:+white;\n++++font-size:+18px;\n++++padding:+15px+50px;\n++++border-radius:+30px;\n++++border:+none;\n++++cursor:+pointer;\n++++font-weight:+bold;\n++++box-shadow:+0+8px+25px+rgba(0,0,0,0.6),+0+0+10px+rgba(0,184,148,0.3);\n++++transition:+transform+0.1s,+background+0.2s;\n++}\n++\n++#saveBtn:active+{+transform:+scale(0.95);+}\n\n++#menuOverlay+{\n++++position:+fixed;\n++++top:+0;+left:+0;\n++++width:+100%;+height:+100%;\n++++background:+rgba(0,0,0,0.8);\n++++display:+none;\n++++justify-content:+center;\n++++align-items:+center;\n++++z-index:+2000;\n++++backdrop-filter:+blur(4px);\n++}\n\n++.menu-box+{\n++++background:+#222;\n++++padding:+20px;\n++++border-radius:+20px;\n++++width:+80%;\n++++max-width:+320px;\n++++border:+1px+solid+#444;\n++}\n\n++.menu-item+{\n++++background:+#333;\n++++padding:+15px;\n++++font-size:+18px;\n++++text-align:+center;\n++++border-radius:+10px;\n++++margin-bottom:+10px;\n++++color:+white;\n++}\n++\n++.menu-item:last-child+{+margin-bottom:+0;+}\n++.menu-item:active+{+background:+#00b894;+}\n\n</style>\n</head>\n<body>\n\n<div+id=\"saveContainer\">\n++<button+id=\"saveBtn\">Save+New+Order</button>\n</div>\n\n<h1+id=\"pageTitle\">Select+a+Category</h1>\n\n<div+id=\"buttonContainer\"></div>\n\n<div+id=\"menuOverlay\">\n++<div+id=\"menuPopup\"+class=\"menu-box\"></div>\n</div>\n\n<textarea+id=\"rawDict\"+style=\"display:none\">{lv=selectableItemsJSON}</textarea>\n\n<script>\n++const+triggerUrl+=+\"http://localhost:8080/selectionBox\";\n++const+LONG_PRESS_MS+=+600;\n++const+REORDER_DELAY_MS+=+600;+\n++const+SCENE_ID+=+\"IRO1\";+//+Define+the+parameter+value+here\n\n++let+pressTimer+=+null;\n++let+reorderTimeout+=+null;\n++let+isSortMode+=+false;\n++let+draggingEl+=+null;\n++\n++let+touchStartY+=+0;\n++let+isScrolling+=+false;\n\n++const+rawData+=+document.getElementById('rawDict').value.trim();\n++let+dictionary+=+{};\n++let+listItems+=+[];\n\n++try+{\n++++let+jsonStr+=+rawData;\n++++if+(jsonStr.startsWith('\"')+&&+jsonStr.endsWith('\"'))+{\n+++++++jsonStr+=+jsonStr.substring(1,+jsonStr.length-1).replace(/\\\\\"/g,+'\"');\n++++}\n++++dictionary+=+JSON.parse(jsonStr+||+'{}');\n++++listItems+=+Object.keys(dictionary).filter(k+=>+k+!==+'');\n++}+catch+(e)+{\n++++listItems+=+[\"Error+parsing+JSON\"];\n++++console.error(\"JSON+Error:\",+e);\n++}\n\n++const+container+=+document.getElementById('buttonContainer');\n++const+title+=+document.getElementById('pageTitle');\n++\n++renderList();\n\n++document.getElementById('saveBtn').addEventListener('click',+saveNewOrder);\n++document.getElementById('menuOverlay').addEventListener('click',+(e)+=>+{\n++++if(e.target.id+===+'menuOverlay')+closeMenu();\n++});\n\n++function+renderList()+{\n++++container.innerHTML+=+'';\n++++listItems.forEach((item)+=>+{\n++++++const+btn+=+document.createElement('div');\n++++++btn.className+=+'btn';\n++++++btn.textContent+=+item;\n++++++attachUnifiedListeners(btn,+item);\n++++++container.appendChild(btn);\n++++});\n++}\n\n++function+attachUnifiedListeners(element,+itemText)+{\n++++element.addEventListener('touchstart',+(e)+=>+{\n++++++++touchStartY+=+e.touches[0].pageY;\n++++++++isScrolling+=+false;\n\n++++++++if+(isSortMode)+{\n++++++++++++element.classList.add('preparing-drag');\n++++++++++++reorderTimeout+=+setTimeout(()+=>+{\n++++++++++++++++if+(!isScrolling)+{\n++++++++++++++++++++element.classList.remove('preparing-drag');\n++++++++++++++++++++handleDragStart(element);\n++++++++++++++++}\n++++++++++++},+REORDER_DELAY_MS);\n++++++++}+else+{\n++++++++++++element.classList.add('highlight');\n++++++++++++pressTimer+=+setTimeout(()+=>+{\n++++++++++++++++if+(!isScrolling)+openMenu(element,+itemText);\n++++++++++++},+LONG_PRESS_MS);\n++++++++}\n++++},+{passive:+true});\n\n++++element.addEventListener('touchmove',+(e)+=>+{\n++++++++const+touchY+=+e.touches[0].pageY;\n++++++++if+(Math.abs(touchY+-+touchStartY)+>+10)+{\n++++++++++++isScrolling+=+true;\n++++++++++++clearTimeout(pressTimer);\n++++++++++++clearTimeout(reorderTimeout);+\n++++++++++++element.classList.remove('highlight');\n++++++++++++element.classList.remove('preparing-drag');\n++++++++}\n++++++++if+(isSortMode+&&+draggingEl)+{\n++++++++++++handleDragMove(e);\n++++++++}\n++++},+{passive:+false});\n\n++++element.addEventListener('touchend',+(e)+=>+{\n++++++++clearTimeout(reorderTimeout);\n++++++++element.classList.remove('preparing-drag');\n++++++++if+(isSortMode)+{\n++++++++++++handleDragEnd();\n++++++++}+else+{\n++++++++++++clearTimeout(pressTimer);\n++++++++++++element.classList.remove('highlight');\n++++++++}\n++++});\n\n++++element.addEventListener('click',+(e)+=>+{\n++++++++if(!isSortMode+&&+!draggingEl+&&+!isScrolling)+{\n++++++++++++pick(itemText);\n++++++++}\n++++});\n++}\n\n++function+pick(item)+{\n++++if+(typeof+item+===+'string'+&&+item.endsWith(\",+Move\"))+{\n++++++enableSortMode();\n++++++return;+\n++++}\n++++//+Added+sceneIndicator+parameter+here\n++++const+url+=+`${triggerUrl}?selectedItem=${encodeURIComponent(item)}&sceneIndicator=${SCENE_ID}&t=${Date.now()}`;\n++++fetch(url).catch(err+=>+console.log(\"Fetch+error:\",+err));\n++}\n\n++function+enableSortMode()+{\n++++isSortMode+=+true;\n++++document.body.classList.add('sort-mode');\n++++title.textContent+=+\"Hold+600ms+to+Drag\";\n++++title.style.color+=+\"#00b894\";\n++}\n\n++function+handleDragStart(el)+{\n++++draggingEl+=+el;\n++++draggingEl.classList.add('dragging');\n++++if+(window.navigator.vibrate)+window.navigator.vibrate(40);\n++}\n\n++function+handleDragMove(e)+{\n++++if+(!draggingEl)+return;\n++++if(e.cancelable)+e.preventDefault();+\n\n++++const+touch+=+e.touches[0];\n++++const+elementUnder+=+document.elementFromPoint(touch.clientX,+touch.clientY);\n++++const+targetBtn+=+elementUnder+?+elementUnder.closest('.btn')+:+null;\n\n++++if+(targetBtn+&&+targetBtn+!==+draggingEl)+{\n++++++const+allBtns+=+[...container.children];\n++++++const+curIndex+=+allBtns.indexOf(draggingEl);\n++++++const+targetIndex+=+allBtns.indexOf(targetBtn);\n\n++++++if+(curIndex+<+targetIndex)+{\n++++++++container.insertBefore(draggingEl,+targetBtn.nextSibling);\n++++++}+else+{\n++++++++container.insertBefore(draggingEl,+targetBtn);\n++++++}\n++++}\n\n++++const+scrollThreshold+=+80;\n++++if+(touch.clientY+<+scrollThreshold)+{\n++++++++window.scrollBy(0,+-10);\n++++}+else+if+(window.innerHeight+-+touch.clientY+<+scrollThreshold)+{\n++++++++window.scrollBy(0,+10);\n++++}\n++}\n\n++function+handleDragEnd()+{\n++++if(draggingEl)+{\n++++++++draggingEl.classList.remove('dragging');\n++++++++draggingEl+=+null;\n++++}\n++}\n\n++function+saveNewOrder()+{\n++++const+currentButtons+=+document.querySelectorAll('.btn');\n++++const+newOrderedDict+=+{};\n\n++++currentButtons.forEach(btn+=>+{\n++++++const+key+=+btn.textContent;\n++++++newOrderedDict[key]+=+dictionary[key]+||+\"Move\";\n++++});\n\n++++const+jsonString+=+JSON.stringify(newOrderedDict);\n++++const+sBtn+=+document.getElementById('saveBtn');\n++++sBtn.textContent+=+\"Saving...\";\n++++sBtn.style.backgroundColor+=+\"#555\";\n++++\n++++//+Added+sceneIndicator+parameter+here\n++++const+url+=+`${triggerUrl}?newListOrder=${encodeURIComponent(jsonString)}&sceneIndicator=${SCENE_ID}&t=${Date.now()}`;\n++++\n++++fetch(url).finally(()+=>+{\n++++++++isSortMode+=+false;\n++++++++document.body.classList.remove('sort-mode');\n++++++++setTimeout(()+=>+location.reload(),+500);+\n++++});\n++}\n\n++function+openMenu(element,+itemText)+{\n++++const+popup+=+document.getElementById('menuPopup');\n++++popup.innerHTML+=+'';\n++++\n++++let+optionsStr+=+dictionary[itemText]+||+\"Move\";\n++++if(optionsStr+===+\"\")+optionsStr+=+\"Move\";\n\n++++const+options+=+optionsStr.split(',').map(s+=>+s.trim());\n++++\n++++options.forEach(opt+=>+{\n++++++++if(!opt)+return;\n++++++++const+div+=+document.createElement('div');\n++++++++div.className+=+'menu-item';\n++++++++div.textContent+=+opt;\n++++++++div.onclick+=+(e)+=>+{\n++++++++++++e.stopPropagation();\n++++++++++++closeMenu();\n++++++++++++pick(`${itemText},+${opt}`);+\n++++++++};\n++++++++popup.appendChild(div);\n++++});\n\n++++document.getElementById('menuOverlay').style.display+=+'flex';\n++}\n\n++function+closeMenu()+{\n++++document.getElementById('menuOverlay').style.display+=+'none';\n++}\n</script>\n</body>\n</html>\n",
