       "guid": -8765500203892894539,
       "iconRes": 2131231205,
       "lastRefreshValue": 0
      },
      {
       "type": "SceneWebView",
       "sceneWebViewConfig": {
        "closeSceneOnPress": false,
        "enableJavaScript": true,
        "enableSwipeNavigation": false,
        "height": 100,
        "padding": "0",
        "url": "<!DOCTYPE+html>\n<html>\n<head>\n<meta+charset=\"UTF-8\">\n<title>Pick+One</title>\n\n<style>\n++/*+---+Global+Body+Setup+---+*/\n++body+{\n++++margin:0;\n++++background:#000;\n++++color:white;\n++++font-family:sans-serif;\n++++display:flex;\n++++flex-direction:column;\n++++justify-content:flex-start;+\n++++align-items:center;\n++++min-height:100vh;\n++++padding:40px+0;\n++++box-sizing:border-box;\n++}\n\n++/*+---+Page+Title+Style+---+*/\n++#pageTitle+{\n++++font-size:+70px;\n++++margin-bottom:+20px;\n++++text-align:+center;\n++++text-shadow:+none;\n++}\n\n++/*+---+Search+Input+Style+---+*/\n++#searchInput+{\n++++width:+90vw;\n++++max-width:+600px;\n++++padding:+30px;\n++++font-size:+44px;\n++++background:+#222;\n++++color:+white;\n++++border:+2px+solid+#444;\n++++border-radius:+20px;\n++++margin-bottom:+30px;\n++++outline:+none;\n++++box-sizing:+border-box;\n++}\n++\n++#searchInput:focus+{\n++++border-color:+#00ffff;\n++}\n\n++/*+---+Main+Button+Style+(.btn)+---+*/\n++.btn+{\n++++width:90vw;\n++++max-width:600px;\n++++padding:45px;\n++++background:#111;\n++++font-size:52px;\n++++text-align:center;\n++++border-radius:24px;\n++++margin:20px+0;\n++++cursor:pointer;\n++++user-select:none;\n++++transition:+background+0.2s,+box-shadow+0.2s;\n++}\n\n++.btn:active+{\n++++background:#444;\n++}\n</style>\n</head>\n<body>\n\n<h1+id=\"pageTitle\">Select+a+Macro</h1>\n\n<input+type=\"text\"+id=\"searchInput\"+placeholder=\"Search+items...\"+autocomplete=\"off\">\n\n<div+id=\"buttonContainer\"></div>\n\n<textarea+id=\"rawString\"+style=\"display:none\">{lv=macroListString}</textarea>\n\n<script>\nconst+triggerUrl+=+\"http://localhost:8080/selectionBox\";\nconst+DELIMITER+=+\"「≠\";\n\n//+1.+DATA+EXTRACTION\nconst+rawInput+=+document.getElementById('rawString').value.trim();\n\n//+2.+DATA+PROCESSING\nlet+items+=+[];\nif+(rawInput)+{\n++//+Split,+trim,+and+remove+empty+strings\n++const+rawArray+=+rawInput.split(DELIMITER).map(s+=>+s.trim()).filter(s+=>+s+!==+'');\n++\n++//+Map+items+to+keep+track+of+their+ORIGINAL+index+and+remove+duplicates\n++const+seen+=+new+Set();\n++items+=+rawArray.map((text,+originalIndex)+=>+({+text,+originalIndex+}))\n++++++++++++++++++.filter(item+=>+{\n++++++++++++++++++++const+duplicate+=+seen.has(item.text);\n++++++++++++++++++++seen.add(item.text);\n++++++++++++++++++++return+!duplicate;\n++++++++++++++++++});\n}\n\nif+(items.length+===+0)+{\n++++items+=+[{+text:+\"No+Items+Found\",+originalIndex:+-1+}];\n}\n\nconst+container+=+document.getElementById('buttonContainer');\nconst+searchInput+=+document.getElementById('searchInput');\n\n/**\n+*+3.+CLICK+HANDLER\n+*/\nfunction+pick(itemText,+originalIndex)+{\n++const+data+=+`selectedItem=${encodeURIComponent(itemText)}&sceneIndicator=IRO3`;\n++//+Use+originalIndex+if+valid,+otherwise+don't+send+it\n++const+indexParam+=+(originalIndex+>=+0)+?+`&idx=${originalIndex}`+:+'';\n++const+fullUrl+=+`${triggerUrl}?${data}${indexParam}&t=${Date.now()}`;\n++fetch(fullUrl).catch(()+=>+{});\n}\n\n/**\n+*+4.+RENDERING+LOGIC\n+*/\nfunction+renderList(filterText+=+\"\")+{\n++++container.innerHTML+=+\"\";\n++++\n++++const+query+=+filterText.toLowerCase();\n\n++++//+Filter+based+on+the+stored+text+property\n++++const+filteredItems+=+items.filter(item+=>+\n++++++++item.text.toLowerCase().includes(query)\n++++);\n\n++++filteredItems.forEach((item)+=>+{\n++++++++const+btn+=+document.createElement('div');\n++++++++btn.className+=+'btn';\n++++++++btn.textContent+=+item.text;\n++++++++\n++++++++//+Use+the+originalIndex+so+MacroDroid+gets+the+right+reference\n++++++++btn.onclick+=+()+=>+pick(item.text,+item.originalIndex);\n\n++++++++container.appendChild(btn);\n++++});\n}\n\n//+Listen+for+typing+in+the+search+box\nsearchInput.addEventListener('input',+(e)+=>+{\n++++renderList(e.target.value);\n});\n\n//+Initial+render\nrenderList();\n\n</script>\n\n</body>\n</html>\n",
        "variableUpdateValue": {
         "type": "None"
        },
        "width": 100
       },
       "guid": -5410565919998211437,
       "iconRes": 2131231733,
       "lastRefreshValue": 0
      }
