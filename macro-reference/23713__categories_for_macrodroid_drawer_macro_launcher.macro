   "customEntries": [
    {
     "color": -1118482,
     "guid": -7379386131690248900,
     "isBold": false,
     "isItalic": false,
     "key": "",
     "text": "Version+1+:+In+this+version,+the+macro+itself+is+the+category,+and+the+macro+will+launch+directly+into+the+category.+Just+copy+this+macro,+rename+it+to+the+category+name,+and+place+it+into+the+MacroDroid+drawer.+Do+this+for+each+category.+Intended+for+launching+categories+directly+from+the+MacroDroid+drawer.",
     "value": ""
    },
    {
     "color": -1118482,
     "guid": -9085284213927491707,
     "isBold": false,
     "isItalic": false,
     "key": "",
     "text": "Version+2+:+In+this+version,+the+macro+will+launch+into+a+category+selector+where+you+can+create+new+categories+dynamically.+Intended+to+be+a+separate+launcher+or+be+a+sub-drawer.+",
     "value": ""
    }
   ],
