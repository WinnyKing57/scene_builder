  {
   "description": "This+variable+is+only+used+for+description+in+German+and+can+be+deleted.\nDiese+Variable+dient+nur+der+Beschreibung+in+deutsch+und+kann+gelöscht+werden.",
   "dictionary": {
    "entries": [],
    "isArray": false,
    "variableType": 4,
    "type": "Dictionary"
   },
   "isActionBlockWorkingVar": true,
   "isLocalVar": true,
   "isSecure": false,
   "m_booleanValue": false,
   "m_decimalValue": 0.0,
   "m_intValue": 0,
   "m_name": "DeutscheBeschreibung",
   "m_stringValue": "Das+Makro+dient+zum+Suchen+von+Tasmotageräten+im+Heimnetzwerk.+Die+gefundenen+Geräte+werden+in+der+globalen+Variable+'TasmotaDevices'++zusammen+mit+den+Status-Informationen+'Hostname',+'DeviceName',+'FriendlyName',+'Gateway',+'Mac'+und+'Version'+pro+WLAN+gespeichert.+Die+Suche+wird+visuell+dargestellt.+Die+Links+zu+den+gefundenen+Geräten+werden+angezeigt.+Das+Makro+enthält+bereits+die+englischen+und+deutschen+Bezeichnungen.++Die+Bezeichnungen+in+deiner+Sprache+kannst+du+fast+'wysiwyg'+in+den+Szenen+eingeben.+Falls+nicht+alle+Geräte+gefunden+werden+erhöhe+bitte+den+Timeout+in+der+Verbindungsüberprüfung+im+Aktionsblock+'TasmotaSearchDevices'.+\n\nEine+weitere+globale+Variable+namens+'TasmotaSearchDevices'+hat+nur+temporäre+Zwecke+und+wird+vor+jeder+neuen+Suche+gelöscht.+\n\nEine+deutsche+Beschreibung+des+Makros+ist+in+der+Variable+'DeutscheBeschreibung'+enthalten.",
   "m_type": 2,
   "supportsInput": false,
   "supportsOutput": true
  },
