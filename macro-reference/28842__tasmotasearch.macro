   "m_category": "Werkzeuge",
   "m_constraintList": [],
   "m_description": "This+action+block+inverts+multiple+Boolean+variables+simultaneously.+This+is+useful+in+scenes,+where+only+one+variable+can+be+inverted+at+a+time.\nDieser+Aktionsblock+invertiert+mehrere+boolesche+Variablen+gleichzeitig.+Dies+ist+nützlich+in+Szenen,+in+denen+jeweils+nur+eine+Variable+invertiert+werden+kann.",
   "m_descriptionOpen": true,
   "m_enabled": false,
   "m_excludeLog": false,
   "m_headingColor": -11382190,
   "m_isOrCondition": false,
   "m_name": "MultiToggle",
   "m_triggerList": []
  }
