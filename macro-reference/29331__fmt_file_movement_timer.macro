   "scriptText": "try+{\nlet+f+=+`{lv=from}`\nif(f)+console.log(f.substr(-1)+!==+\"/\"+?+f.replace(/(\\w$)/,+\"$1/\")+:+f)\n}+catch+(err)+{\n++++`{lv=from}`\n}",
