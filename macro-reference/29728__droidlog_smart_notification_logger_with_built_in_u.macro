   "m_script": "LOG=\"{lv=log_file_path}\"\nLANG=\"{lv=language}\"\nNOT_FOUND=\"Archives+not+found\"\nERROR=\"Error+deleting\"\nDELETED_ARCHIVES=\"Deleted+archives:\"\nDIR=$(dirname+\"$LOG\")\nBASE=$(basename+\"$LOG\"+|+sed+'s/\\.[^.]*$//')\nEXT=\"${LOG##*.}\"\nPATTERN=\"$DIR/${BASE}_[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]_[0-9][0-9]-[0-9][0-9]-[0-9][0-9].$EXT\"\nFILES=$(ls+$PATTERN+2>/dev/null)\n\nif+[+\"$LANG\"+=+\"UA\"+-o+\"$LANG\"+=+\"ua\"+];+then\n++++NOT_FOUND=\"Архіви+не+знайдені\"\n++++ERROR=\"Помилка+при+видаленні\"\n++++DELETED_ARCHIVES=\"Видалено+архівів:\"\nfi\n\nif+[+-z+\"$FILES\"+];+then\n++++echo+\"$NOT_FOUND\"\nelse\n++++COUNT=$(echo+\"$FILES\"+|+wc+-l)\n++++rm+$PATTERN\n++++if+[+$?+-eq+0+];+then\n++++++++echo+\"$DELETED_ARCHIVES+$COUNT\"\n++++else\n++++++++echo+\"$ERROR\"\n++++fi\nfi",
