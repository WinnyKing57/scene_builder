  {
   "blockNextAction": true,
   "m_nonRoot": true,
   "m_script": "FILE_PATH=\"{lv=log_file_path}\"\nMAX_COUNT=\"{lv=log_archives_max_count}\"\n\nDIR_PATH=$(dirname+\"$FILE_PATH\")\nFILE_NAME=$(basename+\"$FILE_PATH\")\nBASE_NAME=\"${FILE_NAME%.*}\"\nEXT=\"${FILE_NAME##*.}\"\n\nTIMESTAMP=$(date++\"%Y-%m-%d_%H-%M-%S\")\nARCHIVE_NAME=\"${DIR_PATH}/${BASE_NAME}_${TIMESTAMP}.${EXT}\"\n\nif+[+-f+\"$FILE_PATH\"+];+then\n++++mv+\"$FILE_PATH\"+\"$ARCHIVE_NAME\"\n++++touch+\"$FILE_PATH\"\nfi\n\ncd+\"$DIR_PATH\"+||+exit\nCURRENT_COUNT=$(ls+-1+${BASE_NAME}_*.\"${EXT}\"+2>/dev/null+|+wc+-l)\n\nif+[+\"$CURRENT_COUNT\"+-gt+\"$MAX_COUNT\"+];+then\n++++DELETE_COUNT=$((CURRENT_COUNT+-+MAX_COUNT))\n++++ls+-1tr+${BASE_NAME}_*.\"${EXT}\"+|+head+-n+\"$DELETE_COUNT\"+|+xargs+rm+-f\nfi",
   "m_variableToSaveErrorResponse": {
