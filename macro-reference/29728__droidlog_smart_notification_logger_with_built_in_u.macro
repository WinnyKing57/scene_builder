  {
   "sceneDescription": {
    "itemList": {
     "items": [
      {
       "type": "SceneWebView",
       "sceneWebViewConfig": {
        "closeSceneOnPress": false,
        "enableJavaScript": true,
        "enableSwipeNavigation": true,
        "height": 80,
        "padding": "0",
        "url": "<!DOCTYPE+html>\n<html>\n<head>\n<meta+charset=\"UTF-8\">\n<meta+name=\"viewport\"+content=\"width=device-width,+initial-scale=1.0\">\n<style>\n*+{+margin:+0;+padding:+0;+box-sizing:+border-box;+}\nhtml+{+padding:+15px;+}\nh1+{+font-size:+22px;+margin-bottom:+15px;+text-align:+center;+}\n.total+{+font-size:+18px;+margin-bottom:+7px;+}\n.total+span+{+font-weight:+bold;+}\n.date+{+margin-bottom:+7px;+}\n.file-size+{+font-size:+18px;+margin-bottom:+7px;+}\n.file-size+span+{+font-weight:+bold;+}\n.apps-count+{+font-size:+18px;+margin-bottom:+7px;+}\n</style>\n</head>\n<body>\n<div+id=\"error\"></div>\n<h1>{lv=lang_statistics_notification-statistics}</h1>\n<div+class=\"total\">{lv=lang_statistics_total-number-of-notifications}+<span>{lv=stat_total}</span></div>\n<div+class=\"date\">{lv=stat_date_first}+-+{lv=stat_date_last}</div>\n<div+class=\"file-size\">{lv=lang_statistics_log-file-size}+<span>{lv=stat_size_kb}+KB+({lv=stat_size_b}+{lv=lang_statistics_bytes})</span></div>\n<div+class=\"apps-count\">{lv=lang_statistics_number-of-notifications-by-app}</div>\n<div+id=\"apps-container\"></div>\n<script>\nlet+appsRawString+=+`{lv=stat_apps}`\ntry+{\n++let+appsArray+=+appsRawString.split(String.fromCharCode(10));\n++let+container+=+document.getElementById(\"apps-container\");\n++let+tableHTML+=+'<table+style=\"width:100%;+border-collapse:+collapse;+font-family:+sans-serif;\">';\n++tableHTML++=+'<thead+style=\"background-color:+#f2f2f2;\"><tr>'++\n+++++++++++++++'<th+style=\"padding:+8px;+border:+1px+solid+#ddd;+width:+30px;\">№</th>'++\n+++++++++++++++'<th+style=\"padding:+8px;+border:+1px+solid+#ddd;+text-align:+left;\">{lv=lang_statistics_app-name}</th>'++\n+++++++++++++++'<th+style=\"padding:+8px;+border:+1px+solid+#ddd;+width:+80px;\">{lv=lang_statistics_count}</th>'++\n+++++++++++++++'</tr></thead>';\n++tableHTML++=+'<tbody>';\n++let+rowNum+=+1;\n++appsArray.forEach(function(item)+{\n++++let+trimmedItem+=+item.trim();\n++++if+(trimmedItem.length+>+0)+{\n++++++let+parts+=+trimmedItem.split(\":\");\n++++++let+name+=+parts[0]+?+parts[0].trim()+:+\"Невідомо\";\n++++++let+count+=+parts[1]+?+parts[1].trim()+:+\"0\";\n++++++tableHTML++=+'<tr>';\n++++++tableHTML++=+'<td+style=\"padding:+8px;+border:+1px+solid+#ddd;+text-align:+center;+color:+#666;\">'+++rowNum+++'</td>';\n++++++tableHTML++=+'<td+style=\"padding:+8px;+border:+1px+solid+#ddd;\">'+++name+++'</td>';\n++++++tableHTML++=+'<td+style=\"padding:+8px;+border:+1px+solid+#ddd;+text-align:+center;+font-weight:+bold;\">'+++count+++'</td>';\n++++++tableHTML++=+'</tr>';\n++++++rowNum++;\n++++}\n++});\n++tableHTML++=+'</tbody></table>';\n++container.innerHTML+=+tableHTML;\n}+catch+(e)+{\n++document.getElementById(\"apps-container\").innerHTML+=+\"Помилка:+\"+++e.message;\n}\n</script>\n</body>\n</html>",
        "variableUpdateValue": {
         "type": "None"
        },
        "width": 100
       },
