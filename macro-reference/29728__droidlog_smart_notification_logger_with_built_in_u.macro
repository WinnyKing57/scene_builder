   "m_script": "LOG=\"{lv=log_file_path}\"\nLANG=\"{lv=language}\"\nDIR=$(dirname+\"$LOG\")\nBASE=$(basename+\"$LOG\"+|+sed+'s/\\.[^.]*$//')\nEXT=\"${LOG##*.}\"\n\nif+[+\"$LANG\"+=+\"UA\"+]+||+[+\"$LANG\"+=+\"ua\"+];+then\n++++HEADER=\"Додаток\tЗаголовок\tДата\tТекст\"\n++++MSG_OK=\"Експорт+завершено\"\n++++MSG_ERROR=\"Помилка+експорту\"\nelse\n++++HEADER=\"App\tTitle\tDate\tContent\"\n++++MSG_OK=\"Export+completed\"\n++++MSG_ERROR=\"Export+error\"\nfi\n\nOUT=\"$DIR/export.tsv\"\necho+\"$HEADER\"+>+\"$OUT\"\n\nAWK_SCRIPT='\nfunction+e(s)+{\n++++gsub(/\\t/,+\"+\",+s)\n++++return+s\n}\nfunction+f()+{\n++++if+(app+!=+\"\")\n++++++++print+e(app)+\"\\t\"+e(title)+\"\\t\"+e(date)+\"\\t\"+e(text)\n++++app=\"\"\n++++title=\"\"\n++++date=\"\"\n++++text=\"\"\n++++last=\"\"\n}\n/^App:+/++++++++{+f();+app=substr($0,index($0,\":+\")+2);+last=\"app\";+next+}\n/^Title:+/++++++{+title=substr($0,index($0,\":+\")+2);+last=\"title\";+next+}\n/^Date:+/+++++++{+date=substr($0,index($0,\":+\")+2);+last=\"date\";+next+}\n/^Content:+/+++++++{+text=substr($0,index($0,\":+\")+2);+last=\"text\";+next+}\n/^Додаток:+/++++{+f();+app=substr($0,index($0,\":+\")+2);+last=\"app\";+next+}\n/^Заголовок:+/++{+title=substr($0,index($0,\":+\")+2);+last=\"title\";+next+}\n/^Дата:+/+++++++{+date=substr($0,index($0,\":+\")+2);+last=\"date\";+next+}\n/^Текст:+/++++++{+text=substr($0,index($0,\":+\")+2);+last=\"text\";+next+}\n{\n++++if+(app+!=+\"\"+&&+last+!=+\"\"+&&+$0+!=+\"\")\n++++++++if+(last+==+\"app\")+app=app+\"+\"+$0\n++++++++else+if+(last+==+\"title\")+title=title+\"+\"+$0\n++++++++else+if+(last+==+\"date\")+date=date+\"+\"+$0\n++++++++else+if+(last+==+\"text\")+text=text+\"+\"+$0\n}\nEND+{+f()+}\n'\n\ncd+\"$DIR\"\nARCHIVES=($BASE\\_[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]_[0-9][0-9]-[0-9][0-9]-[0-9][0-9].$EXT)\n\nif+[+-f+\"${ARCHIVES[0]}\"+];+then\n++++awk+\"$AWK_SCRIPT\"+\"${ARCHIVES[@]}\"+>>+\"$OUT\"\nfi\n\nawk+\"$AWK_SCRIPT\"+\"$LOG\"+>>+\"$OUT\"\n\nif+[+$?+-eq+0+];+then\n++++echo+\"$MSG_OK:+$OUT\"\nelse\n++++echo+\"$MSG_ERROR\"\nfi\n\ncd+-",
