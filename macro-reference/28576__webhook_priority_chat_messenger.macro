   "m_SIGUID": -5136007787725802628,
   "m_classType": "ShortcutTrigger",
   "m_comment": "Please+watch+a+tutorial+before+you+actually+install+this+messenger.+Link+can+be+seen+in+comments+and+is+given+below:\n`Please+stand+by`.+Read+user+guide+till+then.\n\n>+User+guide+till+then.\n++++-+After+saving+the+bot,+you+need+to+access+local+variables.\n++++-+`yourName`+variable,+as+the+name+implies+holds+your+name+that+is+sent+along+with+the+message+to+receiver.\n++++-+`contactNameAndUrl`+is+a+dictionary/object+that+holds+type-string+key:+value+pair.+Key+being+receiver's+name+and+value+being+hs+webhook+url.+\n++++-+You+can+create+as+many+contacts+as+you+want.\n++++-+Save+everything+and+you're+good+to+go.\n\n>+Features:\n-+By+using+widget+and/or+the+shortcut+you+can:\n++++1.+send+new+message+\n++++2.+read+chat+history+of+all+contacts\n-+When+you+receive+a+new+message\n++++1.+Not+only+you+can+reply+to+the+from+the+same+menu+but+also+you+can+see+your+chat+history+with+them+(sender).",
   "m_constraintList": [],
   "m_isDisabled": false,
   "m_isOrCondition": false
  },
