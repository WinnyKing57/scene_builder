          "children": [
           {
            "type": "SceneWebView",
            "sceneWebViewConfig": {
             "closeSceneOnPress": false,
             "enableJavaScript": true,
             "enableSwipeNavigation": true,
             "height": 50,
             "url": "<!DOCTYPE+html>\n<html>\n<head>\n<style>\nbody+{\nposition:+relative;\ndisplay:+flex;\nflex-direction:+column;\nalign-items:+center;\n}\n*+{\n/*border:+2px+solid+red;*/\n}\n\npre:target,+pre:active{\nborder:+2px+solid+grey;\nfilter:+contrast(50%);\n}\n\npre,+.chats,+h4+{\nwidth:+80%;\noverflow-x:+hidden;\ncolor:+white;\nborder-radius:+16px+16px+16px+4px;+\nbox-shadow:0+6px+18px+rgba(0,0,0,.15);\nwhite-space:+pre-wrap;\noverflow-wrap:+break-word;\npadding:+20px;\nfont-size:+50px+\n}\n\nh4+{\nwidth:+90%;\ntext-align:+center;\nbackground:+#8788DF;\n}\n.chats+{\nwidth:+90%;\nmin-height:+20px;\nbackground:+#E3C680;\nmargin-bottom:+.5em;\n}\n\npre.left+{\nbackground:+#02343F;\ntransform:+translate(2%);\n}\npre.right+{\ntransform:+translate(17%);\nbackground:+#331B3F;\n}\n\n.float+{\nposition:+absolute;\nz-index:+2;\nwidth:+95%;\n/*overflow-y:+scroll;*/\nbackground:+rgba(0,+0,+0,+0.6);\nbox-shadow:+2px+2px+2px+rgba(0,+0,+0,+0.5)\nfilter:+blur(10px);\nborder-radius:+10px;\ndisplay:+none;\n}\n\n.float+span+{\npadding:+.2em;\nmargin:+.5em;\nborder-radius:+10px;\nbox-shadow:+2px+2px+5px+rgba(0,0,0,0.5);\nfont-size:+60px;\n}\n\n.exit+{\nbackground:+#D90000;\npadding:+.3em;\ntext-align:+center;\nwidth:+20%;\n}\n\n.tcn+{\nwidth:+80%;\nbackground:+#A2798F;\n}\n\n.tcnContainer+{\ndisplay:+flex;\njustify-content:+space-between;\nalign-content:+center;\nposition:+sticky;\n}\n\n.history+{\noverflow-y:+scroll;\n}\n</style>\n</head>\n<body+style=\"background:+rgba(0,0,0,0.7);\">\n\n<h4>CHAT+HISTORY</h4>\n\n<div+class=\"float\">\n<div+class=\"tcnContainer\">\n<span+class=\"tcn\">Chat+name</span>\n<span+class=\"exit\">X</span>\n</div>\n<hr>\n<div+class=\"history\">\n</div>\n</div>\n\n<script>\nconst+showChat+=+document.querySelector(\".float\")\nconst+history+=+document.querySelector(\".history\");\nconst+ch+=+JSON.parse(`{lvjson=chatHistory}`);\nObject.keys(ch).forEach(e+=>+{+\ndocument.body.insertAdjacentHTML(\n++++\"beforeend\",\n++++`<div+class=\"chats\">${e}</div>`\n++);\n});\n\ndocument.addEventListener(\"click\",+function(e){+\ndocument.body.classList.toggle(\"black\");\n\nif+(e.target.className.includes(\"chats\")){\nshowChat.style+=+\"display:+block;\"\nshowChat.querySelector(\".tcn\").textContent+=+e.target.textContent\n\nch[e.target.textContent].forEach(e+=>+{\nif(e.includes(\"You:\")){\nhistory.insertAdjacentHTML(\"beforeend\",+`<pre+class=\"right\">${e.replace(/^.+?\\:/igm,+\"\")}</pre>`)\n}+else+if+(!e.includes(\"You:\")){\nhistory.insertAdjacentHTML(\"beforeend\",+`<pre+class=\"left\">${e.replace(/^.+?\\:/,+\"\")}</pre>`)\n}\n})\n}+else+if+(e.target.className.includes(\"exit\")){\nshowChat.style+=+`display:+none`;\nhistory.innerHTML+=+\"\"\n//)\n\n}+else+if+(e.target.tagName+===+\"PRE\"){\nlet+i+=+document.createElement(\"input\")\ni.value+=+e.target.textContent\ndocument.body.append(i)\ni.select();\ni.setSelectionRange(0,+99999);\ndocument.execCommand(\"copy\");\ndocument.body.removeChild(i)\n}\n\n});\n\n</script>\n</body>\n</html>",
             "variableUpdateValue": {
              "type": "None"
             },
             "width": 100
            },
