  {
   "blockNextAction": true,
   "consoleVariableName": "rawHTML",
   "javascriptEngine": "JetPack+JavascriptEngine",
   "scriptText": "let+properties+=+{\n++++senderClr:+\"#02343F\",\n++++yourClr:+\"#331B3F\",\n++++tagName:+\"pre\"\n}\n//+globally+applied+css+to+both+`pre`+tag\nlet+rawCss+=+`width:+80%;+overflow-x:+hidden;+color:+white;+border-radius:16px+16px+16px+4px;+box-shadow:0+6px+18px+rgba(0,0,0,.15);+white-space:+pre-wrap;+overflow-wrap:+break-word;+padding:+20px;+font-size:+50px`\nlet+ch+=+`{lvjson=chatHistory[{lv=tsn}]}`.replaceAll(/[[\"]|\\]/igm,+\"\").split(\",\")\nlet+msg+=+[]\nch.forEach(e+=>+{\n++++if(e.includes(\"You:\")){\n++++++++\n++++++++msg.push(`\n<${properties.tagName}+style=\"transform:+translateX(17%);+background:+${properties.yourClr};+${rawCss};\">\n${e.replace(/^.+?\\:\\s/igm,+\"\")}\n</${properties.tagName}>\n`)\n++++}+else+if+(!e.includes(\"You:\")){\n++++++++msg.push(`\n<${properties.tagName}+style=\"${rawCss};+transform:+translateX(0);+background:+${properties.senderClr};\">\n${e.replace(/^.+?\\:\\s/igm,+\"\")}\n</${properties.tagName}>\n`)\n++++++++}\n})\nconsole.log(msg.join(\"\\n\"))\n",
   "stringVariableName": "",
   "disableLogging": false,
   "m_SIGUID": -8698397465601109798,
   "m_classType": "JavaScriptAction",
   "m_comment": "properties+object+in+JS+controls+some+global+settings.\nrawCss+is+globally+applied+to+both+yours+and+sender+messages",
   "m_constraintList": [],
   "m_isDisabled": false,
   "m_isOrCondition": false
  },
