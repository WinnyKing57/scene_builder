     "m_script": "a=$(wc+-m+<+\"{lv=filePath}{lv=copyName}\")\nb=$\"{lv=charSize}\"\nv=$(<\"{lv=filePath}{lv=copyName}\")\ncutSize=$((({lv=charSize}+1)))\nstring=$(<'{lv=filePath}{lv=copyName}')\nlength=$\"{lv=charSize}\"\noffset=$((({lv=charSize}*{lv=substringIndex}-{lv=charSize})))\n\n\nif+((+\"$a\"+>\"$b\"));+then\necho+\n\nsubstring=${string:$offset:$length}\n\nvlength=${#substring}\n\necho+\"$substring\"♤\"$vlength\"\n\n\nelse\necho+\"$v\"\n\nfi\n",
